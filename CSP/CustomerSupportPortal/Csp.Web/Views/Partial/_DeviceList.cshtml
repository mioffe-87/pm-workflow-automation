        setTimeout(function() {
            $("#@UniqueId.searchValueId").focus();
        }, 500);

        setTimeout(function() {
            $('#' + deviceGridId).data('kendoGrid').table.on('click', '.pending-device-transfer', showPendingDeviceTransferDetailWindow);
        });
    });

    function SetDeviceType(obj) {
        var deviceType = $('input:radio[name=DeviceType]:checked').val();
        $("#hdnDeviceType").val(deviceType);
        var cloudType = $("#ddCloudTypes").val();
        $("#hdnCloudType").val(cloudType);
        if (deviceType == "2" && cloudType == "") {
            $("#cloudValidationMessage").show();
        } else {
            $("#cloudValidationMessage").hide();
            $(obj).closest(".k-window-content").data("kendoWindow").close();
            @(UniqueId.devices)deviceButtons.openRegisterDeviceWindow();
        }
    }

    function GetAscContactLink(data) {
        if (data && data.ASCId && data.ASCName) {
            return '<a href="javascript:void(0);" onclick="@(UniqueId.device)showAscContactDetailsWindow(' + data.ASCId + ')">' + data.ASCName + '</a>';
        }

        return '';
    }

    function GetActionsLink(data) {
        //Malbork always has 1 license
        if (data.Licenses && data.Licenses.length === 1 && data.Licenses[0].Pandbidentification) {
            var pattern = new RegExp('^(REN)*TRAPSMA(L|LUS|LLAB|LNFR)');
            if (pattern.test(data.Licenses[0].Pandbidentification)) {
                return '<span class=" "></span>';
            }
        }

        //Block AuthCode Activation for CGX devices
        if(data.ProductFamily === 'CGX')
        {
            return '<span class=" "></span>';
        }

        var isCsspDevice = false;
        if (data.ExpirationDate.indexOf('Pay Per Use') > 0) {
            isCsspDevice = true;
        }
        return '<a class="k-button k-button-icontext k-grid-csp-edit" href="javascript:void(0);" onclick="EditLicenseClick(' + data.DeviceId + ',' + isCsspDevice + ')"><span class=" "></span></a>';
    }

    function EditLicenseClick(deviceId, isCsspDevice) {
        var direction = "/@ControllerFields.LicenseController/DeviceLicenses?id=" + deviceId + "&isCsspDevice=" + isCsspDevice;
        var window = $("#@UniqueId.licenseWindowId").data("kendoWindow");
        window.content(" ");
        window.refresh();
        window.refresh(direction);
        window.setOptions({
            minHeight: 730
        });
        window.open();
        window.center();
    }

    function @(UniqueId.device)showCaseHistory(serialNumber) {
        var caseHistoryUrl= "@caseHistoryUrl" + serialNumber;
        var caseHistoryUrlDec = caseHistoryUrl.replace("&amp;","&");
        window.open(caseHistoryUrlDec,"_blank");
    }


    //show master authcode info
    function showMasterAuthCodeInfo(masterAuthCodeLicenseId, serialNumber, modelName, authCode) {
        var direction = "/License/ShowMasterAutoCodeInfo?masterAutocodeLicId=" + masterAuthCodeLicenseId + "&serialNumber=" + serialNumber + "&modelName=" + modelName + "&authCode=" + authCode;
        var window = $('#@UniqueId.showMasterAuthCodeInfoWindowsId').data("kendoWindow");
        window.content(" ");
        window.refresh();
        window.refresh(direction);
        window.setOptions({
            minHeight: 240
        });
        window.open();
        window.center();
    }

    var hideExpiredLicenses = '@Model.HideExpiredLicenses';
    function @(UniqueId.devices)hideExpiredLicenses() {

        var params = @(UniqueId.device)getSearchParams();

        //toggle the flag
        if (hideExpiredLicenses === 'True' || hideExpiredLicenses === true)
           hideExpiredLicenses = false;
        else
           hideExpiredLicenses= true;


        // toggle the button text
        if (hideExpiredLicenses) {
            $('#btnExpiredLicenses').val('Show Expired License(s)');
        } else {
            $('#btnExpiredLicenses').val('Hide Expired License(s)');
       }

        //refresh the grid based on flag
        $('#@UniqueId.gridId').data('kendoGrid').dataSource.read({
            id: @actionHelper.Id,
            hideExpiredLicenses: hideExpiredLicenses,
            searchField:params.field,
            searchValue:params.value
        });
    }

    function getMagicLinkTooltip(e) {
        var content = e.target.next("div").html();
        return content;
    }


</script>
<input type="hidden" id="hdnDeviceType" name="hdnDeviceType"/>
<input type="hidden" id="hdnCloudType" name="hdnCloudType"/>
