<?xml version="1.0"?>
<templateBindings xmlns="http://sd/llblgen/pro/templateBindingsDefinition.xsd" name="SD.TemplateBindings.SharedTemplates.NET35"
				  description ="Template bindings for the templates which are shared among all database types. Specific for .NET 3.5/VS.NET 2008"
				  precedenceLevel="10">
	<supportedPlatforms>
		<platform name=".NET 3.5"/>
	</supportedPlatforms>
	<supportedFrameworks>
		<framework name="LLBLGen Pro Runtime Framework"/>
	</supportedFrameworks>

	<language name="C#">
		<templateBinding templateID="SD_VsNetTemplate" filename="SharedTemplates\Net3.5\C#\vsnet2008ProjectFile.template" templateLanguage="TDL" />
		<templateBinding templateID="SD_VsNetAdapterTemplate" filename="SharedTemplates\Net3.5\C#\vsnet2008ProjectFileAdapter.template" />
		<templateBinding templateID="SD_VsNetDBSpecificAdapterTemplate" filename="SharedTemplates\Net3.5\C#\vsnet2008DBSpecificProjectFileAdapter.template" templateLanguage="TDL" />
	</language>
	<language name="VB.NET">
		<templateBinding templateID="SD_VsNetTemplate" filename="SharedTemplates\Net3.5\VB.NET\vsnet2008ProjectFile.template" templateLanguage="TDL" />
		<templateBinding templateID="SD_VsNetAdapterTemplate" filename="SharedTemplates\Net3.5\VB.NET\vsnet2008ProjectFileAdapter.template" />
		<templateBinding templateID="SD_VsNetDBSpecificAdapterTemplate" filename="SharedTemplates\Net3.5\VB.NET\vsnet2008DBSpecificProjectFileAdapter.template" templateLanguage="TDL" />
	</language>
</templateBindings>

