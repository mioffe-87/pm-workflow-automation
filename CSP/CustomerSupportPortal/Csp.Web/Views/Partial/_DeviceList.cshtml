        }

        function onCloseDeactivateLicensesWindow() {
            var window = $("#@UniqueId.deactivateLicensesWindowId").data("kendoWindow");
            window.content("");
            window.refresh();

            SupportPortal.OnWindowClose(deviceGridId);
        }

        return {
            openAddDeviceToGroupWindow: openAddDeviceToGroupWindow,
            openDeviceTypeWindow: openDeviceTypeWindow,
            openRegisterDeviceWindow: openRegisterDeviceWindow,
            openDeviceTransferWindow: openDeviceTransferWindow,
            openDeactivateLicensesWindow: openDeactivateLicensesWindow,
            exportProductionAssetsToCsv: exportProductionAssetsToCsv
        };
    })();

    var @(UniqueId.device)licensePopup = (function () {


        function onOpenLicenseWindow() {

            SupportPortal.OnWindowOpen("@UniqueId.licenseWindowId");
        }

        function onCloseLicenseWindow() {
            var window = $("#@UniqueId.licenseWindowId").data("kendoWindow");
            window.content("");
            window.refresh();
            SupportPortal.OnWindowClose("@UniqueId.gridId");
        }

        function editLicenses(e) {
            var dataItem = this.dataItem($(e.currentTarget).closest("tr"));
            console.log(dataItem);
            var isCsspDevice = false;

            if (dataItem.ExpirationDate.indexOf('Pay Per Use') > 0) {
                isCsspDevice = true;
            }

            var deviceId = dataItem.DeviceId;

            var direction = "/@ControllerFields.LicenseController/DeviceLicenses?id=" + deviceId + "&isCsspDevice=" + isCsspDevice;
            var window = $("#@UniqueId.licenseWindowId").data("kendoWindow");
            window.content(" ");
            window.refresh();
            window.refresh(direction);
            window.setOptions({
                minHeight: 730
            });
            window.open();
            window.center();
        }

        return {
            onOpenLicenseWindow: onOpenLicenseWindow,
            onCloseLicenseWindow: onCloseLicenseWindow,
            editLicenses: editLicenses
        };
    })();

    function kendoGridNewLines(text) {
        //var regexp = new RegExp('\n', 'g');
        //return text.replace(regexp, '<br>');
        return text;
    }

    $(document).ready(function () {
        addDeviceToGroupWindow = "#@UniqueId.addDeviceToGroupWindowId";
        registerDeviceWindow = "#@UniqueId.registerDeviceWindowId";
        deviceTypeWindowId = "#@UniqueId.deviceTypeWindowId";
        deviceWindowId = "#@UniqueId.deviceWindowId";
