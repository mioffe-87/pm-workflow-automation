    $(document).ready(function() {
        
        _.delay(function() {
            $(".k-chart").width("100%");
            $(".k-gauge").width("100%");
            $(".k-grid").width("100%");
            kendo.resize($(".k-chart"));
            kendo.resize($(".k-gauge"));
            kendo.resize($(".k-grid"));
