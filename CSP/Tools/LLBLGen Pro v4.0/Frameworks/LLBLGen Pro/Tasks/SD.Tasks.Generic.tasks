			<supportedPlatforms>
				<platform name=".NET 3.5"/>
				<platform name=".NET 4.0"/>
				<platform name=".NET 4.5"/>
			</supportedPlatforms>
			<supportedTemplateGroups/>
			<supportedFrameworks>
