@model Csp.Web.DataTransferObjects.SsoConfigurationDto
@{
    Layout = "~/Views/Shared/_SiteLayout.cshtml";
}
<div class="ssoconfig-container" data-url="@Model.ThirdPartySsoConfigUrl"></div>
<script>

    function renderSsoConfiguration(element) {

        var xmlHttp = new XMLHttpRequest();

        xmlHttp.onreadystatechange = function () {
            if (xmlHttp.readyState == 4 && xmlHttp.status == 200) {
                element.innerHTML = getBodyContent(xmlHttp.responseText);

                [].forEach.call(element.querySelectorAll('script'), function (nonExecutableScript) {
                    var script = document.createElement("script");

                    script.setAttribute("src", nonExecutableScript.src);
                    script.setAttribute("type", "text/javascript");
                    element.appendChild(script);
                    nonExecutableScript.parentNode.removeChild(nonExecutableScript);
                });
            }
        };

        xmlHttp.open("GET", element.dataset.url, true);
        xmlHttp.send(null);
    }

    function getBodyContent(content) {
        var x = content.indexOf("<body");
        x = content.indexOf(">", x);
        var y = content.lastIndexOf("</body>");
        return content.slice(x + 1, y);
    }

    document.querySelectorAll('.ssoconfig-container').forEach(renderSsoConfiguration);
</script>