@using Csp.Web.Controllers
@model Csp.Web.Controllers.BulkRegistrationTabsDto
@{
    var resourceRevisionNumber = SiteHelper.GetResourceRevisionNumber();
}
<style>
    li.disabledtab a {
        color: #CED5D5 !important;
        font-weight: bold;
        cursor: default;
    }
    li.disabledtab a:hover {
        text-decoration: none !important;
    }
</style>

@Scripts.RenderFormat("<script type=\"text/javascript\" src=\"{0}?" + resourceRevisionNumber + "\"></script>", "~/bundles/bulkreg")
<script type="text/javascript">
    var @(UniqueId.bulkreg)bulkReg = (function () {
        var lastSelectedDevicesTab = -1;

        function onBulkRegTabStripSelect(e) {
            lastSelectedDevicesTab = $(e.item).index();
        }

        function onBulkRegTabStripContentLoad(e) {
            var eItem = $(e.item);
            var tabStrip = eItem.closest('.k-tabstrip').data("kendoTabStrip");

            var isFirstTabSelection = lastSelectedDevicesTab == -1;
            var isMostRecentlySelectedTab = lastSelectedDevicesTab == eItem.index();
            if (isFirstTabSelection || isMostRecentlySelectedTab) {
                //Proceed as normal - this tab should load
            } else {
                //This tab should not load
                tabStrip.deactivateTab(eItem);
            }

            deactivateUnselectedTabs(tabStrip);
        }

        var callonce = true;

        function deactivateUnselectedTabs(tabStrip) {
            if (callonce) {
                callonce = false;

                var tabs = tabStrip.items();
                var current = tabStrip.select();
                for (var i = 0; i < tabs.length; i++) {
                    //var tab = $(tabs[i]);
                    var isCurrentTab = i == current.index();

                    if (!isCurrentTab) {
                        var contentHolder = tabStrip.contentHolder(i);
                        $(contentHolder).css('display', 'none');
                    }
                }
            }
        }

        return {
            onBulkRegTabStripSelect: onBulkRegTabStripSelect,
            onBulkRegTabStripContentLoad: onBulkRegTabStripContentLoad
        };
    })();

    $(function() {
        $('li.disabledtab').on('click', 'a', function () {
            console.log('logged');
            return false;
        });
    });

    $(document).ready(function () {
        BulkRegistrationManageUtil.Init({
            urlBulkRegistrationDiscardDraft: '@(Url.Action("PrepBulkRegDiscardDraft", "BulkRegistration", new { id=Model.ActionHelper.Id }))',
            urlGetPrepBulkRegistration: '@(Url.Action("Devices", "SupportAccount", new {id = Model.ActionHelper.Id, assetType="PrepBulkRegistration"}))'
        });

        setTimeout(function() {
            var ts = $('#@UniqueId.bulkRegistrationTabId').data('kendoTabStrip');

            ts.tabGroup.on('click', 'li', function(e) {
                var index = $(this).index();
                if (!$(ts.contentElement(index)).is(":empty")) {
                    $(ts.contentElement(index)).empty();
                    ts.reload($(this));
                }
            });
        });
    });
</script>

