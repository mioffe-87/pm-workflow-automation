                StringEscapeHandling = StringEscapeHandling.EscapeHtml
            }));
            var availableRoles = new HtmlString(JsonConvert.SerializeObject(Model.AvailableRoles, new JsonSerializerSettings
            {
                StringEscapeHandling = StringEscapeHandling.EscapeHtml
            }));
