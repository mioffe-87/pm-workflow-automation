    function @(UniqueId.memberships)onMemberGridEdit(e) {
            $(e.container).find('select[name="Roles"]').change('change', function() { onRolesSelect(this) });
            //Check if thridparty config is enabled
            var validateIdpUrl = '@Url.Action("IsThirdPartyIdpConfigured", "Membership")';
            var email = $(e.container).find('input[name="Email"]').val();
            if("@Model.AllowMfaEdit".toLowerCase() == "true")
            {
                var ddlMfaStatus = $(e.container).find('input[name="MfaStatus"]').data("kendoDropDownList");
                if(ddlMfaStatus)
                {
                    var mfaStatusData = ddlMfaStatus.dataSource.data();
                    if( e.model.MultiFactorAuthType != 2)
                    {
                        ddlMfaStatus.dataSource.remove(mfaStatusData[mfaStatusData.length - 1]);
                    }
                    if(e.model.isNew())
                    {
                        ddlMfaStatus.enable(false);
                    }
                }
            }

            $.ajax({
                url: validateIdpUrl,
                type: 'POST',
                dataType: 'json',
                data: JSON.stringify({
                    email: email
                }),
                contentType: 'application/json; charset=utf-8',
                global: true,
                success: function(result) {
                    isThirdPartyConfigured = result.isThirdPartyIdpConfigured;
                    isNewUser = false;
                },
                error: function (request, error) {
                }
            });

        $(e.container.find("input")).each(function(i, el) {
            $(el).on("focus",
                function() {
                    $(this).closest(".k-widget").siblings(".k-tooltip-validation").hide();
                });
        });

        var membershipsId = "@((string) UniqueId.memberships)";

        if (!e.model.IsMfaEnabled || e.model.MultiFactorAuthType == 1) {
            $(e.container).find('input[name="EnableEmailMfa"]').attr("disabled", true);
        }

        if ("@isMfaRequired" == "True" || e.model.IsMfaRequired) {
            $(e.container).find('input[name="IsMfaEnabled"]').attr("disabled", true);

            if (e.model.IsMfaRequired) {
                $(e.container)
                    .find('input[name="IsMfaEnabled"]')
                    .attr("title", "2 FA is still required in other account");
            }

        }

        //Disable Roles if any
        var disabledItem = $('span[data-disabled="true"]').closest('li');
        disabledItem.addClass('disabled-Role');
        disabledItem.children('span.k-select').hide();

        $(e.container)
            .find("td:last")
            .html(
                "<a class='k-button k-button-icontext k-grid-csp-update' data-link-field='update' href='javascript:void(0);' onclick='" +
                membershipsId +
                "UpdateMembership();' title='Update'><span class=''></span></a>" +
                "<a class='k-button k-button-icontext k-grid-csp-cancel' data-link-field='cancel' href='javascript:void(0);' onclick='" +
                membershipsId +
                "CancelMembership();' title='Cancel'><span class=''></span></a>");

        if (e.model.isNew() == false) {
            $(e.container).find('input[name="Email"]').unbind("onblur");
            $(e.container).find('input[name="Email"]').attr("readonly", true);
            $(e.container).find('input[name="Email"]').replaceWith($(e.container).find('input[name="Email"]').val());

            var isActive = e.model.AutoFocusTrialUser;
            if (!isActive) {
                $(e.container)
                    .find('#Roles_taglist li')
                    .each(function() {
                        var roleSpan = $(this).find('span').first();
                        if (roleSpan.text().match("Autofocus Trial")) {
                            roleSpan.css('text-decoration', 'line-through');
                        }
                    });
            }
        } else {
            var rolesList = $(e.container).find('select[name="Roles"]').data("kendoMultiSelect");
            rolesList.value(_.pluck('@defaultRoles', 'Value'));
            rolesList.trigger("change");

            if ("@isMfaRequired" == "True") {
                $(e.container).find('input[name="IsMfaEnabled"]').attr("checked", true);
            }

            $(e.container).find('input[name="Email"]').bind('blur',
                function() {
                    @(UniqueId.memberships)ValidateEmail(this);
                });

           // $(e.container).find('select[name="Roles"]').change('change', function() { onRolesSelect(this) });
        }
    }

    function @(UniqueId.memberships)GetCreateMembershipData(data) {
        data.MembershipTypeId = "@Model.MembershipTypeId";
        data.MembershipParentId = "@Model.MembershipParentId";
        data.RoleNames = "";
        var grid = $("#@UniqueId.gridId").data("kendoGrid");
        var gridElement = grid.editable.element;
        SupportPortal.stripProps(data, ['CreatedOn', 'LastUpdate']);

        @(UniqueId.memberships)MultiSelectRolesFix(data.Roles);
        SupportPortal.Serialize(data);

       // SupportPortal.BlockUI();

        return data;
    }

    function @(UniqueId.memberships)GetUpdateMembershipData(data) {
        data.RoleNames = "";
        data.MembershipTypeId = "@Model.MembershipTypeId";
        SupportPortal.stripProps(data, ['CreatedOn', 'LastUpdate']);

        @(UniqueId.memberships)MultiSelectRolesFix(data.Roles);
        var grid = $("#@UniqueId.gridId").data("kendoGrid");
        var gridElement = grid.editable.element;
        if("@Model.AllowMfaEdit".toLowerCase() == "true")
        {
            var ddlMfaStatus= gridElement.find('input[name="MfaStatus"]').data("kendoDropDownList");

            if (ddlMfaStatus) {
                data.MultiFactorAuthType = (ddlMfaStatus.value() === "Not Enabled") ? 0 : (ddlMfaStatus.value() === "Email") ? 1 : data.MultiFactorAuthType;
                data.IsMfaEnabled = (ddlMfaStatus.value() === "Not Enabled") ? false : (ddlMfaStatus.value() === "Email") ? true : data.IsMfaEnabled;
                data.EnableEmailMfa = (ddlMfaStatus.value() === "Email") ? true : false;
            }
        }

        SupportPortal.Serialize(data);

       // SupportPortal.BlockUI();

        return data;
    }

    function @(UniqueId.memberships)MultiSelectRolesFix(roles) {
        var allAvailableRoles = JSON.parse('@availableRoles');

        var i;
        for (i = 0; i < roles.length;i++) {
            var role = roles[i];

            var roleId = parseInt(role);
            if (!isNaN(roleId)) {
                var name = _.find(allAvailableRoles, function(r) { return r.Value == roleId; }).Name;
                roles[i] = {
                    Name: name,
                    Value: roleId
                };
            }
        }
    }

    function @(UniqueId.memberships)GetDeleteMembershipData(data) {

        data.MembershipTypeId = "@Model.MembershipTypeId";
        SupportPortal.stripProps(data, ['CreatedOn', 'LastUpdate']);

       // SupportPortal.BlockUI();

        return SupportPortal.Serialize(data);
    }

    function @(UniqueId.memberships)ValidateEmail(selector) {

        var email = $(selector).val().trim();
        var membershipTypeId = "@Model.MembershipTypeId";
        var membershipParentId = "@Model.MembershipParentId";

        if (email == "") {
            return;
        }
        newUserEmail = email;
        var validateEmailUrl = '@Url.Action("IsValidEmail", "Membership")';

        $.ajax({
            url: validateEmailUrl,
            type: 'POST',
            dataType: 'json',
            data: JSON.stringify({
                email: email,
                membershipTypeId: membershipTypeId,
                membershipParentId: membershipParentId
            }),
            contentType: 'application/json; charset=utf-8',
            global: true,
            success: function(result) {
                if (!result.Success) {
                    var grid = $("#@UniqueId.gridId").data("kendoGrid");
                    var gridElement = grid.editable.element;

                    var key = "Email";
                    var message = result.Message;

                    gridElement.find("[data-valmsg-for=" + key + "],[data-val-msg-for=" + key + "]")
                        .replaceWith(SupportPortal.ValidationMessageTemplate({ field: key, message: message }));
                }
                isNewUser = result.isNewUser;
                isThirdPartyConfigured = result.isThirdPartyIdpConfigured;

                if (isThirdPartyConfigured) {
                    var grid = $("#@UniqueId.gridId").data("kendoGrid");
                    var gridElement = grid.editable.element;

                    gridElement.find("[id='EnableEmailMfa']").hide();
                    gridElement.find("[id='IsMfaEnabled']").hide();

                }
            },
            error: function (request, error) {
            }
        });


    }

    function exportMembersToCsv() {

        var supportAccountId = @actionHelper.Id;

        var searchField = $("#@UniqueId.searchFieldId").val();
        var searchValue = $("#@UniqueId.searchValueId").val();

        location.href = '@Url.Action("UsersCsv", actionHelper.Controller)?id=' + supportAccountId + '&searchField=' + searchField + '&searchValue=' + searchValue;
    }

    function @(UniqueId.memberships)membershipRequestStart() {
        //  SupportPortal.BlockUI();
    }

    function @(UniqueId.memberships)membershipRequestEnd(e) {
        //  SupportPortal.UnBlockUI();
        SupportPortal.kendoGridTimezoneToPst(e);
        //Show warning when Autofocus Trial role is removed
        if (e.type == "create" || e.type == "update") {
            //check for errors in the response
            if (e.response == null || e.response.Errors == null) {
                var rows = e.response.Data;
                var notification = rows[0].Notification;
                //Show notification if exist
                if (notification != undefined && notification.length > 0) {
                    SupportPortal.ClearNotification();
                    SupportPortal.Notification(notification, SupportPortal.NotificationType.Success);
                }
            }
        }
    }

        function onRolesSelect(selector) {

        var e = $(selector).data("kendoMultiSelect");

        var domainAdmin = '@((int)Csp.Api.Model.Enums.RoleType.DomainAdministrator)';
        var message = "";

        var grid = $("#@UniqueId.gridId").data("kendoGrid");
        var gridElement = grid.editable.element;
        var key = "Email";

        if(isNewUser){
            if (isThirdPartyConfigured) {
                if (e.value().indexOf(domainAdmin) > -1) {

                    message = "To add a domain administrator who has never registered, use the 'Create New User' under Members on the side navigation bar";

                    gridElement.find("[data-valmsg-for=" + key + "],[data-val-msg-for=" + key + "]").show();
                    gridElement.find("[data-valmsg-for=" + key + "],[data-val-msg-for=" + key + "]").replaceWith(SupportPortal.ValidationMessageTemplate({ field: key, message: message }));

                    gridElement.find("[id='IsMfaEnabled']").show();
                    gridElement.find("[id='EnableEmailMfa']").show();

                } else {
                    gridElement.find("[data-valmsg-for=" + key + "],[data-val-msg-for=" + key + "]").hide();
                    gridElement.find("[id='IsMfaEnabled']").hide();
                    gridElement.find("[id='EnableEmailMfa']").hide();
                }
            }
        }
    }
