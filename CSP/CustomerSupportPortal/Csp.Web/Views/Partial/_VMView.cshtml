@using Csp.Api.HelperClasses
@using Csp.Api.Model
@using Kendo.Mvc.UI
@using NHibernate.Type
@model Csp.Web.DataTransferObjects.VmViewModelDto<AvailableVm>

<script>
    function ShowNsxDevices(e) {
        var direction = '/VM/ViewProvisionedPanoramaDevices';
        var dataItem = this.dataItem($(e.target).closest("tr"));
        var window = $('#@UniqueId.PraProvisionWindow').data("kendoWindow");
        window.refresh(direction + '?authCode=' + dataItem.AuthorizationCode + "&partNumber=" + dataItem.ProductSku);
        window.setOptions({
            minHeight: 200
        });
        window.open();
        window.center();
    }

    function RegisterVm(e) {
        e.preventDefault ? e.preventDefault() : e.returnValue = false;

        var direction = '/VM/RegisterVm';

        var dataItem = this.dataItem($(e.currentTarget).closest("tr"));

        var newVmDeviceId = $('#@UniqueId.NewVmDeviceId');
        newVmDeviceId.val('');
        globalNewVmDeviceId = '@UniqueId.NewVmDeviceId';

        var window = $('#@UniqueId.RegisterVmWindow').data("kendoWindow");
        window.refresh(direction + '?authCode=' + dataItem.AuthorizationCode);
        window.setOptions({
            minHeight: 200
        });
        window.open();
        window.center();
    }

    function Download(e) {
        e.preventDefault ? e.preventDefault() : e.returnValue = false;

        var downloadsWindow = $('#@UniqueId.DownloadsWindow').data('kendoWindow');
        downloadsWindow.refresh('/updates/softwareupdates?id=@(Model.ActionHelper.Id)&vmDevices=true');
        downloadsWindow.setOptions({
            minHeight: 200
        });

        downloadsWindow.open();
        downloadsWindow.center();
    }

    //show renewal items dialog
    function ShowRenewalItems(e) {
        var direction = '/VM/Renewal';
        var dataItem = this.dataItem($(e.target).closest("tr"));
        var window = $('#@UniqueId.RenewalWindow').data("kendoWindow");
        window.refresh(direction + '?authCode=' + dataItem.AuthorizationCode + '&description=' + dataItem.Description
                    + '&totalQuantity=' + dataItem.VmTotalCount + '&provisionedNum=' + (dataItem.VmTotalCount-dataItem.VmUseCount) + '&partNumber=' + dataItem.ProductSku) ;
        window.setOptions({
            minHeight: 665,
            minWidth: 500
        });
        window.title("VM RENEWAL: " + dataItem.AuthorizationCode);
        window.open();
        window.center();
    }

    //deactivate VM-ELA Authcode only
    function DeactivateVM(e) {
        var direction = '/VM/DeactivateVm';
        var dataItem = this.dataItem($(e.target).closest("tr"));
        var window = $('#@UniqueId.DeactivateVmWindow').data("kendoWindow");
        window.refresh(direction + '?authCode=' + dataItem.AuthorizationCode) ;
        window.setOptions({
            minHeight: 500,
            minWidth: 400
        });
        window.title("Deactivate VM");
        window.open();
        window.center();
    }

