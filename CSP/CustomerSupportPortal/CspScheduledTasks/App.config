  <atlas>
    <host name="CSPScheduledTasks" displayName="CSP QA Scheduled Tasks Windows Service" description="CSP QA Scheduled Tasks Windows Service" allowMultipleInstances="false">
      <runtime accounttype="NetworkService" startup="Automatic" />
    </host>
  </atlas>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
  <appSettings>
    <add key="InstanceName" value="SIT" />
    <add key="LoggerPath" value="c:\csplog.txt" />
    <add key="NotificationList" value="lkoneru@paloaltonetworks.com" />
    <!-- Generic Service Account -->
    <add key="ServiceAccountUsername" value="iad-jobs" />
    <add key="ServiceAccountPassword" value="ejOh;#.H4(8g|J%c" />
    <add key="EvalAccountCreationJobCronSchedule" value="0 0/5 * 1/1 * ? *" />
    <!-- Visit http://www.cronmaker.com/ Queues the job every 5 minutes -->
    <add key="VmRegistrationJobCronSchedule" value="0 0/5 * 1/1 * ? *" />
    <!-- Visit http://www.cronmaker.com/ Queues the job every 5 minutes -->
    <add key="SfdcAddUpdateContactJobCronSchedule" value="0 0 0/2 * * ?" />
    <!-- Visit http://www.cronmaker.com/ Queues the job every 2 hours -->
    <add key="BulkRegistrationJobCronSchedule" value="0 0/5 * 1/1 * ? *" />
    <!-- Visit http://www.cronmaker.com/ Queues the job every 5 minutes -->
    <add key="AutofocusTrialExpJobCronSchedule" value="0 0 0 1/1 * ? *" />
    <!-- Visit http://www.cronmaker.com/ Queues the job everyday at 12:00am US PST -->
    <add key="MfaRegistrationCronSchedule" value="0 0/5 * 1/1 * ? *" />
    <!-- Visit http://www.cronmaker.com/ Queues the job every 5 minutes -->
    <add key="bulkDeviceTransferCronSchedule" value="0 0/5 * 1/1 * ? *" />
    <!-- Visit http://www.cronmaker.com/ Queues the job every 5 minutes -->
    <add key="emailNotificationsCronSchedule" value="0 0/5 * 1/1 * ? *" />
    <!-- Visit http://www.cronmaker.com/ Queues the job every 5 minutes -->
    <add key="LicensingApiNotificationJobCronSchedule" value="0 0 0 1/1 * ? *" />
    <!-- Visit http://www.cronmaker.com/ Queues the job everyday at 12:00am PST -->
    <add key="VmElaTokenNotificationJobCronSchedule" value="0 0 0 1/1 * ? *" />
    <!-- Visit http://www.cronmaker.com/ Queues the job everyday at 12:00am US PST -->
    <add key="CloudServiceUserTransferCronSchedule" value="0 0/5 * 1/1 * ? *" />
    <!-- Visit http://www.cronmaker.com/ Queues the job every 5 minutes -->
    <add key="BulkOtpRequestCronSchedule" value="0 0/5 * 1/1 * ? *" />
    <!-- Visit http://www.cronmaker.com/ Queues the job every 5 minutes -->
    <add key="OtpExpirationRequestCronSchedule" value="0 0/5 * 1/1 * ? *" />
    <!-- Visit http://www.cronmaker.com/ Queues the job every 5 minutes -->
    <add key="PinExpirationRequestCronSchedule" value="0 0/5 * 1/1 * ? *" />
    <!-- Visit http://www.cronmaker.com/ Queues the job every 5 minutes -->
    <add key="ApplicationUrl" value="https://support.api.paloaltonetworks.com" />
    <add key="ScheduledJobCnName" value="csp.api.paloaltonetworks.com" />
    <add key="ScheduledJobThumbprint" value="4f3de8a32d11967660ebece467cc63678dacceb8" />
  </appSettings>
  <system.net>
    <mailSettings>
      <smtp deliveryMethod="Network" from="PASWorkflow@paloaltonetworks.com">
        <specifiedPickupDirectory pickupDirectoryLocation="C:\emails" />
        <network host="smtp.paloaltonetworks.local" enableSsl="false" userName="pasworkflow" password="Workflow123" defaultCredentials="false" />
      </smtp>
    </mailSettings>
