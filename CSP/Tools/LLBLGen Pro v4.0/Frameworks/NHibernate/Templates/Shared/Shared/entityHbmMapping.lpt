<%	Project currentProject = _executingGenerator.ProjectDefinition;
	var allTargetedCatalogs = GeneratorUtils.GetAllMappedTargetsInScope(_executingGenerator).Select(t=>t.ContainingSchema.ParentCatalog).Distinct();
	bool hasMultipleCatalogs = allTargetedCatalogs.Count() > 1;
	EntityDefinition entity = (EntityDefinition)_activeObject;
	
	var entityFields = entity.Fields.Where(f=>f.FieldType.KindOfType==FieldTypeKind.DotNetType).OrderBy(f=>f.Name);
	var valueTypeFields = entity.Fields.Where(f=>f.FieldType.KindOfType==FieldTypeKind.ValueTypeDefinition).OrderBy(f=>f.Name);
	var pkFieldList = SD_NHibernateGeneralUtils.GetPkFieldsForEntity(entity, _executingGenerator);
    var identifyingFields = pkFieldList.FieldsOrdered.ToList();

	EntityMapping mapping = (EntityMapping)_executingGenerator.ProjectDefinition.GetGroupableModelElementMapping(entity, _executingGenerator.DriverID);
	bool useCompositeKey = identifyingFields.Count > 1;
	IProjectElementMapTargetElement mappedTarget = mapping.MappedTarget;
	string discriminatorValueAttribute;
	string dynamicUpdateAttribute;
	string dynamicInsertAttribute;
	string lazyAttribute;
	string optimisticLockAttribute;
	ProduceClassMappingAttributesFromSettings(entity, currentProject, out discriminatorValueAttribute, out dynamicUpdateAttribute, out dynamicInsertAttribute,
												out lazyAttribute, out optimisticLockAttribute);
%><?xml version="1.0" encoding="utf-8" ?>
<hibernate-mapping xmlns="urn:nhibernate-mapping-2.2"
                   assembly="<%=_executingGenerator.RootNamespaceToUse%>.Model"
                   namespace="<%=_executingGenerator.GetValueFromRunQueueCache<string>("EntityClassesNamespace") ?? _executingGenerator.RootNamespaceToUse + ".EntityClasses"%>">
				   
	<class name="<%=entity.Name%>" table="<%=SD_NHibernateGeneralUtils.ProduceTargetFullName(mappedTarget, _executingGenerator, hasMultipleCatalogs, "&quot;")%>"<%=discriminatorValueAttribute%><%=dynamicUpdateAttribute%><%=dynamicInsertAttribute%><%=lazyAttribute%><%=optimisticLockAttribute%> >
<%	FieldMapping fieldMapping = null;
	string typeConverterDeclaration = string.Empty;
	IProjectElementFieldMapTargetElement targetField = null;
	if(useCompositeKey)
	{
		//-----------------COMPOSITE KEY FIELDS------------------------------------------------------- 
%>		<composite-id>
<%		foreach(var pair in pkFieldList) 
		{
			// Value1 is relationship, Value2 is fields in pk using the relationship. If Value1 is null, emit key-property, otherwise key-many-to-one
			if(pair.Value1 == null)
			{
				// always 1 field
				IFieldElementCore field = pair.Value2.FirstOrDefault();
				if(field==null)
				{
					continue;
				}
				SD_NHibernateGeneralUtils.GetFieldEmitInfo(field, mapping, out fieldMapping, out typeConverterDeclaration, out targetField);
%>    		<key-property name="<%=field.Name%>" column="<%=SD_NHibernateGeneralUtils.ProduceFieldFullName(targetField.FieldName, _executingGenerator, "&quot;")%>" access="field.camelcase-underscore"<%=typeConverterDeclaration%> />
<%			}
			else
			{
				var relationship = pair.Value1;
				var navigatorInstance = relationship.StartEntityIsPkSide?relationship.GetEndNavigatorAsObject() : relationship.GetStartNavigatorAsObject();
				if(pair.Value2.Count==1)
				{
					IFieldElementCore field = pair.Value2.FirstOrDefault();
					if(field==null)
					{
						continue;
					}
					SD_NHibernateGeneralUtils.GetFieldEmitInfo(field, mapping, out fieldMapping, out typeConverterDeclaration, out targetField);
%>			<key-many-to-one name="<%=relationship.NavigatorFkSide%>" column="<%=SD_NHibernateGeneralUtils.ProduceFieldFullName(targetField.FieldName, _executingGenerator, "&quot;")%>" access="field.camelcase-underscore" <%=typeConverterDeclaration%> />
<%				}
				else
				{
%>			<key-many-to-one name="<%=relationship.NavigatorFkSide%>" access="field.camelcase-underscore">
<%					foreach(var field in pair.Value2)
					{
						SD_NHibernateGeneralUtils.GetFieldEmitInfo(field, mapping, out fieldMapping, out typeConverterDeclaration, out targetField);
%>    			<column name="<%=SD_NHibernateGeneralUtils.ProduceFieldFullName(targetField.FieldName, _executingGenerator, "&quot;")%>" <%=typeConverterDeclaration%> />
<%					}
%>			</key-many-to-one>
<%				}
			}
		}
%>		</composite-id>
<%	} 
	else 
	{
		bool useGuidCOMB = currentProject.GetRealBoolSettingValue("GenerateGuidPKValuesAsCOMBs");
		//-----------------PRIMARY KEY FIELDS------------------------------------------------------- 
		foreach(IFieldElementCore field in identifyingFields)
		{
			SD_NHibernateGeneralUtils.GetFieldEmitInfo(field, mapping, out fieldMapping, out typeConverterDeclaration, out targetField);
			bool useCustomGenerator = field.OutputSettingValues.GetRealBoolSettingValue("UseCustomGenerator", currentProject);
			string guidGeneratorClass;
			if(useGuidCOMB)
			{
				guidGeneratorClass="guid.comb";
			}
			else
			{
				guidGeneratorClass="guid";
			}
%>		<id name="<%=field.Name%>" column="<%=SD_NHibernateGeneralUtils.ProduceFieldFullName(targetField.FieldName, _executingGenerator, "&quot;")%>" access="field.camelcase-underscore"<%=typeConverterDeclaration%> >
<%			if(fieldMapping.SequenceToUse==null)
			{
				if(field.IsForeignKeyField)
				{
					// 1:1 pk-pk mapping, generate generator with 'foreign'.
					var relationship = entity.GetAllRelationshipsContainingFkField(field).First(); // always 1
					string navigator = relationship.NavigatorFkSide;
					if(!string.IsNullOrEmpty(navigator))
					{
%>			<generator class="foreign">
				<param name="property"><%=navigator%></param>
			</generator>
<%					}
				}
				else
				{
					if (targetField.DbTypeAsString.ToLowerInvariant() == "uniqueidentifier") 
					{
%>			<generator class="<%=guidGeneratorClass%>"/>
<%					}
					else
					{
						// check whether the field has a numeric type and we have to use a custom generator.
						if(SD_NHibernateGeneralUtils.DetermineIfFieldIsNumericTyped(field) && useCustomGenerator)
						{
							string generatorToUse = string.Empty;
							Dictionary<string, string> generatorValues = SD_NHibernateGeneralUtils.DetermineCustomGeneratorDataToUse(field, _executingGenerator, 
															mappedTarget.ContainingSchema, "&quot;", hasMultipleCatalogs, false, out generatorToUse);
%>			<generator class="<%=generatorToUse%>">
<%							foreach(var kvp in generatorValues)
							{
%>				<param name="<%=kvp.Key%>"><%=kvp.Value%></param>
<%							}
%>			</generator>
<%						}
						else
						{
%>			<generator class="assigned"/>
<%						}
					}
				}
			}
			else
			{
				if(fieldMapping.SequenceToUse.ContainingSchema==null)
				{
					// system sequence
%>			<generator class="identity"/>
<%				}
				else
				{
					// sequence specified from a schema
%>			<generator class="native">
				<param name="sequence"><%=SD_NHibernateGeneralUtils.ProduceSequenceFullName(fieldMapping.SequenceToUse, _executingGenerator)%></param>
			</generator>
<%				}
			}
%>		</id>
<%		}
	}
	
	//-----------------DISCRIMINATOR FIELD------------------------------------------------------- 
	if(entity.IsHierarchyRoot && (entity.InheritanceType==InheritanceHierarchyType.TargetPerEntityHierarchy))	
	{
		SD_NHibernateGeneralUtils.GetFieldEmitInfo(entity.DiscriminatorField, mapping, out fieldMapping, out typeConverterDeclaration, out targetField);
%>		<discriminator column="<%=SD_NHibernateGeneralUtils.ProduceFieldFullName(targetField.FieldName, _executingGenerator, "&quot;")%>"/>
<%	}
%><%=GetEntityFieldMappings(2, entity, mapping, currentProject)%><%
%><%=GetEntityAssociationMappings(2, entity, mapping, currentProject, hasMultipleCatalogs)%><%

	//-----------------SUB TYPE MAPPINGS --------------------------------------------------------
	if(entity.IsHierarchyRoot)
	{
%><%=GetSubClassMapping(entity, 0, currentProject, hasMultipleCatalogs)%>
<%	}
%><%=DotNetTemplateEngine.GetUserCodeRegion("EntityMappingCustomCode", "<!--", "-->", string.Empty, false)%><# SD_NHibernate_CustomEntityHbmMappingInclude #>
	</class>
</hibernate-mapping>
<~
	// produces the complete subtype mapping for an entity which is in a hierarchy of type TargetPerEntityHierarchy
	private string GetSubClassMappingTPEH(EntityDefinition entity,int level,Project currentProject, bool hasMultipleCatalogs)
	{
		StringBuilder sb = new StringBuilder();
		string indents = new string('\t', level+2);
		var nl = Environment.NewLine;
		
		foreach(EntityDefinition subType in currentProject.GetSubtypesForEntity(entity))
		{
			string discriminatorValueAttribute;
			string dynamicUpdateAttribute;
			string dynamicInsertAttribute;
			string lazyAttribute;
			string optimisticLockAttribute;
			ProduceClassMappingAttributesFromSettings(subType, currentProject, out discriminatorValueAttribute, out dynamicUpdateAttribute, out dynamicInsertAttribute,
														out lazyAttribute, out optimisticLockAttribute);
		
			EntityMapping subTypeMapping = (EntityMapping)_executingGenerator.ProjectDefinition.GetGroupableModelElementMapping(subType, _executingGenerator.DriverID);
	
			sb.AppendFormat("{0}<subclass name=\"{1}\"{2}{3}{4}{5}>{6}", indents, subType.Name, discriminatorValueAttribute, dynamicUpdateAttribute, 
																			   dynamicInsertAttribute, lazyAttribute, Environment.NewLine); 
			AppendFieldAndAssociationMappings(level+2, subType, subTypeMapping, currentProject, sb, hasMultipleCatalogs);
			sb.Append(GetSubClassMapping(subType, level+1, currentProject, hasMultipleCatalogs));
			sb.AppendFormat("{0}</subclass>{1}",indents,Environment.NewLine);   
		}
		return sb.ToString();
	}

	// produces the complete subtype mapping for an entity which is in a hierarchy of type TargetPerEntity 
	private string GetSubClassMappingTPE(EntityDefinition entity, int level, Project currentProject, bool hasMultipleCatalogs)
	{
		StringBuilder sb = new StringBuilder();
		string indents = new string('\t', level+2);
		var nl = Environment.NewLine;
		
		foreach(EntityDefinition subType in currentProject.GetSubtypesForEntity(entity))
		{
			string discriminatorValueAttribute;
			string dynamicUpdateAttribute;
			string dynamicInsertAttribute;
			string lazyAttribute;
			string optimisticLockAttribute;
			ProduceClassMappingAttributesFromSettings(subType, currentProject, out discriminatorValueAttribute, out dynamicUpdateAttribute, out dynamicInsertAttribute,
														out lazyAttribute, out optimisticLockAttribute);
			EntityMapping subTypeMapping = (EntityMapping)_executingGenerator.ProjectDefinition.GetGroupableModelElementMapping(subType, _executingGenerator.DriverID);
	
			sb.AppendFormat("{0}<joined-subclass name=\"{1}\" table=\"{2}\"{3}{4}{5}>{6}",indents, subType.Name, 
											SD_NHibernateGeneralUtils.ProduceTargetFullName(subTypeMapping.MappedTarget, _executingGenerator, hasMultipleCatalogs, "&quot;"), 
											dynamicUpdateAttribute, dynamicInsertAttribute, lazyAttribute, Environment.NewLine); 
			
			sb.AppendFormat("{0}\t<key>{1}",indents,nl);
			foreach(IFieldElementCore field in subType.IdentifyingFields)
			{
				var fieldMapping = subTypeMapping.GetFieldMappingOfField(field);
				var targetField = fieldMapping.MappedTarget;
				sb.AppendFormat("{0}\t\t<column name=\"{1}\"/>{2}",indents,
								SD_NHibernateGeneralUtils.ProduceFieldFullName(targetField.FieldName, _executingGenerator, "&quot;"),nl);
			}
			sb.AppendFormat("{0}\t</key>{1}",indents,nl);
			AppendFieldAndAssociationMappings(level + 2, subType, subTypeMapping, currentProject, sb, hasMultipleCatalogs);
			sb.Append(GetSubClassMapping(subType, level+1, currentProject, hasMultipleCatalogs));
			sb.AppendFormat("{0}</joined-subclass>{1}",indents,Environment.NewLine);   
		}
		return sb.ToString();
	}


	// Appends the field and association mappings for the entity specified to the stringbuilder specified
	private void AppendFieldAndAssociationMappings(int numberOfRootTabs, EntityDefinition entity, GroupableModelElementMapping mapping, Project currentProject, 
												   StringBuilder toAppendTo, bool hasMultipleCatalogs)
	{
		string propertyMappings = GetEntityFieldMappings(numberOfRootTabs + 1, entity, mapping, currentProject);
		if(!string.IsNullOrEmpty(propertyMappings))
		{
			toAppendTo.Append(propertyMappings);
		}
		string associationMappings = GetEntityAssociationMappings(numberOfRootTabs + 1, entity, mapping, currentProject, hasMultipleCatalogs);
		if(!string.IsNullOrEmpty(associationMappings))
		{
			toAppendTo.Append(associationMappings);
		}	
	}

	// selector method to get the subclass mapping for the entity specified.
	private string GetSubClassMapping(EntityDefinition entity, int level, Project currentProject, bool hasMultipleCatalogs)
	{
		switch(entity.InheritanceType)
		{
			case InheritanceHierarchyType.TargetPerEntity:
				return GetSubClassMappingTPE(entity, level, currentProject, hasMultipleCatalogs);
			case InheritanceHierarchyType.TargetPerEntityHierarchy:
				return GetSubClassMappingTPEH(entity, level, currentProject, hasMultipleCatalogs);
			default:
				return string.Empty;
		}
	}

	// gets the field mappings for the valuetype at the index of the path in the field mappings.
	private string GetValueTypeFieldMappings(int numberOfRootTabs, int pathIndex,  IEnumerable<FieldMapping> fieldMappings)
	{
		StringBuilder sb = new StringBuilder();
		var groupedMappings = from fm in fieldMappings
							group fm by
							fm.MappedFieldWrapper.Path[pathIndex] into g
							select g;
							
		string rootIndents = new string('\t', numberOfRootTabs);
		string indents = new string('\t', pathIndex);
		foreach(var groupMapping in groupedMappings)
		{
			bool doRecursion = false;
			
			if(groupMapping.Key.FieldType.KindOfType==FieldTypeKind.ValueTypeDefinition)
			{
				sb.AppendFormat("{0}{1}<component name=\"{2}\" class=\"{3}\">{4}", rootIndents, indents, groupMapping.Key.Name, SD_NHibernateGeneralUtils.ProduceDotNetTypeName((IFieldElementCore)groupMapping.Key, _executingGenerator, "Nullable<{0}>"), Environment.NewLine);
				doRecursion = true;
			}
			
			if(pathIndex>0)
			{
				foreach(var fieldMapping in groupMapping.Where(f=>f.MappedFieldWrapper.Path[pathIndex]==f.MappedFieldInstance &
													f.MappedFieldInstance.FieldType.KindOfType==FieldTypeKind.DotNetType))
				{
					string typeConverterDeclaration = SD_NHibernateGeneralUtils.ProduceTypeConverterTypeString(fieldMapping);
					string notNullSpecification = string.Empty;
					if(!fieldMapping.MappedFieldInstance.IsOptional)
					{
						notNullSpecification = " not-null=\"true\"";
					}
					sb.AppendFormat("{0}{1}<property name=\"{2}\" column=\"{3}\" access=\"field.camelcase-underscore\"{4}{5}/>{6}", rootIndents, indents, 
												fieldMapping.MappedFieldInstance.Name, 
												SD_NHibernateGeneralUtils.ProduceFieldFullName(fieldMapping.MappedTarget.FieldName, _executingGenerator, "&quot;"),
												typeConverterDeclaration, notNullSpecification, Environment.NewLine);
				}
			}
			
			if(doRecursion)
			{
				sb.AppendFormat(GetValueTypeFieldMappings(numberOfRootTabs, pathIndex+1, groupMapping));
				sb.AppendFormat("{0}{1}</component>{2}", rootIndents, indents, Environment.NewLine);
			}
		}
		return sb.ToString();
	}
	
	// gets all field mappings for the entity specified
	private string GetEntityFieldMappings(int numberOfRootTabs, EntityDefinition entity, GroupableModelElementMapping mapping, Project currentProject)
	{
		StringBuilder sb = new StringBuilder();
		string rootIndents = new string('\t', numberOfRootTabs);
		FieldMapping fieldMapping = null;
		IProjectElementFieldMapTargetElement targetField = null;
		// first emit the version field, if any. 
		var versionField = entity.Fields.FirstOrDefault(f=>f.OutputSettingValues.GetRealBoolSettingValue("UseAsVersionField", currentProject) &&
															f.FieldType.KindOfType==FieldTypeKind.DotNetType);
		if(versionField!=null)
		{
			fieldMapping = mapping.GetFieldMappingOfField(versionField);
			targetField = fieldMapping.MappedTarget;
			if(targetField.TypeDefinition.DBTypeAsNETType==typeof(byte[]))
			{
				// special case for SQL Server... 
				sb.AppendFormat("{0}<version name=\"{1}\" access=\"field.camelcase-underscore\" generated=\"always\" unsaved-value=\"null\" type=\"BinaryBlob\">{2}", 
									rootIndents, versionField.Name, Environment.NewLine);
				sb.AppendFormat("{0}\t<column name=\"{1}\" not-null=\"false\" sql-type=\"timestamp\"/>{2}", 
									rootIndents, SD_NHibernateGeneralUtils.ProduceFieldFullName(targetField.FieldName, _executingGenerator, "&quot;"), 
									Environment.NewLine);
				sb.AppendFormat("{0}</version>{1}", rootIndents, Environment.NewLine);
			}
			else
			{
				// as version requires the type explicitly if the type isn't an int, we've to do the work for NHibernate...
				string typeSpecification=string.Empty;
				switch(Type.GetTypeCode(versionField.FieldType.RepresentedType))
				{
					case TypeCode.DateTime:
						typeSpecification=" type=\"Timestamp\"";
						break;
					case TypeCode.Int16:
						typeSpecification=" type=\"Int16\"";
						break;
					case TypeCode.Int64:
						typeSpecification=" type=\"Int64\"";
						break;
				}
				sb.AppendFormat("{0}<version name=\"{1}\" column=\"{2}\" access=\"field.camelcase-underscore\"{3}/>{4}", 
									rootIndents, versionField.Name, SD_NHibernateGeneralUtils.ProduceFieldFullName(targetField.FieldName, _executingGenerator, "&quot;"), 
									typeSpecification, Environment.NewLine);
			}
		}
		foreach(IFieldElementCore field in entity.Fields.Where(f=>!f.IsPartOfIdentifyingFields && !f.IsForeignKeyField  && f!=entity.DiscriminatorField &&
																	(f.FieldType.KindOfType!=FieldTypeKind.ValueTypeDefinition) &&
																	(f!=versionField))
														.OrderBy(f=>f.Name))
		{
			fieldMapping = mapping.GetFieldMappingOfField(field);
			string typeConverterDeclaration = SD_NHibernateGeneralUtils.ProduceTypeConverterTypeString(fieldMapping);
			targetField = fieldMapping.MappedTarget;
			string typeSpecification = string.Empty;
			if(field.FieldType.KindOfType==FieldTypeKind.DotNetType)
			{
				int realLength = GeneratorUtils.GetRealMaxLength(field.MaxLength, field.FieldType.RepresentedType);
				if(realLength > 8*1024)
				{
					if(field.FieldType.RepresentedType == typeof(string))
					{
						typeSpecification = " type=\"StringClob\"";
					}
					if(field.FieldType.RepresentedType == typeof(byte[]))
					{
						typeSpecification = " type=\"BinaryBlob\"";
					}
				}
			}
			string updateInsertAttributes = string.Empty;
			if(field.IsReadOnly)
			{
				updateInsertAttributes = " insert=\"false\" update=\"false\"";
			}
			string notNullSpecification = string.Empty;
			if(!field.IsOptional)
			{
				notNullSpecification = " not-null=\"true\"";
			}
			sb.AppendFormat("{0}<property name=\"{1}\" column=\"{2}\" access=\"field.camelcase-underscore\"{3}{4}{5}{6}/>{7}", 
									rootIndents, field.Name, SD_NHibernateGeneralUtils.ProduceFieldFullName(targetField.FieldName, _executingGenerator, "&quot;"), 
									typeConverterDeclaration, typeSpecification, updateInsertAttributes, notNullSpecification, Environment.NewLine);
		}
		string valueTypeMappings = GetValueTypeFieldMappings(numberOfRootTabs, 0, mapping.FieldMappings);
		if(!string.IsNullOrEmpty(valueTypeMappings))
		{
			sb.Append(valueTypeMappings);
		}
		return sb.ToString();
	}

	// gets all association mappings for the entity specified
	private string GetEntityAssociationMappings(int numberOfRootTabs, EntityDefinition entity, GroupableModelElementMapping mapping, Project currentProject, 
												bool hasMultipleCatalogs)
	{
		var allRelationshipInfosToTraverse = GeneratorUtils.GetAllRelationshipInfosForEntity(_executingGenerator, entity);
		StringBuilder sb = new StringBuilder();
		string rootIndents = new string('\t', numberOfRootTabs);	
		foreach(var relationshipInfo in allRelationshipInfosToTraverse.OrderBy(ri=>ri.Navigator))
		{
			if(relationshipInfo.NavigatorIsHidden)
			{
				continue;
			}
			List<FieldElement> fkFieldsFromFkSide = new List<FieldElement>();
			if(relationshipInfo.RelationshipType!=EntityRelationshipType.ManyToMany)
			{
				fkFieldsFromFkSide = relationshipInfo.NormalRelationship.GetFkFieldsFromFkSide().ToList();
			}
			string fetchAttribute = string.Format(" fetch=\"{0}\"", relationshipInfo.NavigatorInstance.OutputSettingValues.GetRealStringSettingValue("FetchStrategy", currentProject));
			string cascadeAttribute = string.Empty;
			string collectionType = string.Empty;
			string inverseAttribute = string.Empty;
			string lazyAttribute = string.Empty;
			bool inverse = false;
			switch(relationshipInfo.RelationshipType)
			{
				case EntityRelationshipType.ManyToMany:
					IndirectRelationshipEdge relationshipAsMtoM = (IndirectRelationshipEdge)relationshipInfo.Relationship;
					cascadeAttribute = string.Format(" cascade=\"{0}\"", relationshipInfo.NavigatorInstance.OutputSettingValues.GetRealStringSettingValue("CollectionNavigatorCascadeType", currentProject));
					collectionType = relationshipInfo.NavigatorInstance.OutputSettingValues.GetRealStringSettingValue("CollectionType", currentProject);
					if(!relationshipInfo.NavigatorInstance.OutputSettingValues.GetRealBoolSettingValue("UseLazyLoading", currentProject))
					{
						lazyAttribute=" lazy=\"false\"";
					}
					EntityDefinition intermediateEntity = relationshipAsMtoM.DetermineIntermediateEntity();
					EntityMapping intermediateEntityMapping = (EntityMapping)_executingGenerator.ProjectDefinition.GetGroupableModelElementMapping(intermediateEntity, 
																					_executingGenerator.DriverID);
					string intermediateTableAttribute = string.Format(" table=\"{0}\"", 
											SD_NHibernateGeneralUtils.ProduceTargetFullName(intermediateEntityMapping.MappedTarget, _executingGenerator, 
											hasMultipleCatalogs, "&quot;"));
					sb.AppendFormat("{0}<{1} name=\"{2}\" access=\"field.camelcase-underscore\"{3}{4}{5}{6}>{7}",
									rootIndents, collectionType, relationshipInfo.Navigator, intermediateTableAttribute, cascadeAttribute, 
									lazyAttribute, fetchAttribute, Environment.NewLine);
					NormalRelationshipEdge normalRelationshipToUse = relationshipAsMtoM.FirstRelationship;
					NormalRelationshipEdge oppositeRelationshipToUse = relationshipAsMtoM.SecondRelationship;
					if(!relationshipInfo.ViaStartNavigator)
					{
						normalRelationshipToUse = relationshipAsMtoM.SecondRelationship;
						oppositeRelationshipToUse = relationshipAsMtoM.FirstRelationship;
					}
					sb.AppendFormat("{0}\t<key>{1}", rootIndents, Environment.NewLine);
					// as key columns simply emit the FK side's fields, as the intermediate entity is always the FK side. Do this in the order
					// of the pk fields of the current entity, as that's always the pk side for the relationship we're focused on: normalRelationshipToUse.
					fkFieldsFromFkSide = normalRelationshipToUse.GetFkFieldsFromFkSide().ToList();
					foreach(IFieldElementCore field in fkFieldsFromFkSide) 
					{
						var fieldMapping = intermediateEntityMapping.GetFieldMappingOfField(field);
						var targetField = fieldMapping.MappedTarget;
						sb.AppendFormat("{0}\t\t<column name=\"{1}\"/>{2}", rootIndents, SD_NHibernateGeneralUtils.ProduceFieldFullName(targetField.FieldName, _executingGenerator, "&quot;"), 
																			Environment.NewLine);
					}
					sb.AppendFormat("{0}\t</key>{1}", rootIndents, Environment.NewLine);
					sb.AppendFormat("{0}\t<many-to-many class=\"{1}\">{2}", rootIndents, relationshipInfo.RelatedEntity.Name, Environment.NewLine);
					fkFieldsFromFkSide = oppositeRelationshipToUse.GetFkFieldsFromFkSide().ToList();
					foreach(IFieldElementCore field in fkFieldsFromFkSide) 
					{
						var fieldMapping = intermediateEntityMapping.GetFieldMappingOfField(field);
						var targetField = fieldMapping.MappedTarget;
						sb.AppendFormat("{0}\t\t<column name=\"{1}\"/>{2}", rootIndents, SD_NHibernateGeneralUtils.ProduceFieldFullName(targetField.FieldName, _executingGenerator, "&quot;"), 
																			Environment.NewLine);
					}
					sb.AppendFormat("{0}\t</many-to-many>{1}", rootIndents, Environment.NewLine);
					sb.AppendFormat("{0}</{1}>{2}", rootIndents, collectionType, Environment.NewLine);
					break;
				case EntityRelationshipType.OneToOne:
					cascadeAttribute = string.Format(" cascade=\"{0}\"", relationshipInfo.NavigatorInstance.OutputSettingValues.GetRealStringSettingValue("SingleEntityNavigatorCascadeType", currentProject));
					bool isPkPk = relationshipInfo.NormalRelationship.FkFieldsFormPkOfFkSide;
					bool emitOneToOne = true;
					bool relatedEntityIsOptional = false;
					if(relationshipInfo.IsOnPkSide)
					{
						relatedEntityIsOptional = relationshipInfo.NormalRelationship.StartEntityIsPkSide ? relationshipInfo.NormalRelationship.EndEntityIsOptional
																										: relationshipInfo.NormalRelationship.StartEntityIsOptional;
					}
					else
					{
						emitOneToOne = isPkPk;
					}
					if(emitOneToOne)
					{
						sb.AppendFormat("{0}<one-to-one name=\"{1}\" access=\"field.camelcase-underscore\"{2}{3}", rootIndents, relationshipInfo.Navigator, 
																														    fetchAttribute, cascadeAttribute);
						if(!relatedEntityIsOptional) 
						{
							sb.Append(" constrained=\"true\"");
						}
						if(!relationshipInfo.OppositeNavigatorIsHidden && !isPkPk)
						{
							sb.AppendFormat(" property-ref=\"{0}\"", relationshipInfo.OppositeNavigator);
						}
						sb.AppendFormat("/>{0}", Environment.NewLine);
					}
					else
					{
						sb.AppendFormat("{0}<many-to-one name=\"{1}\" access=\"field.camelcase-underscore\"{2} unique=\"true\"{3}>{4}", 
														rootIndents, relationshipInfo.Navigator, fetchAttribute, cascadeAttribute, Environment.NewLine);
						foreach(IFieldElementCore field in fkFieldsFromFkSide) 
						{
							var fieldMapping = mapping.GetFieldMappingOfField(field);
							var targetField = fieldMapping.MappedTarget;
							sb.AppendFormat("{0}\t<column name=\"{1}\"/>{2}", rootIndents, 
										SD_NHibernateGeneralUtils.ProduceFieldFullName(targetField.FieldName, _executingGenerator, "&quot;"), Environment.NewLine);
						}
						sb.AppendFormat("{0}</many-to-one>{1}", rootIndents, Environment.NewLine);
					}
					break;
				case EntityRelationshipType.ManyToOne:
					// if there's one pk field in the fk fields, we skip it, as it's already mapped in the composite PK (otherwise it'd have been a 1:1, so
					// pk must be composite)
					if(relationshipInfo.NormalRelationship.GetFkFieldsFromFkSide().Any(f=>f.IsPartOfIdentifyingFields))
					{
						continue;
					}
					cascadeAttribute = string.Format(" cascade=\"{0}\"", relationshipInfo.NavigatorInstance.OutputSettingValues.GetRealStringSettingValue("SingleEntityNavigatorCascadeType", currentProject));
					sb.AppendFormat("{0}<many-to-one name=\"{1}\" access=\"field.camelcase-underscore\"{2}{3}>{4}", 
														rootIndents, relationshipInfo.Navigator, fetchAttribute, cascadeAttribute, Environment.NewLine);
					var pkSidePkFields = SD_NHibernateGeneralUtils.GetPkFieldsForEntity(relationshipInfo.RelatedEntity, _executingGenerator).FieldsOrdered;
					foreach(IFieldElementCore pkFieldPkSide in pkSidePkFields) 
					{
						var field = relationshipInfo.NormalRelationship.GetFkFieldAssignedToPkField((IIdentifyingField)pkFieldPkSide);
						var fieldMapping = mapping.GetFieldMappingOfField(field);
						var targetField = fieldMapping.MappedTarget;
						sb.AppendFormat("{0}\t<column name=\"{1}\"/>{2}", rootIndents, 
											SD_NHibernateGeneralUtils.ProduceFieldFullName(targetField.FieldName, _executingGenerator, "&quot;"), Environment.NewLine);
					}
					sb.AppendFormat("{0}</many-to-one>{1}", rootIndents, Environment.NewLine);
					break;
				case EntityRelationshipType.OneToMany:
					// if related entity is a pure m:n intermediate, the entity doesn't exist in the generated output, so we should ignore it.
					if(relationshipInfo.RelatedEntity.IsPureManyToManyIntermediate)
					{
						continue;
					}
					inverse= currentProject.GetRealBoolSettingValue("SetInverseTrueOnCollectionMappings");
					if(inverse)
					{
						inverseAttribute=" inverse=\"true\"";
					} 
					cascadeAttribute = string.Format(" cascade=\"{0}\"", relationshipInfo.NavigatorInstance.OutputSettingValues.GetRealStringSettingValue("CollectionNavigatorCascadeType", currentProject));
					collectionType = relationshipInfo.NavigatorInstance.OutputSettingValues.GetRealStringSettingValue("CollectionType", currentProject);
					lazyAttribute = string.Empty;
					if(!relationshipInfo.NavigatorInstance.OutputSettingValues.GetRealBoolSettingValue("UseLazyLoading", currentProject))
					{
						lazyAttribute=" lazy=\"false\"";
					}
					sb.AppendFormat("{0}<{1} name=\"{2}\" access=\"field.camelcase-underscore\"{3}{4}{5}{6}>{7}",
									rootIndents, collectionType, relationshipInfo.Navigator, cascadeAttribute, 
									inverseAttribute, lazyAttribute, fetchAttribute, Environment.NewLine);
					sb.AppendFormat("{0}\t<key>{1}", rootIndents, Environment.NewLine);
					var fkEntity = relationshipInfo.NormalRelationship.EntityFkSide;
					EntityMapping fkMapping = (EntityMapping)currentProject.GetGroupableModelElementMapping(fkEntity, _executingGenerator.DriverID);
					var identifyingFields = SD_NHibernateGeneralUtils.GetPkFieldsForEntity(entity, _executingGenerator).FieldsOrdered;
					foreach(IFieldElementCore pkField in identifyingFields) 
					{
						var field = relationshipInfo.NormalRelationship.GetFkFieldAssignedToPkField((IIdentifyingField)pkField);
						var fieldMapping = fkMapping.GetFieldMappingOfField(field);
						var targetField = fieldMapping.MappedTarget;
						sb.AppendFormat("{0}\t\t<column name=\"{1}\"/>{2}", rootIndents, 
									SD_NHibernateGeneralUtils.ProduceFieldFullName(targetField.FieldName, _executingGenerator, "&quot;"), Environment.NewLine);
					}
					sb.AppendFormat("{0}\t</key>{1}", rootIndents, Environment.NewLine);
					sb.AppendFormat("{0}\t<one-to-many class=\"{1}\"/>{2}", rootIndents, relationshipInfo.RelatedEntity.Name, Environment.NewLine);
					sb.AppendFormat("{0}</{1}>{2}", rootIndents, collectionType, Environment.NewLine);
					break;
			}
		}
		return sb.ToString();
	}

	
	private void ProduceClassMappingAttributesFromSettings(EntityDefinition entity, Project currentProject, out string discriminatorValueAttribute,
							out string dynamicUpdateAttribute, out string dynamicInsertAttribute, out string lazyAttribute, out string optimisticLockAttribute)
	{
		discriminatorValueAttribute=string.Empty;
		if(entity.InheritanceType==InheritanceHierarchyType.TargetPerEntityHierarchy)
		{
			string discriminatorValueAsString = GeneratorUtils.GetDiscriminatorValueAsString(entity, _executingGenerator, false);
			if(!discriminatorValueAsString.StartsWith("\""))
			{
				discriminatorValueAsString = string.Format("\"{0}\"", discriminatorValueAsString);
			}
			discriminatorValueAttribute = string.Format(" discriminator-value={0}", discriminatorValueAsString);
		}
		dynamicUpdateAttribute=string.Empty;
		if(entity.OutputSettingValues.GetRealBoolSettingValue("UseDynamicUpdates", currentProject))
		{
			dynamicUpdateAttribute = " dynamic-update=\"true\"";
		}
		dynamicInsertAttribute=string.Empty;
		if(entity.OutputSettingValues.GetRealBoolSettingValue("UseDynamicInserts", currentProject))
		{
			dynamicInsertAttribute = " dynamic-insert=\"true\"";
		}
		lazyAttribute = string.Empty;
		if(!entity.OutputSettingValues.GetRealBoolSettingValue("UseLazyLoading", currentProject))
		{
			lazyAttribute=" lazy=\"false\"";
		}
		optimisticLockAttribute = string.Format(" optimistic-lock=\"{0}\"", entity.OutputSettingValues.GetRealStringSettingValue("OptimisticLockType", currentProject));
	}
~>
