		<add key="VaultResourcePath" value="v1/kv-v1/prod/cspaps" />
		<add key="VaultCommand" value="java -cp &quot;c:\javautil\lib\mail.jar;c:\javautil\lib\org.json.jar;c:\javautil\lib\google-api-services-iam-v1-rev209-1.22.0.jar;c:\javautil\lib\google-api-services-storage-v1-rev116-1.22.0.jar;c:\javautil\lib\commons-codec-1.10.jar;c:\javautil\lib\commons-logging-1.2.jar;c:\javautil\lib\google-api-client-1.24.1.jar;c:\javautil\lib\google-http-client-1.24.1.jar;c:\javautil\lib\google-http-client-jackson2-1.24.1.jar;c:\javautil\lib\google-oauth-client-1.24.1.jar;c:\javautil\lib\guava-20.0.jar;c:\javautil\lib\httpclient-4.5.3.jar;c:\javautil\lib\httpcore-4.4.6.jar;c:\javautil\lib\jackson-core-2.9.2.jar;c:\javautil\lib\jsr305-3.0.2.jar;c:\javautil\lib\bcprov-jdk15on-1.55.jar;c:\javautil\lib\jackson-annotations-2.8.0.jar;c:\javautil\lib\jackson-core-2.8.4.jar;c:\javautil\lib\jackson-databind-2.8.4.jar;c:\javautil\lib\java-jwt-3.1.0.jar;c:\javautil\lib\commons-io-2.6.jar;C:\javautil\vaultutil.jar&quot; com.panw.gcp.HashiVaultUtil &quot;C:\javautil\vault_config.properties&quot;" />
		<add key="EnableSsl" value="false" />
		<add key="AgentConfig" value="c:\agent-config.txt" />
		<add key="GoogleApplicationCredentials" value="C:\Config\g-app-creds.json" />
		<add key="Glimpse:DisableAsyncSupport" value="true" />
