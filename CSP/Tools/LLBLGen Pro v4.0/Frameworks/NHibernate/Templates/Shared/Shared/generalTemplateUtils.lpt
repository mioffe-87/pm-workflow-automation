<[ System.Data ]>
<[ SD.LLBLGen.Pro.ApplicationCore.Interfaces ]>
<[ SD.Tools.Algorithmia.Graphs]>
<[ SD.Tools.Algorithmia.Graphs.Algorithms]>
<[ SD.Tools.Algorithmia.GeneralDataStructures]>
<~
	// returns the path from start till index (including the name on index) of the path contained by wrapper.
	// index is 0 bound. 
	internal static string ProducePartialPathName(MappableFieldWrapper wrapper, int index)
	{
		StringBuilder builder = new StringBuilder();
		for(int i=0;i<=index;i++)
		{
			builder.Append(wrapper.Path[i]);
		}
		return builder.ToString();
	}
	
	
	// Gets information from the field + mapping specified for key info emitting.
	internal static void GetFieldEmitInfo(IFieldElementCore field, GroupableModelElementMapping mapping, out FieldMapping fieldMapping, 
										  out string typeConverterDeclaration, out IProjectElementFieldMapTargetElement targetField)
	{
		fieldMapping = mapping.GetFieldMappingOfField(field);
		typeConverterDeclaration = SD_NHibernateGeneralUtils.ProduceTypeConverterTypeString(fieldMapping);
		targetField = fieldMapping.MappedTarget;
	}
		
	
	// Returns a list of pairs where value1 is the relationship over which value2's fields are referencing a related entity, or where
	// value1 is null and value2 is a list with 1 field which isn't an FK field. The fields should be processed and emitted in the order of the pairs
	// and within a pair in the order of the fields in Value2. If no cache with pre-calculated pk field orders is present yet, it's produced first. 
	internal static PkFieldList GetPkFieldsForEntity(EntityDefinition entity, IGenerator executingGenerator)
	{
		PkFieldListCache cache = GetPkFieldOrderCache(executingGenerator);
		PkFieldList toReturn = cache.GetValue(entity);
		if(toReturn==null)
		{
			toReturn = new PkFieldList();
		}
		return toReturn;
	}
	
	
	// determines the custom generator to use, based on settings and the current target db.  Returned dictionary: key: param name, value: value for param
	internal static Dictionary<string, string> DetermineCustomGeneratorDataToUse(IFieldElementCore field, IGenerator executingGenerator, DBSchema targetSchema, 
															string quoteEscapeString, bool includeCatalogName, bool forFluentNHibernate, out string generatorToUse)
	{
		Project currentProject = executingGenerator.ProjectDefinition;
		Dictionary<string, string> toReturn = new Dictionary<string, string>();
		generatorToUse = field.OutputSettingValues.GetRealStringSettingValue("CustomGeneratorTypeToUse", currentProject);
		int intervalSize = field.OutputSettingValues.GetRealIntSettingValue("CustomGeneratorIntervalSize", currentProject);
		if(intervalSize >=0)
		{
			toReturn.Add("max_lo", intervalSize.ToString());
		}
		string schemaName = targetSchema.SchemaOwner;
		string catalogName = targetSchema.ParentCatalog.CatalogName;
		string schemaNameInSettings = string.Empty;
		string targetName = string.Empty;
		string targetParamName = string.Empty;
		bool emitCatalogName = includeCatalogName;
		switch(generatorToUse)
		{
			case "hilo":
				schemaNameInSettings = field.OutputSettingValues.GetRealStringSettingValue("CustomGeneratorHiLoTableSchema", currentProject);
				targetName = field.OutputSettingValues.GetRealStringSettingValue("CustomGeneratorHiLoTable", currentProject);
				toReturn.Add("column", field.OutputSettingValues.GetRealStringSettingValue("CustomGeneratorHiLoField", currentProject));
				targetParamName = "table";
				if(forFluentNHibernate)
				{
					generatorToUse = "HiLo";
				}
				break;
			case "seqhilo":
				schemaNameInSettings = field.OutputSettingValues.GetRealStringSettingValue("CustomGeneratorSeqHiLoSequenceSchema", currentProject);
				targetName = field.OutputSettingValues.GetRealStringSettingValue("CustomGeneratorSeqHiLoSequence", currentProject);
				targetParamName = "sequence";
				emitCatalogName = false;
				if(forFluentNHibernate)
				{
					generatorToUse = "SeqHiLo";
				}
				break;
		}
		if(forFluentNHibernate)
		{
			targetParamName = "target";
		}
		// determine target name
		if(!string.IsNullOrEmpty(schemaNameInSettings))
		{
			schemaName = schemaNameInSettings;
		}
		toReturn.Add(targetParamName, ProduceTargetFullName(catalogName, schemaName, targetName, executingGenerator, emitCatalogName, quoteEscapeString));
		return toReturn;
	}

	
	internal static bool DetermineIfFieldIsNumericTyped(IFieldElementCore field)
	{
		bool toReturn = false;
		switch(field.FieldType.KindOfType)
		{
			case FieldTypeKind.ValueTypeDefinition:
				toReturn = false;
				break;
			case FieldTypeKind.DotNetType:
				toReturn = new List<TypeCode>() { TypeCode.Byte, TypeCode.Int16, TypeCode.Int32, TypeCode.Int64, TypeCode.UInt16, TypeCode.UInt32, TypeCode.UInt64,
												  TypeCode.Decimal}.Contains(Type.GetTypeCode(field.FieldType.RepresentedType));
				break;
		}
		return toReturn;
	}
	
	internal static string GetFluentFetchAttributeValue(string fetchSetting)
	{
		string fetchAttribute=string.Empty;
		
		if (fetchSetting.Length==0)
		{
			return string.Empty;
		}
		switch(fetchSetting)
		{ 
			case "select":
				fetchAttribute=".Fetch.Select()";
				break;
			case "join":
				fetchAttribute=".Fetch.Join()";
				break;
		}
		
		return fetchAttribute;
	}


	internal static string GetFluentCascadeAttributeValue(string cascadeSetting)
	{
		string cascadeAttribute=string.Empty;
		
		if (cascadeSetting.Length==0)
		{
			return string.Empty;
		}
		switch(cascadeSetting)
		{ 
			case "all":
				cascadeAttribute=".Cascade.All()";
				break;
			case "all-delete-orphan":
				cascadeAttribute=".Cascade.AllDeleteOrphan()";
				break;
			case "none":
				cascadeAttribute=".Cascade.None()";
				break;
			case "save-update":
				cascadeAttribute=".Cascade.SaveUpdate()";
				break;
			case "delete":
				cascadeAttribute=".Cascade.Delete()";
				break;
		}
		
		return cascadeAttribute;
	}


	// returns the dialect name To use For the driverid specified
	internal static string DriverIdToDbConfigurationName(string driverID)
	{
		string toReturn;
		switch(driverID)
		{
			case "2D18D138-1DD2-467E-86CC-4838250611AE":
				// sql server
				toReturn = "MsSqlConfiguration.MsSql2005";
				break;
			case "758A392F-06F3-498b-AED9-D85A4C795BDA":
				// Mysql. 
				toReturn = "MySQLConfiguration.Standard";
				break;
			case "88EBFD8C-CBDD-4452-88AF-1C99E41A123F":
				// PostgreSql
				toReturn = "PostgreSQLConfiguration.Standard";
				break;
			case "A8034CB0-319D-4cdd-BC7D-1E7CFDBA3B74":
				// ODP.NET Oracle
				toReturn = "OracleDataClientConfiguration.Oracle10";
				break;
			case "DE158D99-1B10-4d88-8DEA-888E7930FF40":
				// MS Oracle
				toReturn = "OracleClientConfiguration.Oracle10";
				break;
			case "BB438EBA-A0B5-4236-A2B8-64D828A138AF":
				// DB2
				toReturn = "DB2Configuration.Standard";
				break;
			case "BCF16BE3-7E29-4E07-AC27-9FBF79D3CA7A":
				// Firebird
				toReturn = "FirebirdConfiguration";
				break;
			default:
				toReturn = "Driver not supported by FluentNH, Use Hibernate.cfg.xml file instead";
				break;
		}
		return toReturn;
	}

	// returns the dialect name to use for the driverid specified
	internal static string DriverIdToDialectName(string driverID)
	{
		string toReturn;
		switch(driverID)
		{
			case "2D18D138-1DD2-467E-86CC-4838250611AE":
				// sql server
				toReturn = "NHibernate.Dialect.MsSql2005Dialect";
				break;
			case "3FABDE1A-21DF-4fcb-96FD-BBFA8F18B1EA":
				// Sybase iAnywhere / ASA
				toReturn = "NHibernate.Dialect.SybaseAnywhereDialect";
				break;
			case "758A392F-06F3-498b-AED9-D85A4C795BDA":
				// Mysql. 
				toReturn = "NHibernate.Dialect.MySQL5Dialect";
				break;
			case "88EBFD8C-CBDD-4452-88AF-1C99E41A123F":
				// PostgreSql
				toReturn = "NHibernate.Dialect.PostgreSQLDialect";
				break;
			case "A3076322-977C-4e28-BFF4-F25ED096D1DB":
				// Sybase Advanced Server Enterprice (ASE)
				toReturn = "NHibernate.Dialect.SybaseDialect";
				break;
			case "A8034CB0-319D-4cdd-BC7D-1E7CFDBA3B74":		// ODP.NET Oracle
			case "DE158D99-1B10-4d88-8DEA-888E7930FF40":		// MS Oracle
				toReturn = "NHibernate.Dialect.Oracle10gDialect";
				break;
			case "BB438EBA-A0B5-4236-A2B8-64D828A138AF":
				// DB2
				toReturn = "NHibernate.Dialect.DB2Dialect";
				break;
			case "BCF16BE3-7E29-4E07-AC27-9FBF79D3CA7A":
				// Firebird
				toReturn = "NHibernate.Dialect.FirebirdDialect";
				break;
			default:
				toReturn = "NHibernate.Dialect.GenericDialect";
				break;
		}
		return toReturn;
	}


