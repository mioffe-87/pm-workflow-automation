<div class="grid-header">
    <input type="hidden" id="ProductSubType" name="ProductSubType" value="" />

    <div class="grid-left">
        <button type="button" class="k-button k-primary"  data-link-type="auth-code" id="@UniqueId.AddEpAuthCode">Activate New Auth-Code</button><span class="csp-tooltip"></span>
    </div>
    <div class="grid-right">

            <div class="grid-filter">
                @{                    
                    @(Html.Kendo().DropDownList()
                        .Name((string)UniqueId.searchFieldId)
                        .Events(events => events.Change("OnDevicesCmbChange"))
                        .OptionLabel("Filter By")
                        .OptionLabelTemplate("<span class='grid-filter__dropdown-placeholder'>Filter By</span>")
                        .DataTextField("Text")
                        .DataValueField("Value")
                        .BindTo(new List<SelectListItem>
                            {
                                new SelectListItem
                                    {
                                        Text = "Serial Number",
                                        Value = "SerialNumber"
                                    },
                                 new SelectListItem
                                    {
                                        Text = "Authorization Code",
                                        Value = "AuthCode"
                                    },
                                new SelectListItem
                                    {
                                        Text = "Device Name",
                                        Value = "DeviceName"
                                    },
                                new SelectListItem
                                    {
                                        Text = ApiConstants.DEVICE_CATEGORY,
                                        Value = "DeviceCategoryId"
                                    },

                            })
                        )
                }

            </div>

