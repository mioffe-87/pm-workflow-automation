<~
	// produces the complete subtype mapping for an entity which is in an inheritance hierarchy
	private string GetSubClassMapping(EntityDefinition entity,int level,Project currentProject, bool hasMultipleCatalogs)
	{
		StringBuilder sb = new StringBuilder();
		string indents = new string('\t', level+1);
		var nl = Environment.NewLine;
		
		foreach(EntityDefinition subType in currentProject.GetSubtypesForEntity(entity))
		{
			string discriminatorValueAttribute;
			string dynamicUpdateAttribute;
			string dynamicInsertAttribute;
			string lazyAttribute;
			string optimisticLockAttribute;
			ProduceClassMappingAttributesFromSettings(subType, currentProject, out discriminatorValueAttribute, out dynamicUpdateAttribute, out dynamicInsertAttribute,
														out lazyAttribute, out optimisticLockAttribute);
		
			EntityMapping subTypeMapping = (EntityMapping)_executingGenerator.ProjectDefinition.GetGroupableModelElementMapping(subType, _executingGenerator.DriverID);
			
			sb.AppendFormat("{3}{3}{0}''' <summary>Represents the mapping of the '{1}' entity, represented by the '{2}' class.</summary>{3}", indents, subType.FullName, subType.Name, nl);
			sb.AppendFormat("{0}Public class {1}Map{2}{0}\tInherits SubclassMap(Of [{1}]){2}",indents,subType.Name, nl); 
			sb.AppendFormat("{0}\t''' <summary>Initializes a new instance of the <see cref=\"{1}Map\"/> class.</summary>{2}", indents, subType.Name, nl);
			sb.AppendFormat("{0}\tPublic Sub New(){1}",indents, nl); 
		
			// this is a subtype, so it's either TPEH or TPE
			if(entity.InheritanceType==InheritanceHierarchyType.TargetPerEntityHierarchy)
			{
				sb.AppendFormat("{0}\t\t{1}{2}",indents,discriminatorValueAttribute,nl); 
			}
			else
			{
				sb.AppendFormat("{0}\t\tTable(\"{1}\"){2}", indents,
							SD_NHibernateGeneralUtils.ProduceTargetFullName(subTypeMapping.MappedTarget, _executingGenerator, hasMultipleCatalogs, "\"\""), nl);
				foreach(IFieldElementCore field in subType.IdentifyingFields)
				{
					var fieldMapping = subTypeMapping.GetFieldMappingOfField(field);
					var targetField = fieldMapping.MappedTarget;
					sb.AppendFormat("{0}\t\tKeyColumn(\"{1}\"){2}",indents,
						SD_NHibernateGeneralUtils.ProduceFieldFullName(targetField.FieldName, _executingGenerator, "\"\""),nl);
				}
			}
						
			if (dynamicInsertAttribute.Length>0)
			{
				sb.AppendFormat("{0}\t\t{1}{2}",indents,dynamicInsertAttribute,nl); 
			}
			if (dynamicUpdateAttribute.Length>0)
			{
				sb.AppendFormat("{0}\t\t{1}{2}",indents,dynamicUpdateAttribute,nl); 
			}
			if (lazyAttribute.Length>0)
			{
				sb.AppendFormat("{0}\t\t{1}{2}",indents,lazyAttribute,nl); 
			}
			AppendFieldAndAssociationMappings(level+2, subType, subTypeMapping, currentProject, sb, hasMultipleCatalogs);
			sb.AppendFormat("{0}\t\tAdditionalMappingInfo(){1}", indents, nl);
			sb.AppendFormat("{0}\tEnd Sub{1}",indents,nl); 
			sb.AppendFormat("{1}{0}\t''' <summary>Partial method for adding additional mapping information in a partial class./ </summary>{1}", indents, nl);
			sb.AppendFormat("{0}\tPartial Private Sub AdditionalMappingInfo(){1}", indents, nl);
			sb.AppendFormat("{0}\tEnd Sub{1}", indents, nl);
			sb.Append(ProduceValueTypeMappingMethods(level+2, 0, subTypeMapping.FieldMappings));
			sb.AppendFormat("{0}End Class{1}",indents,Environment.NewLine);   

			sb.Append(GetSubClassMapping(subType, level, currentProject, hasMultipleCatalogs));
		}
		return sb.ToString();
	}

	
	// Appends the field and association mappings for the entity specified to the stringbuilder specified
	private void AppendFieldAndAssociationMappings(int numberOfRootTabs, EntityDefinition entity, GroupableModelElementMapping mapping, Project currentProject, 
												   StringBuilder toAppendTo, bool hasMultipleCatalogs)
	{
		string propertyMappings = GetEntityFieldMappings(numberOfRootTabs + 1, entity, mapping, currentProject);
		if(!string.IsNullOrEmpty(propertyMappings))
		{
			toAppendTo.Append(propertyMappings);
		}
		string associationMappings = GetEntityAssociationMappings(numberOfRootTabs + 1, entity, mapping, currentProject, hasMultipleCatalogs);
		if(!string.IsNullOrEmpty(associationMappings))
		{
			toAppendTo.Append(associationMappings);
		}	
	}


	// gets the field mappings for the valuetype at the index of the path in the field mappings.
	private string ProduceValueTypeMappingMethods(int numberOfRootTabs, int pathIndex,  IEnumerable<FieldMapping> fieldMappings)
	{
		List<GroupedFieldMapping> groupsCollected = new List<GroupedFieldMapping>();
		GroupFieldMappingCollectorForValueTypeMappingProducer(pathIndex, fieldMappings, groupsCollected);
		StringBuilder sb = new StringBuilder();
		var nl = Environment.NewLine;
		string rootIndents = new string('\t', numberOfRootTabs);
		foreach(var group in groupsCollected)
		{
			sb.Append(nl);
			sb.AppendFormat("{0}Private Sub Map{1}Component(toMap As ComponentPart(Of ValueTypeClasses.{2})){3}", 
									rootIndents, group.PartialPath, ((ValueTypeDefinition)group.Field.FieldType).Name, nl);
									
			foreach(var fieldMapping in group.Mappings)
			{
				IMappableField field = fieldMapping.MappedFieldWrapper.Path[group.PathIndex+1];
				
				switch(field.FieldType.KindOfType)
				{
					case FieldTypeKind.DotNetType:
						string typeConverterDeclaration = SD_NHibernateGeneralUtils.ProduceTypeConverterTypeStringFluentVBNet(fieldMapping);
						sb.AppendFormat("{0}\ttoMap.Map(Function(x) x.{1}){2}",rootIndents, field.Name, typeConverterDeclaration);
						sb.AppendFormat(".Column(\"{0}\")",
								SD_NHibernateGeneralUtils.ProduceFieldFullName(fieldMapping.MappedTarget.FieldName, _executingGenerator, "\"\""));
						if(!fieldMapping.MappedFieldInstance.IsOptional)
						{
							sb.Append(".Not.Nullable()");
						}
						sb.Append(".Access.CamelCaseField(Prefix.Underscore)");
						break;
					case FieldTypeKind.ValueTypeDefinition:
						sb.AppendFormat("{0}\ttoMap.Component(Function(x) x.{1}, AddressOf Map{2}Component)",
										rootIndents, field.Name, SD_NHibernateGeneralUtils.ProducePartialPathName(fieldMapping.MappedFieldWrapper, group.PathIndex+1));
						break;
				}
				sb.Append(nl);
			}			
			
			sb.AppendFormat("{0}End Sub{1}", rootIndents, nl);
		}
		return sb.ToString();
	}
	
	// collector method for ProduceValueTypeMappingMethods which collects all valuetype field mappings to emit into private mapping methods.
	private void GroupFieldMappingCollectorForValueTypeMappingProducer(int pathIndex,  IEnumerable<FieldMapping> fieldMappings, 
												  					   List<GroupedFieldMapping> groupsCollected)
	{
		var groupedMappings = 	from fm in fieldMappings
								group fm by new { 
													PartialPath = SD_NHibernateGeneralUtils.ProducePartialPathName(fm.MappedFieldWrapper, pathIndex), 
												  	Field = fm.MappedFieldWrapper.Path[pathIndex] 
												} into g
								select new GroupedFieldMapping { PartialPath = g.Key.PartialPath, Field = g.Key.Field, PathIndex = pathIndex, Mappings = g.ToList()};
								
		foreach(var group in groupedMappings)
		{
            bool doRecursion = false;
			if(group.Field.FieldType.KindOfType==FieldTypeKind.ValueTypeDefinition)
			{
				groupsCollected.Add(group);
				doRecursion = true;
			}		   
			
			if(doRecursion)
			{	
				GroupFieldMappingCollectorForValueTypeMappingProducer(pathIndex+1, group.Mappings, groupsCollected);
			}
		}
	}

	// gets all field mappings for the entity specified
	private string GetEntityFieldMappings(int numberOfRootTabs, EntityDefinition entity, GroupableModelElementMapping mapping, Project currentProject)
	{
		StringBuilder sb = new StringBuilder();
		string rootIndents = new string('\t', numberOfRootTabs);
		FieldMapping fieldMapping = null;
		IProjectElementFieldMapTargetElement targetField = null;
		// first emit the version field, if any. 
		var versionField = entity.Fields.FirstOrDefault(f=>f.OutputSettingValues.GetRealBoolSettingValue("UseAsVersionField", currentProject) &&
															f.FieldType.KindOfType==FieldTypeKind.DotNetType);
		if(versionField!=null)
		{
			fieldMapping = mapping.GetFieldMappingOfField(versionField);
			targetField = fieldMapping.MappedTarget;
			if(targetField.TypeDefinition.DBTypeAsNETType==typeof(byte[]))
			{
				// special case for SQL Server... 
				sb.AppendFormat("{0}Version(Function(x) x.{1}) _{2}",rootIndents,versionField.Name,Environment.NewLine);
				sb.AppendFormat("{0}\t.Access.CamelCaseField(Prefix.Underscore) _{1}",rootIndents,Environment.NewLine);
				sb.AppendFormat("{0}\t.Column(\"{1}\") _{2}",rootIndents,
						SD_NHibernateGeneralUtils.ProduceFieldFullName(targetField.FieldName, _executingGenerator, "\"\""), Environment.NewLine);
				sb.AppendFormat("{0}\t\t.CustomSqlType(\"timestamp\") _{1}",rootIndents,Environment.NewLine);
				sb.AppendFormat("{0}\t\t.Not.Nullable() _{1}",rootIndents,Environment.NewLine);
				sb.AppendFormat("{0}\t.UnsavedValue(\"null\") _{1}",rootIndents,Environment.NewLine);
				sb.AppendFormat("{0}\t.CustomType(\"BinaryBlob\") _{1}",rootIndents,Environment.NewLine);
				sb.AppendFormat("{0}\t.Generated.Always(){1}",rootIndents,Environment.NewLine);
			}
			else
			{
				// as version requires the type explicitly if the type isn't an int, we've to do the work for NHibernate...
				string typeSpecification=string.Empty;
				switch(Type.GetTypeCode(versionField.FieldType.RepresentedType))
				{
					case TypeCode.DateTime:
						typeSpecification="Timestamp";
						break;
					case TypeCode.Int16:
						typeSpecification="Int16";
						break;
					case TypeCode.Int32:
						typeSpecification="Int32";
						break;
					case TypeCode.Int64:
						typeSpecification="Int64";
						break;
				}
				sb.AppendFormat("{0}Version(Function(x) x.{1}) _{2}",rootIndents,versionField.Name,Environment.NewLine);
				sb.AppendFormat("{0}\t.Access.CamelCaseField(Prefix.Underscore) _{1}",rootIndents,Environment.NewLine);
				sb.AppendFormat("{0}\t.Column(\"{1}\") _{2}",rootIndents,
					SD_NHibernateGeneralUtils.ProduceFieldFullName(targetField.FieldName, _executingGenerator, "\"\""),Environment.NewLine);
				sb.AppendFormat("{0}\t.CustomType(\"{1}\"){2}",rootIndents,typeSpecification,Environment.NewLine);
			}
		}
		
		foreach(IFieldElementCore field in entity.Fields.Where(f=>!f.IsPartOfIdentifyingFields && !f.IsForeignKeyField  && f!=entity.DiscriminatorField &&
																	(f!=versionField))
														.OrderBy(f=>f.Name))
		{
			switch(field.FieldType.KindOfType)
			{
				case FieldTypeKind.DotNetType:
					fieldMapping = mapping.GetFieldMappingOfField(field);
					string typeConverterDeclaration = SD_NHibernateGeneralUtils.ProduceTypeConverterTypeStringFluentVBNet(fieldMapping);
					targetField = fieldMapping.MappedTarget;
					string typeSpecification = string.Empty;
					int realLength = GeneratorUtils.GetRealMaxLength(field.MaxLength, field.FieldType.RepresentedType);
					if(realLength > 8*1024)
					{
						if(field.FieldType.RepresentedType == typeof(string))
						{
							typeSpecification = ".CustomType(\"StringClob\")";
						}
						if(field.FieldType.RepresentedType == typeof(byte[]))
						{
							typeSpecification = ".CustomType(\"BinaryBlob\")";
						}
					}
					string updateInsertAttributes = string.Empty;
					if(field.IsReadOnly)
					{
						updateInsertAttributes = ".ReadOnly()";
					}
					sb.AppendFormat("{0}Map(Function(x) x.{1}){2}{3}{4}",rootIndents, field.Name, updateInsertAttributes, typeSpecification, typeConverterDeclaration);
					sb.AppendFormat(".Column(\"{0}\")", SD_NHibernateGeneralUtils.ProduceFieldFullName(targetField.FieldName, _executingGenerator, "\"\""));
					if(!field.IsOptional)
					{
						sb.Append(".Not.Nullable()");
					}
					sb.AppendFormat(".Access.CamelCaseField(Prefix.Underscore){0}", Environment.NewLine);
					break;
				case FieldTypeKind.ValueTypeDefinition:
					sb.AppendFormat("{0}Component(Function(x) x.{1}, AddressOf Map{1}Component){2}", rootIndents, field.Name, Environment.NewLine);
					break;
			}
		}
		return sb.ToString();
	}

	// gets all association mappings for the entity specified
	private string GetEntityAssociationMappings(int numberOfRootTabs, EntityDefinition entity, GroupableModelElementMapping mapping, Project currentProject,
												bool hasMultipleCatalogs)
	{
		var nl = Environment.NewLine;
		var allRelationshipInfosToTraverse = GeneratorUtils.GetAllRelationshipInfosForEntity(_executingGenerator, entity);
		StringBuilder sb = new StringBuilder();
		string rootIndents = new string('\t', numberOfRootTabs);
		List<string> fragments = new List<string>();
		foreach(var relationshipInfo in allRelationshipInfosToTraverse.OrderBy(ri=>ri.Navigator))
		{
			if(relationshipInfo.NavigatorIsHidden)
			{
				continue;
			}
			List<FieldElement> fkFieldsFromFkSide = new List<FieldElement>();
			if(relationshipInfo.RelationshipType!=EntityRelationshipType.ManyToMany)
			{
				fkFieldsFromFkSide = relationshipInfo.NormalRelationship.GetFkFieldsFromFkSide().ToList();
			}
			string fetchSetting = relationshipInfo.NavigatorInstance.OutputSettingValues.GetRealStringSettingValue("FetchStrategy", currentProject);
			string fetchAttribute = SD_NHibernateGeneralUtils.GetFluentFetchAttributeValue(fetchSetting);
			string cascadeAttribute = string.Empty;
			string collectionType = string.Empty;
			string inverseAttribute = string.Empty;
			string lazyAttribute = string.Empty;
			bool inverse = false;
			string cascadeSetting = string.Empty;
			switch(relationshipInfo.RelationshipType)
			{
				case EntityRelationshipType.ManyToMany:
					IndirectRelationshipEdge relationshipAsMtoM = (IndirectRelationshipEdge)relationshipInfo.Relationship;
					cascadeSetting = relationshipInfo.NavigatorInstance.OutputSettingValues.GetRealStringSettingValue("CollectionNavigatorCascadeType",currentProject);
					cascadeAttribute=SD_NHibernateGeneralUtils.GetFluentCascadeAttributeValue(cascadeSetting);
					collectionType = relationshipInfo.NavigatorInstance.OutputSettingValues.GetRealStringSettingValue("CollectionType", currentProject);
					if(!relationshipInfo.NavigatorInstance.OutputSettingValues.GetRealBoolSettingValue("UseLazyLoading", currentProject))
					{
						lazyAttribute=".LazyLoad()";
					}
					sb.AppendFormat("{0}HasManyToMany(Function(x) x.{1}) _{2}",rootIndents,relationshipInfo.Navigator,nl);
					sb.AppendFormat("{0}\t.Access.CamelCaseField(Prefix.Underscore) _{1}",rootIndents,nl);
					if (cascadeSetting.Length>0)
					{
						sb.AppendFormat("{0}\t{1} _{2}",rootIndents, cascadeAttribute,nl);
					}
					sb.AppendFormat("{0}\t{1} _{2}",rootIndents, fetchAttribute,nl);
					if(collectionType=="set")
					{
						sb.AppendFormat("{0}\t.AsSet() _{1}", rootIndents, nl);
					}
					if (lazyAttribute.Length>0)
					{	
						sb.AppendFormat("{0}\t{1} _{2}",rootIndents, lazyAttribute,nl);
					}
					EntityDefinition intermediateEntity = relationshipAsMtoM.DetermineIntermediateEntity();
					EntityMapping intermediateEntityMapping = (EntityMapping)_executingGenerator.ProjectDefinition.GetGroupableModelElementMapping(intermediateEntity, 
																					_executingGenerator.DriverID);
					sb.AppendFormat("{0}\t.Table(\"{1}\") _{2}", rootIndents, 
										SD_NHibernateGeneralUtils.ProduceTargetFullName(intermediateEntityMapping.MappedTarget, _executingGenerator, 
																						hasMultipleCatalogs, "\"\""), nl);
					NormalRelationshipEdge normalRelationshipToUse = relationshipAsMtoM.FirstRelationship;
					NormalRelationshipEdge oppositeRelationshipToUse = relationshipAsMtoM.SecondRelationship;
					if(!relationshipInfo.ViaStartNavigator)
					{
						normalRelationshipToUse = relationshipAsMtoM.SecondRelationship;
						oppositeRelationshipToUse = relationshipAsMtoM.FirstRelationship;
					}
					// as key columns simply emit the FK side's fields, as the intermediate entity is always the FK side. Do this in the order
					// of the pk fields of the current entity, as that's always the pk side for the relationship we're focused on: normalRelationshipToUse.
					fkFieldsFromFkSide = normalRelationshipToUse.GetFkFieldsFromFkSide().ToList();
					fragments.Clear();
					foreach(IFieldElementCore field in fkFieldsFromFkSide) 
					{
						var fieldMapping = intermediateEntityMapping.GetFieldMappingOfField(field);
						var targetField = fieldMapping.MappedTarget;
						fragments.Add(string.Format("\"{0}\"", SD_NHibernateGeneralUtils.ProduceFieldFullName(targetField.FieldName, _executingGenerator, "\"\"")));
					}
					sb.AppendFormat("{0}\t.ParentKeyColumns.Add({1}) _{2}", rootIndents, string.Join(", ", fragments.ToArray()), Environment.NewLine);
					fkFieldsFromFkSide = oppositeRelationshipToUse.GetFkFieldsFromFkSide().ToList();
					fragments.Clear();
					foreach(IFieldElementCore field in fkFieldsFromFkSide) 
					{
						var fieldMapping = intermediateEntityMapping.GetFieldMappingOfField(field);
						var targetField = fieldMapping.MappedTarget;
						fragments.Add(string.Format("\"{0}\"", SD_NHibernateGeneralUtils.ProduceFieldFullName(targetField.FieldName, _executingGenerator, "\"\"")));
					}
					sb.AppendFormat("{0}\t.ChildKeyColumns.Add({1}){2}", rootIndents, string.Join(", ", fragments.ToArray()), Environment.NewLine);
					break;						
				case EntityRelationshipType.OneToOne:
					cascadeAttribute = SD_NHibernateGeneralUtils.GetFluentCascadeAttributeValue(relationshipInfo.NavigatorInstance.OutputSettingValues.GetRealStringSettingValue("SingleEntityNavigatorCascadeType", currentProject));
					bool emitOneToOne = true;
					bool isPkPk = relationshipInfo.NormalRelationship.FkFieldsFormPkOfFkSide;
					bool relatedEntityIsOptional = false;
					if(relationshipInfo.IsOnPkSide)
					{
						relatedEntityIsOptional = relationshipInfo.NormalRelationship.StartEntityIsPkSide ? relationshipInfo.NormalRelationship.EndEntityIsOptional
																										: relationshipInfo.NormalRelationship.StartEntityIsOptional;
					}
					else
					{
						emitOneToOne = isPkPk;
					}
					if(emitOneToOne)
					{
						sb.AppendFormat("{0}HasOne(Function(x) x.{1}) _{2}", rootIndents, relationshipInfo.Navigator,nl); 
						sb.AppendFormat("{0}\t.Access.CamelCaseField(Prefix.Underscore)",rootIndents);
						if (cascadeAttribute.Length>0)
						{
							sb.AppendFormat(" _{2}{0}\t{1}",rootIndents, cascadeAttribute, nl);
						}
						sb.AppendFormat(" _{2}{0}\t{1}",rootIndents, fetchAttribute, nl);
						if(!relationshipInfo.OppositeNavigatorIsHidden && !isPkPk)
						{
							sb.AppendFormat(" _{2}{0}\t.PropertyRef(Function(x) x.{1})", rootIndents, relationshipInfo.OppositeNavigator, nl);
						}
						if(relatedEntityIsOptional) 
						{
							sb.AppendFormat("{0}", nl);
						}
						else
						{
							sb.AppendFormat(" _{1}{0}\t.Constrained(){1}",rootIndents,nl);
						}
					}
					else
					{
						sb.AppendFormat("{0}References(Function(x) x.{1}) _{2}", rootIndents, relationshipInfo.Navigator, Environment.NewLine);
						sb.AppendFormat("{0}\t.Access.CamelCaseField(Prefix.Underscore) _{1}",rootIndents,nl);
						if (cascadeAttribute.Length>0)
						{
							sb.AppendFormat("{0}\t{1} _{2}",rootIndents, cascadeAttribute,nl);
						}
						sb.AppendFormat("{0}\t.Unique() _{1}",rootIndents,nl);
						sb.AppendFormat("{0}\t{1} _{2}",rootIndents, fetchAttribute,nl);
						sb.AppendFormat("{0}\t.Columns(",rootIndents);
						fragments.Clear();
						foreach(IFieldElementCore field in fkFieldsFromFkSide) 
						{
							var fieldMapping = mapping.GetFieldMappingOfField(field);
							var targetField = fieldMapping.MappedTarget;
							fragments.Add(string.Format("\"{0}\"", SD_NHibernateGeneralUtils.ProduceFieldFullName(targetField.FieldName, _executingGenerator, "\"\"")));
						}
						sb.AppendFormat("{0}){1}", string.Join(", ", fragments.ToArray()), nl);
					}
					break;
				case EntityRelationshipType.ManyToOne:
					// if there's one pk field in the fk fields, we skip it, as it's already mapped in the composite PK (otherwise it'd have been a 1:1, so
					// pk must be composite)
					if(relationshipInfo.NormalRelationship.GetFkFieldsFromFkSide().Any(f=>f.IsPartOfIdentifyingFields))
					{
						continue;
					}
					cascadeAttribute=SD_NHibernateGeneralUtils.GetFluentCascadeAttributeValue(relationshipInfo.NavigatorInstance.OutputSettingValues.GetRealStringSettingValue("SingleEntityNavigatorCascadeType", currentProject));
					
					sb.AppendFormat("{0}References(Function(x) x.{1}) _{2}", rootIndents, relationshipInfo.Navigator, Environment.NewLine);
					sb.AppendFormat("{0}\t.Access.CamelCaseField(Prefix.Underscore) _{1}",rootIndents,nl);
					if (cascadeAttribute.Length>0)
					{
						sb.AppendFormat("{0}\t{1} _{2}",rootIndents, cascadeAttribute,nl);
					}
					sb.AppendFormat("{0}\t{1} _{2}",rootIndents, fetchAttribute,nl);
					
					var relatedEntityMapping = currentProject.GetGroupableModelElementMapping(relationshipInfo.RelatedEntity, _executingGenerator.DriverID);
					var fieldMappingOfRelatedSequencedPkField = relatedEntityMapping.GetAllIdentifyingFieldMappings(true).FirstOrDefault(fm=>fm.SequenceToUse!=null);
					if((relationshipInfo.RelatedEntity.IdentifyingFields.Count()>1) && (fieldMappingOfRelatedSequencedPkField!=null))
					{
						fkFieldsFromFkSide = new List<FieldElement>();
						fkFieldsFromFkSide.Add(relationshipInfo.NormalRelationship.GetFkFieldAssignedToPkField((IIdentifyingField)fieldMappingOfRelatedSequencedPkField.MappedFieldInstance));
					}
					sb.AppendFormat("{0}\t.Columns(",rootIndents);
					fragments.Clear();
					var pkSidePkFields = SD_NHibernateGeneralUtils.GetPkFieldsForEntity(relationshipInfo.RelatedEntity, _executingGenerator).FieldsOrdered;
					foreach(IFieldElementCore pkFieldPkSide in pkSidePkFields) 
					{
						var field = relationshipInfo.NormalRelationship.GetFkFieldAssignedToPkField((IIdentifyingField)pkFieldPkSide);
						var fieldMapping = mapping.GetFieldMappingOfField(field);
						var targetField = fieldMapping.MappedTarget;
						fragments.Add(string.Format("\"{0}\"", SD_NHibernateGeneralUtils.ProduceFieldFullName(targetField.FieldName, _executingGenerator, "\"\"")));
					}
					sb.AppendFormat("{0}){1}", string.Join(", ", fragments.ToArray()), nl);
					break;
				case EntityRelationshipType.OneToMany:
					// if related entity is a pure m:n intermediate, the entity doesn't exist in the generated output, so we should ignore it.
					if(relationshipInfo.RelatedEntity.IsPureManyToManyIntermediate)
					{
						continue;
					}
					inverse= currentProject.GetRealBoolSettingValue("SetInverseTrueOnCollectionMappings");
					if(inverse)
					{
						inverseAttribute=".Inverse()";
					} 
					cascadeSetting = relationshipInfo.NavigatorInstance.OutputSettingValues.GetRealStringSettingValue("CollectionNavigatorCascadeType",currentProject);
					cascadeAttribute=SD_NHibernateGeneralUtils.GetFluentCascadeAttributeValue(cascadeSetting);

					collectionType = relationshipInfo.NavigatorInstance.OutputSettingValues.GetRealStringSettingValue("CollectionType", currentProject);
					if(relationshipInfo.NavigatorInstance.OutputSettingValues.GetRealBoolSettingValue("UseLazyLoading", currentProject))
					{
						lazyAttribute=".LazyLoad()";
					}
					sb.AppendFormat("{0}HasMany(Function(x) x.{1}) _{2}",rootIndents,relationshipInfo.Navigator,nl);
					sb.AppendFormat("{0}\t.Access.CamelCaseField(Prefix.Underscore) _{1}",rootIndents,nl);
					if (cascadeSetting.Length>0)
					{
						sb.AppendFormat("{0}\t{1} _{2}",rootIndents, cascadeAttribute,nl);
					}
					sb.AppendFormat("{0}\t{1} _{2}",rootIndents, fetchAttribute,nl);
					if(collectionType=="set")
					{
						sb.AppendFormat("{0}\t.AsSet() _{1}", rootIndents, nl);
					}
					if(inverse)
					{	
						sb.AppendFormat("{0}\t{1} _{2}",rootIndents, inverseAttribute,nl);
					}
					if (lazyAttribute.Length>0)
					{	
						sb.AppendFormat("{0}\t{1} _{2}",rootIndents, lazyAttribute,nl);
					}
					sb.AppendFormat("{0}\t.KeyColumns.Add(", rootIndents);
					fragments.Clear();
					var fkEntity = relationshipInfo.NormalRelationship.EntityFkSide;
					EntityMapping fkMapping = (EntityMapping)currentProject.GetGroupableModelElementMapping(fkEntity, _executingGenerator.DriverID);
					var identifyingFields = SD_NHibernateGeneralUtils.GetPkFieldsForEntity(entity, _executingGenerator).FieldsOrdered;
					foreach(IFieldElementCore pkField in identifyingFields) 
					{
						var field = relationshipInfo.NormalRelationship.GetFkFieldAssignedToPkField((IIdentifyingField)pkField);
						var fieldMapping = fkMapping.GetFieldMappingOfField(field);
						var targetField = fieldMapping.MappedTarget;
							fragments.Add(string.Format("\"{0}\"", SD_NHibernateGeneralUtils.ProduceFieldFullName(targetField.FieldName, _executingGenerator, "\"\"")));
					}
					sb.AppendFormat("{0}){1}", string.Join(", ", fragments.ToArray()), nl);
					break;
			}
		}
		return sb.ToString();
	}

	
	private void ProduceClassMappingAttributesFromSettings(EntityDefinition entity, Project currentProject, out string discriminatorValueAttribute,
							out string dynamicUpdateAttribute, out string dynamicInsertAttribute, out string lazyAttribute, out string optimisticLockAttribute)
	{
		discriminatorValueAttribute=string.Empty;
		if(entity.InheritanceType==InheritanceHierarchyType.TargetPerEntityHierarchy)
		{
			string discriminatorValueAsString = GeneratorUtils.GetDiscriminatorValueAsString(entity, _executingGenerator, false);
			if(!discriminatorValueAsString.StartsWith("\""))
			{
				discriminatorValueAsString = string.Format("\"{0}\"", discriminatorValueAsString);
			}
			discriminatorValueAttribute = string.Format("DiscriminatorValue({0})", discriminatorValueAsString);
		}
		dynamicUpdateAttribute=string.Empty;
		if(entity.OutputSettingValues.GetRealBoolSettingValue("UseDynamicUpdates", currentProject))
		{
			dynamicUpdateAttribute = "DynamicUpdate()";
		}
		dynamicInsertAttribute=string.Empty;
		if(entity.OutputSettingValues.GetRealBoolSettingValue("UseDynamicInserts", currentProject))
		{
			dynamicInsertAttribute = "DynamicInsert()";
		}
		lazyAttribute = string.Empty;
		if(entity.OutputSettingValues.GetRealBoolSettingValue("UseLazyLoading", currentProject))
		{
			lazyAttribute="LazyLoad()";
		}
		optimisticLockAttribute = string.Format("OptimisticLock.{0}()", CapitalizeFirst(entity.OutputSettingValues.GetRealStringSettingValue("OptimisticLockType", currentProject)));
	}
	
	private class GroupedFieldMapping 
	{
		public string PartialPath { get; set;}
		public IMappableField Field { get; set;}
		public IEnumerable<FieldMapping> Mappings { get; set;}
		public int PathIndex { get; set;}
	}
	
		
	public string CapitalizeFirst(string input)
	{
    	return Char.ToUpper(input[0]) + input.Substring(1);
	}
~>
