                                    <span class="csp-required">*</span>
                                </div>
                            </div>
                            <div>
                                <div class="csp-label" style="width: 200px;">
                                    @Html.Label((string) UniqueId.CpuId, "CPUID:")
                                </div>
                                <div class="csp-field">
                                    @Html.ValidationMessageFor(model => model.VMRegistrationDto.CpuId)
                                    @Html.TextBoxFor(model => model.VMRegistrationDto.CpuId, new {id = UniqueId.CpuId})
                                    <span class="csp-required">*</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </li>
            }
        </ul>
    </fieldset>
