	/// <summary>Class which contains the typed list query factory methods.</summary>
	public static partial class TypedListQueryFactory
	{
<%	foreach(var typedList in _executingGenerator.TypedLists.OrderBy(tl=>tl.Name))
	{
%>		/// <summary>Creates an IQuery to fetch the typed list '<%=typedList.FullName%>' into instances of <%=typedList.Name%>TypedListRow</summary>
		/// <param name="session">The session to use for fetching.</param>
