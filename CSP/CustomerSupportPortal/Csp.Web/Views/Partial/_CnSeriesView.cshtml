        <button type="button" class="k-button k-primary" data-link-type="cnSeries-series-add-auth-code" id="@UniqueId.AddCnSeriesSeriesAuthCode">Add CN-Series Auth-Code</button>
        <button type="button" class="k-button k-primary" data-link-type="cnSeries-series-add-auth-code" id="@UniqueId.AllocateTokensToPanorama">Allocate Tokens to Panorama</button>
        @*<button type="button" class="k-button" style="margin-left: 5px; color: red" id="@UniqueId.ReviewTokensGrantBtn" >Review Tokens Grant</button>*@
    </div>
    <div class="grid-right">
        <div class="grid-filter">
            @{
                @(Html.Kendo().DropDownList()
                    .Name((string)UniqueId.searchFieldId)
                    .OptionLabel("Filter By")
                    .OptionLabelTemplate("<span class='grid-filter__dropdown-placeholder'>Filter By</span>")
                    .DataTextField("Text")
                    .DataValueField("Value")
                    .BindTo(new List<SelectListItem>
                    {
                        new SelectListItem { Text = "Authorization Code", Value = "AuthorizationCodes" },
                        new SelectListItem { Text = "Serial Number", Value = "SerialNumber" }
                    })
                )
