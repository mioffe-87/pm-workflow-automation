            var qs = new URLSearchParams(window.location.search);
            var configValue = qs.get("config");
            if (configValue === "1") {
                var grid = $("#@UniqueId.gridId").data("kendoGrid");
                grid.addRow();
                }

    },4000));


    function @(UniqueId.memberships)onMembershipEnterPress(e) {

        if (e.keyCode == 13) {
            @(UniqueId.memberships)SearchMemberShipData();
            return false;
        }
    }

    function @(UniqueId.memberships)onMemberGridDataBound() {
        if ($("#@UniqueId.isPostBackId").val() == "") {
            $("#@UniqueId.gridId").data("kendoGrid").dataSource._total = "@Convert.ToInt32(Model.DataParameters.TotalRecordCount)";
            $("#@UniqueId.isPostBackId").val(1);
        }

        //Selects all rows
        var gridRows = this.tbody.find("tr");
        gridRows.each(function(e){
            var currentDataItem = $("#@UniqueId.gridId").data("kendoGrid").dataItem($(this).closest("tr"));
            console.log("currentDataItem" + currentDataItem);

            //Check in the current dataItem if the row is editable
            if (currentDataItem.Editable === false) {
                $(this).find('td .k-grid-csp-edit').css("display", "none");
                $(this).find('td .k-grid-csp-delete').css("display", "none");
            }
        });
    }

    function @(UniqueId.memberships)editMembershipOLD(e) {
        e.preventDefault ? e.preventDefault() : e.returnValue = false;
        var dataItem = this.dataItem($(e.currentTarget).closest("tr"));
        var membershipid = dataItem.MembershipId;
        var direction = "/@ControllerFields.MembershipController/@actionHelper.Edit/?id=" + membershipid;
        var window = $("#@UniqueId.membershipWindowId").data("kendoWindow");
        window.refresh(direction);
        window.setOptions({
            minWidth: 985,
            minHeight: 400
        });
        window.open();
        window.center();
    }


    function @(UniqueId.memberships)showUserAccountDetails(userId) {
        var direction = "/@ControllerFields.UserAccountController/@actionHelper.Details/" + userId;
        var window = $("#@UniqueId.userAccountWindowId").data("kendoWindow");
        window.refresh();
        window.refresh(direction);
        window.setOptions({
            minHeight: 450
        });
        window.open();
        window.center();
    };


    $(document).ready(function () {
        $("#@UniqueId.createMembershipButtonId").click(function () {

            @{
                var createAction = "";

                if (actionHelper.Controller == ControllerFields.SupportAccountController) {

                    createAction = @actionHelper.CreateAccountMembership;

                } else if (actionHelper.Controller == ControllerFields.GroupController) {

                    createAction = @actionHelper.CreateGroupMembership;

                } else if (actionHelper.Controller == ControllerFields.DeviceController) {

                    createAction = @actionHelper.CreateDeviceMembership;
                }
            };
            var window = $("#@UniqueId.membershipWindowId").data("kendoWindow");
            var direction = "/@ControllerFields.MembershipController/@createAction/@actionHelper.Id";
            window.refresh(direction);
            window.setOptions({
                minWidth: 985,
                minHeight: 400
            });
            window.open();
            window.center();

        });


    });


    function @(UniqueId.memberships)DeleteMembershipDetails(e) {

        e.preventDefault ? e.preventDefault() : e.returnValue = false;
        var dataItem = this.dataItem($(e.currentTarget).closest("tr"));
        var row = $(e.currentTarget).closest("tr");
        var id = dataItem.MembershipId;
        var direction = "/@ControllerFields.MembershipController/@actionHelper.Delete/" + id;

        SupportPortal.Confirmation("@Constants.DeletePreMessage Membership?", function () { @(UniqueId.memberships)removeMembership(); });

        function @(UniqueId.memberships)removeMembership(e) {
            $.ajax({
                url: direction,
                type: 'POST',
                cache: false,
                data: { "__RequestVerificationToken": $("input[name=__RequestVerificationToken]").val() },
                success: function (result) {

                    if (result.Data && result.Data.Success) {
                        row.hide();
                        var grid = $("#@UniqueId.gridId").data("kendoGrid").dataSource;
                        grid.read();
                    } else {
                        row.show();

                        if (result.Data.Message) {
                            SupportPortal.Message(result.Data.Message);
                        }
                    }
                },
                error: function () {
                    row.show();
                }
            });

        }

    }

    function @(UniqueId.memberships)SearchMemberShipData() {
        var selectedValue = $("#@UniqueId.searchFieldId").val();
        if ($("#@UniqueId.searchDateTimePickerId").val() != '') {
            var dt = new Date($("#@UniqueId.searchDateTimePickerId").val());
            var dtString = dt.getFullYear() + "-" + ((dt.getMonth() + 1) > 9 ? (dt.getMonth() + 1) : "0" + (dt.getMonth() + 1)) + "-" + (dt.getDate() > 9 ? dt.getDate() : "0" + dt.getDate());


            if (selectedValue == "ExpirationDate") {
                $("#@UniqueId.searchValueId").val(dtString);
            }
            if (selectedValue == "ActivationDate") {
                $("#@UniqueId.searchValueId").val(dtString);
            }
        }
        var grid = $("#@UniqueId.gridId").data("kendoGrid").dataSource;
        grid.filter(
            {
                field: $("#@UniqueId.searchFieldId").val(),
                operator: "eq",
                value: $("#@UniqueId.searchValueId").val()
            }
        );
            grid.sync();
        }

        function @(UniqueId.memberships)OnCmbChange() {
        $("#@UniqueId.searchValueId").select();
            var dropDownControl = $("#@UniqueId.searchFieldId").data("kendoDropDownList");
            //dropDownControl.focus();
            var selectedValue = dropDownControl.value();
            if (selectedValue == "ExpirationDate") {
                $("#@UniqueId.dateDivId").show();
            $("#@UniqueId.searchDivId").hide();
        }
        else if (selectedValue == "ActivationDate") {
            $("#@UniqueId.dateDivId").show();
            $("#@UniqueId.searchDivId").hide();

        }
        else {
            $("#@UniqueId.dateDivId").hide();
            $("#@UniqueId.searchDivId").show();
        }
};


function @(UniqueId.memberships)onCloseMembershipWindow() {
    var window = $("#@UniqueId.membershipWindowId").data("kendoWindow");
