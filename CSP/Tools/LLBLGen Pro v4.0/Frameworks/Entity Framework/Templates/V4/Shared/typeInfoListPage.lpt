<%
	Project currentProject = _executingGenerator.ProjectDefinition;
	bool emitForeignKeyFields = currentProject.GetRealBoolSettingValue("EmitForeignKeyFields");
	_executingGenerator.StoreValueInRunQueueCache("TypedListClassesNamespace", _executingGenerator.RootNamespaceToUse + ".TypedListClasses");
	_executingGenerator.StoreValueInRunQueueCache("TypedViewClassesNamespace", _executingGenerator.RootNamespaceToUse + ".TypedViewClasses");
	_executingGenerator.StoreValueInRunQueueCache("ValueTypeClassesNamespace", _executingGenerator.RootNamespaceToUse + ".ValueTypeClasses");
	_executingGenerator.StoreValueInRunQueueCache("EntityClassesNamespace", _executingGenerator.RootNamespaceToUse + ".EntityClasses");
%>
<head>
<style type="text/css">
body {
	font-family: Arial, Helvetica, sans-serif;
}
.tableStyle {
	border-style: solid;
	border-width: 1px;
}
td {
	border-left-style: solid;
	border-left-width: 1px;
	border-color: #000000 #000000 #999999 #333333;
	border-bottom-style: solid;
	border-bottom-width: 1px;
}

.allBorders {
	border: 1px;
	border-style: solid;
	border-color: #999999;
}
h1 { margin-bottom: 0; }
h2 { margin-bottom: 0; }
h3 { margin-bottom: 0; }
p { margin-top: 0; }
</style>
</head>

<h1>Classes to implement manually</h1>
<p>Below are the classes specified, grouped per kind, which have to be 
implemented manually to work with the generated Context and Edmx file. This list 
of classes, their properties and the types of the properties, have to be 
implemented with the same names and types as specified below to avoid 
runtime-errors due to name mismatches as the Entity Framework requires that the 
names are equal in both code and mapping file (Edmx file). Keep the following in 
mind when writing your own classes:</p>
<ul>
	<li>Entity classes have all their properties defined as <i>virtual</i>. Other classes don't require virtual properties.</li>
	<li>Do <i>not</i> change the names of classes, properties nor the types of the properties otherwise you will get errors at runtime.</li>
	<li>Properties which have as type a value-type definition should have a backing field inside the class they're defined in which should be 
	initialized with a new instance when the containing class is instantiated.</li>
	<li>Implement collection properties (properties which represent navigators which return a set, e.g. Customer.Orders) using an 
	ICollection&lt;<i>EntityClassType</i>&gt; (VB.NET: ICollection(Of <i>EntityClassType</i>)) derived type, where <i>
	EntityClassType</i> is the type contained in the set, as listed in the table specified with each entity class</li>
	<li>Typed view and typed list classes have to have property setters, even though they're considered as read-only. This is because Entity Framework can't 
	fetch data through constructors, it has to fetch sets into instances through property setters. </li>
	<li>You have to use the specified namespaces, because the generated context class refers to these namespaces when referring to the classes you have to 
	write manually. If you don't want to / can't use these namespaces, you have to write the context class manually as well.</li>
</ul>
<p>Use the quick-jump menu below to quickly browse to the group of elements you're interested in. </p>
<h4>Quickly jump to:</h4>
<ul>
	<li><a href="#Entity classes">Entity classes</a></li>
	<li><a href="#Valuetype classes">Value-type classes</a></li>
	<li><a href="#Typedview classes">Typed view classes</a></li>
	<li><a href="#Typedlist classes">Typed list classes</a></li>
</ul>
<h2>Project information</h2>
<table cellpadding="3" cellspacing="0" border="1px">
	<tr>
		<td class="allBorders">Generated on</td>
		<td class="allBorders"><%=DateTime.Now.ToString("ddd dd MMMM yyyy. HH:mm:ss")%></td>
	</tr>
	<tr>
		<td class="allBorders">Project name</td>
		<td class="allBorders"><%=currentProject.Properties.ProjectName%></td>
	</tr>
	<tr>
		<td class="allBorders">Project filename</td>
		<td class="allBorders">
<a href="file:///<%=currentProject.Properties.ProjectLocationPathFilename%>"><%=currentProject.Properties.ProjectLocationPathFilename%></a></td>
	</tr>
	<tr>
		<td class="allBorders">Root namespace</td>
		<td class="allBorders"><%=_executingGenerator.RootNamespaceToUse%></td>
	</tr>
</table>
<p>&nbsp;</p>
<a name="Entity classes"></a><h2>Entity classes</h2>
<p>Full mandatory namespace to use: <b><%=_executingGenerator.RootNamespaceToUse%>.EntityClasses</b>.</p>
<%	if(_executingGenerator.Entities.Any())
	{
%><p>The following entity classes have to be implemented.</p>
<%
		foreach(var entity in _executingGenerator.Entities.OrderBy(e=>e.FullName))
		{
			var superType = entity.GetSuperType();
%><h3><%=entity.Name%></h3>
<p>Super-type: <% if(superType==null) {%><i>none</i> <%} else {%><i><%=_executingGenerator.RootNamespaceToUse%>.EntityClasses.<%=superType.Name%></i><%}%>.</p>
<p>This class has the following properties which are representations of entity fields</p>
<table class="tableStyle" cellspacing="0" cellpadding="3">
	<tr bgcolor="#C0C0C0">
		<td><b>Name</b></td>
		<td><b>.NET Type</b></td>
		<td><b>Length</b></td>
		<td><b>Precision</b></td>
		<td><b>Scale</b></td>
		<td><b>Is Nullable</b></td>
		<td><b>Is PK</b></td>
		<td><b>Is FK</b></td>
	</tr>
<%			var fields = entity.Fields.Where(f=>!f.IsDiscriminator).OrderBy(f=>f.Name).ToList();
			if(!emitForeignKeyFields)
			{
				fields = fields.Where(f=>!f.IsForeignKeyField || (f.IsForeignKeyField && f.IsPartOfIdentifyingFields)).ToList();
			}
			foreach(var field in fields)
			{
%>	<tr>
		<td><%=field.Name%></td>
<%				switch(field.FieldType.KindOfType)
				{
					case FieldTypeKind.DotNetType:
%>		<td><%=SD_EF_GeneralUtils.ProduceDotNetTypeName(field, _executingGenerator, "Nullable&lt;{0}&gt;")%></td>
		<td align="right"><%=GeneratorUtils.GetRealMaxLength(field.MaxLength, field.FieldType.RepresentedType)%></td>
		<td align="right"><%=field.Precision%></td>
		<td align="right"><%=field.Scale%></td>
		<td><%=field.IsOptional ? "True" : "&nbsp;"%></td>
		<td><%=field.IsPartOfIdentifyingFields ? "True" : "&nbsp;"%></td>
		<td><%=field.IsForeignKeyField ? "True" : "&nbsp;"%></td>
<%						break;
					case FieldTypeKind.ValueTypeDefinition:
%>		<td><i><%=SD_EF_GeneralUtils.ProduceDotNetTypeName(field, _executingGenerator, "Nullable&lt;{0}&gt;")%></i></td>
		<td align="right">0</td>
		<td align="right">0</td>
		<td align="right">0</td>
		<td>&nbsp;</td>
		<td>&nbsp;</td>
		<td>&nbsp;</td>
<%						break;
				}
%>	</tr>
<%			}
%></table>
<p>&nbsp;</p>
<%
			var allRelationshipInfosToTraverse = GeneratorUtils.GetAllRelationshipInfosForEntity(_executingGenerator, entity);
			var allSingleEntityRelationshipInfos = allRelationshipInfosToTraverse.Where(ri=>ri.NavigatorIsSingleEntity).OrderBy(ri=>ri.Navigator);
			if(allSingleEntityRelationshipInfos.Any())
			{
%><p>This class has the following single entity properties which are representations of navigators:</p>
<table class="tableStyle" cellspacing="0" cellpadding="4">
	<tr bgcolor="#C0C0C0">
		<td>Name</td>
		<td>Entity Class Type</td>
	</tr>
<%				foreach(var relationshipInfo in allSingleEntityRelationshipInfos)
				{
					if(relationshipInfo.NavigatorIsHidden)
					{
						continue;
					}
%>	<tr>
		<td><%=relationshipInfo.Navigator%></td>
		<td><i><%=_executingGenerator.RootNamespaceToUse%>.EntityClasses.<%=relationshipInfo.RelatedEntity.Name%></i></td>
	</tr>
<%				}
%></table>
<p>&nbsp;</p>
<%			}

			var allMultiEntityRelationshipInfos = allRelationshipInfosToTraverse.Where(ri=>!ri.NavigatorIsSingleEntity && 
								(ri.RelationshipType!=EntityRelationshipType.ManyToMany)).OrderBy(ri=>ri.Navigator);
			if(allMultiEntityRelationshipInfos.Any())
			{
%><p>This class has the following collection properties which are representations of navigators returning a set.</p>
<table class="tableStyle" cellspacing="0" cellpadding="4">
	<tr bgcolor="#C0C0C0">
		<td>Name</td>
		<td>Entity Class Type Contained in Collection</td>
	</tr>
<%				foreach(var relationshipInfo in allMultiEntityRelationshipInfos)
				{
					if(relationshipInfo.NavigatorIsHidden)
					{
						continue;
					}
%>	<tr>
		<td><%=relationshipInfo.Navigator%></td>
		<td><i><%=_executingGenerator.RootNamespaceToUse%>.EntityClasses.<%=relationshipInfo.RelatedEntity.Name%></i></td>
	</tr>
<%				}	
%></table>
<p>&nbsp;<br></p>
<%			}
		}
	}
%><a name="Valuetype classes"></a><h2>Value-type classes</h2>
<p>Full mandatory namespace to use: <b><%=_executingGenerator.RootNamespaceToUse%>.ValueTypeClasses</b>.</p>
<%	if(_executingGenerator.ValueTypes.Any())
	{
%><p>The following value-type classes have to be implemented.</p>
<%		foreach(var valueType in _executingGenerator.ValueTypes.OrderBy(vt=>vt.FullName))
		{
%><h3><%=valueType.Name%></h3>
<p>This class has the following properties which are representations of fields</p>
<table class="tableStyle" cellspacing="0" cellpadding="3">
	<tr bgcolor="#C0C0C0">
		<td><b>Name</b></td>
		<td><b>.NET Type</b></td>
		<td><b>Length</b></td>
		<td><b>Precision</b></td>
		<td><b>Scale</b></td>
		<td><b>Is Nullable</b></td>
	</tr>
<%			var fields = valueType.Fields.OrderBy(f=>f.Name);
			foreach(var field in fields)
			{
%>	<tr>
		<td><%=field.Name%></td>
<%				switch(field.FieldType.KindOfType)
				{
					case FieldTypeKind.DotNetType:
%>		<td><%=SD_EF_GeneralUtils.ProduceDotNetTypeName(field, _executingGenerator, "Nullable&lt;{0}&gt;")%></td>
		<td align="right"><%=GeneratorUtils.GetRealMaxLength(field.MaxLength, field.FieldType.RepresentedType)%></td>
		<td align="right"><%=field.Precision%></td>
		<td align="right"><%=field.Scale%></td>
		<td><%=field.IsOptional ? "True" : "&nbsp;"%></td>
<%						break;
					case FieldTypeKind.ValueTypeDefinition:
%>		<td><i><%=SD_EF_GeneralUtils.ProduceDotNetTypeName(field, _executingGenerator, "Nullable&lt;{0}&gt;")%></i></td>
		<td align="right">0</td>
		<td align="right">0</td>
		<td align="right">0</td>
		<td>&nbsp;</td>
<%						break;
				}
%>	</tr>
<%			}
%></table>
<p>&nbsp;<br></p>
<%		}
	}
%><a name="Typedview classes"></a><h2>Typed view row classes</h2>
<p>Full mandatory namespace to use: <b><%=_executingGenerator.RootNamespaceToUse%>.TypedViewClasses</b>.</p>
<%	if(_executingGenerator.TypedViews.Any())
	{
%><p>The following typed view classes have to be implemented.</p>
<%		foreach(var typedView in _executingGenerator.TypedViews.OrderBy(tv=>tv.Name))
		{
%><h3><%=typedView.Name%>TypedViewRow</h3>
<p>This class has the following properties which are representations of fields</p>
<table class="tableStyle" cellspacing="0" cellpadding="3">
	<tr bgcolor="#C0C0C0">
		<td><b>Name</b></td>
		<td><b>.NET Type</b></td>
		<td><b>Length</b></td>
		<td><b>Precision</b></td>
		<td><b>Scale</b></td>
		<td><b>Is Nullable</b></td>
	</tr>
<%			foreach(var field in typedView.Fields.OrderBy(f=>f.Name))
			{
%>	<tr>
		<td><%=field.Name%></td>
		<td><%=SD_EF_GeneralUtils.ProduceDotNetTypeName(field, _executingGenerator, "Nullable&lt;{0}&gt;")%></td>
		<td align="right"><%=GeneratorUtils.GetRealMaxLength(field.MaxLength, field.FieldType.RepresentedType)%></td>
		<td align="right"><%=field.Precision%></td>
		<td align="right"><%=field.Scale%></td>
		<td><%=field.IsOptional ? "True" : "&nbsp;"%></td>
	</tr>
<%			}
		}
%></table>
<p>&nbsp;<br></p>
<%	}
%><a name="Typedlist classes"></a><h2>Typed list row classes</h2>
<p>Full mandatory namespace to use: <b><%=_executingGenerator.RootNamespaceToUse%>.TypedListClasses</b>.</p>
<%	if(_executingGenerator.TypedLists.Any())
	{
%><p>The following typed list classes have to be implemented.</p>
<%		foreach(var typedList in _executingGenerator.TypedLists.OrderBy(tl=>tl.Name))
		{
%><h3><%=typedList.Name%>TypedListRow</h3>
<p>This class has the following properties which are representations of fields</p>
<table class="tableStyle" cellspacing="0" cellpadding="3">
	<tr bgcolor="#C0C0C0">
		<td><b>Name</b></td>
		<td><b>.NET Type</b></td>
		<td><b>Length</b></td>
		<td><b>Precision</b></td>
		<td><b>Scale</b></td>
		<td><b>Is Nullable</b></td>
	</tr>
<%			foreach(var field in typedList.Fields.OrderBy(f=>f.FieldAlias))
			{
				var mappedFieldInstance = field.MappedFieldInstance;
%>
	<tr>
		<td><%=field.FieldAlias%></td>
		<td><%=GeneratorUtils.ProduceDotNetTypeName(mappedFieldInstance.FieldType.RepresentedType, mappedFieldInstance.IsOptional, "Nullable&lt;{0}&gt;")%></td>
		<td align="right"><%=GeneratorUtils.GetRealMaxLength(mappedFieldInstance.MaxLength, mappedFieldInstance.FieldType.RepresentedType)%></td>
		<td align="right"><%=mappedFieldInstance.Precision%></td>
		<td align="right"><%=mappedFieldInstance.Scale%></td>
		<td><%=mappedFieldInstance.IsOptional ? "True" : "&nbsp;"%></td>
	</tr>
<%			}
		}
%></table>
<p>&nbsp;<br></p>
<%	}
%>



