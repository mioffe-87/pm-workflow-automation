<?xml version="1.0" encoding="utf-8"?>
<configuration xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">

  <connectionStrings>
  </connectionStrings>
  <appSettings>   
    <!--GCP Vault Config-->
    <add key="AppEnv" value="stg"  xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
    <add key="LocalDevSecretsFile" xdt:Transform="Remove" xdt:Locator="Match(key)"/>
    <add key="VaultUrl" value="http://127.0.0.1:8200/v1/IT/kv/data/stage/csp-stg/secret" xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
    <add key="AllowedOrigins" value="http://supportqa1.paloaltonetworks.com,https://supportqa1.paloaltonetworks.com,https://paloaltonetworks--QAQ1.my.salesforce.com,https://qaq1-paloaltonetworkssupport.cs91.force.com,http://localhost:3000" xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
    <add key="Impersonate_ProjectName" value="its-stg-csp-portalbff" xdt:Transform="SetAttributes" xdt:Locator="Match(key)"/>
    <add key="Data_Collection_ProjectName" value="its-stg-csp-data-coll" xdt:Transform="SetAttributes" xdt:Locator="Match(key)"/>
  </appSettings>
  <system.webServer>
    <httpProtocol xdt:Transform="Insert">
      <customHeaders>
        <add name="X-Frame-Options" value="SAMEORIGIN" />
        <add name="Content-Security-Policy" value="frame-ancestors 'self' https://*.paloaltonetworks.com" />
      </customHeaders>
    </httpProtocol>
    <defaultDocument>
      <files xdt:Transform="Replace">
        <remove value="default.aspx" />
        <remove value="iisstart.htm" />
        <remove value="index.html" />
        <remove value="index.htm" />
        <remove value="Default.asp" />
        <remove value="Default.htm" />
        <add value="healthCheck.htm" />
      </files>
    </defaultDocument>
    <rewrite xdt:Transform="Insert">
      <rules>
        <clear />
        <rule name="NoSSL - folder" stopProcessing="true">
          <match url="^healthCheck" />
          <conditions logicalGrouping="MatchAll" trackAllCaptures="false" />
          <action type="None" />
        </rule>
        <rule name="HTTPS force" stopProcessing="true">
          <match url="(.*)" />
          <conditions logicalGrouping="MatchAll" trackAllCaptures="false">
            <add input="{HTTPS}" pattern="^OFF$" />
          </conditions>
          <action type="Redirect" url="https://{HTTP_HOST}{REQUEST_URI}" appendQueryString="false" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
  <system.net>
    <mailSettings>
      <smtp deliveryMethod="Network" xdt:Transform="SetAttributes"></smtp>
    </mailSettings>
  </system.net>
  <elmah>
    <security allowRemoteAccess="1" xdt:Transform="SetAttributes" />
  </elmah>
  <system.serviceModel>
    <bindings xdt:Transform="Replace">
      <basicHttpBinding>
        <binding name="BasicHttpBinding_ILicense" />
        <binding name="LicenseService2Soap" openTimeout="0:10:0" closeTimeout="0:10:0" sendTimeout="0:10:0" receiveTimeout="0:10:0">
          <security mode="Transport">
          </security>
        </binding>
        <binding name="UpdateService2Soap" maxReceivedMessageSize="2147483647" openTimeout="0:10:0" closeTimeout="0:10:0" sendTimeout="0:10:0" receiveTimeout="0:10:0">
          <security mode="Transport">
            <transport clientCredentialType="Basic" proxyCredentialType="Basic" realm=""></transport>
            <message clientCredentialType="UserName"/>
          </security>
        </binding>
        <binding name="BasicHttpBinding_ILoginService" />
        <binding name="EvalWebServiceBinding">
          <security mode="Transport">
            <transport clientCredentialType="Basic" />
          </security>
        </binding>
      </basicHttpBinding>
    </bindings>
    <client>
      <endpoint name="LicenseService2Soap" address="https://coreservice.stg.api.paloaltonetworks.com/license/licenseservice2.asmx" xdt:Transform="SetAttributes" xdt:Locator="Match(name)"/>
      <endpoint name="UpdateService2Soap" address="http://licenseqa1.paloaltonetworks.com/updates/updateservice2.asmx" xdt:Transform="SetAttributes" xdt:Locator="Match(name)"/>
      <endpoint name="EvalWebService" address="https://cs211.salesforce.com/services/Soap/class/EvalWebService" xdt:Transform="SetAttributes" xdt:Locator="Match(name)"/>
      <endpoint name="BasicHttpBinding_ILicense" address="https://panservice.qa.sap.api.paloaltonetworks.com/License.svc" xdt:Transform="SetAttributes" xdt:Locator="Match(name)" />
    </client>
  </system.serviceModel>
</configuration>