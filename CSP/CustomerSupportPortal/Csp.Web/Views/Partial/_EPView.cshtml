                        <span aria-hidden="true" class="fa fa-search" />
                    </button>
                </div>
                <div class="grid-filter" id="@UniqueId.deviceCategoryDropDownDivId" style="display: none;">
                    @(Html.Kendo().DropDownList()
                            .Name((string)UniqueId.deviceCategoryFieldId)
                            .Events(events => events.Change("DeviceTagChangeHandler"))
                            .HtmlAttributes(new { @class = "grid-filter__date-input" })
                            .OptionLabel(Constants.DropDownPleaseSelect)
                            .DataValueField("DeviceCategoryId")
                            .DataTextField("DeviceCategoryName")
                            .BindTo(Model.AllDeviceCategories))
                </div>
            </div>
        </div>
</div>

<div class="grid-content">
    @{
        var maxPageSizeForms = (Model != null && Model.AvailableEps != null) ? Convert.ToInt32(Model.AvailableEps.ToList().Count) : 0;
        var pageSizeOptionsForms = new List<int> { 5, 10, 20, 50 };
        if (maxPageSizeForms > pageSizeOptionsForms.Max()) {
            pageSizeOptionsForms.Add(maxPageSizeForms);
        }

    }
    @(Html.Kendo().Grid(Model.AvailableEps)
          .Name((string)UniqueId.EpAuthCodesGrid)
          .Columns(cols =>
              {
                  cols.Bound(x => x.DivSerialNumber).Title("Serial Number").Width(100).ClientTemplate("#= kendoGridNewLines(DivSerialNumber) #");
                  cols.Bound(x => x.AuthorizationCode).Title("Auth Code").Width(100).ClientTemplate("#= kendoGridNewLines(AuthorizationCode) #");
                  cols.Bound(x => x.ELAAuthCode).Title("ELA Auth Code").Width(100).ClientTemplate("#= kendoGridNewLines(ELAAuthCode) #");
                  cols.Bound(x => x.Quantity).Title("Quantity").Width(100).ClientTemplate("#= kendoGridNewLines(Quantity) #");
                  cols.Bound(x => x.PartSubTypeName).Title("License").ClientTemplate("#= kendoGridNewLines(PartSubTypeName) #");
                  cols.Bound(x => x.DivExpirationDate).Title("Expiration Date").ClientTemplate("#= kendoGridNewLines(DivExpirationDate) #");
                  cols.Bound(x => x.ASCName).Title("ASC").Template(t => "<div class='AscContactInfo'></div>").ClientTemplate("<div class='AscContactInfo'></div>");
                  cols.Bound(x => x.Description).Title("Part Description").ClientTemplate("#= kendoGridNewLines(Description) #").Hidden(true);
                  cols.Bound(x => x.DeviceName).Title("Device Name").ClientTemplate("#= kendoGridNewLines(DeviceName) #");
                  cols.Bound(x => x.DeviceTag).Title("Device Tag").ClientTemplate("#= kendoGridNewLines(DeviceTag) #");
                  cols.Bound(x => x.Actions).Title("Actions/Software Download").ClientTemplate("#= kendoGridNewLines(Actions) #");
              })
          .Editable(x => x.Mode(GridEditMode.InLine))
          .Pageable(pageable => pageable.PageSizes(pageSizeOptionsForms.ToArray()))
          .Resizable(resize => resize.Columns(true))
          .Events(e => e.DataBound((string)UniqueId.EpGrid + "onDataBound"))
          .ToolBar(toolBar => {
                toolBar.Custom()
                .Text("Export To CSV")
                .HtmlAttributes(new { id = "export", data_link_type = "export-csv-assets" })
                .Url("javascript: exportTrapsToCsv();");
            })
          .DataSource(dataSource => dataSource
                                        .Ajax()
                                        .Total(Convert.ToInt32(Model.DataParameters.TotalRecordCount))
                                        .Model(model => {
                                                            model.Id(p => p.AuthorizationCode);
                                                            model.Field(f => f.DivSerialNumber).Editable(false);
                                                            model.Field(f => f.Quantity).Editable(false);
                                                            model.Field(f => f.Description).Editable(false);
                                                            model.Field(f => f.PartSubType).Editable(false);
                                                            model.Field(f => f.ShowLicenseKey).Editable(false);
