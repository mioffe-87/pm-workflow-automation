@using Csp.Api.Model
@using Csp.Api.Model.Enums
@model Csp.Web.DataTransferObjects.ReviewRequestDto
@using Csp.Web.DataTransferObjects;
@using Glimpse.Core.Extensions
@using Kendo.Mvc.UI
@using NotificationCategory = Csp.Api.Model.Enums.NotificationCategory


@{
    ViewBag.Title = "Review Device Transfer";
    if (ViewBag.options == "back")
    {
        ViewBag.IsGlobal = true;
    }
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<script>

    $(document).ready(function() {

       
        var category = $('#lblCateogry').text();
        var isDeviceTransfer = category.trim() === '@NotificationCategory.DeviceTransfer.ToDescription()';
        var isVMELAToken = category.trim() ===  '@NotificationCategory.VMELATokenGrant.ToDescription()';

        var deviceTransferList = @Model.DeviceTransferRequest.Count();
        var tokenGrantList = @Model.VmElaTokenRequest.Count();

        $('#divResult').hide();
        $('#divElaTokenGrants').hide();
        $('#divDeviceTransfers').hide();

        if (isDeviceTransfer)
            $('#divDeviceTransfers').show();
        else if (isVMELAToken) 
            $('#divElaTokenGrants').show();

        if (deviceTransferList === 0 && tokenGrantList === 0) {
            $('#lblMessage').text("The decision was already submitted and the request is no longer valid.");
            $('#divReview').hide();
            $('#divResult').show();
        }

    });

    function SubmitDecision(authcode, grantDate, isApproved, grantedBy, devicetransferId) {

        var category = $('#lblCateogry').text();
        var isDeviceTransfer = category.trim() === '@NotificationCategory.DeviceTransfer.ToDescription()';
        var isVMELAToken = category.trim() === '@NotificationCategory.VMELATokenGrant.ToDescription()';
        var notificationId = '@Model.NotificationId';

        var _postData = {
            "deviceTransferId": devicetransferId,
            "isApproved": isApproved,
            "SelectedEulaId": 3,
            "authCode": authcode,
            "grantDate": grantDate,
            "grantedBy": grantedBy,
            "category": category,
            "notificationId": notificationId
        };


        SupportPortal.BlockUI();

        var grid;

        if (isDeviceTransfer) {
            //set the grid
            grid = $('#PendingDeviceTransfers').data('kendoGrid');
        } else if (isVMELAToken) {
            grid = $('#ElaAcceptTokensGrant').data('kendoGrid');
        }

        console.log(JSON.stringify(_postData));

        $.ajax({
            type: "POST",
            url: '@Url.Action("Review", "Approve")',
            contentType: "application/json; charset=utf-8",
            data: JSON.stringify(_postData),
            headers: { "__RequestVerificationToken": $("input[name=__RequestVerificationToken]").val() }
        }).done(function(e) {
            
            if (e.Notifications) {
                var notificationType;
                switch (e.Notifications[0].State) {
                case 1:
                    notificationType = SupportPortal.NotificationType.Success;
                    break;
                case 2:
                    notificationType = SupportPortal.NotificationType.Information;
                    break;
                case 3:
                    notificationType = SupportPortal.NotificationType.Warning;
                    break;
                case 4:
                    notificationType = SupportPortal.NotificationType.Error;
                    break;

                default:
                    notificationType = SupportPortal.NotificationType.Error;
                    break;
                }

                $('#lblMessage').text(e.Notifications[0].Message);
                SupportPortal.Notification(e.Notifications[0].Message, notificationType);

            } else {
                $('#lblMessage').text("An error occured. Please contact support.");
                SupportPortal.Notification("An error occured. Please contact support.",
                    SupportPortal.NotificationType.Error);
            }

            if (isDeviceTransfer)
                grid.dataSource.data(e.DeviceTransferRequest);
            else if (isVMELAToken)
                grid.dataSource.data(e.VmElaTokenRequest);

            $('#divReview').hide();
            $('#divResult').show();

            SupportPortal.UnBlockUI();

        });
     
        
    }

    function OnAccept(e) {
        e.preventDefault ? e.preventDefault() : e.returnValue = false;
        var item = this.dataItem($(e.currentTarget).closest("tr"));
        SubmitDecision(item.AuthorizationCode, item.GrantDate, true, item.SourceUser, item.DeviceTransferId);
    }

    function OnReject(e) {
        e.preventDefault ? e.preventDefault() : e.returnValue = false;
        var item = this.dataItem($(e.currentTarget).closest("tr"));
        SubmitDecision(item.AuthorizationCode, item.GrantDate, false, item.SourceUser, item.DeviceTransferId);
    }

</script>


@{Html.RenderPartial("../Partial/_ResponseNotification", Model.Notifications);}
@Html.AntiForgeryToken()
<div id="divReview">
    @Html.Partial("../Partial/_Eula", Model.Eula)
    <br/>
    <fieldset>
        <div id="divDeviceTransfers">

            <legend>Device Transfers</legend>
            <div class="grid-content">
            @(Html.Kendo().Grid(Model.DeviceTransferRequest)
                  .Name("PendingDeviceTransfers")
                  .Columns(col =>
                  {
                      col.Bound(c => c.SerialNumber).Title("Serial Number").Width(130);
                      col.Bound(c => c.DeviceName).Title("Device Name").Width(130);
                      col.Bound(c => c.PartNumber).Title("Part Number").Width(110);
                      col.Bound(c => c.DeviceTransferBeginDate).Title("Transfer Start Date").Format("{0:MM/dd/yyyy}").Width(130);
                      col.Bound(c => c.FromUserDisplayName).Title("Source User").Width(110);
                      col.Command(command =>
                      {
                          command.Custom("Agree and Accept").Click("OnAccept");
                          command.Custom("Reject").Click("OnReject");
                      });
                  })
                  .DataSource(dataSource => dataSource
                      .Ajax()
                      .ServerOperation(false)
                      .Model(x => x.Id(id => id.DeviceTransferId))
                      .Events(e => e.RequestEnd("SupportPortal.kendoGridTimezoneToPst"))
                  )
                  .Sortable()
                  )
            </div>
        </div>
        <br/>        

        <div id="divElaTokenGrants">
            <legend>Review Tokens</legend>
            <div class="grid-content" >
            @(Html.Kendo().Grid(Model.VmElaTokenRequest)
                  .Name("ElaAcceptTokensGrant")
                  .DataSource(dataSource => dataSource
                      .Ajax()
                      .ServerOperation(false)
                  )
                  .Columns(columns =>
                  {
                      columns.Bound(p => p.AuthorizationCode).Title("Token Auth Code").Width(120);
                      columns.Bound(p => p.SupportAccountId).Title("Account ID").Width(75);
                      columns.Bound(p => p.AccountName).Title("Account Name");
                      columns.Bound(p => p.GrantDate).Title("Grant Date").ClientTemplate("#= kendo.toString(GrantDate,'MM/dd/yyyy') #").Width(75);
                      columns.Bound(p => p.SourceUser).Title("Source User").Width(130);
                      columns.Command(command =>
                      {
                          command.Custom("Agree and Accept").Click("OnAccept");
                          command.Custom("Reject").Click("OnReject");
                      }).Width(220);
                  })
                  )
            </div>
        </div>
        
        <label id="lblCateogry" style="display:none" >@Model.Category</label>
    </fieldset>
    
</div>

<div class="content" id="divResult" style="display:none">
    <div class="container" style="width: 850px;">
        <div class="page-title">
            <span id="Title" class="contextTitle" style="margin-left: 0px;">Review Request</span>
        </div>
        <div class="row-fluid">
            <div class="span12">
                <div class="row-fluid">
                    <div >
                            <label id="lblMessage" style="font-size: large"></label>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


