	EntityMapping mapping = (EntityMapping)_executingGenerator.ProjectDefinition.GetGroupableModelElementMapping(entity, _executingGenerator.DriverID);
	bool useCompositeKey = identifyingFields.Count > 1;
	IProjectElementMapTargetElement mappedTarget = mapping.MappedTarget;
	string discriminatorValueAttribute;
	string dynamicUpdateAttribute;
	string dynamicInsertAttribute;
	string lazyAttribute;
	string optimisticLockAttribute;
	ProduceClassMappingAttributesFromSettings(entity, currentProject, out discriminatorValueAttribute, out dynamicUpdateAttribute, out dynamicInsertAttribute,
												out lazyAttribute, out optimisticLockAttribute);
