@model Csp.Web.DataTransferObjects.AccountTypesDto
@using Kendo.Mvc.UI;

@{
    var actionHelper = Model.ActionHelper;
    Html.RenderPartial("../Partial/_ResponseNotification", Model.Notifications);
}

<script>
    $.validator.unobtrusive.parse("#AddUpdateAccountTypeForm");

    function onAdminRoleChange(e) {
        var dropDownval = $("#AdminRole").val();
        $("#AccountType_AdministrativeRole_Id").val(dropDownval);
    }

    function onClassificationChange(e) {
        var dropDownval = $("#Classification").val();
        $("#AccountType_Classification").val(dropDownval);
    }

    function GetAccountTypeId() {
        return { accountTypeId: $("#AccountType_Id").val() };
    }

    function SetAdminRoleChange() {
        var dropDownval = $("#AdminRole").val();
        $("#AccountType_AdministrativeRole_Id").val(dropDownval);
        alert($("#AccountType_AdministrativeRole_Id").val());
    }
</script>

<div id="AddUpdateAccountTypeDiv">

    @using (Ajax.BeginForm(actionHelper.AddUpdateAccountType, actionHelper.Controller, new AjaxOptions { UpdateTargetId = "AddUpdateAccountTypeDiv", OnBegin = "SupportPortal.BlockUI();", OnComplete = "SupportPortal.UnBlockUI();" }, new { id = "AddUpdateAccountTypeForm" })) {
        @Html.AntiForgeryToken()      
       
        @Html.HiddenFor(model => model.AccountType.Id)
        @Html.HiddenFor(model => model.AccountType.AdministrativeRole.Id)
        @Html.HiddenFor(model => model.AccountType.Classification)
       
        <div class="csp-content-sections-parent static-sized-content">
            <div class="horizontal-form-element">
                <div class="fieldset">
                    <fieldset>
                        <legend>Account Type Information</legend>

                        <div>
                            <div class="csp-label">
                                @Html.Label("Name: ")
                            </div>
                            <div class="csp-field">
                                @Html.ValidationMessageFor(model => model.AccountType.Name)
                                @Html.TextBoxFor(model => model.AccountType.Name, new { maxlength = 45 })
                                <span class="csp-required">*</span>
                            </div>
                        </div>

                        <div>
                            <div class="csp-label">
                                @Html.Label("Administrative Role: ")
                            </div>

                            <div class="csp-field">
                                @(Html.Kendo().DropDownList()
                                  .Name("AdminRole")
                                  .DataTextField("Key")
                                  .DataValueField("Value")
                                  .Events(e => e.Change("onAdminRoleChange"))
                                  .DataSource(source => source.Read(read => read.Action("GetAdmistrativeRoleForAccountType", "Admin").Data("GetAccountTypeId")))
                                  .Value(Model.AccountType.AdministrativeRole.Id.ToString())
                               )

                            </div>
                        </div>
                        <div>
                            <div class="csp-label">
                                @Html.Label("Classification: ")
                            </div>

                            <div class="csp-field">
                                @(Html.Kendo().DropDownList()
                                     .Name("Classification")
                                     .DataTextField("Text")
                                     .DataValueField("Value")
                                     .Events(e => e.Change("onClassificationChange"))
                                     .BindTo(new List<SelectListItem>() {
                                         new SelectListItem() {
                                             Text = "Default",
                                             Value = "Default"
                                         },
                                         new SelectListItem() {
                                             Text = "Administrative",
                                             Value = "Administrative"
                                         },
                                         new SelectListItem() {
                                             Text = "Support",
                                             Value = "Support"
                                         },
                                         new SelectListItem() {
                                             Text = "Global",
                                             Value = "Global"
                                         }
                                     })
                                     .Value(Model.AccountType.Classification.ToString())
                                     )
                            </div>
                        </div>
                        <div>
                            <div class="csp-label">
                                @Html.Label("Created On: ")
                            </div>
                            <div class="csp-field">
                                @Html.ValidationMessageFor(model => model.AccountType.CreatedOn)
                                @Html.TextBoxFor(model => Model.AccountType.CreatedOn, "{0:MM/dd/yyyy}", new { maxlength = 255, rows = 3, columns = 3 })
                            </div>
                        </div>
                        <div>
                            <div class="csp-label">
                                @Html.Label("Created By: ")
                            </div>
                            <div class="csp-field">
                                @Html.ValidationMessageFor(model => model.AccountType.CreatedByEmail)
                                @Html.TextBoxFor(model => Model.AccountType.CreatedByEmail, new { maxlength = 255, rows = 3, columns = 3 })
                            </div>
                        </div>
                    </fieldset>
                </div>
            </div>
            <div class="horizontal-form-element horizontal-form-element-right">
                <div class="fieldset" style="height: 100%">
                    <fieldset>
                        <legend>Assignable Roles <span class="csp-tooltip"><i class="icon-question-sign icon-large" onclick="SupportPortal.Help(this, 1);"></i></span></legend>
                        <div style="height: 150px; overflow-y: auto; overflow-x: hidden">
                            @Html.EditorFor(model => model.AssignableRoleAssignment)
                        </div>
                        <legend>Default Roles <span class="csp-tooltip"><i class="icon-question-sign icon-large" onclick="SupportPortal.Help(this, 1);"></i></span></legend>
                        <div style="height: 150px; overflow-y: auto; overflow-x: hidden">
                            @Html.EditorFor(model => model.DefaultRoleAssignment)
                        </div>
                    </fieldset>
                </div>

            </div>
            <br />
            <br />
            <br />
            <br />
            <br />
            <br />
            <br />
            <br />
            <br />
            <br />
            <br />
            <br />
        </div>
        <div class="csp-submit-container">
            <span class="csp-required-text"><span class="csp-required">*</span>@Constants.RequiredField</span>
            <input type="submit" value="Submit" onclick="SetAdminRoleChange();" class="k-button csp-submit" />
        </div>
    }

</div>
