	// Generate a Linq query for each typed list. 
	foreach(TypedListDefinition typedList in _executingGenerator.TypedLists.OrderBy(tl=>tl.Name))
	{
		var root = typedList.Root;
		if(root==null)
		{
			continue;
		}
		int currentSetCounter = 0;
%>		''' <summary>Gets the query to fetch the typed list <%=typedList.FullName%></summary>
		Public Function Get<%=typedList.Name%>TypedList() As IQueryable(Of <%=typedList.Name%>TypedListRow)
			Dim current<%=currentSetCounter%> = From v In Me.<%=SD_EF_GeneralUtils.GetCorrectContextMemberName(root.AliassedEntity, currentProject)%>
			
<%		bool currentSetIsJoinResult = false;
		int joinResultCounter = 0;
		var elementsThroughJoinResults = new HashSet<EntityAlias>();
		foreach(var chunkInfo in GeneratorUtils.GetLinqChunkInfosForTypedList(typedList))
		{
			bool startNewCurrentSet = true;
			foreach(var joinInfo in chunkInfo.JoinInfos)
			{
				bool leftSideDeclaredThisChunk = chunkInfo.EntityAliasses.Contains(joinInfo.LeftEntityAlias) && !elementsThroughJoinResults.Contains(joinInfo.LeftEntityAlias);
				bool rightSideDeclaredThisChunk = chunkInfo.EntityAliasses.Contains(joinInfo.RightEntityAlias) && !elementsThroughJoinResults.Contains(joinInfo.RightEntityAlias);
				string fromClauseSource = "current" + currentSetCounter;
				string joinClauseSource = "Me." + SD_EF_GeneralUtils.GetCorrectContextMemberName(joinInfo.RightEntityAlias, currentProject);
				string leftName = currentSetIsJoinResult && ! leftSideDeclaredThisChunk ?  "current_v" : joinInfo.LeftNameCamelCased;
				string rightName = joinInfo.RightNameCamelCased;
				string onClauseLeftSuffix = currentSetIsJoinResult && ! leftSideDeclaredThisChunk ? joinInfo.LeftNameCamelCased +"." : string.Empty;
				string onClauseRightSuffix = string.Empty;
				if(joinInfo.FetchFromClauseAsNew)
				{
					fromClauseSource = "Me." + SD_EF_GeneralUtils.GetCorrectContextMemberName(joinInfo.LeftEntityAlias, currentProject);
					joinClauseSource = "current" + currentSetCounter;
					leftName = joinInfo.LeftNameCamelCased;
					rightName = currentSetIsJoinResult && ! rightSideDeclaredThisChunk ?  "current_v" : joinInfo.RightNameCamelCased;
					onClauseLeftSuffix = string.Empty;
					onClauseRightSuffix = currentSetIsJoinResult && ! rightSideDeclaredThisChunk ? joinInfo.RightNameCamelCased + "." : string.Empty;
				}

				string leftOnClauseOperand = SD_EF_GeneralUtils.ProduceLinqOnClauseOperand(leftName, onClauseLeftSuffix, true, joinInfo, "New With {{{0}}}");
				string rightOnClauseOperand = SD_EF_GeneralUtils.ProduceLinqOnClauseOperand(rightName, onClauseRightSuffix, false, joinInfo, "New With {{{0}}}");
				
				if(startNewCurrentSet)
				{
					startNewCurrentSet = false;
					currentSetCounter++;
%>			Dim current<%=currentSetCounter%> = From <%=leftName%> In <%=fromClauseSource%> _
<%				}
				switch(joinInfo.HintForJoins)
				{
					case JoinHint.Left:
						joinResultCounter++;
%>						   Group Join <%=rightName%> In <%=joinClauseSource%> On <%=leftOnClauseOperand%> Equals <%=rightOnClauseOperand%> _
						   Into joinresult_<%=joinResultCounter%> = Group _
						   From <% if(currentSetIsJoinResult) {%><%=rightName%><%} else {%><%=joinInfo.RightNameCamelCased%><%}%> In joinresult_<%=joinResultCounter%>.DefaultIfEmpty() _
<%						break;
					case JoinHint.Cross:
%>						   From <%=joinInfo.RightNameCamelCased%> In Me.<%=SD_EF_GeneralUtils.GetCorrectContextMemberName(joinInfo.RightEntityAlias, currentProject)%> _
<%						break;
					default:
%>						   Join <%=joinInfo.RightNameCamelCased%> In Me.<%=SD_EF_GeneralUtils.GetCorrectContextMemberName(joinInfo.RightEntityAlias, currentProject)%> On <%=leftOnClauseOperand%> Equals <%=rightOnClauseOperand%> _
<%						break;
				}
			}
			// emit temporary projection for this intermediate query (currentSet)
			List<string> tempProjectionFragments = new List<string>();
			foreach(var alias in chunkInfo.EntityAliasses.Where(ea=>!elementsThroughJoinResults.Contains(ea)))
			{
				tempProjectionFragments.Add(GeneratorUtils.CamelCaseString(alias.NameForOutput));
			}
			foreach(var alias in elementsThroughJoinResults)
			{
				tempProjectionFragments.Add(string.Format("current_v.{0}", GeneratorUtils.CamelCaseString(alias.NameForOutput)));
			}
%>						   Select New With {<%=string.Join(", ", tempProjectionFragments.ToArray())%> }
<%
			elementsThroughJoinResults.AddRange(chunkInfo.EntityAliasses);
			currentSetIsJoinResult = true;
		}
		// emit final projection.
		List<string> finalProjectionFragments = new List<string>();
		foreach(var field in typedList.Fields)
		{
			string fieldPrefix = "v.";
			if(currentSetIsJoinResult)
			{
				fieldPrefix = string.Format("v.{0}.", GeneratorUtils.CamelCaseString(field.SourceEntityAlias.NameForOutput));
			}
			finalProjectionFragments.Add(string.Format(".{0} = {1}{2}", field.FieldAlias, fieldPrefix, field.MappedFieldAsString ));
		}
%>			Return current<%=currentSetCounter%>.Select(Function(v) New <%=typedList.Name%>TypedListRow() With { <%=string.Join(", ", finalProjectionFragments.ToArray())%> } )
		End Function
		
<%	}

	bool emitStoredProcCalls = ((currentProject.GetAllDriverIDsOfDatabasesWithMetaDataInProject().Count()==1) && ((_executingGenerator.RetrievalProcedures.Count + _executingGenerator.ActionProcedures.Count) > 0));
	if(emitStoredProcCalls)
	{
		foreach(SPCallDefinition spCall in _executingGenerator.RetrievalProcedures.OrderBy(sp=>sp.Name))
		{
			var mapping = currentProject.GetGroupableModelElementMapping(spCall, _executingGenerator.DriverID);
			var parameterMappings = GeneratorUtils.GetStoredProcedureParameterMappingsToWalk(false, false, spCall, _executingGenerator);
			List<string> parameterDeclarations = ProduceSPCallParameterDeclarations(parameterMappings, spCall);
			DBStoredProcedure targetProc = (DBStoredProcedure)mapping.MappedTarget;
			string returnType = (targetProc.NumberOfResultsets>1) ? "DataSet" : "DataTable";
			string storedProcedureToCall = SD_EF_GeneralUtils.ProduceTargetFullName(targetProc, _executingGenerator);
%>		''' <summary>Calls the stored procedure '<%=storedProcedureToCall%>' and returns its results in a single <%=returnType%></summary>
<%			foreach(var parameterMapping in parameterMappings)
			{
%>		''' <param name="<%=GeneratorUtils.CamelCaseString(parameterMapping.MappedFieldName)%>">Parameter mapped onto the stored procedure parameter '<%=parameterMapping.MappedTarget.FieldName%>'</param>
<%			}
%>		''' <returns>A single <%=returnType%> with all result data returned by the called stored procedure</returns>
<%			if(spCall.OutputSettingValues.CustomProperties.Count>0)
			{
%>		''' <remarks>Custom Properties: <br/>
<%				foreach(var kvp in spCall.OutputSettingValues.CustomProperties)
				{
%>		''' <%=kvp.Key%>: <%=kvp.Value%><br/>
<%				}
%>		''' </remarks>
<%			}
%>		Public Function Get<%=spCall.Name%>Results(<%=string.Join(", ", parameterDeclarations.ToArray())%>) As <%=returnType%> 
			Dim cmd As DbCommand = CreateStoredProcCallCommand("<%=storedProcedureToCall%>", False)
<%			foreach(var parameterMapping in parameterMappings)
			{
				var targetParameter = (DBStoredProcedureParameter)parameterMapping.MappedTarget;
%>			AddParameter(cmd, "<%=targetParameter.ParameterName%>", <%=targetParameter.TypeDefinition.Length%>, ParameterDirection.<%=targetParameter.Direction%>, <%=GeneratorUtils.CamelCaseString(parameterMapping.MappedFieldName)%>)
<%			}
%>			Dim toReturn As New <%=returnType%>()
			CreateAndSetupAdapter(cmd).Fill(toReturn)
<%			foreach(var parameterMapping in parameterMappings.Where(pm=>pm.MappedTarget.Direction!=ParameterDirection.Input))
			{
%>			<%=GeneratorUtils.CamelCaseString(parameterMapping.MappedFieldName)%> = CType(cmd.Parameters(<%=parameterMapping.MappedTarget.OrdinalPosition-1%>).Value, <%=SD_EF_GeneralUtils.ProduceDotNetTypeName((IFieldElementCore)parameterMapping.MappedFieldInstance, _executingGenerator, "Nullable(Of {0})")%>)
<%			}
%>			Return toReturn
		End Function
		
<%		}

		foreach(SPCallDefinition spCall in _executingGenerator.ActionProcedures.OrderBy(sp=>sp.Name))
		{
			var mapping = currentProject.GetGroupableModelElementMapping(spCall, _executingGenerator.DriverID);
			var parameterMappings = GeneratorUtils.GetStoredProcedureParameterMappingsToWalk(false, false, spCall, _executingGenerator);
			List<string> parameterDeclarations = ProduceSPCallParameterDeclarations(parameterMappings, spCall);
			DBStoredProcedure targetProc = (DBStoredProcedure)mapping.MappedTarget;
			string storedProcedureToCall = SD_EF_GeneralUtils.ProduceTargetFullName(targetProc, _executingGenerator);
%>		''' <summary>Calls the stored procedure '<%=storedProcedureToCall%>'</summary>
<%			foreach(var parameterMapping in parameterMappings)
			{
%>		''' <param name="<%=GeneratorUtils.CamelCaseString(parameterMapping.MappedFieldName)%>">Parameter mapped onto the stored procedure parameter '<%=parameterMapping.MappedTarget.FieldName%>'</param>
<%			}
%>		''' <returns>The number of rows affected, as reported by ADO.NET</returns>
<%			if(spCall.OutputSettingValues.CustomProperties.Count>0)
			{
%>		''' <remarks>Custom Properties: <br/>
<%				foreach(var kvp in spCall.OutputSettingValues.CustomProperties)
				{
%>		''' <%=kvp.Key%>: <%=kvp.Value%><br/>
<%				}
%>		''' </remarks>
<%			}
%>		Public Function Call<%=spCall.Name%>(<%=string.Join(", ", parameterDeclarations.ToArray())%>) As Integer
			Dim cmd As DbCommand = CreateStoredProcCallCommand("<%=storedProcedureToCall%>", True)
<%			foreach(var parameterMapping in parameterMappings)
			{
				var targetParameter = (DBStoredProcedureParameter)parameterMapping.MappedTarget;
%>			AddParameter(cmd, "<%=targetParameter.ParameterName%>", <%=targetParameter.TypeDefinition.Length%>, ParameterDirection.<%=targetParameter.Direction%>, <%=GeneratorUtils.CamelCaseString(parameterMapping.MappedFieldName)%>)
<%			}
%>			Dim toReturn As Integer = ExecuteNonQueryCommand(cmd)
<%			foreach(var parameterMapping in parameterMappings.Where(pm=>pm.MappedTarget.Direction!=ParameterDirection.Input))
			{
%>			<%=GeneratorUtils.CamelCaseString(parameterMapping.MappedFieldName)%> = CType(cmd.Parameters(<%=parameterMapping.MappedTarget.OrdinalPosition-1%>).Value, <%=SD_EF_GeneralUtils.ProduceDotNetTypeName((IFieldElementCore)parameterMapping.MappedFieldInstance, _executingGenerator, "Nullable(Of {0})")%>)
<%			}
%>			Return toReturn
		End Function
		
<%		}
	}

	if(useEFSpecificProcCalls)
	{
		var spResultsetMappingInfos = GeneratorUtils.GetAllSPResultsetMappingInfos(_executingGenerator);
		bool procCallEmitted = false;
		foreach(var spResultsetInfo in spResultsetMappingInfos)
		{
			DBStoredProcedure targetProc = spResultsetInfo.StoredProcedureDefinition;
			foreach(var mappingCombination in spResultsetInfo.GetAllDifferentMappingCombinationsOnResultsets())
			{
				// EF can only deal with 1 resultset per proc call
				var typedViewMapped = mappingCombination.Select(tvm=>tvm.MappedElement).FirstOrDefault() as TypedViewDefinition;
				if(typedViewMapped==null)
				{
					continue;
				}
				string methodName = string.Format("Get{0}TypedView", typedViewMapped.Name);
				List<string> parameterDeclarations = new List<string>();
				List<string> parameterNames = new List<string>();
				Dictionary<string, DBStoredProcedureParameter> parameters = new Dictionary<string, DBStoredProcedureParameter>();
				var realParameterNames = new Dictionary<string, string>();
				foreach(var parameterInfo in targetProc.Parameters.OrderBy(pi=>pi.Key))
				{
					string realParameterName = CoreUtils.MakeCLSCompliantName(parameterInfo.Value.ParameterName, null, false, false, false);
					string parameterName = GeneratorUtils.CamelCaseString(realParameterName);
					realParameterNames.Add(parameterName, realParameterName);
					string refKeyword = (parameterInfo.Value.Direction==ParameterDirection.Input) ? string.Empty : "ByRef ";
					parameterDeclarations.Add(string.Format("{0} {1} As {2}", refKeyword, parameterName, 
								GeneratorUtils.ProduceDotNetTypeName(parameterInfo.Value.TypeDefinition.DBTypeAsNETType, true, "Nullable(Of {0})")));
					parameters.Add(parameterName, parameterInfo.Value);
					parameterNames.Add(parameterName);
				}
%>		''' <summary>Calls the stored procedure '<%=targetProc.FullNameWithCatalog%>' and fills the typedview: '<%=typedViewMapped.FullName%>'</summary>
<%				foreach(var kvp in parameters)
				{
%>		''' <param name="<%=kvp.Key%>">Parameter mapped onto the stored procedure parameter '<%=kvp.Value.FieldName%>'</param>
<%				}
%>		''' <returns>A single result object which contains the filled typedview '<%=typedViewMapped.FullName%>'</returns>
		Public Function <%=methodName%>(<%=string.Join(", ", parameterDeclarations.ToArray())%>) As ObjectResult(Of <%=typedViewMapped.Name%>TypedViewRow)
<%				if(isForDbContextAPI)
				{
%>			CType(Me, IObjectContextAdapter).ObjectContext.MetadataWorkspace.LoadFromAssembly(GetType(<%=typedViewMapped.Name%>TypedViewRow).Assembly)
<%				}
				
				foreach(var kvp in parameters)
				{
%>			Dim <%=kvp.Key%>Param As ObjectParameter = CreateObjectParameter("<%=realParameterNames.GetValue(kvp.Key)%>", <%=kvp.Key%>, GetType(<%=kvp.Value.TypeDefinition.DBTypeAsNETType%>))
<%				}
%>			Dim toReturn As ObjectResult(Of <%=typedViewMapped.Name%>TypedViewRow)= <% if(isForDbContextAPI) { %>CType(Me, IObjectContextAdapter).ObjectContext<% } else { %>Me<% }%>.ExecuteFunction(Of <%=typedViewMapped.Name%>TypedViewRow)("<%=methodName%>"<% if(parameterNames.Count>0) {%>, <%=string.Join(", ", parameterNames.Select(n=>n+"Param").ToArray())%><%}%>)
<%				foreach(var kvp in parameters.Where(v=>v.Value.Direction!=ParameterDirection.Input))
				{
%>			<%=kvp.Key%> = CType(<%=kvp.Key%>Param.Value, <%=GeneratorUtils.ProduceDotNetTypeName(kvp.Value.TypeDefinition.DBTypeAsNETType, true, "Nullable(Of {0})")%>)
<%				}
%>			Return toReturn
		End Function
		
<%				procCallEmitted = true;
			}
		}
		
		if(procCallEmitted)
		{
%>		''' <summary>Creates a new ObjectParameter from the values specified to be used for a stored proc call</summary>
		''' <param name="name">Name of the parameter</param>
		''' <param name="value">Value of the parameter</param>
		''' <param name="parameterType">Type of the parameter</param>
		''' <returns>ready to use ObjectParameter</returns>
		Private Shared Function CreateObjectParameter(name As String, value As Object, parameterType As Type) As ObjectParameter 
			Return IIf(value Is Nothing, New ObjectParameter(name, parameterType), New ObjectParameter(name, value))
		End Function
		
<%		}
	}

	foreach(var tvfMappingPair in GeneratorUtils.GetAllTvfCallMappingsInScope(_executingGenerator, _executingGenerator.DriverID))
	{
		var tvfCallMapping = tvfMappingPair.Value1 as TvfCallMapping;
		var tvfCall = tvfCallMapping.MappedTvfCall;
		var returnElementMapping = tvfMappingPair.Value2;
		string codeElementSuffix = (returnElementMapping.MappedElement is TypedViewDefinition) ? "TypedViewRow" : string.Empty;
		string returnElementName = returnElementMapping.MappedElement.Name + codeElementSuffix;
%>		''' <summary>Method which represents a call to the table-valued function '<%=tvfCallMapping.MappedTarget.FullName%>'.</summary>
<%		if(tvfCall.OutputSettingValues.CustomProperties.Count>0)
		{
%>		''' <remarks>Custom Properties: <br/>
<%			foreach(var kvp in tvfCall.OutputSettingValues.CustomProperties)
			{
%>		''' <%=kvp.Key%>: <%=kvp.Value%><br/>
<%			}
%>		''' </remarks>
<%		}
		var parameterDeclarations = new List<string>();
		var parameterNames = new List<string>();
		var parameterInstantiations = new List<string>();
		var targetParameterNames = new List<string>();
		foreach(var parameterMapping in tvfCallMapping.FieldMappings.OrderBy(fm=>fm.MappedTarget.OrdinalPosition))
		{
			targetParameterNames.Add(parameterMapping.MappedTarget.FieldName);
			var mappedParameter = parameterMapping.MappedFieldInstance as TvfCallParameterDefinition;
			string parameterNameCamelCased = GeneratorUtils.CamelCaseString(mappedParameter.Name);
			parameterNames.Add(parameterNameCamelCased + "Parameter");
			string netType = GeneratorUtils.GetDotNetTypeAsString(mappedParameter.FieldType.RepresentedType, _executingGenerator, "Nullable(Of {0})", mappedParameter.IsOptional);
			parameterDeclarations.Add(string.Format("{0} As {1}", parameterNameCamelCased, netType));
			if(mappedParameter.FieldType.RepresentedType.IsValueType)
			{
				parameterInstantiations.Add(string.Format("Dim {0}Parameter As New ObjectParameter(\"{0}\", {0})", parameterNameCamelCased));
			}
			else
			{
				parameterInstantiations.Add(string.Format("Dim {0}Parameter As ObjectParameter = IIf(({0} Is Nothing), New ObjectParameter(\"{0}\", GetType({1})), New ObjectParameter(\"{0}\", {0}))", parameterNameCamelCased, netType));
			}
%>		''' <param name="<%=parameterNameCamelCased%>">parameter of the TVF</param>
<%		}
%>		''' <returns>IQueryable&lt;<%=returnElementName%>&gt;</returns>
		<EdmFunction("<%=_executingGenerator.ActiveSourceElementsContainerName%>Entities", "<%=tvfCall.Name%>")> _
        Public Overridable Function <%=tvfCall.Name%>(<%=string.Join(", ", parameterDeclarations.ToArray())%>) As IQueryable(Of <%=returnElementName%>)
<%		foreach(var parameterInstantiation in parameterInstantiations)
		{
%>			<%=parameterInstantiation%>		
<%		}
%>			Return CType(Me, IObjectContextAdapter).ObjectContext.CreateQuery(Of <%=returnElementName%>)("[<%=_executingGenerator.ActiveSourceElementsContainerName%>Entities].[<%=tvfCall.Name%>](<%=string.Join(", ", targetParameterNames.ToArray())%>)"<%if(parameterNames.Count>0) {%>, <%=string.Join(", ", parameterNames.ToArray())%><% } %>)
        End Function

<%	}

	if(emitStoredProcCalls)
	{
%>		''' <summary>Executes the passed in command</summary>
		''' <param name="cmd">command to execute</param>
		''' <returns>Value returned by ExecuteNonQuery</returns>
		Private Function ExecuteNonQueryCommand(cmd As DbCommand) As Integer
			Dim connectionToUse = GetConnection()
			Dim closeLocally As Boolean = connectionToUse.State=ConnectionState.Open
			Dim toReturn As Integer = cmd.ExecuteNonQuery()
			If closeLocally Then
				connectionToUse.Close()
			End If
			Return toReturn
		End Function

		''' <summary>Creates a new DbDataAdapter and assigns the passed in command as the select command</summary>
		''' <param name="selectCommand">The select command to use with the adapter</param>
		''' <returns>created and setup DbDataAdapter</returns>
		Private Function CreateAndSetupAdapter(selectCommand As DbCommand) As DbDataAdapter
			Dim adapter As DbDataAdapter = _factoryToUse.CreateDataAdapter()
			adapter.SelectCommand = selectCommand
			Return adapter
		End Function

		''' <summary>Sets up the command specified. It wires it to the current connection and transaction, sets command timeout and if requested, it also opens the command</summary>
		''' <param name="toSetup">The command to setup</param>
		''' <param name="openConnection">If set to true, the connection is also opened if it's not already open, otherwise it's left as-is</param>
		''' <returns>The passed in DbCommand</returns>
		Private Function SetupCommand(toSetup As DbCommand, openConnection As Boolean) As DbCommand 
			If toSetup Is Nothing Then
				Return toSetup
			End If
			toSetup.Connection = GetConnection()
			Dim commandTimeOutValue = <% if(isForDbContextAPI) { %>CType(Me, IObjectContextAdapter).ObjectContext<% } else {%>Me<%}%>.CommandTimeout
			toSetup.CommandTimeout = IIf(commandTimeOutValue Is Nothing, 0, commandTimeOutValue)
			If (Not (toSetup.Connection Is Nothing)) AndAlso openConnection AndAlso (toSetup.Connection.State<>ConnectionState.Open) Then
				toSetup.Connection.Open()
			End If
			Return toSetup
		End Function
				        
		''' <summary>Creates a new stored procedure call command and sets it up to make it ready to use.</summary>
		''' <param name="storedProcedureToCall">The stored procedure to call.</param>
		''' <param name="openConnection">If set to true, the connection is also opened if it's not already open, otherwise it's left as-is</param>
		''' <returns>ready to use command</returns>
		Private Function CreateStoredProcCallCommand(storedProcedureToCall As String, openConnection As Boolean) As DbCommand
			Dim cmd As DbCommand = _factoryToUse.CreateCommand()
			cmd.CommandType = CommandType.StoredProcedure
			cmd.CommandText = storedProcedureToCall
			Return SetupCommand(cmd, openConnection)
		End Function
 		
		''' <summary>Obtains the live DbConnection used by this context</summary>
		''' <returns>Live DbConnection used by this context</returns>
		Private Function GetConnection() As DbConnection 
<%		if(isForDbContextAPI)
		{
%>			Return CType(CType(Me, IObjectContextAdapter).ObjectContext.Connection, EntityConnection).StoreConnection
<%		}
		else
		{
%>			Return CType(Me.Connection, EntityConnection).StoreConnection
<%		}
%>		End Function
 		
		''' <summary>Adds a new parameter created from the input specified to the command specified</summary>
		''' <param name="cmd">The command to add the new parameter to</param>
		''' <param name="parameterName">Name of the parameter.</param>
		''' <param name="length">The length.</param>
		''' <param name="direction">The direction.</param>
		''' <param name="value">The value for the parameter</param>
		Private Shared Sub AddParameter(cmd As DbCommand, parameterName As String, length As Integer, direction As ParameterDirection, value As Object)
			Dim dummyParam As New EntityParameter() With { .Value = value }
			Dim parameter As DbParameter = cmd.CreateParameter()
			parameter.ParameterName = parameterName
			parameter.Direction = direction
			parameter.Size = length
			parameter.Value = value
			parameter.DbType = dummyParam.DbType
			cmd.Parameters.Add(parameter)
		End Sub
		
<%	}
%>		''' <summary>Initializes this instance</summary>
		Private Sub Initialize()
<%	string optionsPropertyName = isForDbContextAPI ? "Configuration" : "ContextOptions";
	if(enableLazyLoadingOnContext)
	{
%>			Me.<%=optionsPropertyName%>.LazyLoadingEnabled = True
<%	}
	if(enableProxyCreationOnContextForPOCO)
	{
%>			Me.<%=optionsPropertyName%>.ProxyCreationEnabled = True
<%	}
	if(isForSelfTrackingEntities)
	{
%>			AddHandler Me.ObjectMaterialized, AddressOf HandleObjectMaterialized
<%	}
%>			OnContextCreated()
		End Sub
		
<%	if(isForSelfTrackingEntities)
	{
%>		''' <summary>Handles the ObjectMaterialized event for cleaning up change trackers</summary>
		''' <param name="sender">The sender of the event</param>
		''' <param name="e">The event arguments</param>
		Private Sub HandleObjectMaterialized(sender As Object, e As ObjectMaterializedEventArgs)
			Dim entity As IObjectWithChangeTracker = TryCast(e.Entity, IObjectWithChangeTracker)
			If Not entity Is Nothing Then
				Dim changeTrackingEnabledSave As Boolean = entity.ChangeTracker.ChangeTrackingEnabled
				Try
					entity.MarkAsUnchanged()
				Finally
					entity.ChangeTracker.ChangeTrackingEnabled = changeTrackingEnabledSave
				End Try
				Me.StoreReferenceKeyValues(entity)
			End If
		End Sub
<%	}
%><# SD_EF_CustomContextInclude #>
#Region "Class Property Declarations"
<%	foreach(EntityDefinition entity in _executingGenerator.Entities.Where(e=>!e.IsSubType && !e.IsPureManyToManyIntermediate).OrderBy(e=>e.Name))
	{
%>		''' <summary>Gets an object query for the entity set '<%=entity.Name%>', containing entity type '<%=entity.Name%>'<% if(entity.InheritanceType!=InheritanceHierarchyType.None) {%> and all sub types of this entity type.<%}%></summary>
		Public <% if(!isForDbContextAPI) { %>ReadOnly<%}%> Property <%=GeneratorUtils.PluralizeString(entity.Name)%> As <%=entitySetType%>(Of <%=entity.Name%>)
<%		if(!isForDbContextAPI)
		{
%>			Get 
				If _<%=GeneratorUtils.CamelCaseString(entity.Name)%> Is Nothing Then
<% 		if(useObjectSet)
		{
%>					_<%=GeneratorUtils.CamelCaseString(entity.Name)%> = Me.CreateObjectSet(Of <%=entity.Name%>)("<%=entity.Name%>")
<%		}
		else
		{
%>					_<%=GeneratorUtils.CamelCaseString(entity.Name)%> = Me.CreateQuery(Of <%=entity.Name%>)("[<%=entity.Name%>]")
<%		}
%>				End If
				Return _<%=GeneratorUtils.CamelCaseString(entity.Name)%>
			End Get
		End Property
		
<%		}
	} 
%>#End Region
	End Class
End Namespace

<~
	// produces the parameter declarations for the .net method to generate for a call to the proc specified.
	private List<string> ProduceSPCallParameterDeclarations(IEnumerable<FieldMapping> parameterMappings, SPCallDefinition spCall)
	{
		List<string> parameterDeclarations = new List<string>();
		foreach(var parameterMapping in parameterMappings)
		{
			var spCallParameter = (FieldElement)parameterMapping.MappedFieldInstance;
			string refKeyword = (spCallParameter.Direction==ParameterDirection.Input) ? string.Empty : "ByRef ";
			parameterDeclarations.Add(string.Format("{0} {1} As {2}", refKeyword, GeneratorUtils.CamelCaseString(spCallParameter.Name), 
											SD_EF_GeneralUtils.ProduceDotNetTypeName(spCallParameter, _executingGenerator, "Nullable(Of {0})")));
		}
		return parameterDeclarations;
	}
~>
