    var @(UniqueId.devices)deviceButtons = (function () {

        function openAddDeviceToGroupWindow() {
            var isProductionDeviceList = '@Model.IsProductionDeviceList';
            var addDeviceToGroupTitle = (isProductionDeviceList.toLowerCase() === "true") ? "Add Device to Group" : "Add Spare to Group";
            var direction = "/@ControllerFields.DeviceController/@actionHelper.AddDeviceToGroup?groupId=@actionHelper.Id&isProd=@Model.IsProductionDeviceList";
            var window = $("#@UniqueId.addDeviceToGroupWindowId").data("kendoWindow");
            window.content(" ");
            window.setOptions({
                minWidth: 400,
                minHeight: 110
            });
            window.bind('open', onOpenAddDeviceGroupWindow);
            window.bind('close', onCloseAddDeviceGroupWindow);
            window.title(addDeviceToGroupTitle);
            window.refresh();
            window.refresh(direction);
            window.open();
            window.center();
        }

        function onOpenAddDeviceGroupWindow() {
            SupportPortal.OnWindowOpen("@UniqueId.addDeviceToGroupWindowId");
        }

        function onCloseAddDeviceGroupWindow() {
            var window = $("#@UniqueId.addDeviceToGroupWindowId").data("kendoWindow");
            window.content("");
            window.refresh();

            SupportPortal.OnWindowClose(deviceGridId);
        }

        function openDeviceTypeWindow() {
            var direction = "/@ControllerFields.DeviceController/@actionHelper.DeviceType";           
            if (@groupId > 0) {
                direction = direction + "?id=" + @supportAccountId + "&groupId=" + @groupId;
            } else {
                direction = direction + "?id=" + @supportAccountId;
            }            
            var window = $("#@UniqueId.deviceTypeWindowId").data("kendoWindow");
            window.content(SupportPortal.AjaxLoadingMessage());
            window.setOptions({
                minHeight: 220,
                animation: {
                    open: {
                        effects: "slideIn:down fadeIn",
                        duration: 500
                    }, close: {
                        effects: "fadeOut",
                        duration: 300
                    }
                }
            });
            window.title("Device Type");
            window.refresh();
            window.refresh(direction);
            window.open();
            window.center();
        }

       function openRegisterDeviceWindow() {
            var deviceType = $("#hdnDeviceType").val();
            var cloudType = $("#hdnCloudType").val();
            var direction = "/@ControllerFields.DeviceController/@actionHelper.RegisterDevice";

            if (@groupId > 0) {
                direction = direction + "?id=" + @supportAccountId + "&groupId=" + @groupId;
            } else {
                direction = direction + "?id=" + @supportAccountId;
            }

            if (deviceType == 2) {
                direction = "/@ControllerFields.DeviceController/@actionHelper.RegisterDevice?id=@actionHelper.Id&isCloudDevice=true&cloudType="+cloudType;
            }
            var window = $("#@UniqueId.registerDeviceWindowId").data("kendoWindow");
            window.content(" ");
            window.setOptions({
                minHeight: 500,
                position: {
                    top: 100, // or "100px"
                    left: "27%"
                },
                animation: {
                    open: {
                        effects: "slideIn:down fadeIn",
                        duration: 500
                    }, close: {
                        effects: "fadeOut",
                        duration: 300
                    }
                }
            });
            window.bind('open', onOpenRegisterDeviceWindow);
            window.bind('close', onCloseRegisterDeviceWindow);
            window.title("Device Registration");
            window.refresh();
            window.refresh(direction);
            window.open();
            window.center();
        }

        function onOpenRegisterDeviceWindow() {
            SupportPortal.OnWindowOpen("@UniqueId.registerDeviceWindowId");
        }

        function onCloseRegisterDeviceWindow() {
            var window = $("#@UniqueId.registerDeviceWindowId").data("kendoWindow");
            window.content("");
            window.refresh();

            SupportPortal.OnWindowClose(deviceGridId);
        }



        function openDeviceTransferWindow() {
            var direction = "/DeviceTransfer/ReviewTransfers";
            var window = $("#@UniqueId.ReviewDeviceTransfersWindow").data("kendoWindow");
            window.content(" ");
            window.setOptions({
                minWidth: "70%",
                minHeight: 500
