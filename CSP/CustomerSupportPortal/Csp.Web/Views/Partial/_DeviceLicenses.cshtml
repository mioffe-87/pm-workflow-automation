@if (Model.WF500Keys.Any())
{

    var maxPageSizeForms = Convert.ToInt32(Model.WF500Keys.Count);
    var pageSizeOptionsForms = new List<int> { 5, 10, 20, 50 };

    if (maxPageSizeForms > pageSizeOptionsForms.Max())
    {
        pageSizeOptionsForms.Add(maxPageSizeForms);
    }
                   
                    
    <fieldset>
        <legend>Microsoft License Keys</legend>

        <div style="overflow-y: auto; overflow-x: hidden">
            @(Html.Kendo().Grid(Model.WF500Keys)
                            .Name((string)UniqueId.wfGrid)
                            .Columns(columns =>
                            {
                                columns.Bound(model => model.LicenseType).Sortable(true).Visible(false);
                                columns.Bound(model => model.LicenseKey).Sortable(true).Visible(false);
                            })
                            .Pageable(pageable => pageable.PageSizes(pageSizeOptionsForms.ToArray()))
                            .Sortable()
                            .Resizable(resize => resize.Columns(true))
                            .HtmlAttributes(new { style = "max-height:400px; max-width:535px;" })
                            .DataSource(dataSource => dataSource
                            .Ajax()
                            .Total(Model.WF500Keys.Count)
                            .Model(model => model.Id(p => p.LicenseKey))
                            .PageSize(50)
                            .ServerOperation(false)
                            ))

        </div>
    </fieldset>
}

<div class="fieldset" id="divActivateLicenses">
    <div class="dns-alert innernotification">To activate the license feature for DNS Security, the OS version for the firewall must be 9.0 or above and have a valid Threat Prevention license.</div>
    <div id="ngfw-dlp-license-activation" class="dns-alert innernotification hide">Activation of DLP Subscription will require a support ticket to do NGFW device transfer.</div>
    <div id="iot-max-reached-message" class="dns-alert innernotification hide">You have activated/requested the five allowed trial licenses for the IOT Security Subscription.</div>
    <div id="iot-cdl-required-message" class="dns-alert innernotification hide">IOT Subscription requires Cortex Data Lake. Please contact your Palo Alto Networks representative for details and options.</div>
    <div id="saas-inline-max-reached-message" class="dns-alert innernotification hide">You have activated/requested the five allowed trial licenses for the SaaS Security Inline Subscription.</div>
    <div id="saas-inline-cdl-required-message" class="dns-alert innernotification hide">SaaS Security Inline Subscription requires Data Lake. Please contact your Palo Alto Networks representative for details and options.</div>
    <fieldset>
        <legend>Activate Licenses</legend>
        <ul class="list-style-none">
            <li>
                <label style="cursor: pointer;">
                    <input type="radio" name="LicenseActivation" value="AuthCode"/>
                    <span>Activate Auth-Code</span>
                </label>
            </li>
            @if (Model.DeviceLicenseMode != DeviceLicenseMode.None)
            {

                var trialNfr = Model.DeviceLicenseMode == DeviceLicenseMode.Trial ? "Trial" : "Evaluation";
                <li>
                    <label style="cursor: pointer;">
                        <input type="radio" name="LicenseActivation" value="TrialNfr"/>
                        <span>Activate @trialNfr License</span>
                    </label>
                </li>
            }
            @if (Model.IsEligibleForFeatureLicense)
            {
                <li id="@UniqueId.FeatureLicense_li">
                    <label style="cursor: pointer;">
                        <input type="radio" name="LicenseActivation" value="Feature" id="@UniqueId.FeatureCheckbox"/>
                        <span>
                            Activate Feature License
                        </span>
                    </label>
                </li>
            }

            @if (Model.Device.IsEligibleForUpgrade)
            {
                <li>
                    <label style="cursor: pointer;">
                        <input type="radio" name="LicenseActivation" value="Upgrade"/>
                        <span>Activate Upgrade License</span>
                    </label>
                </li>
            }

            @if (Model.IsEligibleForPanoramaLicense)
            {
                <li id="@UniqueId.PanoramaLicense_li">
                    <label style="cursor: pointer;">
                        <input type="radio" name="LicenseActivation" value="Panorama" id="@UniqueId.PanoramLicenseActivation"/>
                        <span>Is the Panorama Offline?</span>
                    </label>
                    <div id="@UniqueId.PanoramaDiv">
                        <div>
                            <div class="csp-label" style="width: 200px;">
                                @Html.LabelFor(model => model.VMRegistrationDto.PanOsVersion, "OS Release:")
                            </div>
                            <div class="csp-field">
                                @Html.ValidationMessageFor(model => model.VMRegistrationDto.PanOsVersion)
                                @(Html.Kendo().DropDownListFor(model => model.VMRegistrationDto.PanOsVersion)
                                      .HtmlAttributes(new {@class = "k-dropdown", id = UniqueId.OsDropDown})
                                      .OptionLabel(Constants.DropDownOsReleaseSelect)
                                      .DataValueField("PanOsVersion")
                                      .DataTextField("PanOsVersion")
                                      .Events(e => e.Select("OnPanOsSelectedItem"))
                                      .DataSource(source => source.Read(read => { read.Action("GetPanOsVersions", "Device"); })))
                                <span class="csp-required">*</span>
                            </div>
                        </div>
                        <div id="@UniqueId.PanoramaUuidDiv">
                            <div>
                                <div class="csp-label" style="width: 200px;">
                                    @Html.LabelFor(model => model.VMRegistrationDto.HyperVisorVersion, "Virtual Platform:")
                                </div>
                                <div class="csp-field">
                                    @Html.ValidationMessageFor(model => model.VMRegistrationDto.HyperVisorVersion)
                                    @(Html.Kendo().DropDownListFor(model => model.VMRegistrationDto.HyperVisorVersion)
                                          .OptionLabel(Constants.DropDownVirtualPlatformSelect)
                                          .HtmlAttributes(new {@class = "k-dropdown", id = UniqueId.HyperVisorDropDown})
                                          .DataValueField("HyperVisorVersion")
                                          .DataTextField("DisplayValue")
                                          .DataSource(source => source.Read(read => read.Action("GetHyperVisorVersions", "Device", new {filter = "VM"})))
                                          )
                                    <span class="csp-required">*</span>
                                </div>
                            </div>
                            <div>
                                <div class="csp-label" style="width: 200px;">
                                    @Html.Label("UploadUUIDCPUID", "Upload File for UUID & CPUID:")
                                </div>
                                <div class="csp-field">
                                    @(Html.Kendo().Upload()
                                          .Name("uploadUuIdCpuId")
                                          .Multiple(false)
                                          .Async(async => async.Save("RegisterVmFile", "VM"))
                                          .Events(e => e.Success("uploadSuccess")))
