		<keyword name="byteKeyword" value="(byte)"/>
		<keyword name="int16Keyword" value="(short)"/>
		<keyword name="int32Keyword" value="(int)"/> 
		<keyword name="int64Keyword" value="(long)"/>
		<keyword name="singleKeyword" value="(float)"/>
		<keyword name="doubleKeyword" value="(double)"/>
		<keyword name="decimalKeyword" value="(decimal)"/>
	</keywords>
