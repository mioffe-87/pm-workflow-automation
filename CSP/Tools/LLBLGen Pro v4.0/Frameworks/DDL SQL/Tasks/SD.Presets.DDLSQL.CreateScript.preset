<?xml version="1.0" encoding="utf-8"?>
<preset name="SD.Presets.DDLSQL.CreateScript" lastModifiedOn="2009-07-21T15:09:04.1349754+02:00" createdBy="Solutions Design" isSealed="false" xmlns="http://sd/llblgen/pro/presetElementDefinitions.xsd">
  <supportedPlatforms>
    <platform name="RDBMS" />
  </supportedPlatforms>
  <supportedTemplateGroups>
    <templateGroup name="Create DDL SQL" />
  </supportedTemplateGroups>
  <supportedFrameworks>
    <framework name="DDL SQL" />
  </supportedFrameworks>
  <taskPresets>
    <taskGroupPreset name="SD.Tasks.Base.GenericTaskGroup" displayName="Generate the Create DDL Script per database." requiresCleanCache="false">
      <taskPreset name="SD.Tasks.Base.CreateAFolder" displayName="Create driver specific folder for script file.">
        <parameters>
          <parameter name="folderToCreate" value="[driverShortName]" />
        </parameters>
      </taskPreset>
      <taskPreset name="SD.Tasks.DDLSQL.GenerateCreateScript" displayName="Generate Create script">
        <parameters>
          <parameter name="destinationFolder" value="[driverShortName]" />
        </parameters>
      </taskPreset>
    </taskGroupPreset>
  </taskPresets>
</preset>