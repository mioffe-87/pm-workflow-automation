// Code is generated using templates: <%=_executingGenerator.GetTemplateBindingsName(_templateID, _templateBindingDefinitionName)%>
// Templates vendor: Solutions Design.
//////////////////////////////////////////////////////////////
using System;
using System.Collections.Generic;
using System.Linq;
using System.Text;
using SD.LLBLGen.Pro.ORMSupportClasses;
using <%=_executingGenerator.RootNamespaceToUse%>.FactoryClasses;
using <%=_executingGenerator.RootNamespaceToUse%>.HelperClasses;

namespace <%=_executingGenerator.RootNamespaceToUse%>.FactoryClasses
{
	/// <summary>Static factory class for creating TableValuedFunctionCall objects.</summary>
	public static partial class TvfCallFactory
	{
<%
	foreach(var tvfCall in tvfCallsToProcess)
	{
%>		/// <summary>Creates a TableValuedFunctionCall object for the TvfCallDefinition '<%=tvfCall.FullName%>'. Returns a set of elements of type '<%=tvfCall.ReturnElement.FullName%>'.</summary>
<%		if(tvfCall.OutputSettingValues.CustomProperties.Count>0)
		{
%>		/// <remarks>Custom Properties: <br/>
<%			foreach(var kvp in tvfCall.OutputSettingValues.CustomProperties)
			{
%>		/// <%=kvp.Key%>: <%=kvp.Value%><br/>
<%			}
%>		/// </remarks>
<%		}
%>		/// <param name="alias">The alias to specify for the query fetching the TVF.</param>
<%		var mapping = _currentProject.GetGroupableModelElementMapping(tvfCall, _executingGenerator.DriverID);
		string fieldsFactoryMethodCallFormatString = (tvfCall.ReturnElement is EntityDefinition) ? "CreateEntityFieldsObject({0}.EntityType.{1}Entity)"
																								 : "CreateTypedViewEntityFieldsObject({0}.TypedViewType.{1}TypedView)";
		List<string> parameterDeclarations = new List<string>();
		List<string> parameterNames = new List<string>();
		foreach(var parameterMapping in mapping.FieldMappings.OrderBy(fm=>fm.MappedTarget.OrdinalPosition))
		{
			var mappedParameter = parameterMapping.MappedFieldInstance as TvfCallParameterDefinition;
			string parameterNameCamelCased = GeneratorUtils.CamelCaseString(mappedParameter.Name);
			parameterNames.Add(parameterNameCamelCased);
			parameterDeclarations.Add(string.Format("{0} {1}", 
							GeneratorUtils.GetDotNetTypeAsString(mappedParameter.FieldType.RepresentedType, _executingGenerator, "Nullable<{0}>", mappedParameter.IsOptional), 
							parameterNameCamelCased));
%>		/// <param name="<%=parameterNameCamelCased%>">parameter of the TVF</param>
<%		}
%>		/// <returns>ready to use TableValuedFunctionCall</returns>
		public static TableValuedFunctionCall <%=tvfCall.Name%>(string alias<% if(parameterDeclarations.Count>0) { %>, <%=string.Join(", ", parameterDeclarations.ToArray())%><% } %>)
		{
			return new TableValuedFunctionCall(EntityFieldsFactory.<%=string.Format(fieldsFactoryMethodCallFormatString, _executingGenerator.RootNamespaceToUse, tvfCall.ReturnElement.Name)%>, alias, "<%=tvfCall.Name%>"<%if(selfServicing) {%>, PersistenceInfoProviderSingleton.GetInstance().GetTvfCallInfo("<%=tvfCall.Name%>")<% } if(parameterNames.Count>0) {%>, <%=string.Join(", ", parameterNames.ToArray())%><% } %>);
		}
		
<%	}
%>	}
}