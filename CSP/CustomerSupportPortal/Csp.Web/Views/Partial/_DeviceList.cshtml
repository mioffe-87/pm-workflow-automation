        function onOpenDeviceTransferWindow() {
            SupportPortal.OnWindowOpen('@UniqueId.ReviewDeviceTransfersWindow');
        }

        function onCloseDeviceTransferWindow() {
            SupportPortal.OnWindowClose(deviceGridId);
        }

        function exportProductionAssetsToCsv() {

            var id = @actionHelper.Id;

            var searchField = $("#@UniqueId.searchFieldId").val();
            var searchValue = $("#@UniqueId.searchValueId").val();
            var hideExpiredLicenses= '@Model.HideExpiredLicenses';

            location.href = '@Url.Action((Model.IsProductionDeviceList ? actionHelper.ProductionDevices : actionHelper.SpareDevices) +
                "Report", actionHelper.Controller)?id=' + id + '&searchField='
                    + searchField + '&searchValue=' + searchValue + '&hideExpiredLicenses=' + hideExpiredLicenses;
        }

        function openDeactivateLicensesWindow() {

            var direction = "/License/DeactivateLicenses";
            var window = $("#@UniqueId.deactivateLicensesWindowId").data("kendoWindow");
            window.content(" ");
            window.setOptions({
                minHeight: 400
            });
