    // Search Related
    
    function OnDevicesCmbChange() {
        var cmbId = "#@(UniqueId.searchFieldId)";
        $('#@UniqueId.textDivId input:text').val('');
        var selectedValue = $(cmbId).data("kendoDropDownList").value();
        if (selectedValue == "DeviceCategoryId") {
            $('#@UniqueId.textDivId').css('display', 'none');
            $('#@UniqueId.deviceCategoryDropDownDivId').css('display', 'block');

        } else {
            $('#@UniqueId.textDivId').css('display', 'block');
            $('#@UniqueId.deviceCategoryDropDownDivId').css('display', 'none');
        }
    }
    
    function getSearchParams() {
        var selectedValue = $("#@UniqueId.searchFieldId").val();

        if (selectedValue == "DeviceCategoryId") {
            var deviceCategoryDropDown = $("#@UniqueId.deviceCategoryFieldId");
            if (deviceCategoryDropDown.val() > 0)
                $("#@UniqueId.searchValueId").val(deviceCategoryDropDown.val());
            else {
                $("#@UniqueId.searchValueId").val("");
            }
        }
        
        var params = SetAntiForgery();
        params.searchField = $("#@UniqueId.searchFieldId").val();
        params.searchValue = $("#@UniqueId.searchValueId").val();
        return params;
    }
    
    function getAddParams() {
        var params = SetAntiForgery();
        params.authCode = $("#AuthorizationCode").val();
        return params;
    }

    function @(UniqueId.device)SearchDeviceData() {
        var grid = $("#@UniqueId.EpAuthCodesGrid").data("kendoGrid");
        var gridData = grid.dataSource;
        gridData.read();
    }
    
        function GenerateAndDownloadLicense(authCode, subType, partNumber) {
            
        var isMalborkLicense = "false";
        var showDialog = false;
        // var pattern = new RegExp('^(REN)*TRAPSMA(L|LUS|LLAB|LNFR)');
        var pattern = new RegExp('MAL|TRAPSELA');
        if (pattern.test(subType.toUpperCase())) {
            isMalborkLicense = 'true';
            if (partNumber) {
                showDialog = true;
            }
        }

        //TRAPSBETA40 or Malbork Renewal: launch the dialog to let customer choose which license is needed
        if ((subType.toLowerCase().indexOf("40") >= 0 && partNumber != undefined && partNumber !== '') || (isMalborkLicense === 'true' && showDialog)) {
            $('#ProductSubType').val(subType);
            GetLicenseForMalbork(authCode);
        }
        else {
            //not new Malbork SKU, 4.0 BETA SKU like PAN-TRAPS-200-40BETA, subtype: TRAPSBETA40 
            if (isMalborkLicense === 'false' && subType.toLowerCase().indexOf("40") >= 0) {
                isMalborkLicense = true;
            }

            GetLicenseFromCyveraLicensing(authCode, isMalborkLicense); // 4.0 and before (3.2,3.2-3.3)
        } 
    }

    function GetLicenseFromCyveraLicensing(authCode, isMalborkLicense) {
        var window = $('#DownloadLicenseKey').data('kendoWindow');
        $(".no-buttons").prev(".k-window-titlebar").find(".k-window-action").hide();

        window.setOptions({
            minWidth: 400,
            minHeight: 100
        });
        window.content(SupportPortal.CustomLoadingMessageWithSpinner("Please wait while we download the License Key"));
        window.open();
        window.center();

        // Ajax call and get the type of Auth Code
        // Auth Code should be a Cyvera Auth Code

        var serverCount = $("#ServerUsecount").length > 0 ? $("#ServerUsecount").val() : 0;
        var workstationCount = $("#WorkstationUsecount").length > 0 ? $("#WorkstationUsecount").val() : 0;
        var vdiCount = $("#VdiUsecount").length > 0 ? $("#VdiUsecount").val() : 0;
        var panOsV = $("#ddTrapsVersion").length > 0 ? $("#ddTrapsVersion").val() : "";

        serverCount = isNaN(parseInt(serverCount)) ? 0 : parseInt(serverCount);
        workstationCount = isNaN(parseInt(workstationCount)) ? 0 : parseInt(workstationCount);
        vdiCount = isNaN(parseInt(vdiCount)) ? 0 : parseInt(vdiCount);

        var urldata = "/EP/GenerateLicenseKey?authCode=" + authCode + "&isMalborkLicense=" + isMalborkLicense + "&versionRequested=" + panOsV + "&serverCount=" + serverCount + "&workstationCount=" + workstationCount + "&vdiCount=" + vdiCount;
        $.ajax({
            url: urldata,
            async: true,
            type: 'POST',
            cache: false,
            success: function (result) {
                window.close();
                DownloadLicense(authCode);
            },
            error: function () {
                SupportPortal.Message("Error in processing request.");
                window.close();
            }
        });
    }

    function GetLicenseForMalbork(authCode) {
        var direction = "/EP/TrapsVersion?authCode=" + authCode;
        var window = $("#@UniqueId.SelectTrapsVersion").data("kendoWindow");
        window.content(" ");
        window.refresh();
        window.refresh(direction);
        window.setOptions({
            minHeight: 150
        });
        window.open();
        window.center();
    }
    
    function DownloadLicense(authcode) {
        window.location = "/EP/DownloadLicenseKey?authCode=" + authcode;
    }
    
    function @((string)UniqueId.device)onDevicesEnterPress(e) {
        if (e.keyCode == 13) {
            @(UniqueId.device)SearchDeviceData()
            return false;
        }

        return true;
    }

    function DeviceTagChangeHandler(e) {
        @(UniqueId.device)SearchDeviceData();
        return false;
    }

    function exportTrapsToCsv() {

        var supportAccountId = "@Model.ActionHelper.Id";
        
        var searchField = $("#@UniqueId.searchFieldId").val();
        var searchValue = $("#@UniqueId.searchValueId").val();
        //"SearchAvailable", "EP"
        location.href = '@Url.Action("SearchAvailableReport", "EP")?supportAccountId=' + supportAccountId + '&searchField='
                + searchField + '&searchValue=' + searchValue;
    }

</script>
