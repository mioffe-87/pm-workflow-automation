@{
    ViewBag.Title = "User Account Already Exists";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var actionHelper = ViewBag.ActionHelper;
}

<div class="content">
    <div class="container">
        <div class="page-title">
            <span id="Title" class="contextTitle">User Account already exists</span>
        </div>
        <div class="row-fluid">
            <div class="span12">
                <div class="row-fluid">
                    <div class="span4">
                        <div class="control-group">
                            Email already exists for user. Enter email address and password.
                            Or <a href="@ViewBag.ReturnUrl">click here</a> to login.
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
