<%
	Project currentProject = _executingGenerator.ProjectDefinition;
	string factoryToUse=string.Empty;
	bool emitFactory = true;
	switch(currentProject.GetRealStringSettingValue("BytecodeProxyFactory"))
	{
		case "LinFu":
			factoryToUse = "NHibernate.ByteCode.LinFu.ProxyFactoryFactory, NHibernate.ByteCode.LinFu";
			break;
		case "Castle":
			factoryToUse = "NHibernate.ByteCode.Castle.ProxyFactoryFactory, NHibernate.ByteCode.Castle";
			break;
		case "Spring":
			factoryToUse = "NHibernate.ByteCode.Spring.ProxyFactoryFactory, NHibernate.ByteCode.Spring";
			break;
		case "BuiltIn":
			emitFactory = false;
			break;
	}
%>'------------------------------------------------------------------------------
' <Auto-generated>This code was generated by LLBLGen Pro v<%=ApplicationConstants.LLBLGenProVersion%>.</Auto-generated>
'------------------------------------------------------------------------------
Imports System
Imports FluentNHibernate
Imports FluentNHibernate.Cfg
Imports FluentNHibernate.Cfg.Db
Imports NHibernate

Namespace <%=_executingGenerator.RootNamespaceToUse%>
	''' <summary>Small, simple session manager class which initializes NHibernate's session factory and loads the configuration.</summary>
	Public Class SessionManager
#Region "Class Member Declarations"
		Private Shared ReadOnly _sessionFactory As ISessionFactory 
#End Region

		''' <summary>Initializes the <see cref="SessionManager"/> Class.</summary>
		Shared Sub New()
			_sessionFactory = Fluently.Configure() _
				.Database(<%=SD_NHibernateGeneralUtils.DriverIdToDbConfigurationName(_executingGenerator.DriverID)%> _
							.ConnectionString(Function(c) c.FromConnectionStringWithKey("<%=currentProject.CreateConnectionStringKeyNameForDatabase(_executingGenerator.DriverID)%>"))) _
				.Mappings(Function(m) m.FluentMappings.AddFromAssembly(GetType(SessionManager).Assembly)) _
<%	if(emitFactory)
	{
%> 				.ProxyFactoryFactory("<%=factoryToUse%>") _
<%	}
%>				.BuildSessionFactory()
		End Sub

		''' <summary>Opens a New session On the existing session factory</summary>
		''' <returns>ready To use ISession instance</returns>
		''' <remarks>Dispose this instance after you're done with the instance, so after lazy loading has occured. The returned
		''' ISession instance is <b>not</b> thread safe.</remarks>
		Public Shared Function OpenSession() As ISession 
			Return _sessionFactory.OpenSession()
		End Function
		
<# SD_NHibernate_CustomSessionManagerFluentInclude #>
#Region "Class Property Declarations"
		''' <summary>Gets the session factory created From the initialized configuration. The returned factory is thread safe.</summary>
		Public Shared ReadOnly Property  SessionFactory As ISessionFactory
			Get 
				Return _sessionFactory
			End Get
		End Property
#End Region
	End Class
End Namespace
