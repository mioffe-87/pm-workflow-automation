<?xml version="1.0" encoding="utf-8"?>
<!--Web.cinfig for Engineering QA environment-->

<configuration xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">
    <connectionStrings>
        <add name="cspEntities" connectionString="metadata=res://*/DBs.CSP.CSPDatabase.csdl|res://*/DBs.CSP.CSPDatabase.ssdl|res://*/DBs.CSP.CSPDatabase.msl;provider=MySql.Data.MySqlClient;provider connection string=&quot;server=10.101.84.48;database=csp;Connect Timeout=45;default command timeout=60;user id=csp_user;password=Supp0rT!&quot;" xdt:Transform="SetAttributes" xdt:Locator="Match(name)" />
        <add name="CspDatabase" connectionString="Datasource=10.101.84.48;Database=csp;uid=csp_user;pwd=Supp0rT!;Connect Timeout=45;default command timeout=60;" xdt:Transform="SetAttributes" xdt:Locator="Match(name)" />
        <add name="PANDatabase" connectionString="Datasource=10.101.84.48;Database=pandb;uid=csp_user;pwd=Supp0rT!;Connect Timeout=45;default command timeout=60;" xdt:Transform="SetAttributes" xdt:Locator="Match(name)" />
        <add name="ContentPublishDatabase" connectionString="Datasource=qaupdatesdb.paloaltonetworks.local;Database=contentpublish;uid=content_update;pwd=yL3gG7zK4FBGu8Hs;Connect Timeout=45;default command timeout=60;Max Pool Size=50; Min Pool Size=10" providerName="MySql.Data.MySqlClient" xdt:Transform="SetAttributes" xdt:Locator="Match(name)" />
    </connectionStrings>
    <appSettings>
        <add key="AdminSiteUrl" value="http://qaupdatesadminsite.paloaltonetworks.com" xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
        <add key="LoginServiceLogoutUrl" value="https://logintest.paloaltonetworks.com/logout?returnurl=http://stage.paloaltonetworks.com/support/tabs/overview.html" xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
        <add key="WildfireDeleteNotifyApi" value="https://sv3-gate1-stg1.wf.pan.local/pansupport/apikey/deletenotify,https://sv3-gate2-stg1.wf.pan.local/pansupport/apikey/deletenotify" xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
        <add key="SalesforceUser" value="cspintegration1@paloaltonetworks.com.qa" xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
        <add key="SalesforcePassword" value="paloaltonetworksxZoBrjlX4cAXg9xPmV80VoAE" xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
        <add key="SaasStubPartNumbers" value="PAN-PA-SAAS-SW-BETA" xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />

        <add key="ShowSaasPanoramasOnly" value="True" xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />

        <add key="SendGridEmail" value="false" xdt:Transform="Insert" xdt:Locator="Match(key)" />
        <add key="Communityurl" value="https://live.paloaltonetworks.com/" xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />

        <add key="AppName" value="CSP EngQA" xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
        <add key="ImpersonateUrl" value="https://logintest.paloaltonetworks.com/impersonate/Index?returnurl=https://supportqa.paloaltonetworks.com" xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
        <add key="DissimulateUrl" value="https://logintest.paloaltonetworks.com/impersonate/Dissimulate?returnurl=https://supportqa.paloaltonetworks.com" xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />

        <add key="IncludeSaasCompatiblePanoramaModels" value="PRA" xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
        <add key="SaasStubPartNumbers" value="PAN-PA-SAAS-SW-BETA" xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
        
    </appSettings>
    <system.net>
        <mailSettings>
            <smtp deliveryMethod="Network" xdt:Transform="SetAttributes"></smtp>
        </mailSettings>
    </system.net>
    <elmah>
        <security allowRemoteAccess="1" xdt:Transform="SetAttributes" />
    </elmah>
    <system.serviceModel>
        <bindings xdt:Transform="Replace">
            <basicHttpBinding>
                <binding name="BasicHttpBinding_ILicense" />
                <binding name="SiteLicenseServiceSoap" openTimeout="0:10:0" closeTimeout="0:10:0" sendTimeout="0:10:0" receiveTimeout="0:10:0">
                    <security mode="Transport">
                        <transport clientCredentialType="Basic" proxyCredentialType="Basic" realm=""></transport>
                        <message clientCredentialType="UserName"/>
                    </security>
                </binding>
                <binding name="LicenseService2Soap" openTimeout="0:10:0" closeTimeout="0:10:0" sendTimeout="0:10:0" receiveTimeout="0:10:0">
                    <security mode="Transport">
                        <transport clientCredentialType="Basic" proxyCredentialType="Basic" realm=""></transport>
                        <message clientCredentialType="UserName"/>
                    </security>
                </binding>
                <binding name="UpdateService2Soap" maxReceivedMessageSize="2147483647" openTimeout="0:10:0" closeTimeout="0:10:0" sendTimeout="0:10:0" receiveTimeout="0:10:0">
                    <security mode="Transport">
                        <transport clientCredentialType="Basic" proxyCredentialType="Basic" realm=""></transport>
                        <message clientCredentialType="UserName"/>
                    </security>
                </binding>
                <binding name="BasicHttpBinding_ILoginService" />
                <binding name="EvalWebServiceBinding">
                    <security mode="Transport" />
                </binding>
            </basicHttpBinding>
        </bindings>
        <client>
            <endpoint name="LicenseService2Soap" address="https://qaupdates.paloaltonetworks.com/license/licenseservice2.asmx" xdt:Transform="SetAttributes" xdt:Locator="Match(name)"/>
            <endpoint name="UpdateService2Soap" address="https://qaupdates.paloaltonetworks.com/updates/updateservice2.asmx" xdt:Transform="SetAttributes" xdt:Locator="Match(name)"/>
            <endpoint name="SiteLicenseServiceSoap" address="https://10.101.27.48/sitelicenseservice.asmx" xdt:Transform="SetAttributes" xdt:Locator="Match(name)" />
        </client>
    </system.serviceModel>

    <system.webServer>
        <httpProtocol xdt:Transform="Insert">
            <customHeaders>
                <add name="X-Frame-Options" value="SAMEORIGIN" />
                <add name="Content-Security-Policy" value="frame-ancestors 'self' https://*.paloaltonetworks.com" />
            </customHeaders>
        </httpProtocol>
        <staticContent xdt:Transform="Remove" />
    </system.webServer>
</configuration>