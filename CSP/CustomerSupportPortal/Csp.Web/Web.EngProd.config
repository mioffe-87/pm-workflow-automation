<?xml version="1.0" encoding="utf-8"?>
<!--Web.cinfig for Engineering PROD environment-->

<configuration xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">
  <applicationSettings xdt:Transform="Replace">
    <Csp.Api.Properties.Settings>
      <setting name="Csp_Api_SalesforceWebApi_SforceService" serializeAs="String">
        <value>https://test.salesforce.com/services/Soap/c/61.0/0DFS00000004FdV</value>
      </setting>
      <setting name="Csp_Api_SAPService_SI_QuoteCreate_OBService" serializeAs="String">
        <value>https://potst.paloaltonetworks.com/QuoteCreate</value>
      </setting>
    </Csp.Api.Properties.Settings>
  </applicationSettings>
  <connectionStrings></connectionStrings>
  <system.net>
    <mailSettings xdt:Transform="Replace">
      <smtp deliveryMethod="Network" from="noreply@paloaltonetworks.com ">
        <network host="sjccmtavip.paloaltonetworks.local" port="25" />
        <specifiedPickupDirectory pickupDirectoryLocation="c:\emails" />
      </smtp>
    </mailSettings>
  </system.net>
  <appSettings>
    <!--GCP Vault Config-->
    <add key="AppEnv" value="engprod"  xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
    <add key="VaultUrl" value="http://127.0.0.1:8200/v1/IT/kv/data/stage/csp/secret_engprod" xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
    <add key="AllowedOrigins" value="http://qasupport.paloaltonetworks.com,https://qasupport.paloaltonetworks.com,https://supportqa.paloaltonetworks.com,https://paloaltonetworks--qa.cs66.my.salesforce.com,https://qa-paloaltonetworkssupport.cs66.force.com" xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
  </appSettings>
  <system.serviceModel xdt:Transform="Replace">
    <bindings>
      <basicHttpBinding>
        <binding name="BasicHttpBinding_ILicense"/>
        <binding name="LicenseService2Soap" openTimeout="0:10:0" closeTimeout="0:10:0" sendTimeout="0:10:0" receiveTimeout="0:10:0">
          <security mode="Transport">
            <transport clientCredentialType="Basic" proxyCredentialType="Basic" realm="">
            </transport>
            <message clientCredentialType="UserName"/>
          </security>
        </binding>
        <binding name="UpdateService2Soap" maxReceivedMessageSize="2147483647" openTimeout="0:10:0" closeTimeout="0:10:0" sendTimeout="0:10:0"
                 receiveTimeout="0:10:0">
          <security mode="Transport">
            <transport clientCredentialType="Basic" proxyCredentialType="Basic" realm="">
            </transport>
            <message clientCredentialType="UserName"/>
          </security>
        </binding>
        <binding name="BasicHttpBinding_ILoginService"/>
        <binding name="EvalWebServiceBinding">
          <security mode="Transport"/>
        </binding>
      </basicHttpBinding>
    </bindings>
    <client>
      <endpoint name="LicenseService2Soap" address="https://pansupport.paloaltonetworks.com/license/licenseservice2.asmx" binding="basicHttpBinding" bindingConfiguration="LicenseService2Soap" contract="LicensingService.LicenseService2Soap" />
      <endpoint name="UpdateService2Soap" address="https://pansupport.paloaltonetworks.com/updates/updateservice2.asmx" binding="basicHttpBinding" bindingConfiguration="UpdateService2Soap" contract="UpdateService.UpdateService2Soap" />
      <endpoint name="BasicHttpBinding_ILoginService" address="http://loginservicetest.paloaltonetworks.com/LoginService.svc?wsdl" binding="basicHttpBinding" bindingConfiguration="BasicHttpBinding_ILoginService" contract="LoginService.ILoginService" />
      <endpoint name="EvalWebService" address="https://cs211.salesforce.com/services/Soap/class/EvalWebService" binding="basicHttpBinding" bindingConfiguration="EvalWebServiceBinding" contract="EvalWebServicePortType" />
      <endpoint name="BasicHttpBinding_ILicense" address="http://pansupport.paloaltonetworks.com/panservices/license.svc" binding="basicHttpBinding" bindingConfiguration="BasicHttpBinding_ILicense" contract="DeviceAndLicenseService.ILicense" />
    </client>
  </system.serviceModel>
  <system.webServer>
    <httpProtocol xdt:Transform="Insert">
      <customHeaders>
        <add name="X-Frame-Options" value="SAMEORIGIN" />
        <add name="Content-Security-Policy" value="frame-ancestors 'self' https://*.paloaltonetworks.com" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>

  <location path="elmah" xdt:Transform="Replace" xdt:Locator="Match(path)">
    <system.web>
      <authorization>
        <allow users="mlavoie@paloaltonetworks.com,jsacks@paloaltonetworks.com,vrangayan@paloaltonetworks.com,rrahardjo@paloaltonetworks.com,pthangavel@paloaltonetworks.com,gengle@paloaltonetworks.com,ffang@paloaltonetworks.com,mdokey@paloaltonetworks.com,cwallace@paloaltonetworks.com,twalsh@paloaltonetworks.com,rparipoorana@paloaltonetworks.com,sseetham@paloaltonetworks.com,ssriram@paloaltonetworks.com,rchaluvadi@paloaltonetworks.com" />
        <deny users="*" />
      </authorization>
    </system.web>
  </location>
  <location path="glimpse.axd" xdt:Transform="Insert" xdt:Locator="Match(path)">
    <system.web>
      <authorization>
        <allow users="mlavoie@paloaltonetworks.com,jsacks@paloaltonetworks.com,vrangayan@paloaltonetworks.com,rrahardjo@paloaltonetworks.com,pthangavel@paloaltonetworks.com,gengle@paloaltonetworks.com,ffang@paloaltonetworks.com,mdokey@paloaltonetworks.com,cwallace@paloaltonetworks.com,twalsh@paloaltonetworks.com,rparipoorana@paloaltonetworks.com,sseetham@paloaltonetworks.com,ssriram@paloaltonetworks.com,rchaluvadi@paloaltonetworks.com" />
        <deny users="*" />
      </authorization>
    </system.web>
  </location>

</configuration>
