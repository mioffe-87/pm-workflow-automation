<script>

    function @(UniqueId.device)onCloseDeviceWindow() {
        var window = $("#@UniqueId.deviceWindowId").data("kendoWindow");
        window.refresh();
        SupportPortal.OnWindowClose("@UniqueId.gridId");
    }


    function @(UniqueId.device)onOpenDeviceWindow() {

        SupportPortal.OnWindowOpen("@UniqueId.deviceWindowId");

    }

    function OnDevicesCmbChange() {
        var cmbId = "#@(UniqueId.searchFieldId)";
        $('#@UniqueId.textDivId input:text').val('');
        var selectedValue = $(cmbId).data("kendoDropDownList").value();
        if (selectedValue == "DeviceCategoryId") {
            $('#@UniqueId.textDivId').css('display', 'none');
            $('#@UniqueId.deviceCategoryDropDownDivId').css('display', 'block');
            $('#@UniqueId.DateSearchDiv').css('display', 'none');
        } else if (selectedValue == "ExpiresBy") {
            $('#@UniqueId.textDivId').css('display', 'none');
            $('#@UniqueId.deviceCategoryDropDownDivId').css('display', 'none');
            $('#@UniqueId.DateSearchDiv').css('display', 'block');
        } else {
            $('#@UniqueId.textDivId').css('display', 'block');
            $('#@UniqueId.deviceCategoryDropDownDivId').css('display', 'none');
            $('#@UniqueId.DateSearchDiv').css('display', 'none');
        }
    }

    function @(UniqueId.device)DeleteDeviceDetails(e) {

        e.preventDefault ? e.preventDefault() : e.returnValue = false;
        var dataItem = this.dataItem($(e.currentTarget).closest("tr"));
        var row = $(e.currentTarget).closest("tr");
        var deviceid = dataItem.DeviceId;
        var direction = "/@ControllerFields.GroupController/RemoveDevice?groupId=@actionHelper.Id&deviceId=" + deviceid;


        SupportPortal.Confirmation("@Constants.DeletePreMessage Device?", function () { @(UniqueId.device)removeDevice(); }, null, null);

        function @(UniqueId.device)removeDevice() {
            $.ajax({
                url: direction,
                type: 'Post',
                data: { "__RequestVerificationToken": $("input[name=__RequestVerificationToken]").val() },
                cache: false,
                success: function (result) {

                    if (result == "Success") {
                        row.hide();
                        var grid = $("#@UniqueId.gridId").data("kendoGrid").dataSource;
                        grid.read();
                    } else {
                        row.show();
                    }
                },
                error: function () {
                    row.show();

                }
            });

        }

    }


    function @(UniqueId.device)onDeviceDataBound() {
        var deviceName = "#@UniqueId.gridId tbody tr .DeviceName";
        $(deviceName).each(function () {
            var currentDataItem = $("#@UniqueId.gridId").data("kendoGrid").dataItem($(this).closest("tr"));
            if (currentDataItem == undefined)
                return true;//continue
            console.log(currentDataItem);
            //Show/Hide Action Buttons
            if (currentDataItem.ShowNfrLicense == false) {
                $(this).closest('tr').find('a.k-grid-ActivateEvalLicense').remove();
            }

            if (currentDataItem.ShowTrialLicense == false) {
                $(this).closest('tr').find('a.k-grid-ActivateTrialLicense').remove();
            }

            if (currentDataItem.ShowTransferLicense == false) {
                $(this).closest('tr').find('a.k-grid-TransferLicenses').remove();
            }
        });

        var ctrlName = "#@UniqueId.isPostBackId";

        if ($(ctrlName).val() == "") {
            $("#@UniqueId.gridId").data("kendoGrid").dataSource._total = "@Convert.ToInt32(Model.DataParameters.TotalRecordCount)";
            $(ctrlName).val("1");
        }

        delayExpandRow(this);
    }

    var loadedFirst = false;
    function delayExpandRow(row) {

        if (loadedFirst) {
            setTimeout(function () { row.expandRow(row.tbody.find("tr.k-master-row")); }, 1000);
        } else {
            loadedFirst = true;
            row.expandRow(row.tbody.find("tr.k-master-row"));
        }
    }

    function @(UniqueId.device)onLicenseDataBound(e) {

        var currentDate = new Date();
        currentDate.setHours(0, 0, 0, 0);
        var numberOfDaysToSubtract = 31;

        var lastColIndex = null;

        var grid = this;
        grid.tbody.find('>tr').each(function () {

            var dataItem = grid.dataItem(this);
            console.log(dataItem);
            var expirationDate = dataItem.ExpirationDate;
            if (!expirationDate) return true;

            var expirationDateWarning = new Date(expirationDate.getTime());

            expirationDateWarning.setDate(expirationDate.getDate() - numberOfDaysToSubtract);

            if (!lastColIndex) {
                lastColIndex = $(this).find('td').length;
            }

            if (expirationDate < currentDate) {
                $(this).find('td:nth-child(' + lastColIndex + ')').addClass("expired-license");
            } else if (expirationDateWarning < currentDate) {
                $(this).find('td:nth-child(' + lastColIndex + ')').addClass("expiration-warning-License");
            }

            if (dataItem.IsPerpetual) {
                $(this).find('td:nth-child(' + lastColIndex + ')').text('Perpetual');
            }

            if (dataItem.CsspProvisionedDevice) {
                $(this).find('td:nth-child(' + lastColIndex + ')').text('NA');
            }

            if (dataItem.LicenseNameDisplay == 'Lab Bundle') {
                $(this).find('td:nth-child(' + lastColIndex + ')').text('');
            }



        });
    }

    function @(UniqueId.device)SearchDeviceData() {

        var params = @(UniqueId.device)getSearchParams();

        var grid = $("#@UniqueId.gridId").data("kendoGrid");
        var gridData = grid.dataSource;
        gridData.filter(
            {
                field: params.field,
                operator: "eq",
                value: params.value
            }
        );

        grid.collapseRow(grid.tbody.find("tr.k-master-row"));
    }

    function @(UniqueId.device)onDevicesEnterPress(e) {

        if (e.keyCode == 13) {
            @(UniqueId.device)SearchDeviceData();
            return false;
        }

        return true;
    }

    function DeviceTagChangeHandler(e) {
        @(UniqueId.device)SearchDeviceData();
        return false;
    }

    function @(UniqueId.device)getSearchParams() {

        var selectedValue = $("#@UniqueId.searchFieldId").val();

        if (selectedValue == "ExpiresBy") {
            var searchDatePicker = $('#@UniqueId.SearchDateValue');
            if (searchDatePicker.val() != "") {

                var dt = new Date(searchDatePicker.val());
                var dtString = dt.getFullYear() + "-" + ((dt.getMonth() + 1) > 9 ? (dt.getMonth() + 1) : "0" + (dt.getMonth() + 1)) + "-" + (dt.getDate() > 9 ? dt.getDate() : "0" + dt.getDate());
                $("#@UniqueId.searchValueId").val(dtString);
            }
            else {
                $("#@UniqueId.searchValueId").val("");
            }
        }
        else if (selectedValue == "DeviceCategoryId") {
            var deviceCategoryDropDown = $("#@UniqueId.deviceCategoryFieldId");
            if (deviceCategoryDropDown.val() > 0)
                $("#@UniqueId.searchValueId").val(deviceCategoryDropDown.val());
            else {
                $("#@UniqueId.searchValueId").val("");
            }
        }

         return {
            field: $("#@UniqueId.searchFieldId").val(),
                value: $("#@UniqueId.searchValueId").val()
            };
        }

        function @(UniqueId.device)getGridParams() {

        var params = @(UniqueId.device)getSearchParams();

        var p = SetAntiForgery();
        p.searchField = params.field;
        p.searchValue = params.value;
            p.hideExpiredLicenses = hideExpiredLicenses;
        return p;
    }

    $("#@UniqueId.searchFieldId").change(function () {

        $("#@UniqueId.searchValueId").select();
        $("#@UniqueId.searchFieldId").data("kendoDropDownList").focus();
    });


