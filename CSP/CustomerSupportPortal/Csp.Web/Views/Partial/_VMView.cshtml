<div class="contextTitle">VM-Series Auth-Codes</div>

<div class="grid-header">
    <div class="grid-left">
        <button type="button" class="k-button k-primary" data-link-type="vm-series-add-auth-code" id="@UniqueId.AddVmSeriesAuthCode">Add VM-Series Auth-Code</button><span class="csp-tooltip"><i class="icon-question-sign icon-large" onclick="SupportPortal.Help(this, 10);"></i></span>
        <input type="button" class="k-button" data-link-type="vm-series-deactivate-license" value="Deactivate License(s)" style="margin-left: 5px;" id="@UniqueId.DeactivateLicenses" />
         <input type="button" class="k-button" data-link-type="vm-series-released-licenses" value="Released VM License Auth Codes" style="margin-left: 5px;" id="@UniqueId.ReleasedVMAuthCodes" />
         <button type="button" class="k-button" style="margin-left: 5px; color: red" id="@UniqueId.ReviewTokensGrantBtn" >Review Tokens Grant</button>
    </div>
    <div class="grid-right">
        <div class="grid-filter">
            @Html.TextBox("FindAuthCode", Model.DefaultDeviceCode, new
                   {
                       onkeypress = "return onSearchEnterPress(event)",
                       @class = "grid-filter__search-input",
                       placeholder = "Auth Code",
                       aria_label = "Search Auth Code"
                   })
            <button aria-label="search" type="button" class="grid-filter__search-button" onclick="findVM()">
                <span aria-hidden="true" class="fa fa-search" />
            </button>
        </div>
    </div>
</div>

<div>

    @{
        var maxPageSizeForms = Convert.ToInt32(Model.DataParameters.TotalRecordCount);
        var pageSizeOptionsForms = new List<int> { 5, 10, 20, 50 };
        if (maxPageSizeForms > pageSizeOptionsForms.Max()) {
            pageSizeOptionsForms.Add(maxPageSizeForms);
        }
    }

    @(Html.Kendo().Grid(Model.AvailableVms)
          .Name((string)UniqueId.VMAuthCodesGrid)
          .Columns(cols => {
              cols.Bound(x => x.AuthorizationCode).Title("Auth Code").Width(100);
              cols.Bound(x => x.DisplayQuantity).Width(100).Title("Quantity of VM Provisioned").Sortable(false);
              cols.Bound(x => x.Description).Title("Part Description");
              cols.Bound(x => x.DisplayExpirationDate).Title("Expiration Date").Sortable(false).Width(80);
              cols.Bound(x => x.AscName).Title("ASC").Sortable(false).Width(160);
              cols.Bound(x => x.ProductSku).Hidden(true);
              cols.Bound(x => x.IsVmRenewalEligible).Hidden(true);
              cols.Command(command => {
                  command.Custom("csp-download").Text(" ").Click("Download").HtmlAttributes(new { title = "Download", href = "javascript:void(0);", style="font-size: 12px;" });
                  command.Custom("RegisterVM").Click("RegisterVm").Text("Register VM").HtmlAttributes(new {style="font-size: 12px;" });
                  command.Custom("DeactivateVM").Click("DeactivateVM").Text("Deactivate VM").HtmlAttributes(new {style="font-size: 12px;" });
                  command.Custom("ProvisionPanorama").Click("ShowNsxDevices").Text("Panorama").HtmlAttributes(new {style="font-size: 12px;" });
                  command.Custom("Renew").Click("ShowRenewalItems").Text("Renew").HtmlAttributes(new {style="font-size: 12px;" });
              }).Width(320).Title("Actions");
          })
          .Pageable(pageable => pageable.PageSizes(pageSizeOptionsForms.ToArray()))
          .Sortable()
          .Editable(x => x.Mode(GridEditMode.InLine))
          .Events(e => e.DataBound((string)UniqueId.VMGrid + "onDataBound"))
          .ToolBar(toolBar => {
                toolBar.Custom()
                .Text("Export To CSV")
                .HtmlAttributes(new { id = "export", data_link_type = "export-csv-assets" })
                .Url("javascript: exportVmsToCsv();");
            })
          .DataSource(dataSource => dataSource
                                        .Ajax()
                                        .Total(Convert.ToInt32(Model.DataParameters.TotalRecordCount))
                                                .Model(model => {
                                                    model.Id(p => p.AuthorizationCode);
                                                    model.Field(f => f.VmUseCount).Editable(false);
                                                    model.Field(f => f.Description).Editable(false);
                                                    model.Field(f => f.VmTotalCount).Editable(false);
                                                    model.Field(f => f.IsNsx).Editable(false);
                                                    model.Field(f => f.IsPerpetualNsx).Editable(false);
                                                    model.Field(f => f.AllowGeneratingPanorama).Editable(false);
                                                    model.Field(f => f.DisplayExpirationDate).Editable(false);
                                                })
                                                .Events(e => e.Error((string)UniqueId.VmView + "onVmViewGridError"))
                                        .PageSize(Model.DataParameters.PaginationCount)
                                        .Read(read => read.Action("SearchAvailable", "VM").Data("getSearchParams"))
                                        .Create(x => x.Action("AddVmAuthCode", "VM").Data("SetAntiForgery"))
          ))
</div>