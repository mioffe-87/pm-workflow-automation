	''' <summary>Class which represents a row in the typed list '<%=typedList.FullName%>'.</summary>
	''' <remarks>Contains the following entity definition(s):
<%	foreach(var alias in typedList.Vertices.OrderBy(v=>v.TextualRepresentation))
	{
%>	''' Entity: <%=alias.AliassedEntity.FullName%>. <% if(!string.IsNullOrEmpty(alias.Alias)) { %> Aliassed as: <%=alias.Alias%> <%}%><br/>
<%	}
%>	''' Custom Properties: <br/>
<%	foreach(var kvp in typedList.OutputSettingValues.CustomProperties)
	{
%>	''' <%=kvp.Key%>: <%=kvp.Value%>		
<%	}
%>	''' </remarks>
<%	string inheritedTypesAsString = SD_LinqToSqlGeneralUtils.GetInheritedTypesAsStringVBNet(typedList, "TypedListRowBaseClassName", currentProject);
	foreach(var additionalAttribute in SD_LinqToSqlGeneralUtils.GetAttributes(typedList, currentProject))
	{
%>	<%=_executingGenerator.ProduceRealAttributeString(additionalAttribute)%>
<%	}
%>	Public Class <%=typedList.Name%>TypedListRow
<% 	if(!string.IsNullOrEmpty(inheritedTypesAsString)) 
	{ 
%><%=inheritedTypesAsString%>
<%	}
%>
#Region "Class Member Declarations"
<%	foreach(var field in fields)
	{
		bool emitAsOptional = field.MappedFieldInstance.IsOptional || nullableAliases.Contains(field.SourceEntityAlias);
%>		Private _<%=GeneratorUtils.CamelCaseString(field.FieldAlias)%> As <%=SD_LinqToSqlGeneralUtils.ProduceDotNetTypeNameVBNet(field.MappedFieldInstance.FieldType.RepresentedType, currentProject, emitAsOptional, "Nullable(Of {0})")%>
<%	}
%>#End Region

#Region "Extensibility Method Definitions"
		Partial Private Sub OnCreated()
		End Sub
#End Region
		
		''' <summary>Initializes a new instance of the <see cref="<%=typedList.Name%>TypedListRow"/> class.</summary>
		Public Sub New()
			MyBase.New()
			OnCreated()
		End Sub
<# SD_LinqToSqlCustomTypedListRowInclude #>
#Region "Class Property Declarations"
<%	foreach(var field in fields)
	{
%>		''' <summary>Gets the <%=field.FieldAlias%> field. Mapped onto '<%=field.MappedFieldWithSourceEntityAliasAsString%>'</summary>
<%		if(field.OutputSettingValues.CustomProperties.Count>0)
		{
%>		''' <remarks>Custom Properties: <br/>
<%			foreach(var kvp in field.OutputSettingValues.CustomProperties)
			{
%>		''' <%=kvp.Key%>: <%=kvp.Value%><br/>
<%			}
%>		''' </remarks>
<%		}
		foreach(var additionalAttribute in SD_LinqToSqlGeneralUtils.GetAttributes(field, currentProject))
		{
%>		<%=_executingGenerator.ProduceRealAttributeString(additionalAttribute)%>
<%		}
		bool emitAsOptional = field.MappedFieldInstance.IsOptional || nullableAliases.Contains(field.SourceEntityAlias);
%>		<%=propertyAccessor%> Property <%=field.FieldAlias%> As <%=SD_LinqToSqlGeneralUtils.ProduceDotNetTypeNameVBNet(field.MappedFieldInstance.FieldType.RepresentedType, currentProject, emitAsOptional, "Nullable(Of {0})")%>
			Get	
				Return _<%=GeneratorUtils.CamelCaseString(field.FieldAlias)%>
			End Get
			Set 
				_<%=GeneratorUtils.CamelCaseString(field.FieldAlias)%> = value
			End Set
		End Property
		
<%	}
%>#End Region
	End Class
End Namespace

