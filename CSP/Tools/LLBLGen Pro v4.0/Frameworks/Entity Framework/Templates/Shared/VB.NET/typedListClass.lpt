%>		Private _<%=GeneratorUtils.CamelCaseString(field.FieldAlias)%> As <%=GeneratorUtils.ProduceDotNetTypeName(field.MappedFieldInstance.FieldType.RepresentedType, emitAsOptional, "Nullable(Of {0})")%>
