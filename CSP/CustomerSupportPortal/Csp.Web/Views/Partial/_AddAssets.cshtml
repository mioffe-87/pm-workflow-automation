<script>
    $("#copyRight").on("click", function (idx, elem) {
        MoveRows($('#' + availablePurchasesGridId).data('kendoGrid'), $('#' + selectedPurchasesGridId).data('kendoGrid'), false);
    });

    $("#copyLeft").on("click", function (idx, elem) {
        MoveRows($('#' + selectedPurchasesGridId).data('kendoGrid'), $('#' + availablePurchasesGridId).data('kendoGrid'), false);
    });

    $("#copyAllRight").on("click", function (idx, elem) {
        MoveRows($('#' + availablePurchasesGridId).data('kendoGrid'), $('#' + selectedPurchasesGridId).data('kendoGrid'), true);
    });

    $("#copyAllLeft").on("click", function (idx, elem) {
        MoveRows($('#' + selectedPurchasesGridId).data('kendoGrid'), $('#' + availablePurchasesGridId).data('kendoGrid'), true);
    });

    function ClaimPurchases(e) {
        SupportPortal.ClearNotification();

        e.preventDefault ? e.preventDefault() : e.returnValue = false;
        var message = "Are you sure, you want to add the selected assets";
        var data = $('#' + selectedPurchasesGridId).data('kendoGrid').dataSource.data();

        if (data.length === 0) {
            SupportPortal.Message("Please select the assets you want to add");
            return;
        }

        var claimPurchasesAction = function () {
            SupportPortal.BlockUI();

            $.ajax({
                url: '@(Url.Action("ClaimPurchases", "BulkRegistration"))',
                type: 'POST',
                dataType: 'json',
                data: JSON.stringify({ purchases: data }),
                contentType: 'application/json; charset=utf-8',
                headers: { "__RequestVerificationToken": $("input[name=__RequestVerificationToken]").val() },
                cache: false,
                success: function (result) {
                    SupportPortal.UnBlockUI();

                    if (result.Success) {
                        SupportPortal.Notification(result.Message, SupportPortal.NotificationType.Success);
                        $('#' + selectedPurchasesGridId).data('kendoGrid').dataSource.data([]);
                        $('#btnCancelAdd').trigger('click');

                        return;
                    }

                    SupportPortal.Notification(result.Message, SupportPortal.NotificationType.Error);
                },
                error: function () {
                    SupportPortal.UnBlockUI();
                    SupportPortal.Notification("Failed to claim your selected purchases.", SupportPortal.NotificationType.Error);
                }
            });
        };

        SupportPortal.Confirmation(message, function () { claimPurchasesAction(); }, null);
    }

