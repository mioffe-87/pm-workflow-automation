<?xml version="1.0" encoding="utf-8"?>
<preset name="SD.Presets.Adapter.TwoClasses" lastModifiedOn="2013-02-20T14:54:41.7418616+02:00" createdBy="FB" isSealed="true" xmlns="http://sd/llblgen/pro/presetElementDefinitions.xsd">
	<supportedPlatforms>
