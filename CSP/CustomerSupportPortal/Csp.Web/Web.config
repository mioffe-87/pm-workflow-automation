		<add name="MarketplaceDatabase" connectionString="" providerName="MySql.Data.MySqlClient" />
		<add name="TempDatabase" connectionString="" providerName="MySql.Data.MySqlClient" />
	</connectionStrings>
	<system.net>
		<mailSettings>
			<smtp deliveryMethod="Network" from="noreply@paloaltonetworks.com ">
				<network host="sjccmtavip.paloaltonetworks.local" port="25" />
				<specifiedPickupDirectory pickupDirectoryLocation="c:\emails" />
			</smtp>
		</mailSettings>
