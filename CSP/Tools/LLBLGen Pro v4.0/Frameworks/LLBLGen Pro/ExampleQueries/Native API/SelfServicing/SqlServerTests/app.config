<?xml version="1.0"?>
<configuration>
	<appSettings>
		<!-- adjust connection strings-->
		<add key="ConnectionString.SQL Server (SqlClient)" value="data source=server;initial catalog=Northwind;integrated security=SSPI;persist security info=False;packet size=4096"/>
		<add key="AdventureWorks.ConnectionString.SQL Server (SqlClient)" value="data source=server;initial catalog=AdventureWorks;integrated security=SSPI;persist security info=False;packet size=4096"/>
		<add key="autoDependencyInjectionDiscovery" value="true"/>
	</appSettings>
		<system.diagnostics>
		<switches>
			<add name="SqlServerDQE" value="4"/>
			<add name="AccessDQE" value="4"/>
			<add name="OracleDQE" value="0"/>
			<add name="FirebirdDQE" value="0"/>
			<add name="MySqlDQE" value="0"/>
			<add name="DB2DQE" value="0"/>
			<add name="ORMGeneral" value="0"/>
			<add name="ORMStateManagement" value="0"/>
			<add name="ORMPersistenceExecution" value="0"/>
		</switches>
	</system.diagnostics>
</configuration>
