    function Download(e) {
        e.preventDefault ? e.preventDefault() : e.returnValue = false;
        var downloadsWindow = $('#@UniqueId.DownloadsWindow').data('kendoWindow');
        downloadsWindow.refresh('/updates/softwareupdates?id=@(Model.ActionHelper.Id)&vmDevices=true');
        downloadsWindow.setOptions({ minHeight: 200 });
        downloadsWindow.open();
        downloadsWindow.center();
    }

    function DownloadLicense(e) {
        e.preventDefault ? e.preventDefault() : e.returnValue = false;
        var item = this.dataItem($(e.currentTarget).closest("tr"));
        window.location.href = "/License/DownloadLicenseKey?licenseId=" + item.PanoramaLicenseId;
    }

    //show renewal items dialog
    function ShowRenewalItems(e) {
        var direction = '/CnSeries/Renewal';
        var dataItem = this.dataItem($(e.target).closest("tr"));
        var window = $('#@UniqueId.RenewalWindow').data("kendoWindow");
        window.refresh(direction + '?authCode=' + dataItem.AuthorizationCode + '&description=' + dataItem.Description + '&partNumber=' + dataItem.ProductSku) ;
        window.setOptions({ minHeight: 665, minWidth: 500 });
        window.title("CN-Series RENEWAL: " + dataItem.AuthorizationCode);
        window.open();
        window.center();        
    }

    //deactivate CnSeries-ELA Authcode only
    function DeactivateCnSeries(e) {
        var direction = '/CnSeries/DeactivateCnSeries';
        var dataItem = this.dataItem($(e.target).closest("tr"));
        var window = $('#@UniqueId.DeactivateCnSeriesWindow').data("kendoWindow");
        window.refresh(direction + '?authCode=' + dataItem.AuthorizationCode) ;
        window.setOptions({ minHeight: 500, minWidth: 400 });
        window.title("Deactivate CN-Series");
        window.open();
        window.center();                
    }

    function onDownloadsWindowOpen() {
        SupportPortal.OnWindowOpen('@UniqueId.DownloadsWindow');
    }

    function onAllocateTokensToPanoramaWindowOpen() {
        SupportPortal.OnWindowOpen('@UniqueId.AllocateTokensToPanoramaWindow');
    }

    function onAllocateTokensToPanoramaWindowClose() {
        SupportPortal.OnWindowClose('@UniqueId.CnSeriesAuthCodesGrid');
    }

    function onActivateCnSeriesAuthCodeWindowOpen() {
        SupportPortal.OnWindowOpen('@UniqueId.ActivateCnSeriesAuthCodeWindow');
    }

    function onActivateCnSeriesAuthCodeWindowClose() {
        SupportPortal.OnWindowClose("@UniqueId.CnSeriesAuthCodesGrid");
    }

    function onDeviceViewWindowOpen() {
        SupportPortal.OnWindowOpen('@UniqueId.DeviceViewWindow');
    }
    
    function onPraProvisionWindowOpen() {
        SupportPortal.OnWindowOpen('@UniqueId.PraProvisionWindow');
    }
    
    function onRenewalWindowOpen() {
        SupportPortal.OnWindowOpen('@UniqueId.RenewalWindow');        
    }

    function onDeactivateCnSeriesWindowOpen() {
        SupportPortal.OnWindowOpen('@UniqueId.DeactivateCnSeriesWindow');        
    }

    //Must be set for pop-up to function
    //var deviceWindowId = '#@UniqueId.DeviceViewWindow';

    function onAllocateTokensToPanoramaWindowClose() {
        var newCnSeriesDeviceId = $('#@UniqueId.NewCnSeriesDeviceId');
        if (newCnSeriesDeviceId.val().length > 0) {
            var proddevicegrid = $('.proddevicegrid');
            if (proddevicegrid.length > 0) {
                proddevicegrid.data("kendoGrid").dataSource.read();
            }
            
            var direction = '/Device/Details?deviceId=' + newCnSeriesDeviceId.val();
            var window = $('#@UniqueId.DeviceViewWindow').data('kendoWindow');
            window.content(' ');
            window.refresh();
            window.refresh(direction);
            window.setOptions({ minHeight: 520 });
            window.open();
            window.center();
        }

        SupportPortal.OnWindowClose("@UniqueId.CnSeriesAuthCodesGrid");
    }

    function onWindowClose() {
        SupportPortal.OnWindowClose("@UniqueId.CnSeriesAuthCodesGrid");
    }
    
    function onPraProvisionWindowClose() {
    }

    //close the Renewal dialog.
    function onRenewalWindowClose() {
        var isDataDirty = $('#renewalDataDirty').val();
        if (isDataDirty !== '0') {
            SupportPortal.Confirmation("You haven't saved your changes yet, do you want to exit?", function() {
                $('#renewalDataDirty').val(0);
                $('#@UniqueId.RenewalWindow').data('kendoWindow').close();
            }, null, null);
            this.preventDefault();
        } 
    }
    
    //close the deactivate CnSeries dialog
    function onDeactivateCnSeriesWindowClose() {
        SupportPortal.OnWindowClose("@UniqueId.CnSeriesAuthCodesGrid");
    }

    function onAcceptElaTokensGrantWindowOpen() {
        SupportPortal.OnWindowOpen('@UniqueId.AcceptElaTokensGrantWindow');
    }

    function onAcceptElaTokensGrantWindowClose() {
        // on grant Token window close the page needs to be refreshed to load page based on Access from database
        window.location.href = '/SupportAccount/CnSeries/' + '@Model.SupportAccountId';
    }

    function getSearchParams() {
        var params = SetAntiForgery();
        if ($('#SearchTypeId').val() === 'AuthorizationCodes') {
            params.authCode = $('#FindSearchValue').val();
        } else {
            params.serialNumber = $('#FindSearchValue').val();
        }
        return params;
    }

    function @(UniqueId.CnSeriesAuthCodesGrid)updateRow(e) {
        var grid = $('#@UniqueId.CnSeriesAuthCodesGrid').data('kendoGrid');
        grid.saveRow();
        //TODO Revert Action column - if the update succeeds - HINT look for a input:text...
    }

        function @(UniqueId.CnSeriesAuthCodesGrid)cancelRow(e) {
            var grid = $('#@UniqueId.CnSeriesAuthCodesGrid').data('kendoGrid');
            grid.cancelRow();
        }

            var isPostBack = $('#@UniqueId.isPostBackId');

            function @(UniqueId.CnSeriesGrid)onDataBound(e) {
                var grid = $('#@UniqueId.CnSeriesAuthCodesGrid').data('kendoGrid');
                var gridData = grid.dataSource.view();
                for (var i = 0; i < gridData.length; i++) {
                    var currentUid = gridData[i].uid;
                    var currenRow = grid.table.find("tr[data-uid='" + currentUid + "']");
            
                    if (gridData[i].IsNsx === 0 || (gridData[i].IsNsx === 1 && gridData[i].AllowGeneratingPanorama === 0)) {
                        var provisionPan = $(currenRow).find(".k-grid-ProvisionPanorama");
                        provisionPan.hide();
                    }
            
                    var showRenewButton = false;
                    if (gridData[i].IsVmRenewalEligible && gridData[i].ProductSku != null) {
                        var re = new RegExp('^PAN-CN-X-(((50|100|300|500|700)-PERP-(BASC|BND1|BND2)-(.+)YR)|((100|200|300)-(BND|USG-BND)-(LAB|NFR))|(300-PREM-(BND|BND1|BND2))|(300-PERP-(USG)*-BND)|(1000-HV-(BND|PERP|PERP-BND|PERP-USG-BND|USG-BND|SUB-BND)-(LAB|NFR|NSX)))');
                        if(re.test(gridData[i].ProductSku)) {
                            showRenewButton = true;                    
                        }
                    }

                    //hide Renew button
                    if (!showRenewButton) {
                        $(currenRow).find(".k-grid-Renew").hide();
                    }

                    //hide Deactivate CnSeries button
                    if (gridData[i].ProductSku != null) {
                        var re1 = new RegExp('^PAN-CN-X-(50|100|300|500|700)-ELA-BND2');
                        if(!re1.test(gridData[i].ProductSku)) {
                            $(currenRow).find(".k-grid-DeactivateCnSeries").hide();
                        }
                    }
                }
                setTimeout(function () { 
                    setRowsState();
                    var snType = $('#SearchTypeId').val();
                    if (snType === 'SerialNumber') {
                        var sn = $('#FindSearchValue').val().trim();
                        if (sn) {
                            $('.k-detail-cell tr:has(> td:contains(' + sn + '))').addClass('bold');
                        }
                    }
                }, 25);
            }
                
                function @(UniqueId.CnSeriesView)onCnSeriesViewGridError(args) {
                    if (args.errors) {
                        var grid = $("#@UniqueId.CnSeriesAuthCodesGrid").data("kendoGrid");
                        var gridElement = grid.editable.element;

                        grid.one("dataBinding",
                            function(e) {
                                e.preventDefault ? e.preventDefault() : e.returnValue = false; // cancel grid rebind if error occurs

                                $.each(args.errors,
                                    function(key, value) {
                                        if (value.errors) {
                                            gridElement.find("[data-valmsg-for=" + key + "],[data-val-msg-for=" + key + "]")
                                                .replaceWith(SupportPortal.ValidationMessageTemplate({
                                                    field: key,
                                                    message: value.errors[0]
                                                }));
                                            gridElement.find("input[name=" + key + "]").focus();
                                        }
                                    });
                            });
                    }
                }

                    $(function() {
                        deviceWindowId = '#@UniqueId.DeviceViewWindow';
                        var hasPendingTokensRequest = '@Model.HasTokenGrantRequest';
                        if (hasPendingTokensRequest === 'False') {
                            $('#@UniqueId.ReviewTokensGrantBtn').hide();
                        }

                        $('#@UniqueId.AddCnSeriesSeriesAuthCode').click(function() {
                            //Open pop-up window
                            var direction = '/CnSeries/AddCnSeriesAuthCode';
                            var window = $('#@UniqueId.ActivateCnSeriesAuthCodeWindow').data("kendoWindow");
                            window.refresh(direction);
                            window.setOptions({ minHeight: 400 });
                            window.open();
                            window.center();
                        });
                        $('#@UniqueId.AllocateTokensToPanorama').click(function() {
                            //Open pop-up window
                            var direction = '/CnSeries/AllocateTokensToPanorama';
                            var window = $('#@UniqueId.AllocateTokensToPanoramaWindow').data("kendoWindow");
                            window.refresh(direction);
                            window.setOptions({ minHeight: 400 });
                            window.open();
                            window.center();
                        });
                        //review tokens grant button action
                        $('#@UniqueId.ReviewTokensGrantBtn').click(function() {
                            var direction = "/SiteLicense/GetPendingElaTokensGrantItems";
                            var window = $('#@UniqueId.AcceptElaTokensGrantWindow').data("kendoWindow");
                            window.refresh(direction);
                            window.open();
                            window.center();
                        });

                        $('#@UniqueId.ReleasedCnSeriesAuthCodes').click(function() {
                            var direction = "/CnSeries/ViewReleasedLicenses";
                            var window = $("#@UniqueId.releasedCnSeriesLicensesWindowId").data("kendoWindow");
                            window.content(" ");
                            window.setOptions({ minHeight: 400, minWidth: 350 });
                            window.bind('open', onOpenReleasedCnSeriesAuthCodesWindow);
                            window.bind('close', onCloseReleasedCnSeriesAuthCodesWindow);
                            window.title("Available CN-Series Licenses");
                            window.refresh();
                            window.refresh(direction);
                            window.open();
                            window.center();
                        });

                        function onOpenReleasedCnSeriesAuthCodesWindow() {
                            SupportPortal.OnWindowOpen("@UniqueId.releasedCnSeriesLicensesWindowId");
                        }

                        function onCloseReleasedCnSeriesAuthCodesWindow() {
                            var window = $("#@UniqueId.releasedCnSeriesLicensesWindowId").data("kendoWindow");
                            window.content(" ");
                            window.refresh();

                            SupportPortal.OnWindowClose("@UniqueId.CnSeriesAuthCodesGrid");
                        }


                        $('#@UniqueId.DeactivateLicenses').click(function() {
                            var direction = "/CnSeries/DeactivateLicenses";
                            var window = $("#@UniqueId.deactivateLicensesWindowId").data("kendoWindow");
                            window.content(" ");
                            window.setOptions({ minHeight: 400 });
                            window.bind('open', onOpenDeactivateLicensesWindow);
                            window.bind('close', onCloseDeactivateLicensesWindow);
                            window.title("Deactivate Licenses");
                            window.refresh();
                            window.refresh(direction);
                            window.open();
                            window.center();
                        });

                        function onOpenDeactivateLicensesWindow() {
                            SupportPortal.OnWindowOpen("@UniqueId.deactivateLicensesWindowId");
                        }

                        function onCloseDeactivateLicensesWindow() {
                            var window = $("#@UniqueId.deactivateLicensesWindowId").data("kendoWindow");
                            window.content("");
                            window.refresh();

                            SupportPortal.OnWindowClose("@UniqueId.CnSeriesAuthCodesGrid");
                        }
                    });

                    function onSearchEnterPress(e) {
                        if (e.keyCode == 13) {
                            findCN();
                            return false;
                        }

                        return true;
                    }

                    function findCN() {
                        $('#@UniqueId.CnSeriesAuthCodesGrid').data('kendoGrid').dataSource.read();
                        return false;
                    }

                    function exportCnSeriesToCsv() {

                        var val = $('#FindSearchValue').val();

                        if (val === 'AuthorizationCodes') {
                            location.href = '@Url.Action("SearchAvailableReport", "CnSeries")?authCode=' + val;
                        } else {
                            location.href = '@Url.Action("SearchAvailableReport", "CnSeries")?serialNumber=' + val;
                        }
                    }
</script>

