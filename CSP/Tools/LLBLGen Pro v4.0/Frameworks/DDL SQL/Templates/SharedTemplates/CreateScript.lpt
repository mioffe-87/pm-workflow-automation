<[ SD.Tools.Algorithmia.GeneralDataStructures ]>
<~ 
	private Project _currentProject;
~>
<# SD_DDLSQL_FieldCreationInclude #>
<%
	_currentProject = _executingGenerator.ProjectDefinition;
%>-- ----------------------------------------------------------------------------------------------------------------
-- Generated by LLBLGen Pro v<%=ApplicationConstants.LLBLGenProVersion%>  Build: <%=ApplicationConstants.LLBLGenProReleaseDate%>
-- <%=_executingGenerator.GetDatabaseNameForDriverID()%> DDL Script generated from project: <%=_currentProject.ProjectName%>
-- Project filename: <%=_currentProject.Properties.ProjectLocationPathFilename %>
-- Script generated on: <%=DateTime.Now.ToString("dd-MMM-yyyy HH:mm.ss")%>
--
-- This is a Create script for creating a NEW data model. If you want DDL SQL for updating an existing model,
-- please create an Update script instead. 
--
-- This script might create schemas, which requires you to assign a proper user to the schema. Adjust the CREATE SCHEMA
-- statements below, if any, to avoid errors at runtime. Schemas aren't dropped in the DROP section.
--
--      >>>>> WARNING <<<<<
--      This is a CREATE script, with DROP statements for the existing tables, foreign keys and other constraints
--      This means that existing tables, data, constraints and other elements in the catalog/schemas addressed
--      are deleted. Use this Create script only to create new schemas with tables/constraints and other elements.
--
-- ----------------------------------------------------------------------------------------------------------------
-- ###############################################################################################################
-- DROP statements for existing elements. 
-- ###############################################################################################################
-- DROP statements for dropping existing elements with the same names as the ones created are commented out below. 
-- If you want to enable these statements for DROPping the existing elements first (which will remove all the data
-- in these existing elements), uncomment these statements by removing the two comment markers /* and */

-- Remove the comment marker on the NEXT line to enable DROP statements to remove existing elements
/* 
<%
	// Catalogs
	HashSet<DBCatalog> existingCatalogs = _currentProject.GetAllPopulatedCatalogsFromMetaData(_executingGenerator.DriverID);
	foreach(DBCatalog catalog in existingCatalogs.OrderBy(c=>c.CatalogName))
	{
		string catalogName = catalog.CatalogName;
%><# SD_DDLSQL_SetActiveCatalogInclude #><%
		var allForeignKeyConstraints = (from s in catalog.Schemas
									   from t in s.Tables
									   from fk in t.ForeignKeyConstraints
									   where !fk.CreatedByDesigner
									   select fk).ToList();
		if(allForeignKeyConstraints.Count>0)
		{
%>-- ----------------------------------------------------------------------------------------------------------------
-- DROP Foreign keys
-- ----------------------------------------------------------------------------------------------------------------
<%
			foreach(DBForeignKeyConstraint foreignKeyConstraint in allForeignKeyConstraints.OrderBy(fk=>fk.AppliesToTable.FullName).ThenBy(fk=>fk.ConstraintName))
			{
				string schemaName = foreignKeyConstraint.AppliesToTable.ContainingSchema.SchemaOwner;
				string tableName = foreignKeyConstraint.AppliesToTable.Name;
				string constraintName = foreignKeyConstraint.ConstraintName;
%><# SD_DDLSQL_DropForeignKeyConstraintInclude #><%
			}
		}
		
		foreach(DBSchema schema in catalog.Schemas.Where(s=>!s.CreatedByDesigner).OrderBy(s=>s.SchemaOwner))
		{
			string schemaName = schema.SchemaOwner;
			if(schema.Tables.Count>0)
			{
%>-- ----------------------------------------------------------------------------------------------------------------
-- DROP tables for schema '<%=schemaName%>' 
-- ----------------------------------------------------------------------------------------------------------------
<%
				// All tables
				foreach(DBTable table in schema.Tables.Where(t=>!t.CreatedByDesigner).OrderBy(t=>t.Name))
				{
					string tableName = table.Name;
%><# SD_DDLSQL_DropTableInclude #><%
				}
			}
			
			if(schema.Sequences.Count>0)
			{
%>-- ----------------------------------------------------------------------------------------------------------------
-- DROP sequences for schema '<%=schemaName%>'
-- ----------------------------------------------------------------------------------------------------------------
<%
				// All sequences
				foreach(DBSequence sequence in schema.Sequences.Where(s=>!s.CreatedByDesigner).OrderBy(s=>s.Name))
				{
					string sequenceName = sequence.Name;
%><# SD_DDLSQL_DropSequenceInclude #><%
				}
			}
		}
	}
%>*/
-- Remove the comment marker on the PREVIOUS line to enable DROP statements to remove existing elements

-- ###############################################################################################################
-- Create statements for catalogs, schemas, tables and sequences
-- ###############################################################################################################
<%
	// Catalogs
	foreach(DBCatalog catalog in existingCatalogs.OrderBy(c=>c.CatalogName))
	{
		string catalogName = catalog.CatalogName;
%>-- ----------------------------------------------------------------------------------------------------------------
-- Catalog '<%=catalogName%>'
-- ----------------------------------------------------------------------------------------------------------------
<# SD_DDLSQL_CreateCatalogInclude #>
<# SD_DDLSQL_SetActiveCatalogInclude #><%		

		// Schemas
		foreach(DBSchema schema in catalog.Schemas.OrderBy(s=>s.SchemaOwner))
		{
			string schemaName = schema.SchemaOwner;
%>-- ----------------------------------------------------------------------------------------------------------------
-- Schema '<%=schemaName%>'
-- ----------------------------------------------------------------------------------------------------------------
<# SD_DDLSQL_CreateSchemaInclude #>
<%
			if(schema.Tables.Count>0)
			{
%>-- -------[ Tables ]-----------------------------------------------------------------------------------------------
<%
				// Tables
				foreach(DBTable table in schema.Tables.OrderBy(t=>t.Name))
				{
%><# SD_DDLSQL_CreateTableInclude #><%
				}
			}

			if(schema.Sequences.Count>0)
			{
%>-- -------[ Sequences ]--------------------------------------------------------------------------------------------
<%			
				// Sequences
				foreach(DBSequence sequence in schema.Sequences.OrderBy(s=>s.Name))
				{
					string sequenceName = sequence.Name;
%><# SD_DDLSQL_CreateSequenceInclude #><%
				}
			}
		}
	}
%>
-- ###############################################################################################################
-- Create statements for Primary key constraints, Foreign key constraints and Unique constraints
-- ###############################################################################################################
<%
	// Catalogs
	foreach(DBCatalog catalog in existingCatalogs.OrderBy(c=>c.CatalogName))
	{
		string catalogName = catalog.CatalogName;
%>-- ----------------------------------------------------------------------------------------------------------------
-- Catalog '<%=catalogName%>'
-- ----------------------------------------------------------------------------------------------------------------
<# SD_DDLSQL_SetActiveCatalogInclude #><%		
		// Schemas
		foreach(DBSchema schema in catalog.Schemas.OrderBy(s=>s.SchemaOwner))
		{
			string schemaName = schema.SchemaOwner;
			if(schema.Tables.Count>0)
			{
%>-- ----------------------------------------------------------------------------------------------------------------
-- Primary Key constraints for schema '<%=schemaName%>'
-- ----------------------------------------------------------------------------------------------------------------
<%			
				// Primary key constraints
				foreach(DBTable table in schema.Tables.Where(t=>t.PrimaryKeyFields.Count()>0).OrderBy(t=>t.Name))
				{
					string constraintName = table.PrimaryKeyFields.First().PrimaryKeyConstraintName;
%><# SD_DDLSQL_CreatePrimaryKeyConstraintInclude #><%
				}

%>-- ----------------------------------------------------------------------------------------------------------------
-- Unique constraints for schema '<%=schemaName%>'
-- ----------------------------------------------------------------------------------------------------------------
<%			
				// Unique constraints
				foreach(DBTable table in schema.Tables.Where(t=>t.UniqueConstraints.Count>0).OrderBy(t=>t.Name))
				{
					foreach(DBUniqueConstraint uniqueConstraint in table.UniqueConstraints.OrderBy(uc=>uc.ConstraintName))
					{
						string tableName = uniqueConstraint.AppliesToTable.Name;
						string constraintName = uniqueConstraint.ConstraintName;
%><# SD_DDLSQL_CreateUniqueConstraintInclude #><%
					}
				}
			}
		}
		
		var allForeignKeyConstraints = (from s in catalog.Schemas
									   from t in s.Tables
									   from fk in t.ForeignKeyConstraints
									   where !fk.MarkedForDeletion
									   orderby s.SchemaOwner ascending, t.Name ascending, fk.ConstraintName ascending
									   select fk).ToList();
		if(allForeignKeyConstraints.Count>0)
		{
%>-- ----------------------------------------------------------------------------------------------------------------
-- All foreign Key constraints
-- ----------------------------------------------------------------------------------------------------------------
<%			
			// Foreign key constraints
			foreach(DBForeignKeyConstraint foreignKeyConstraint in allForeignKeyConstraints)
			{
				DBTable fkTable = foreignKeyConstraint.AppliesToTable;
				string schemaName = fkTable.ContainingSchema.SchemaOwner;
				DBTable pkTable = foreignKeyConstraint.PKSide;
				string tableName = foreignKeyConstraint.AppliesToTable.Name;
				string constraintName = foreignKeyConstraint.ConstraintName;
				IEnumerable<Pair<IProjectElementFieldMapTargetElement, IProjectElementFieldMapTargetElement>> fkPkFieldPairs = foreignKeyConstraint.GetFkPkFieldPairs();
%><# SD_DDLSQL_CreateForeignKeyConstraintInclude #><%
			}
		}
	}
%>