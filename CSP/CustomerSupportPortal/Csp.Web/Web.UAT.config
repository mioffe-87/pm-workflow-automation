<?xml version="1.0" encoding="utf-8"?>
<configuration xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">

  <connectionStrings></connectionStrings>
  <appSettings>
    <!--GCP Vault Config-->
    <!--GCP Vault Config-->
    <add key="AppEnv" value="uat"  xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
    <add key="LocalDevSecretsFile" xdt:Transform="Remove" xdt:Locator="Match(key)"/>
    <add key="VaultUrl" value="http://127.0.0.1:8200/v1/IT/kv/data/stage/csp/secret_uat" xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
    <!--SSO Settings - //TODO: Check if this needs to be true-->
    <add key="EnableSsl" value="false" xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
  </appSettings>
  <system.net>
    <mailSettings>
      <smtp deliveryMethod="Network" xdt:Transform="SetAttributes"></smtp>
    </mailSettings>
  </system.net>
  <elmah>
    <security allowRemoteAccess="1" xdt:Transform="SetAttributes" />
  </elmah>
  <system.serviceModel>
    <bindings xdt:Transform="Replace">
      <basicHttpBinding>
        <binding name="BasicHttpBinding_ILicense" />
        <binding name="LicenseService2Soap" openTimeout="0:10:0" closeTimeout="0:10:0" sendTimeout="0:10:0" receiveTimeout="0:10:0">
          <security mode="Transport">
            <transport clientCredentialType="Basic" proxyCredentialType="Basic" realm=""></transport>
            <message clientCredentialType="UserName"/>
          </security>
        </binding>
        <binding name="UpdateService2Soap" maxReceivedMessageSize="2147483647" openTimeout="0:10:0" closeTimeout="0:10:0" sendTimeout="0:10:0" receiveTimeout="0:10:0">
          <security mode="Transport">
            <transport clientCredentialType="Basic" proxyCredentialType="Basic" realm=""></transport>
            <message clientCredentialType="UserName"/>
          </security>
        </binding>
        <binding name="BasicHttpBinding_ILoginService" />
        <binding name="EvalWebServiceBinding">
          <security mode="Transport" />
        </binding>
      </basicHttpBinding>
    </bindings>
    <client>
      <endpoint name="LicenseService2Soap" address="https://staticupdatestest.paloaltonetworks.com/license/licenseservice2.asmx" xdt:Transform="SetAttributes" xdt:Locator="Match(name)"/>
      <endpoint name="UpdateService2Soap" address="https://staticupdatestest.paloaltonetworks.com/updates/updateservice2.asmx" xdt:Transform="SetAttributes" xdt:Locator="Match(name)"/>
    </client>
  </system.serviceModel>
  <system.webServer>
    <httpProtocol xdt:Transform="Insert">
      <customHeaders>
        <add name="X-Frame-Options" value="SAMEORIGIN" />
        <add name="Content-Security-Policy" value="frame-ancestors 'self' https://*.paloaltonetworks.com" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>
</configuration>