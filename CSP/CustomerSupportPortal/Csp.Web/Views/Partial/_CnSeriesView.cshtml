        <input type="button" value="Expand All" id="expand-all" class="k-button" />
        <input type="button" value="Collapse All" id="collapse-all" class="k-button" />
    </div>
</div>
<div>
    @{
        var maxPageSizeForms = Convert.ToInt32(Model.DataParameters.TotalRecordCount);
        var pageSizeOptionsForms = new List<int> { 5, 10, 20, 50 };
        if (maxPageSizeForms > pageSizeOptionsForms.Max()) {
            pageSizeOptionsForms.Add(maxPageSizeForms);
        }
    }

    @(Html.Kendo().Grid(Model.AvailableVms)
        .Name((string)UniqueId.CnSeriesAuthCodesGrid)
        .Columns(cols => {
            cols.Bound(x => x.AuthorizationCode).Title("Auth Code").Sortable(false).Width(100);
            cols.Bound(x => x.ProductSku).Title("Part Number").Sortable(false);
            cols.Bound(x => x.Description).Title("Description").Sortable(false);
            cols.Bound(x => x.VmTotalCount).Title("Tokens Purchased").Sortable(false).Width(160);
            cols.Bound(x => x.VmAllocated).Title("Total Tokens Allocated").Sortable(false).Width(160);
            cols.Bound(x => x.VmUseCount).Title("Tokens Available For Allocation").Sortable(false).Width(160);
            cols.Bound(x => x.MonthlyPeakUsageTotal).Title("Total Monthly Usage").Sortable(false).Width(160);
            cols.Bound(x => x.AscName).Title("ASC").Sortable(false).Width(160);
            cols.Bound(x => x.DisplayExpirationDate).Title("Expiration Date").Sortable(false).Width(160);
            cols.Bound(x => x.IsVmRenewalEligible).Sortable(false).Hidden(true);
            /*
            cols.Command(command => {
                command.Custom("csp-download").Text(" ").Click("Download").HtmlAttributes(new { title = "Download", href = "javascript:void(0);", style="font-size: 12px;" });
                command.Custom("DeactivateCnSeries").Click("DeactivateCnSeries").Text("Deactivate").HtmlAttributes(new {style="font-size: 12px;" });
                command.Custom("ProvisionPanorama").Click("ShowNsxDevices").Text("Panorama").HtmlAttributes(new {style="font-size: 12px;" });
                command.Custom("Renew").Click("ShowRenewalItems").Text("Renew").HtmlAttributes(new {style="font-size: 12px;" });
            }).Width(320).Title("Actions");
            */
        })
        .Pageable(pageable => pageable.PageSizes(pageSizeOptionsForms.ToArray()))
        .Sortable()
        .Editable(x => x.Mode(GridEditMode.InLine))
        .ClientDetailTemplateId("template")
        .Events(e => { e.DataBound((string)UniqueId.CnSeriesGrid + "onDataBound"); e.DetailInit("initDetail"); })
        .ToolBar(toolBar => { toolBar
            .Custom()
            .Text("Export To CSV")
            .HtmlAttributes(new { id = "export", data_link_type = "export-csv-assets" })
            .Url("javascript: exportCnSeriesToCsv();");
        })
        .DataSource(dataSource => dataSource
            .Ajax()
            .Model(model => {
                model.Id(p => p.AuthorizationCode);
            })
            .Events(e => e.Error((string)UniqueId.CnSeriesView + "onCnSeriesViewGridError"))
            .PageSize(Model.DataParameters.PaginationCount)
            .Read(read => read.Action("SearchAvailable", "CnSeries").Data("getSearchParams"))
            .Create(x => x.Action("AddCnSeriesAuthCode", "CnSeries").Data("SetAntiForgery"))
            .Total(Convert.ToInt32(Model.DataParameters.TotalRecordCount))
        ))
    <script id="template" type="text/kendo-tmpl">
        @((Html.Kendo().Grid<AvailableCn>()
            .Name("AvailableCnsGrid_#=AuthorizationCode#") // template expression, to be evaluated in the master context
            .Columns(columns =>
            {
                columns.Bound(o => o.SerialNumber).Title("Serial Number");
                columns.Bound(o => o.ProductSku).Title("Panorama Model Name");
                columns.Bound(o => o.VmUseCount).Title("Num. Licenses");
                columns.Bound(o => o.VmTotalCount).Title("Tokens Allocated");
                columns.Bound(o => o.MonthlyAverageUsage).Title("Total Monthly Average Usage <i class='fa fa-info-circle info-icon-color' title='Only available for online Panoramas'></i>");
                //columns.Bound(o => o.TotalAvailable).Title("Total Avail. \\#");
                columns.Bound(o => o.MonthlyPeakUsage).Title("Monthly Peak Usage <i class='fa fa-info-circle info-icon-color' title='Monthly Peak Usage is from prior month'></i>");
                columns.Command(command =>
                {
                    command.Custom("csp-download").Text(" ").Click("DownloadLicense").HtmlAttributes(new { title = "Download", href = "javascript:void(0);", style = "font-size: 12px;" });
                }).Width(160).Title("License Key Download");
            })
            .ToClientTemplate()))
    </script>
    <script>
        function initDetail(e) {
            $("#AvailableCnsGrid_" + e.data.AuthorizationCode).data("kendoGrid").dataSource.data(e.data.Vms);
        }

        function setButtonsState() {
            var total = $('.k-master-row').length;
            var selected = $('.k-master-row.bold').length;

            if (total === selected) { // all collapsed
                $('#expand-all').addClass('selected');
                $('#collapse-all').removeClass('selected');
            } else if (selected === 0) { // all expanded
                $('#expand-all').removeClass('selected');
                $('#collapse-all').addClass('selected');
            } else {
                $('#expand-all').removeClass('selected');
                $('#collapse-all').removeClass('selected');
            }
        }
        
        function setRowsState() {
            $('.k-master-row > td.k-hierarchy-cell a').click(function flipMasterRow(e) {
                var el = $(this).parent().parent()
                if (el.hasClass('bold')) {
                    el.removeClass('bold');
                } else {
                    el.addClass('bold');
                }
                setButtonsState();
            });
            $('.k-master-row > td.k-hierarchy-cell a').click();
            $('#expand-all').click(function() {
                $('.k-master-row:not(.bold) > td.k-hierarchy-cell a').click();
            });
            $('#collapse-all').click(function() {
                $('.k-master-row.bold > td.k-hierarchy-cell a').click();
            });
            setButtonsState();
        }

        $('#FindSearchValue').keyup(function(e) {
            if (e.keyCode == 13) {
                $('#@UniqueId.FindCnSeries').click();
            }
        });

        //$(document).ready(function () {
        //    $('#@UniqueId.CnSeriesAuthCodesGrid').data('kendoGrid').dataSource.read();
        //});
    </script>
</div>
