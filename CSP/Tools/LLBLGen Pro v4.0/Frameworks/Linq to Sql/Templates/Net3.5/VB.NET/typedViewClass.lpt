<%
	Project currentProject = _executingGenerator.ProjectDefinition;
	TypedViewDefinition typedView = (TypedViewDefinition)_activeObject;
	TypedViewMapping mapping = (TypedViewMapping)currentProject.GetGroupableModelElementMapping(typedView, _executingGenerator.DriverID);
	if(mapping==null)
	{
		mapping = (TypedViewMapping)currentProject.GetGroupableModelElementMapping(typedView, _executingGenerator.DriverID, true);
	}
	IProjectElementMapTargetElement mappedTarget = mapping.MappedTarget;
	// Linq to sql supports multiple catalogs but they've to be hardcoded in the meta-data. Only do this if there are multiple
	// catalogs in the meta-data with mappings.
	var allTargetedCatalogs = currentProject.GetAllMappedTargets(_executingGenerator.DriverID).Select(t=>t.ContainingSchema.ParentCatalog).Distinct();
	bool hasMultipleCatalogs = allTargetedCatalogs.Count() > 1;
	var fields = typedView.Fields.OrderBy(f=>f.Name);
	bool useExternalMappings = currentProject.GetRealBoolSettingValue("MappingsAsExternalXmlFile");
	string propertyAccessor = currentProject.GetRealBoolSettingValue("PublicPropertyGettersAndSetters") ? "Public" : "Private";
	bool tableViewTargetingTypedView = ((mappedTarget.ElementType==ProjectElementMapTargetElementType.Table) || (mappedTarget.ElementType==ProjectElementMapTargetElementType.View));
%>'------------------------------------------------------------------------------
' <auto-generated>This code was generated by LLBLGen Pro v<%=ApplicationConstants.LLBLGenProVersion%>.</auto-generated>
'------------------------------------------------------------------------------
Imports System
Imports System.Data.Linq
Imports System.Data.Linq.Mapping
Imports System.ComponentModel
<%	foreach(var additionalNamespace in typedView.GetAdditionalNamespaces(currentProject))
	{
%>Imports <%=additionalNamespace%>
<%	}
%>

Namespace <%=_executingGenerator.RootNamespaceToUse%>.TypedViewClasses

	''' <summary>Class which represents a row in the typed view '<%=typedView.FullName%>'<% if(tableViewTargetingTypedView) { %>, mapped on <%=mappedTarget.ElementType.ToString().ToLowerInvariant()%> '<%=mappedTarget.FullNameWithCatalog%>'<%}%>.</summary>
<%	if(typedView.OutputSettingValues.CustomProperties.Count>0)
	{
%>	''' <remarks>Custom Properties: <br/>
<%		foreach(var kvp in typedView.OutputSettingValues.CustomProperties)
		{
%>	''' <%=kvp.Key%>: <%=kvp.Value%><br/>
<%		}
%>	''' </remarks>
<%	}

	if(!useExternalMappings && tableViewTargetingTypedView)
	{
%>	<Table(Name:="<% if(hasMultipleCatalogs) {%>[<%=mappedTarget.ContainingSchema.ParentCatalog.CatalogName%>].<%}%>[<%=mappedTarget.ContainingSchema.SchemaOwner%>].[<%=mappedTarget.Name%>]")> _
<%	}

	string inheritedTypesAsString = SD_LinqToSqlGeneralUtils.GetInheritedTypesAsStringVBNet(typedView, "TypedViewRowBaseClassName", currentProject);
	foreach(var additionalAttribute in SD_LinqToSqlGeneralUtils.GetAttributes(typedView, currentProject))
	{
%>	<%=_executingGenerator.ProduceRealAttributeString(additionalAttribute)%>
<%	}
%>	Public Class <%=typedView.Name%>TypedViewRow
<%	if(!string.IsNullOrEmpty(inheritedTypesAsString)) 
	{ 
%><%=inheritedTypesAsString%>
<%	}
%>
#Region "Class Member Declarations"
<%	foreach(IFieldElementCore field in fields)
	{
%>		Private _<%=GeneratorUtils.CamelCaseString(field.Name)%> As <%=SD_LinqToSqlGeneralUtils.ProduceDotNetTypeNameVBNet(field, currentProject, "Nullable(Of {0})")%>
<%	}
%>#End Region

#Region "Extensibility Method Definitions"
		Partial Private Sub OnCreated()
		End Sub
#End Region
		
		''' <summary>Initializes a new instance of the <see cref="<%=typedView.Name%>TypedViewRow"/> class.</summary>
		Public Sub New()
			MyBase.New()
			OnCreated()
		End Sub
<# SD_LinqToSqlCustomTypedViewRowInclude #>
#Region "Class Property Declarations"
<%	foreach(IFieldElementCore field in fields)
	{
		var fieldMapping = mapping.GetFieldMappingOfField(field);
		var targetField = fieldMapping.MappedTarget;
		var camelCasedFieldName = GeneratorUtils.CamelCaseString(field.Name);
%>		''' <summary>Gets the <%=field.Name%> field. Mapped onto target field / column '<%=targetField.FieldName%>'. <%=field.Description%></summary>
<%		if(field.OutputSettingValues.CustomProperties.Count>0)
		{
%>		''' <remarks>Custom Properties: <br/>
<%			foreach(var kvp in field.OutputSettingValues.CustomProperties)
			{
%>		''' <%=kvp.Key%>: <%=kvp.Value%><br/>
<%			}
%>		''' </remarks>
<%		}
		if(!useExternalMappings)
		{
%>		<Column(Name:="<%=targetField.FieldName%>", Storage:="_<%=camelCasedFieldName%>", DbType:="<%=SD_LinqToSqlGeneralUtils.ProduceDbTypeString(targetField)%>"<% if(!field.IsOptional) {%>, CanBeNull:=False<%}%>)> _
<%		}
		foreach(var additionalAttribute in SD_LinqToSqlGeneralUtils.GetAttributes(field, currentProject))
		{
%>		<%=_executingGenerator.ProduceRealAttributeString(additionalAttribute)%>
<%		}
%>		<%=propertyAccessor%> ReadOnly Property <%=field.Name%> As <%=SD_LinqToSqlGeneralUtils.ProduceDotNetTypeNameVBNet(field, currentProject, "Nullable(Of {0})")%>
			Get	
				Return _<%=camelCasedFieldName%>
			End Get
		End Property
		
<%	}
%>#End Region
	End Class
End Namespace
