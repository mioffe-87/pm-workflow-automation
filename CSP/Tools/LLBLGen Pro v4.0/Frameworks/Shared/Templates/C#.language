<?xml version="1.0"?>
<language xmlns="http://sd/llblgen/pro/languageDefinition.xsd" 
		  name="C#" fileExtension ="cs" arrayIndexOperatorOpenChar ="[" hasArrayIndexOperatorOnIdentifier ="false"
		  arrayIndexOperatorCloseChar="]" lineConcatenator="" supportsNamespaces="true" attributeAssignmentOperator="=" attributePattern="[{0}]">
	<keywords>
		<keyword name="trueKeyword" value ="true"/>
		<keyword name="falseKeyword" value ="false"/>
