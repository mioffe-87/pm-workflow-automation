                <text>@(UniqueId.DeviceLicenses)License.showVmUpgradeInProgressStatus(); </text>
            }
            if (Model.Device.IsUpgradeComplete)
            {
                <text>@(UniqueId.DeviceLicenses)License.showVmUpgradeCompleteStatus(); </text>
            }
        }

        @if (Model.Device.IsUpgradeComplete)
