<script>
    var isActivatingAuthCode = false;
    var addWindow = null;

    
    $(document).ready(function () {
        deviceWindowId = "#@UniqueId.deviceWindowId";
    });

  
    //Add New Ep AuthCode inside the grid.
    $(function () {
        deviceWindowId = "#@UniqueId.deviceWindowId";
        $("#PleaseWaitDiv").hide();
        $('#@UniqueId.AddEpAuthCode').click(function () {
            
            var direction = '/EP/AddEndpointLicense';
            var window = $('#@UniqueId.AddLicense').data("kendoWindow");
            window.bind('open', onAddLicenseWindowOpen);
            window.bind('close', onAddLicenseWindowClose);
            window.refresh(direction);
            window.setOptions({
                minHeight: 400,
                width: 540
            });
            window.open();
            window.center();

            // Inline add
            // 
            // var grid = $('#@UniqueId.EpAuthCodesGrid').data('kendoGrid');
            // grid.addRow();
            // var row = $('#@UniqueId.EpAuthCodesGrid').find('input:text').closest('tr');
            // $(row).find("td").eq(8).html("<a href='javascript: void(0)' class='k-button k-button-icontext k-grid-csp-update' onclick='@(UniqueId.EpAuthCodesGrid)updateRow()' title='Update Ep'><span class=' '></span></a> " +
            //     "<a href='javascript: void(0)' class='k-button k-button-icontext k-grid-csp-cancel' onclick='@(UniqueId.EpAuthCodesGrid)cancelRow()' title='Cancel EP Changes'><span class=' '></span></a>");
            // $(row).find('td').eq(2).text('');
            // return false;
        });
        $('#@UniqueId.EpAuthCodesGrid').on("focus", "td", function (e) {
            var iCount = 0;
            $(".k-textbox").on("keydown", function (event) {
                if (event.keyCode == 13) {
                    iCount = iCount + 1;
                    if (iCount == 1) {
                        @(UniqueId.EpAuthCodesGrid)updateRow(event);
                        return false;
                    }
                }
            });

        });
    });
    
    function @(UniqueId.EpGrid)onDataBound(e) {
        ShowHideLicenseKey();
        ShowAscInfo();
        if (addWindow != null) {
            addWindow.close();
        }
    }

    function ShowHideLicenseKey() {
        var grid = $('#@UniqueId.EpAuthCodesGrid').data('kendoGrid');
        var gridData = grid.dataSource.view();
        for (var i = 0; i < gridData.length; i++) {
            var currentUid = gridData[i].uid;
            var currenRow = grid.table.find("tr[data-uid='" + currentUid + "']");
            if (gridData[i].ShowLicenseKey == false) {
                var showLicense = $(currenRow).find(".ep-download-license");
                showLicense.hide();
            }
            if (gridData[i].ShowSoftwareUpdates == false) {
                var showSoftwareUpdates = $(currenRow).find(".ep-download-software");
                showSoftwareUpdates.hide();
            }
        }
    }

    function ShowAscInfo() {
        $("div.AscContactInfo").each(function() {
            var row = $(this).closest("tr");
            var dataItem = $("#@UniqueId.EpAuthCodesGrid").data("kendoGrid").dataItem(row);

            if (dataItem != null && dataItem.ASCId != undefined) {
                $(this).html('<a href="javascript:void(0);" onclick="@(UniqueId.EpGrid)showAscContactDetailsWindow(' + dataItem.ASCId + ')">' + dataItem.ASCName + '</a>');
            }
        });
    }

    function @(UniqueId.EpGrid)showAscContactDetailsWindow(id) {

        var direction = "/@ControllerFields.SupportAccountController/GetAscContactInfo/" + id;
            var window = $("#@UniqueId.ascContactDetailsWindowId").data("kendoWindow");
            window.content(SupportPortal.AjaxLoadingMessage());
            window.refresh();
            window.refresh(direction);
            window.setOptions({
                minHeight: 100
            });
            window.open();
            window.center();
        }

    function @(UniqueId.EpView)onEpViewGridError(args) {
        if (args.errors) {
            var grid = $("#@UniqueId.EpAuthCodesGrid").data("kendoGrid");
            var gridElement = grid.editable.element;

            grid.one("dataBinding", function (e) {
                e.preventDefault ? e.preventDefault() : e.returnValue = false; // cancel grid rebind if error occurs

                $.each(args.errors, function (key, value) {
                    if (value.errors) {
                        gridElement.find("[data-valmsg-for=" + key + "],[data-val-msg-for=" + key + "]")
                            .replaceWith(SupportPortal.ValidationMessageTemplate({ field: key, message: value.errors[0] }));
                        gridElement.find("input[name=" + key + "]").focus();
                    }
                });
            });
            
            if (isActivatingAuthCode) {
                SupportPortal.Message("Failed to Activate Endpoint Authcode");
            }

        }
    }

    function kendoGridNewLines(text) {
        return text;
    }

    function  @(UniqueId.EpAuthCodesGrid)updateRow(e) {

        if ($("#AuthorizationCode").val() == "") {
            SupportPortal.Message("Please enter a Authcode");
            return false;
        }

        // Ajax call and get the type of Auth Code
        // Auth Code should be a Cyvera Auth Code
        var urldata = "/EP/ValidateEsmAuthCode?authCode=" + $("#AuthorizationCode").val();
        $.ajax({
            url: urldata,
            async: false,
            type: 'GET',
            cache: false,
            success: function (result) {
                if (result.HasError == true || result.RequiresUserConfirmation == true || result.RequiresUserSelection == true) {
                    if (result.HasError == true) {
                        SupportPortal.LengthyMessage(result.ErrorMessage);
                    } else if (result.RequiresUserConfirmation) {
                        SupportPortal.Confirmation(result.UserConfirmationMessage, function () { AddAuthCode(); }, null);
                    } else {
                        // Show popup window.
                        openAddEpAuthCodeWindowOpen();
                    }
                } else {
                    AddAuthCode();
                }
            },
            error: function () {
                SupportPortal.Message("Error in processing request.");
            }
        });

    }
    
    function  @(UniqueId.EpAuthCodesGrid)cancelRow(e) {
        var grid = $('#@UniqueId.EpAuthCodesGrid').data('kendoGrid');
        grid.cancelRow();
    }
    
    function AddEpLicense(esmAuthCode) {
        var genLicWindow = $('#@UniqueId.AddLicense').data('kendoWindow');
        genLicWindow.content(" ");
        genLicWindow.setOptions({
            minHeight: 650,
            width: 540
        });
        genLicWindow.bind('open', onAddLicenseWindowOpen);
        genLicWindow.bind('close', onAddLicenseWindowClose);
        genLicWindow.refresh();
        genLicWindow.refresh('/EP/AddEndpointLicense?authCode=' + esmAuthCode);
        genLicWindow.open();
        genLicWindow.center();
    }
    
    function onAddLicenseWindowOpen() {
        SupportPortal.OnWindowOpen("@UniqueId.AddLicense");
    }

    function onAddLicenseWindowClose() {
        var window = $("#@UniqueId.AddLicense").data("kendoWindow");
        window.content("");
        window.refresh();
        SupportPortal.OnWindowClose("@UniqueId.EpAuthCodesGrid");
    }

    // Call Genereate Window
    function GenerateLicense(esmAuthCode) {
        var genLicWindow = $('#@UniqueId.GenerateLicense').data('kendoWindow');
        genLicWindow.content(" ");
        genLicWindow.setOptions({
            minHeight: 500,
            width: 700
        });
        genLicWindow.bind('open', onGenerateLicenseWindowOpen);
        genLicWindow.bind('close', onGenerateLicenseWindowClose);
        genLicWindow.refresh();
        genLicWindow.refresh('/EP/ShowLicense?authCode=' + esmAuthCode);
        genLicWindow.open();
        genLicWindow.center();
    }
    
    function onGenerateLicenseWindowOpen() {
        SupportPortal.OnWindowOpen("@UniqueId.GenerateLicense");
    }

    function onGenerateLicenseWindowClose() {
        var window = $("#@UniqueId.GenerateLicense").data("kendoWindow");
        window.content("");
        window.refresh();
    }

    function DownloadSoftwareUpdates(epType) {
        var downloadsWindow = $('#@UniqueId.DownloadsWindow').data('kendoWindow');
