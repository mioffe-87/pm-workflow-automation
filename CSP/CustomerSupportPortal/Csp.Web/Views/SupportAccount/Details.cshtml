<script>

    //$(document).ready(function() {
    //    loadInitialBreadcrumbs();
    //});

    function onSupportAccountTabStripSelect(e) {

        e.preventDefault ? e.preventDefault() : e.returnValue = false;

        var url = '';

        var selectedTab = ''; //$(e.item).text();
        switch (selectedTab) {
        case '@Constants.HOME':
            url = '@(Url.Action("MyAccounts", "SupportAccount", new {id = Model.PartialId}))';
            break;

        case '@Constants.ACCOUNT':
            url = '@(Url.Action("LoadAccountPage", "SupportAccount", new {id = Model.PartialId}))';
            break;

        case '@Constants.GROUPS':
            url = '@(Url.Action("AccountGroups", "SupportAccount", new {id = Model.PartialId}))';
            break;

        case '@Constants.DEVICES':
            url = '@(Url.Action("AccountDevices", "SupportAccount", new {id = Model.PartialId}))';
            break;

        case '@Constants.MEMBERS':
            url = '@(Url.Action("AccountUsers", "SupportAccount", new {id = Model.PartialId}))';
            break;

        case '@Constants.CSSP':
            url = '@(Url.Action("CsspInfo", "SupportAccount", new {id = Model.PartialId}))';
            break;
        }

        if (url != '') {
            location.href = url;
        }
    }

</script>
