        var direction = '/CnSeries/ViewProvisionedPanoramaDevices';
        var dataItem = this.dataItem($(e.target).closest("tr"));
        var window = $('#@UniqueId.PraProvisionWindow').data("kendoWindow");
        window.refresh(direction + '?authCode=' + dataItem.AuthorizationCode + "&partNumber=" + dataItem.ProductSku);
        window.setOptions({ minHeight: 200 });
        window.open();
        window.center();
    }
/*
    function AllocateTokensToPanorama(e) {
        e.preventDefault ? e.preventDefault() : e.returnValue = false;
        var direction = '/CnSeries/AllocateTokensToPanorama';
        var dataItem = this.dataItem($(e.currentTarget).closest("tr"));
        var newCnSeriesDeviceId = $('#@UniqueId.NewCnSeriesDeviceId');
        newCnSeriesDeviceId.val('');
        globalNewCnSeriesDeviceId = '@UniqueId.NewCnSeriesDeviceId';
        var window = $('#@UniqueId.AllocateTokensToPanoramaWindow').data("kendoWindow");
        window.refresh(direction + '?authCode=' + dataItem.AuthorizationCode);
