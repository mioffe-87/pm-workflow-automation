<?xml version="1.0" encoding="utf-8"?>
<preset name="SD.NHibernate (Fluent NHibernate and classes)" lastModifiedOn="2008-04-22T16:06:27.4657865+01:00" createdBy="FB" isSealed="false" xmlns="http://sd/llblgen/pro/presetElementDefinitions.xsd">
	<supportedPlatforms>
		<platform name=".NET 3.5"/>
		<platform name=".NET 4.0"/>
		<platform name=".NET 4.5"/>
	</supportedPlatforms>
	<supportedTemplateGroups>
		<templateGroup name="General"/>
	</supportedTemplateGroups>
	<supportedFrameworks>
		<framework name="NHibernate"/>
	</supportedFrameworks>
	<taskPresets>
		<taskGroupPreset name="SD.Tasks.Base.GenericTaskGroup" displayName="Generate NHibernate Domain model" requiresCleanCache="false">
			<performRule isEnabled="false" settingName="" operator="0" operand=""/>
			<taskPreset name="SD.Tasks.Base.ConsumeLptTemplate" displayName="Generate AssemblyInfo class">
				<performRule isEnabled="false" settingName="" operator="0" operand=""/>
				<parameters>
					<parameter name="destinationFolder" value="Model\Properties"/>
					<parameter name="filenameFormat" value="AssemblyInfo.[extension]"/>
					<parameter name="templateID" value="SD_NHibernateAssemblyInfo"/>
					<parameter name="failWhenExistent" value="true"/>
				</parameters>
			</taskPreset>
			<taskPreset name="SD.Tasks.Base.ConsumeLptTemplate" displayName="Generate Entity Classes">
				<performRule isEnabled="false" settingName="" operator="0" operand=""/>
				<parameters>
					<parameter name="destinationFolder" value="Model\EntityClasses"/>
					<parameter name="templateID" value="SD_NHibernateEntity"/>
					<parameter name="emitType" value="allEntities"/>
					<parameter name="templateAssemblySourceFileFormat" value=""/>
					<parameter name="elementFilter" value="!IsPureManyToManyIntermediate"/>
				</parameters>
			</taskPreset>
			<taskPreset name="SD.Tasks.Base.ConsumeLptTemplate" displayName="Generate ValueType Classes">
				<performRule isEnabled="false" settingName="" operator="0" operand=""/>
				<parameters>
					<parameter name="destinationFolder" value="Model\ValueTypes"/>
					<parameter name="templateID" value="SD_NHibernateValueType"/>
					<parameter name="emitType" value="valuetypes"/>
					<parameter name="templateAssemblySourceFileFormat" value=""/>
				</parameters>
			</taskPreset>
			<taskPreset name="SD.Tasks.Base.ConsumeLptTemplate" displayName="Generate TypedView Classes">
				<performRule isEnabled="false" settingName="" operator="0" operand=""/>
				<parameters>
					<parameter name="destinationFolder" value="Model\TypedViewClasses"/>
					<parameter name="filenameFormat" value="[elementName]TypedViewRow.[extension]"/>
					<parameter name="templateID" value="SD_NHibernateTypedViewRow"/>
					<parameter name="emitType" value="allTypedViews"/>
					<parameter name="templateAssemblySourceFileFormat" value=""/>
				</parameters>
			</taskPreset>
			<taskPreset name="SD.Tasks.Base.ConsumeLptTemplate" displayName="Generate TypedList Classes">
				<performRule isEnabled="false" settingName="" operator="0" operand=""/>
				<parameters>
					<parameter name="destinationFolder" value="Model\TypedListClasses"/>
					<parameter name="filenameFormat" value="[elementName]TypedListRow.[extension]"/>
					<parameter name="templateID" value="SD_NHibernateTypedListRow"/>
					<parameter name="emitType" value="allTypedLists"/>
					<parameter name="templateAssemblySourceFileFormat" value=""/>
				</parameters>
			</taskPreset>
			<taskPreset name="SD.Tasks.Base.GenerateVSNetProject" displayName="Generate VS.NET project file">
				<performRule isEnabled="false" settingName="" operator="0" operand=""/>
				<parameters>
					<parameter name="destinationFolder" value="Model"/>
					<parameter name="filenameFormat" value="[projectName].Model.[extension]proj"/>
					<parameter name="templateID" value="SD_NHibernateVsNet"/>
					<parameter name="buildActionPerExtension" value=".config;None|.hbm.xml;EmbeddedResource|;Compile"/>
				</parameters>
			</taskPreset>
		</taskGroupPreset>
		<taskGroupPreset name="SD.Tasks.Base.GenericTaskGroup" displayName="Generate NHibernate database specific code and FluentNHibernate mapping code" forSpecificDatabase="All" requiresCleanCache="true">
			<performRule isEnabled="false" settingName="" operator="0" operand=""/>
			<taskPreset name="SD.Tasks.Base.ConsumeLptTemplate" displayName="Generate AssemblyInfo class">
				<performRule isEnabled="false" settingName="" operator="0" operand=""/>
				<parameters>
					<parameter name="destinationFolder" value="[driverShortName]\Persistence\Properties"/>
					<parameter name="filenameFormat" value="AssemblyInfo.[extension]"/>
					<parameter name="templateID" value="SD_NHibernateAssemblyInfo"/>
					<parameter name="failWhenExistent" value="true"/>
				</parameters>
			</taskPreset>
			<taskPreset name="SD.Tasks.Base.ConsumeLptTemplate" displayName="Generate Entity Mapping Files">
				<performRule isEnabled="false" settingName="" operator="0" operand=""/>
				<parameters>
					<parameter name="destinationFolder" value="[driverShortName]\Persistence\EntityMappings"/>
					<parameter name="filenameFormat" value="[elementName]Map.[extension]"/>
					<parameter name="templateID" value="SD_NHibernateEntityFluentMapping"/>
					<parameter name="emitType" value="allEntities"/>
					<parameter name="templateAssemblySourceFileFormat" value=""/>
					<parameter name="elementFilter" value="!IsSubType &amp;&amp; !IsPureManyToManyIntermediate"/>
				</parameters>
			</taskPreset>
			<taskPreset name="SD.Tasks.Base.ConsumeLptTemplate" displayName="Generate TypedView Mapping Files">
				<performRule isEnabled="false" settingName="" operator="0" operand=""/>
				<parameters>
					<parameter name="destinationFolder" value="[driverShortName]\Persistence\TypedViewMappings"/>
					<parameter name="filenameFormat" value="[elementName]TypedViewRowMap.[extension]"/>
					<parameter name="templateID" value="SD_NHibernateTypedViewFluentMapping"/>
					<parameter name="emitType" value="allTypedViews"/>
					<parameter name="templateAssemblySourceFileFormat" value=""/>
				</parameters>
			</taskPreset>
			<taskPreset name="SD.Tasks.Base.ConsumeLptTemplate" displayName="Generate TypedListQueryFactory Class">
				<performRule isEnabled="false" settingName="" operator="0" operand=""/>
				<parameters>
					<parameter name="destinationFolder" value="[driverShortName]\Persistence"/>
					<parameter name="filenameFormat" value="TypedListQueryFactory.[extension]"/>
					<parameter name="templateID" value="SD_NHibernateTypedListQueryFactory"/>
					<parameter name="templateAssemblySourceFileFormat" value=""/>
					<parameter name="elementFilter" value="TypedLists.Count &gt; 0"/>
				</parameters>
			</taskPreset>
			<taskPreset name="SD.Tasks.Base.ConsumeLptTemplate" displayName="Generate SessionManager Class">
				<performRule isEnabled="false" settingName="" operator="0" operand=""/>
				<parameters>
					<parameter name="destinationFolder" value="[driverShortName]\Persistence"/>
					<parameter name="filenameFormat" value="SessionManager.[extension]"/>
					<parameter name="templateID" value="SD_NHibernateSessionManagerFluent"/>
					<parameter name="templateAssemblySourceFileFormat" value=""/>
				</parameters>
			</taskPreset>
			<taskPreset name="SD.Tasks.Base.ConsumeLptTemplate" displayName="Generate app.config file">
				<performRule isEnabled="false" settingName="" operator="0" operand=""/>
				<parameters>
					<parameter name="destinationFolder" value="[driverShortName]\Persistence"/>
					<parameter name="filenameFormat" value="app.config"/>
					<parameter name="templateID" value="SD_NHibernateAppConfig"/>
				</parameters>
			</taskPreset>
			<taskPreset name="SD.Tasks.Base.GenerateVSNetProject" displayName="Generate VS.NET project file">
				<performRule isEnabled="false" settingName="" operator="0" operand=""/>
				<parameters>
					<parameter name="destinationFolder" value="[driverShortName]\Persistence"/>
					<parameter name="filenameFormat" value="[projectName].Persistence.[extension]proj"/>
					<parameter name="templateID" value="SD_NHibernatePersistenceVsNet"/>
					<parameter name="buildActionPerExtension" value=".config;None|.cfg.xml;None|.hbm.xml;EmbeddedResource|;Compile"/>
				</parameters>
			</taskPreset>
		</taskGroupPreset>
	</taskPresets>
</preset>
