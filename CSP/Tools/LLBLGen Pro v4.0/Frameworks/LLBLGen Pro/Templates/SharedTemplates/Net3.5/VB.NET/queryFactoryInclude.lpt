 <%
 	var currentProject = _executingGenerator.ProjectDefinition;
	foreach(var tvfCall in _executingGenerator.TvfCalls)
	{
		var entity = tvfCall.ReturnElement as EntityDefinition;
		if(entity==null)
		{
			continue;
		}
		var mapping = currentProject.GetGroupableModelElementMapping(tvfCall, _executingGenerator.DriverID);
 		if(mapping==null)
		{
			continue;
		}
		
		var parameterDeclarations = new List<string>();
		var parameterNames = new List<string>();
		foreach(var parameterMapping in mapping.FieldMappings.OrderBy(fm=>fm.MappedTarget.OrdinalPosition))
		{
			var mappedParameter = parameterMapping.MappedFieldInstance as TvfCallParameterDefinition;
			string parameterNameCamelCased = GeneratorUtils.CamelCaseString(mappedParameter.Name);
			parameterNames.Add(parameterNameCamelCased);
			parameterDeclarations.Add(string.Format("{0} As {1}", 
							parameterNameCamelCased, 
							GeneratorUtils.GetDotNetTypeAsString(mappedParameter.FieldType.RepresentedType, _executingGenerator, "Nullable(Of {0})", mappedParameter.IsOptional)));
		}
 %>
		''' <summary>Creates and returns a new EntityQuery for the <%=entity.Name%> entity fetching data using the Table-valued function <%=tvfCall.Name%>.</summary>
		''' <param name="alias">The alias to use for the table-valued function set.</param>
<%			foreach(var parameterName in parameterNames)
			{
%>		''' <param name="<%=parameterName%>">A parameter of the TVF Call.</param>
<%			}
%>		''' <returns>EntityQuery calling the proper TVF Call</returns>
		Public Function <%=tvfCall.Name%>([alias] As String<%if(parameterDeclarations.Count>0) {%>, <%=string.Join(", ", parameterDeclarations.ToArray())%><% } %>) As EntityQuery(Of <%=entity.Name%>Entity)
			Return Me.<%=entity.Name%>.TargetAs([alias]).From(New TvfCallWrapper(TvfCallFactory.<%=tvfCall.Name%>([alias]<%if(parameterNames.Count>0) {%>, <%=string.Join(", ", parameterNames.ToArray())%><% } %>)))
		End Function
<%	}
%> 