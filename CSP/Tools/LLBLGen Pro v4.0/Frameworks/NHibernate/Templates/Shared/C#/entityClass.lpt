<%
	Project currentProject = _executingGenerator.ProjectDefinition;
	EntityDefinition entity = (EntityDefinition)_activeObject;
	bool isSubType = entity.IsSubType;
	var allRelationshipInfosToTraverse = GeneratorUtils.GetAllRelationshipInfosForEntity(_executingGenerator, entity);
	bool requiresIesiNamespaceReference = allRelationshipInfosToTraverse.Any(ri=>ri.NavigatorInstance.OutputSettingValues.GetRealStringSettingValue("CollectionType", currentProject)=="set");
	var entityFields = entity.Fields.Where(f=>f.FieldType.KindOfType==FieldTypeKind.DotNetType && !f.IsDiscriminator && 
													(!f.IsForeignKeyField || (f.IsForeignKeyField && f.IsPartOfIdentifyingFields))).OrderBy(f=>f.Name);
	var valueTypeFields = entity.Fields.Where(f=>f.FieldType.KindOfType==FieldTypeKind.ValueTypeDefinition).OrderBy(f=>f.Name);
	var identifyingFields = entityFields.Where(f=>f.IsPartOfIdentifyingFields);
	int countOfIdentifyingFields = identifyingFields.Count();
	var pkFieldList = SD_NHibernateGeneralUtils.GetPkFieldsForEntity(entity, _executingGenerator);
	var relationshipsFromPk = (from f in identifyingFields
							   where f.IsForeignKeyField
							   select entity.GetAllRelationshipsContainingFkField(f).First()).Distinct();
	bool pkContainsFk = relationshipsFromPk.Any();
	bool singleFkFormingKey = relationshipsFromPk.Count()==1 && relationshipsFromPk.First().FkFieldsFormPkOfFkSide && 
									relationshipsFromPk.First().FieldRelationships.Count==1;
	if(!singleFkFormingKey)
	{
		// filter out FK fields in entityFields which are part of the pk
		entityFields = entityFields.Where(f=>!f.IsForeignKeyField).OrderBy(f=>f.Name);
	}
	bool supportsPartialMethods = (_executingGenerator.PlatformToUse.GetAspectValue("supportsPartialMethods")!=string.Empty);
	_executingGenerator.StoreValueInRunQueueCache("EntityClassesNamespace", _executingGenerator.RootNamespaceToUse + ".EntityClasses");
