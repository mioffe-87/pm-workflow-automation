<[ SD.Tools.Algorithmia.GeneralDataStructures ]>
<~ 
	private Project _currentProject;
~>
<# SD_DDLSQL_FieldCreationInclude #>
<%
	_currentProject = _executingGenerator.ProjectDefinition;
%>-- ----------------------------------------------------------------------------------------------------------------
-- Generated by LLBLGen Pro v<%=ApplicationConstants.LLBLGenProVersion%>  Build: <%=ApplicationConstants.LLBLGenProReleaseDate%>
-- <%=_executingGenerator.GetDatabaseNameForDriverID()%> DDL Script generated from project: <%=_currentProject.ProjectName%>
-- Project filename: <%=_currentProject.Properties.ProjectLocationPathFilename %>
-- Script generated on: <%=DateTime.Now.ToString("dd-MMM-yyyy HH:mm.ss")%>
--
-- This is an Update script for updating an existing data model to a newer version. If you want DDL SQL for a new model,
-- please create a Create script instead. 
--
-- This script might create schemas, which requires you to assign a proper user to the schema. Adjust the CREATE SCHEMA
-- statements below, if any, to avoid errors at runtime.
--
-- Please run the scripts in the right order, use the timestamp in the filename and inside this script for that.
-- This script might need adjustment in some statements. You should consider this script as a starting point for
-- upgrading the existing data model.
-- ----------------------------------------------------------------------------------------------------------------
-- ###############################################################################################################
-- Drop constraints referring to elements which are changed in this script (constraints are recreated later on)
-- ###############################################################################################################
<%
	HashSet<DBCatalog> existingCatalogs = _currentProject.GetAllPopulatedCatalogsFromMetaData(_executingGenerator.DriverID);

	var _fkConstraintsToRecreate = new HashSet<DBForeignKeyConstraint>();
	var _pkConstraintsToRecreate = new HashSet<DBTable>();
	var _uConstraintsToRecreate = new HashSet<DBUniqueConstraint>();

	// Catalogs
	foreach(DBCatalog catalog in existingCatalogs.OrderBy(c=>c.CatalogName))
	{
		string catalogName = catalog.CatalogName;
%><# SD_DDLSQL_SetActiveCatalogInclude #><%
		
		foreach(DBSchema schema in catalog.Schemas.OrderBy(s=>s.SchemaOwner))
		{
			string schemaName = schema.SchemaOwner;
			// Foreign key constraints
			HashSet<DBElementBase> deletedElements = _currentProject.GetAllConstraintsToDropForUpdateFromMetaData(DBElementType.ForeignKeyConstraint, _executingGenerator.DriverID, catalogName, schemaName);
			foreach(DBForeignKeyConstraint foreignKeyConstraint in deletedElements.Where(fk=>!((DBForeignKeyConstraint)fk).AppliesToTable.CreatedByDesigner && !fk.CreatedByDesigner))
			{
				string tableName = GetOriginalName(foreignKeyConstraint.AppliesToTable);
				string constraintName = foreignKeyConstraint.ConstraintName;
				_fkConstraintsToRecreate.Add(foreignKeyConstraint);
%><# SD_DDLSQL_DropForeignKeyConstraintInclude #><%
			}
			
			// Unique constraints
			deletedElements = _currentProject.GetAllConstraintsToDropForUpdateFromMetaData(DBElementType.UniqueConstraint, _executingGenerator.DriverID, catalogName, schemaName);
			foreach(DBUniqueConstraint uniqueConstraint in deletedElements.Where(uc=>!((DBUniqueConstraint)uc).AppliesToTable.CreatedByDesigner && !uc.CreatedByDesigner))
			{
				string tableName = GetOriginalName(uniqueConstraint.AppliesToTable);
				string constraintName = uniqueConstraint.ConstraintName;
				_uConstraintsToRecreate.Add(uniqueConstraint);
%><# SD_DDLSQL_DropUniqueConstraintInclude #><%
			}
	
			// Primary key constraints
			deletedElements = _currentProject.GetAllConstraintsToDropForUpdateFromMetaData(DBElementType.PrimaryKeyConstraint, _executingGenerator.DriverID, catalogName, schemaName);
			foreach(DBTableField exPkField in deletedElements.Where(f=>!((DBTableField)f).ParentTable.CreatedByDesigner && !f.CreatedByDesigner))		// one field per deleted pk constraint is enough as a table has just 1 at the most.
			{
				string tableName = GetOriginalName(exPkField.ParentTable);
				string constraintName = exPkField.PrimaryKeyConstraintName;
				_pkConstraintsToRecreate.Add(exPkField.ParentTable);
%><# SD_DDLSQL_DropPrimaryKeyConstraintInclude #><%
			}
		}
	}
%>
-- ###############################################################################################################
-- Rename statements
-- ###############################################################################################################
<%
	// Catalogs
	foreach(DBCatalog catalog in existingCatalogs.OrderBy(c=>c.CatalogName))
	{
		string catalogName = GetOriginalName(catalog);
%><# SD_DDLSQL_SetActiveCatalogInclude #><%
		if(((IDBRenameableElement)catalog).IsRenamed)
		{
%><# SD_DDLSQL_RenameCatalogInclude #><%
		}

		foreach(DBSchema schema in catalog.Schemas.OrderBy(s=>s.SchemaOwner))
		{
			// Tables
			HashSet<IDBRenameableElement> renamedElements = _currentProject.GetAllRenamedElementsFromMetaData(DBElementType.Table, _executingGenerator.DriverID, catalog.CatalogName, schema.SchemaOwner);
			if(renamedElements.Count>0)
			{
				foreach(var table in renamedElements.Cast<DBTable>().OrderBy(t=>t.Name))
				{
%><# SD_DDLSQL_RenameTableInclude #><%		
				}
			}

			// Fields
			renamedElements = _currentProject.GetAllRenamedElementsFromMetaData(DBElementType.TableField, _executingGenerator.DriverID, catalog.CatalogName, schema.SchemaOwner);
			if(renamedElements.Count>0)
			{
				foreach(var field in renamedElements.Cast<DBTableField>().OrderBy(f=>f.ParentTable.Name))
				{
%><# SD_DDLSQL_RenameTableFieldInclude #><%
				}
			}
		}
	}
%>
-- ###############################################################################################################
-- DROP statements for elements no longer needed or replaced elements.
-- ###############################################################################################################
<%
	// Catalogs
	foreach(DBCatalog catalog in existingCatalogs.OrderBy(c=>c.CatalogName))
	{
		string catalogName = catalog.CatalogName;
%><# SD_DDLSQL_SetActiveCatalogInclude #><%

		foreach(DBSchema schema in catalog.Schemas.OrderBy(s=>s.SchemaOwner))
		{
			string schemaName = schema.SchemaOwner;

			// Foreign key constraints
			HashSet<DBElementBase> deletedElements = _currentProject.GetAllElementsMarkedForDeletionFromMetaData(DBElementType.ForeignKeyConstraint, _executingGenerator.DriverID, catalogName, schemaName);
			foreach(DBForeignKeyConstraint foreignKeyConstraint in deletedElements)
			{
				if(_fkConstraintsToRecreate.Contains(foreignKeyConstraint))
				{
					continue; // already dropped earlier
				}
				string tableName = foreignKeyConstraint.AppliesToTable.Name;
				string constraintName = foreignKeyConstraint.ConstraintName;
%><# SD_DDLSQL_DropForeignKeyConstraintInclude #><%
			}
			
			// Unique constraints
			deletedElements = _currentProject.GetAllElementsMarkedForDeletionFromMetaData(DBElementType.UniqueConstraint, _executingGenerator.DriverID, catalogName, schemaName);
			foreach(DBUniqueConstraint uniqueConstraint in deletedElements)
			{
				if(_uConstraintsToRecreate.Contains(uniqueConstraint))
				{
					continue; // already dropped earlier
				}
				string tableName = uniqueConstraint.AppliesToTable.Name;
				string constraintName = uniqueConstraint.ConstraintName;
%><# SD_DDLSQL_DropUniqueConstraintInclude #><%
			}
	
			// Primary key constraints
			deletedElements = _currentProject.GetAllElementsMarkedForDeletionFromMetaData(DBElementType.PrimaryKeyConstraint, _executingGenerator.DriverID, catalogName, schemaName);
			foreach(DBTableField exPkField in deletedElements)		// one field per deleted pk constraint is enough as a table has just 1 at the most.
			{
				if(_pkConstraintsToRecreate.Contains(exPkField.ParentTable))
				{
					continue;	// already dropped earlier.
				}
				string tableName = exPkField.ParentTable.Name;
				string constraintName = exPkField.PrimaryKeyConstraintName;
%><# SD_DDLSQL_DropPrimaryKeyConstraintInclude #><%
			}
			
			// Table fields
			deletedElements = _currentProject.GetAllElementsMarkedForDeletionFromMetaData(DBElementType.TableField, _executingGenerator.DriverID, catalogName, schemaName);
			foreach(DBTableField field in deletedElements.Cast<DBTableField>().OrderBy(f=>f.ParentTable.FullName))
			{
				string tableName = field.ParentTable.Name;
				string fieldName = GetOriginalName(field);
%><# SD_DDLSQL_DropTableFieldInclude #><%
			}
			
			// Tables
			deletedElements = _currentProject.GetAllElementsMarkedForDeletionFromMetaData(DBElementType.Table, _executingGenerator.DriverID, catalogName, schemaName);
			foreach(DBTable table in deletedElements.Cast<DBTable>().OrderBy(t=>t.Name))
			{
				string tableName = GetOriginalName(table);
%><# SD_DDLSQL_DropTableInclude #><%
			}
			
			// Sequences
			deletedElements = _currentProject.GetAllElementsMarkedForDeletionFromMetaData(DBElementType.Sequence, _executingGenerator.DriverID, catalogName, schemaName);
			foreach(DBSequence sequence in deletedElements.Cast<DBSequence>().OrderBy(s=>s.Name))
			{
				string sequenceName = GetOriginalName(sequence);
%><# SD_DDLSQL_DropSequenceInclude #><%
			}
		}
	}
%>
-- ###############################################################################################################
-- ADD statements for new elements (except FK/UC)
-- ###############################################################################################################
<%
	// Catalogs
	foreach(DBCatalog catalog in existingCatalogs.OrderBy(c=>c.CatalogName))
	{
		string catalogName = catalog.CatalogName;
		if(catalog.CreatedByDesigner)
		{
%><# SD_DDLSQL_CreateCatalogInclude #><%
		}
%><# SD_DDLSQL_SetActiveCatalogInclude #><%		
		// Schemas
		foreach(DBSchema schema in catalog.Schemas.OrderBy(s=>s.SchemaOwner))
		{
			string schemaName = schema.SchemaOwner;
			if(schema.CreatedByDesigner)
			{
%><# SD_DDLSQL_CreateSchemaInclude #><%
			}
			
			// Tables
			HashSet<DBElementBase> newElements = _currentProject.GetAllNewElementsFromMetaData(DBElementType.Table,_executingGenerator.DriverID, catalogName, schemaName);
			foreach(DBTable table in newElements.Cast<DBTable>().OrderBy(t=>t.Name))
			{
%><# SD_DDLSQL_CreateTableInclude #><%
			}
			
			// Fields
			newElements = _currentProject.GetAllNewElementsFromMetaData(DBElementType.TableField,_executingGenerator.DriverID, catalogName, schemaName);
			foreach(DBTableField field in newElements.Cast<DBTableField>().OrderBy(f=>f.ParentTable.FullName))
			{
				string tableName = field.ParentTable.Name;
%><# SD_DDLSQL_CreateTableFieldInclude #><%
			}
			
			// Sequences
			newElements = _currentProject.GetAllNewElementsFromMetaData(DBElementType.Sequence,_executingGenerator.DriverID, catalogName, schemaName);
			foreach(DBSequence sequence in newElements.Cast<DBSequence>().OrderBy(s=>s.Name))
			{
				string sequenceName = sequence.Name;
%><# SD_DDLSQL_CreateSequenceInclude #><%
			}
		}
	}
%>
-- ###############################################################################################################
-- ALTER statements for table fields and ADD statements for new primary key constraints
-- ###############################################################################################################
<%
	// Catalogs
	foreach(DBCatalog catalog in existingCatalogs.OrderBy(c=>c.CatalogName))
	{
		string catalogName = catalog.CatalogName;
%><# SD_DDLSQL_SetActiveCatalogInclude #><%		
		// Schemas
		foreach(DBSchema schema in catalog.Schemas.OrderBy(s=>s.SchemaOwner))
		{
			string schemaName = schema.SchemaOwner;

			// Fields
			HashSet<DBElementBase> changedElements = _currentProject.GetAllChangedElementsFromMetaData(DBElementType.TableField,_executingGenerator.DriverID, catalogName, schemaName);
			foreach(DBTableField field in changedElements.Cast<DBTableField>().OrderBy(f=>f.ParentTable.FullName))
			{
				string tableName = field.ParentTable.Name;
%><# SD_DDLSQL_AlterTableFieldInclude #><%
			}
			
			// Primary key constraints
			changedElements = _currentProject.GetAllNewElementsFromMetaData(DBElementType.PrimaryKeyConstraint,_executingGenerator.DriverID, catalogName, schemaName);
			foreach(DBTable table in changedElements.Cast<DBTableField>().Select(f=>f.ParentTable).Distinct().OrderBy(t=>t.FullName)
											.Union(_pkConstraintsToRecreate.Where(t=>t.ContainingSchema==schema)))
			{
				string constraintName = table.PrimaryKeyFields.First().PrimaryKeyConstraintName;
%><# SD_DDLSQL_CreatePrimaryKeyConstraintInclude #><%
			}
		}
	}
%>
-- ###############################################################################################################
-- ADD statements for new foreign key constraints and unique constraints
-- ###############################################################################################################
<%
	// Catalogs
	foreach(DBCatalog catalog in existingCatalogs.OrderBy(c=>c.CatalogName))
	{
		string catalogName = catalog.CatalogName;
%><# SD_DDLSQL_SetActiveCatalogInclude #><%
		// Schemas
		foreach(DBSchema schema in catalog.Schemas.OrderBy(s=>s.SchemaOwner))
		{
			string schemaName = schema.SchemaOwner;
			
			// Unique constraints
			HashSet<DBElementBase> newElements = _currentProject.GetAllNewElementsFromMetaData(DBElementType.UniqueConstraint, _executingGenerator.DriverID, catalogName, schemaName);
			foreach(DBUniqueConstraint uniqueConstraint in 
						newElements.Union(_uConstraintsToRecreate.Where(uc=>uc.AppliesToTable.ContainingSchema==schema).Cast<DBElementBase>()))
			{
				DBTable table = uniqueConstraint.AppliesToTable;
				string tableName = uniqueConstraint.AppliesToTable.Name;
				string constraintName = uniqueConstraint.ConstraintName;
%><# SD_DDLSQL_CreateUniqueConstraintInclude #><%
			}

			// Foreign key constraints
			newElements = _currentProject.GetAllNewElementsFromMetaData(DBElementType.ForeignKeyConstraint, _executingGenerator.DriverID, catalogName, schemaName);
			foreach(DBForeignKeyConstraint foreignKeyConstraint in 
						newElements.Union(_fkConstraintsToRecreate.Where(fk=>fk.AppliesToTable.ContainingSchema==schema).Cast<DBElementBase>()))
			{
				DBTable fkTable = foreignKeyConstraint.AppliesToTable;
				DBTable pkTable = foreignKeyConstraint.PKSide;
				string tableName = foreignKeyConstraint.AppliesToTable.Name;
				string constraintName = foreignKeyConstraint.ConstraintName;
				IEnumerable<Pair<IProjectElementFieldMapTargetElement, IProjectElementFieldMapTargetElement>> fkPkFieldPairs = foreignKeyConstraint.GetFkPkFieldPairs();
%><# SD_DDLSQL_CreateForeignKeyConstraintInclude #><%
			}
		}
	}
%>
<~
	/// <summary>Obtains the original name of the renameable element</summary>
	/// <param name="element">the renameable element</param>
	/// <returns>the original name of the renamed element specified</returns>
	private string GetOriginalName(IDBRenameableElement element)
	{
		if(element==null)
		{
			return string.Empty;
		}
		return element.OriginalName;
	}
	
	/// <summary>Obtains the new name of the renameable element</summary>
	/// <param name="element">the renameable element</param>
	/// <returns>the new name of the renamed element specified</returns>
	private string GetNewName(IDBRenameableElement element)
	{
		if(element==null)
		{
			return string.Empty;
		}
		return element.NewName;
	}

~>