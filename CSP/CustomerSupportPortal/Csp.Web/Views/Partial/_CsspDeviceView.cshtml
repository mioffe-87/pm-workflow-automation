    <script type="text/javascript">
        function clickhere(parameter1) {
            window.location.href = '@Url.Action("Event", "Home")' +
        '?parameter1=' + parameter1;
    }
    </script>*@


    @{
        if (Model != null && Model != null)
        {
            var maxPageSizeForms = Convert.ToInt32(Model.DataParameters.TotalRecordCount);
            var pageSizeOptionsForms = new List<int> { 50, 100 };
            if (maxPageSizeForms > pageSizeOptionsForms.Max())
            {
                pageSizeOptionsForms.Add(maxPageSizeForms);
            }
        @(Html.Kendo().Grid(Model.Devices)
                  .Name((string)UniqueId.gridId)
                  .HtmlAttributes(new { @class = "proddevicegrid prov-devices-tabs-root" })
                  .Columns(columns =>
                  {
                      columns.Bound(x => x.DeviceId).ClientTemplate(@"<input type=""checkbox"" id=""chkCsspEndUserDevice#=DeviceId#""  name=""chkCsspEndUserDevice#=DeviceId#"" onclick=""provisionedDevices.SetSelectedDevices(this);"" ; />").Sortable(false).Title("Select").Width(75);
                      columns.Bound(p => p.DeviceId).Hidden(true);
                      columns.Bound(p => p.SerialNumber);
                      columns.Bound(x => x.Model);
                      columns.Bound(x => x.ProvisionedDate).Format("{0:dd/MM/yyyy}");
                      columns.Bound(x => x.EndUserCompany);
                      columns.Bound(x => x.EndUserCustomerAccountId).Title("Customer Reference Id");
                      columns.Bound(x => x.EndUserContactEmail);
                      columns.Bound(x => x.EndUserPhoneNumber);
                      columns.Bound(x => x.EndUserFullAddress).Encoded(false);
                      columns.Command(command =>
                      {
                          command.Custom("csp-download").Text(" ").Click("provisionedDevices.Download").HtmlAttributes(new {title = "Download", href = "javascript:void(0);"});
                         
                      }).Width(110).Title("License Keys");      
                      
                      
                              
                     
                  })
                  .Pageable(pageable => pageable.PageSizes(pageSizeOptionsForms.ToArray()))
                  .Resizable(resize => resize.Columns(true))
                  .Events(e => e.DataBound("provisionedDevices.onDeviceDataBound"))
                  .ToolBar(toolBar =>
                  {
                      toolBar.Template(@<text>
    <a class="k-button k-button-icontext k-grid-AddEndUser" href="" id="enduserinfo" style="color: #999999;text-decoration: none;pointer-events: none;cursor: default;">
        <span class="k-icon k-add"></span>
        Add End User Info
    </a>

    <a class="k-button k-button-icontext k-grid-Export-All" onclick="javascript: provisionedDevices.ExportToCSV()" id="export">
        Export All
    </a>

    <span class="k-button k-button-icontext k-grid-Export-Monthly" onclick="javascript: provisionedDevices.FlipExportTo()" id="export-monthly">
        <span>Download Usage Report</span>
        <span class="menu-icon fa fa-caret-down"></span>
        <ul class="ant-menu amber-menu amber-no-transition ant-menu-light ant-menu-root ant-menu-inline hide" role="menu">
            @if (Model != null
                && Model.DownLoadUsageReportMonths != null)
            {
                foreach (var monthYear in Model.DownLoadUsageReportMonths)
                {
            <li class="ant-menu-item amber-menu-item" role="menuitem" onclick="javascript: provisionedDevices.ExportMonthlyToCSV('@(monthYear.Key)')">
                <a href="javascript: function () {};">@monthYear.Value</a>
                <i class="menu-icon fa fa-download"></i>
            </li>
                }
            }
        </ul>
    </span>

    <span class="prov-devices-disclosure">
        Your <i>prior</i> month's report will become available on the second day of the current month. Please contact csspreports@paloaltonetworks.com to access reports that are more than 6 months old.
    </span>
                                        </text>);
                  })
                  .DataSource(dataSource => dataSource
                                                    .Ajax()
                                                    .Total(Convert.ToInt32(Model.DataParameters.TotalRecordCount))
                                                    .Model(model => model.Id(p => p.DeviceId))
                                                    .PageSize(Model.DataParameters.PaginationCount)
                                                    .Read(read => read.Action("ProvisionedDevices", "Cssp").Data("provisionedDevices.getCsspGridParams"))
                  )
              )
        }
    }

</div>
