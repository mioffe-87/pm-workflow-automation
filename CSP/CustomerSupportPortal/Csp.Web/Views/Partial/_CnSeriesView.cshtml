        <div class="grid-filter">
            @Html.TextBox("FindSearchValue", Model.DefaultDeviceCode, new {
                onkeypress = "return onSearchEnterPress(event)",
                @class = "grid-filter__search-input",
                placeholder = "Search",
                aria_label = "Search"
            })
            <button aria-label="search" type="button" id="@UniqueId.FindCnSeries" class="grid-filter__search-button" onclick="findCN()">
                <span aria-hidden="true" class="fa fa-search" />
            </button>

            <!-- @Html.TextBox("FindSearchValue", Model.DefaultDeviceCode)
            <input type="button" value="Search" id="@UniqueId.FindCnSeries" class="k-button" /> -->
        </div>
    </div>
</div>
