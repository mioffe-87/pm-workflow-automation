<?xml version="1.0"?>
<templateBindings xmlns="http://sd/llblgen/pro/templateBindingsDefinition.xsd" name="SD.TemplateBindings.PostgreSqlSpecific"
				  description ="Template bindings for the templates which are specific for PostgreSql 7.4+ based databases using Npgsql."
				  databaseDriverID="88EBFD8C-CBDD-4452-88AF-1C99E41A123F" precedenceLevel="10">
	<supportedPlatforms>
		<platform name=".NET 3.5"/>
		<platform name=".NET 4.0"/>
		<platform name=".NET 4.5"/>
	</supportedPlatforms>
	<supportedFrameworks>
		<framework name="LLBLGen Pro Runtime Framework"/>
	</supportedFrameworks>

	<language name="C#">
		<!-- DB Specific template bindings -->
		<templateBinding templateID="SD_DQEReferenceXmlIncludeTemplate" filename="PostgreSqlSpecific\Shared\dqeReferenceXmlInclude.template" templateLanguage="TDL" />
		<templateBinding templateID="SD_ProcedureNameIncludeTemplate" filename="PostgreSqlSpecific\Shared\procedureNameInclude.template" templateLanguage="TDL"/>
		<!-- DB Specific include template bindings -->
		<templateBinding templateID="SD_DQENamespaceIncludeTemplate" filename="PostgreSqlSpecific\C#\dqeNamespaceInclude.template" />
	</language>
	<language name="VB.NET">
		<templateBinding templateID="SD_DQEReferenceXmlIncludeTemplate" filename="PostgreSqlSpecific\Shared\dqeReferenceXmlInclude.template" templateLanguage="TDL" />
		<templateBinding templateID="SD_ProcedureNameIncludeTemplate" filename="PostgreSqlSpecific\Shared\procedureNameInclude.template" templateLanguage="TDL"/>
		<!-- DB Specific include template bindings -->
		<templateBinding templateID="SD_DQENamespaceIncludeTemplate" filename="PostgreSqlSpecific\VB.NET\dqeNamespaceInclude.template" />
	</language>
</templateBindings>
