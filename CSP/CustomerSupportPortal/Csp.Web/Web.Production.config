<?xml version="1.0" encoding="utf-8"?>
<configuration xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">
	<connectionStrings></connectionStrings>
	<appSettings>
	  <!--GCP Vault Config-->
    <add key="AppEnv" value="prod" xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
	  <add key="LocalDevSecretsFile" xdt:Transform="Remove" xdt:Locator="Match(key)"/>
    <!--TODO: Update to correct URL once prod env is setup-->
    <add key="VaultUrl" value="http://127.0.0.1:8200/v1/IT/kv/data/prod/csp/secret" xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
    <add key="AllowedOrigins" value="https://support.paloaltonetworks.com,https://supportcases.paloaltonetworks.com,https://paloaltonetworkssupport.force.com,https://paloaltonetworks.my.salesforce.com,https://knowledgebase.paloaltonetworks.com" xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
    <add key="Impersonate_ProjectName" value="itp-iad-csp-portalbff" xdt:Transform="SetAttributes" xdt:Locator="Match(key)"/>
    <add key="Data_Collection_ProjectName" value="itp-csp-data-coll" xdt:Transform="SetAttributes" xdt:Locator="Match(key)"/>
    <add key="User_Profile_ProjectName" value="itp-ent-cortexiam" xdt:Transform="SetAttributes" xdt:Locator="Match(key)"/>
    <add key="ExcludeHelpPage" value="true" xdt:Transform="SetAttributes" xdt:Locator="Match(key)"/>
    
    <!-- CSP API Cert Require Attribute -->
    <add key="CspApiDotNetServerCertCn" value="csp.api.paloaltonetworks.com" xdt:Transform="SetAttributes" xdt:Locator="Match(key)"/>
    <add key="CspApiDotNetServerCertOu" value="IT-Apps-client" />
    <add key="CspApiDotNetServerCertO" value="Palo Alto Networks Inc." />
  </appSettings>
<system.net>
		<mailSettings>
			<smtp deliveryMethod="Network" xdt:Transform="SetAttributes"></smtp>
		</mailSettings>
	</system.net>
	<applicationSettings xdt:Transform="Replace">
    <Csp.Api.Properties.Settings>
      <setting name="Csp_Api_SalesforceWebApi_SforceService" serializeAs="String">
        <value>https://login.salesforce.com/services/Soap/c/61.0/0DFS00000004FdV</value>
      </setting>
      <setting name="Csp_Api_SAPService_SI_QuoteCreate_OBService" serializeAs="String">
        <value>https://po-prd.paloaltonetworks.com/QuoteCreate</value>
      </setting>
    </Csp.Api.Properties.Settings>
  </applicationSettings>
  <system.webServer>
    <httpProtocol xdt:Transform="Insert">
      <customHeaders>
        <add name="X-Frame-Options" value="SAMEORIGIN" />
        <add name="Content-Security-Policy" value="frame-ancestors 'self' https://*.paloaltonetworks.com" />
      </customHeaders>
    </httpProtocol>
    <defaultDocument>
      <files xdt:Transform="Replace">
        <remove value="default.aspx" />
        <remove value="iisstart.htm" />
        <remove value="index.html" />
        <remove value="index.htm" />
        <remove value="Default.asp" />
        <remove value="Default.htm" />
        <add value="healthCheck.htm" />
      </files>
    </defaultDocument>
    <rewrite xdt:Transform="Insert">
      <rules>
        <clear />
        <rule name="NoSSL - folder" stopProcessing="true">
          <match url="^healthCheck" />
          <conditions logicalGrouping="MatchAll" trackAllCaptures="false" />
          <action type="None" />
        </rule>
        <rule name="HTTPS force" stopProcessing="true">
          <match url="(.*)" />
          <conditions logicalGrouping="MatchAll" trackAllCaptures="false">
            <add input="{HTTPS}" pattern="^OFF$" />
          </conditions>
          <action type="Redirect" url="https://{HTTP_HOST}{REQUEST_URI}" appendQueryString="false" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
	<system.serviceModel>
		<bindings xdt:Transform="Replace">
			<basicHttpBinding>
        <binding name="BasicHttpBinding_ILicense" />
				<binding name="LicenseService2Soap" openTimeout="0:10:0" closeTimeout="0:10:0" sendTimeout="0:10:0" receiveTimeout="0:10:0">
					<security mode="Transport">
          </security>
				</binding>
				<binding name="UpdateService2Soap" maxReceivedMessageSize="2147483647" openTimeout="0:10:0" closeTimeout="0:10:0" sendTimeout="0:10:0" receiveTimeout="0:10:0">
					<security mode="Transport">
						<transport clientCredentialType="Basic" proxyCredentialType="Basic" realm=""></transport>
						<message clientCredentialType="UserName"/>
					</security>
				</binding>
				<binding name="BasicHttpBinding_ILoginService">
					<security mode="Transport"/>
				</binding>
				<binding name="EvalWebServiceBinding">
					<security mode="Transport"/>
				</binding>
			</basicHttpBinding>
		</bindings>
		<client>
			<endpoint name="LicenseService2Soap" address="https://svc.paloaltonetworks.com/license/licenseservice2.asmx" xdt:Transform="SetAttributes" xdt:Locator="Match(name)"/>
			<endpoint name="UpdateService2Soap" address="https://staticupdates.paloaltonetworks.com/cspupdates/updateservice2.asmx" xdt:Transform="SetAttributes" xdt:Locator="Match(name)"/>
			<endpoint name="BasicHttpBinding_ILoginService" address="https://loginservice.paloaltonetworks.com/LoginService.svc?wsdl"  xdt:Transform="SetAttributes" xdt:Locator="Match(name)" />
			<endpoint name="EvalWebService" address="https://na5.salesforce.com/services/Soap/class/EvalWebService" xdt:Transform="SetAttributes" xdt:Locator="Match(name)"/>
      <endpoint name="BasicHttpBinding_ILicense" address="https://services.paloaltonetworks.com/License.svc" xdt:Transform="SetAttributes" xdt:Locator="Match(name)"/>
		</client>
	</system.serviceModel>
  <system.web>
		<compilation xdt:Transform="RemoveAttributes(debug)" />
	</system.web>
</configuration>