@using Csp.Api.Model
@using Csp.Api.Services.Contracts
@using Csp.Api.HelperClasses
@using System.Linq
@using Kendo.Mvc.UI
@model SearchAllViewModel

@{
    var searchingOneAccount = Model.DefaultSupportAccountId.HasValue;
    bool showCspIds = !searchingOneAccount && Model.CspIds != null;
}

<style type="text/css">
    .bold { font-weight: bold; }
    body .k-master-row.k-alt, body .k-master-row.k-alt:hover, body .k-detail-row.k-alt, body .k-detail-row.k-alt:hover, body .k-detail-row.k-alt th.k-header, body .k-detail-row.k-alt td[role="gridcell"] { background-color: rgba(52, 52, 52, 0.15); }
    .k-button.selected { border: solid 1px rgba(195, 195, 195, 1);background-color: rgba(215, 215, 215, 1); }
    #SearchDivCspIds .k-select { width: 42px; }
    #SearchDivCspIds .k-reset .k-select { width: 15px; }
    #SearchDiv.error #SearchDivCspIds .k-select { width: 23px; }
    #SearchDivCspIds .k-dropdown-wrap { width: calc(100% + 8px); }
    #SearchDiv.error #SearchDivSearchValue input, #SearchDiv.error #SearchDivCspIds .k-dropdown-wrap { border-color: #ff000050;background-color: #FFF9F8; }
    /*.cbCompText {display: inline-block;padding-left: 5px;width: calc(100% - 20px);height: 14px;overflow: hidden;line-height: 14px;vertical-align: top; }*/
    .k-widget.k-multiselect.k-header { max-height: 50px; overflow: auto; }
    div#SearchDiv { margin: 7px 0 0 0;padding: 0;background-color:#fff; }
</style>
<script>
    var showCspIds = @showCspIds.ToString().ToLower();
    var firstRun = true;

    function checkInput() {
        /*
        if (showCspIds) {
            if (!getSearchFields().searchValue) {
                $('#SearchDiv').addClass("error");
                $('.grid-filter__search-button').hide();
                return false;
            }
            $('.grid-filter__search-button').show();
            $('#SearchDiv').removeClass("error");
        }
        */
        return true;
    }

    function searchAll() {
        if (!checkInput()) {
            return;
        }

        var searchFields = getSearchFields();
        var grid = $('#SearchAllGrid').data("kendoGrid").dataSource;
        grid.filter(
            {
                field: searchFields.searchField,
                operator: "eq",
                value: searchFields.searchValue.trim()
            }
        );
         $('#SearchAllGrid').show();
        if (firstRun === true) {
            firstRun = false;
            @if (!searchingOneAccount) {
                <text>
            var searchAllWindow = $('#SearchAllWindow').data("kendoWindow");
            if (searchAllWindow) {
                if (searchAllWindow.setOptions) {
                    searchAllWindow.setOptions({
                        minWidth: 1100
                    });
                }
                if (searchAllWindow.center) {
                    searchAllWindow.center();
                }
            }
                </text>
            }
        };
        //$('#SearchAllGrid').show();

    }

    var isFirstDataBind = true;
    function SearchAllGridDataBound(e) {
        if (isFirstDataBind) {
            $('#SearchAllGrid').data("kendoGrid").dataSource._total = '@Convert.ToInt32(Model.DataParameters.TotalRecordCount)';
            isFirstDataBind = false;
        }
        setTimeout(function () {
            setRowsState();
            if ($('.k-master-row td a.k-icon').length > 0) {
                $('#expand-all').show();
                $('#collapse-all').show();
            } else {
                $('#expand-all').hide();
                $('#collapse-all').hide();
            }
        }, 25);
    }

    function getSearchFields() {
        var searchField = $('#FilterByCombo').val();
        var searchValue;
        if (searchField === "CspId") {
            searchValue = $("#ddlSupportAccountsDdl").val()?.toString().replaceAll(',', ', ') || '';
        } else if (searchField == "ExpiresBy") {
            searchValue = $('#SearchDateValue').val();
        } else {
            searchValue = $('#SearchValue').val();
        }

        return {
            searchField: searchField,
            searchValue: searchValue
        };
    }

    function onSearchAllEnterPress(e) {
        if (e.keyCode == 13) {
            searchAll();
            return false;
        }
    }

    function onSearchAllEnterUp(e) {
        checkInput();
    }

    var maxRecforCsvExport = 10000;

    function exportSearchAllToCsv() {
        if (!checkInput()) {
            return;
        }

        var grid = $('#SearchAllGrid').data("kendoGrid").dataSource;
        var totalRecCount = grid.total();
        /*
        if (totalRecCount > maxRecforCsvExport) {
            alert('Export currently disabled for more than 10,000 devices.  We\'re working to increase this limit');
            return;
        }
        */
        var id = '@(Model.DefaultSupportAccountId.HasValue ? Model.DefaultSupportAccountId.Value.ToString() : string.Empty)';

        var searchFields = getSearchFields();

        location.href = '@Url.Action("SearchAllReport", "SearchAll")?id=' + id + '&searchField='
            + searchFields.searchField + '&searchValue=' + searchFields.searchValue;
    }

    function FilterByComboChange() {
        checkInput();
        var dropDownControl = $("#FilterByCombo").data("kendoDropDownList");
        var selectedValue = dropDownControl.value();
        if (selectedValue === "CspId") {
            $('#SearchDiv').show();
            $("#DateSearchDiv").hide();
            $('#SearchDivSearchValue').hide();
            $('#SearchDivCspIds').show();
        } else if (selectedValue === "ExpiresBy") {
            $('#SearchDiv').hide();
            $("#DateSearchDiv").show();
            $("#SearchDivSearchValue").hide();
            $('#SearchDivCspIds').hide();
        } else {
            $('#SearchDiv').show();
            $("#DateSearchDiv").hide();
            $('#SearchDivSearchValue').show();
            $('#SearchDivCspIds').hide();
        }
    }

    var initialLoad = true;
    function searchAllRequestStart() {

        var showPleaseWaitMessage = true;

        if (initialLoad === true) {
            initialLoad = false;
            @if (searchingOneAccount) {
                <text>
            showPleaseWaitMessage = false;
                </text>
            }
        }

        if (showPleaseWaitMessage) {
            SupportPortal.BlockUI();
        }
    }

    function searchAllRequestEnd() {
        SupportPortal.UnBlockUI();
    }

    $(function() {
        $('#SearchValue').focus();
    });

    function formatSupportAccount(data) {
        return data.AssetType === "@AssetTypes.CloudServices"
            || data.AssetType === "@AssetTypes.Casb" 
            ? "<a href=\"/SupportAccount/CloudServices/" + data.SupportAccountId + "\">" + data.SupportAccountName + "</a><br>"
            : data.ModelName // TODO: assemble link to IONs home page
                && data.ModelName.includes('-ION')
                ? data.SupportAccountName
                : "<div style=\"white-space: nowrap;\"><a href=\"/SupportAccount/Devices/" + data.SupportAccountId + "?assettype=" + data.AssetType + "&devicecode=" + data.DeviceCode + "\">" + data.SupportAccountName +"</a></div>";
    }

    function formatSNs(data) {
        var returnData = "";
        if (data.AssetType === "@AssetTypes.CloudServices"
            || data.AssetType === "@AssetTypes.Casb") {
            var formatedSns = data.DeviceCode.split("\n");
            for (var i = 0; i < formatedSns.length; i ++) {
                returnData = returnData +
                    "<a href=\"/SupportAccount/CloudServices/" +
                    data.SupportAccountId +
                    "\">" +
                    formatedSns[i] +
                    "</a><br>";
            }
            return returnData;
        } else if (data.ModelName // TODO: assemble link to IONs home page
            && data.ModelName.includes('-ION')) {
            return data.DeviceCode;
        } else {
            returnData = "<div style=\"white-space: nowrap;\"><a href=\"/SupportAccount/Devices/" +
                data.SupportAccountId +
                "?assettype=" +
                data.AssetType +
                "&devicecode=" +
                data.DeviceCode +
                "\">" + data.DeviceCode
                +"</a></div>";

            return returnData;
        }

    }

    function openActivationLinksLookupWindow() {
        var window = $('#ActivationLinkLookupWindowPopup').data("kendoWindow");
        window.setOptions({
            minHeight: 500,
            minWidth: 920
        });
        window.title("Activation Links Lookup");
        window.refresh();
        window.refresh("/SearchAll/ActivationLinksLookup");
        window.open();
        window.center();
    }

    function onOpenActivationLinksLookupWindow() {
        SupportPortal.OnWindowOpen("ActivationLinkLookupWindowPopup");
    }

    function onCloseActivationLinksLookupWindow() {
        /*
        var window = $('#ActivationLinkLookupWindowPopup').data("kendoWindow");
        window.content("");
        window.refresh();
        SupportPortal.OnWindowClose(deviceGridId);
        */
    }
</script>

