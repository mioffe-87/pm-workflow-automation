    }
    
    function onDownloadsWindowClose() {

    }

    function onOpenTrapsVersionWindow() {
       // console.trace();
        SupportPortal.OnWindowOpen("@UniqueId.SelectTrapsVersion");
    }

    function onCloseTrapsVersionWindow() {
        var window = $("#@UniqueId.SelectTrapsVersion").data("kendoWindow");
        if ($("#DownloadEndpointLicense").val() == "1") {
            subType = $('#ProductSubType').val();
            //only pass subtype to terminate the dialog and download the license directly
            GenerateAndDownloadLicense($("#EndpointAuthorizationCode").val(), subType, '');
        }
        
        window.content("");
        window.refresh();
    }

    //Called when there is Just one or no ESM
    function AddAuthCode() {
        isActivatingAuthCode = true;
        if (addWindow == null) {
            addWindow = $('#AddingLicense').data('kendoWindow');

            addWindow.setOptions({
                minWidth: 400,
                minHeight: 100
            });
            addWindow.content(SupportPortal.CustomLoadingMessageWithSpinner("Please wait while we activate Endpoint Auth-Code"));
        }
        addWindow.open();
        addWindow.center();
        var grid = $('#@UniqueId.EpAuthCodesGrid').data('kendoGrid');
        grid.saveRow();
        SupportPortal.OnWindowClose("@UniqueId.EpAuthCodesGrid");
    }

    // Called when more than one ESM and AND ep100 or ep500 IS GETTING ADDED
    function openAddEpAuthCodeWindowOpen() {
        var direction = "/EP/AddEndpointLicense/?authCode=" + $("#AuthorizationCode").val();
        var window = $("#@UniqueId.AddEpAuthCodeWindow").data("kendoWindow");
        window.content(" ");
        window.setOptions({
            minWidth: 450,
            minHeight: 110
        });
        window.bind('open', onAddEpAuthCodeWindowOpen);
        window.bind('close', onAddEpAuthCodeWindowClose);
        window.title("Add Ep License");
        window.refresh();
        window.refresh(direction);
        window.open();
        window.center();
    }
    
    function onAddEpAuthCodeWindowOpen() {
        SupportPortal.OnWindowOpen("@UniqueId.AddEpAuthCodeWindow");
    }
    
