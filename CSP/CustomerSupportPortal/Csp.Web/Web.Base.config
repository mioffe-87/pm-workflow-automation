    <errorLog type="Elmah.MySqlErrorLog, Elmah" connectionStringName="Elmah" />
    <security allowRemoteAccess="1" />
    <errorFilter>
      <test>
        <equal binding="HttpStatusCode" value="404" type="Int32" />
      </test>
    </errorFilter>
  </elmah>
  <system.serviceModel>
    <bindings>
      <basicHttpBinding>
        <binding name="BasicHttpBinding_ILicense" />
        <binding name="SiteLicenseServiceSoap" openTimeout="0:10:0" closeTimeout="0:10:0" sendTimeout="0:10:0" receiveTimeout="0:10:0" />
				<binding name="LicenseService2Soap" openTimeout="0:10:0" closeTimeout="0:10:0" sendTimeout="0:10:0" receiveTimeout="0:10:0">
					<security mode="Transport">
						<transport clientCredentialType="Basic" proxyCredentialType="Basic" realm=""></transport>
						<message clientCredentialType="UserName" />
					</security>
				</binding>
        <binding name="UpdateService2Soap" maxReceivedMessageSize="2147483647" openTimeout="0:10:0" closeTimeout="0:10:0" sendTimeout="0:10:0" receiveTimeout="0:10:0">
          <security mode="Transport">
            <transport clientCredentialType="Basic" proxyCredentialType="Basic" realm=""></transport>
            <message clientCredentialType="UserName" />
          </security>
        </binding>
        <binding name="BasicHttpBinding_ILoginService" />
        <binding name="EvalWebServiceBinding">
          <security mode="Transport" />
        </binding>
      </basicHttpBinding>
      <customBinding>
        <binding name="LicenseService2Soap12">
          <textMessageEncoding messageVersion="Soap12" />
          <httpTransport />
        </binding>
        <binding name="UpdateService2Soap12">
          <textMessageEncoding messageVersion="Soap12" />
          <httpTransport />
        </binding>
      </customBinding>
    </bindings>
    <client>
      <endpoint name="LicenseService2Soap" address="https://staticupdatestest.paloaltonetworks.com/license/licenseservice2.asmx" binding="basicHttpBinding" bindingConfiguration="LicenseService2Soap" contract="LicensingService.LicenseService2Soap" />
      <endpoint name="UpdateService2Soap" address="https://updatestest.paloaltonetworks.com/updates/updateservice2.asmx" binding="basicHttpBinding" bindingConfiguration="UpdateService2Soap" contract="UpdateService.UpdateService2Soap" />
      <endpoint name="BasicHttpBinding_ILoginService" address="http://10.101.27.16/LoginService.svc?wsdl" binding="basicHttpBinding" bindingConfiguration="BasicHttpBinding_ILoginService" contract="LoginService.ILoginService" />
      <endpoint name="SiteLicenseServiceSoap" address="http://localhost:49934/SiteLicenseService.asmx" binding="basicHttpBinding" bindingConfiguration="SiteLicenseServiceSoap" contract="SiteLicenseService.SiteLicenseServiceSoap" />
      <endpoint name="EvalWebService" address="https://cs24.salesforce.com/services/Soap/class/EvalWebService" binding="basicHttpBinding" bindingConfiguration="EvalWebServiceBinding" contract="EvalWebServicePortType" />
      <endpoint name="BasicHttpBinding_ILicense" address="http://servicestest.paloaltonetworks.com/License.svc" binding="basicHttpBinding" bindingConfiguration="BasicHttpBinding_ILicense" contract="DeviceAndLicenseService.ILicense" />
    </client>
  </system.serviceModel>
  <glimpse defaultRuntimePolicy="On" endpointBaseUri="~/Glimpse.axd">
    
    <!-- Want to use Glimpse on a remote server? Ignore the LocalPolicy by removing this comment. -->
    <runtimePolicies>
      <ignoredTypes>
        <add type="Glimpse.AspNet.Policy.LocalPolicy, Glimpse.AspNet" />
      </ignoredTypes>
      <uris>
        <add regex="\/Home\/Header$" />
        <add regex="\/Footer.html$" />
      </uris>
    </runtimePolicies>
  <!-- 
          For more information on how to configure Glimpse, please visit http://getglimpse.com/Help/Configuration
          or access {your site}/Glimpse.axd for even more details and a Configuration Tool to support you. 
      --></glimpse>
  <location path="elmah">
    <system.web>
      <authorization>
        <allow users="mlavoie@paloaltonetworks.com,jsacks@paloaltonetworks.com,vrangayan@paloaltonetworks.com,lkoneru@paloaltonetworks.com,pthangavel@paloaltonetworks.com,gengle@paloaltonetworks.com,ffang@paloaltonetworks.com,mdokey@paloaltonetworks.com,cwallace@paloaltonetworks.com,rparipoorana@paloaltonetworks.com,sseetham@paloaltonetworks.com,ssriram@paloaltonetworks.com,rchaluvadi@paloaltonetworks.com,pmehrotra@paloaltonetworks.com,msaddique@paloaltonetworks.com" />
