@using Csp.Api.Logic
@using Csp.Api.Services.Contracts
@model dynamic

@{
    Layout = null;
    var configValues = new ConfigValues();
}

<!doctype HTML>
<html>

<head>
    <meta http-equiv="content-type" content="text/html; charset=UTF-8">
    <meta http-equiv="keywords" content="">
    <meta http-equiv="description" content="">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <!-- will eventually reference pan.css from paloaltonetworks.com -->
    <link rel="stylesheet" type="text/css" href="/Content/marketing/css/pan.css">

    <!-- icons -->
    <link rel="stylesheet" type="text/css" href="/Content/marketing/css/lato.css">
    <link rel="stylesheet" type="text/css" href="/Content/marketing/css/glyphicons.css">
    <link rel="stylesheet" type="text/css" href="/Content/marketing/css/font-awesome.css">
    <link rel="stylesheet" type="text/css" href="/Content/marketing/css/panicons.css">
    <style>
        #divEnvironment {
            position: fixed;
            top: 10px;
            right: 5px;
        }
        .divRound
        {
            border: 2px solid #303030;
            padding: 2px 10px;
            background: #dddddd;
            width: 80px;
            font-size: 12px;
            border-radius: 25px;
        }
    </style>
    <script>
        // Hide the banner image if the image path is broken
        function OnBannerImageError(elem) {
            elem.style.display = 'none';
        }
    </script>
    <title>Pan Dynamic Template</title>
</head>

<body>

<nav role="navigation" class="navbar mm navbar-default">
    <div class="container-fluid">
        <div class="navbar-header" style="white-space: nowrap;">
            <button type="button" data-toggle="collapse" data-target="#primaryNav" class="navbar-toggle collapsed" aria-expanded="false"><i class="fa fa-navicon"></i></button>
            <a target="_top" href="https://www.paloaltonetworks.com/" class="navbar-brand">
                <img src="/Content/marketing/img/panlogobluesmall.png"></a>

            <a href="http://go.paloaltonetworks.com/supportheaderbanner" target="_blank">
                <img alt="" src="https://www.paloaltonetworks.com/content/dam/ext-includes/support-header-banner.gif" width="728" height="90" style="padding-left: 125px;" onerror="OnBannerImageError(this);"/>
            </a>
        </div>
        <div id="primaryNav" class="collapse navbar-collapse" style="padding-top: 20px;">
        </div>
    </div>
</nav>
@if (configValues.GetAppSetting(AppSettings.AppName) != "CSP PROD")
{
    <div id="divEnvironment" class="divRound"><span style="color: red; font-weight: bold">@configValues.GetAppSetting(AppSettings.AppName).ToUpper()</span></div>
}
</body>
</html>
