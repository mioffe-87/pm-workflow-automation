				string rightOnClauseOperand = SD_LinqToSqlGeneralUtils.ProduceLinqOnClauseOperand(rightName, onClauseRightSuffix, joinInfo.RightFields, "new {{{0}}}");
				
				if(startNewCurrentSet)
