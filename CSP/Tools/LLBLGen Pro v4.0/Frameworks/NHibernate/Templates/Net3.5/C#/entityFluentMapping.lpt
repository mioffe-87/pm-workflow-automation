<%	Project currentProject = _executingGenerator.ProjectDefinition;
	var allTargetedCatalogs = GeneratorUtils.GetAllMappedTargetsInScope(_executingGenerator).Select(t=>t.ContainingSchema.ParentCatalog).Distinct();
	bool hasMultipleCatalogs = allTargetedCatalogs.Count() > 1;
	EntityDefinition entity = (EntityDefinition)_activeObject;
	
	var entityFields = entity.Fields.Where(f=>f.FieldType.KindOfType==FieldTypeKind.DotNetType).OrderBy(f=>f.Name);
