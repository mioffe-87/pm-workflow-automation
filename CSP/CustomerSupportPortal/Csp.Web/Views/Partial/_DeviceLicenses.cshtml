                            </div>
                            <div>
                                <div class="csp-label" style="width: 200px;">
                                    @Html.Label((string) UniqueId.UuId, "UUID:")
                                </div>
                                <div class="csp-field">
                                    @Html.ValidationMessageFor(model => model.VMRegistrationDto.UuId)
