@{
    var title = Model.IsProductionDeviceList ? "Devices" : "Spares";
}
<div id="@UniqueId.DownloadsWindow"></div>
<div class="contextTitle"> @title </div>

@{
     
    <div class="grid-header" style="height: inherit;">
        <div class="grid-left">
            @if (actionHelper.Controller == ControllerFields.GroupController) {
                if (User.HasPermission(Permission.CreateGroup) || User.HasPermission(Permission.EditGroup)) {
                    var addDeviceText = Model.IsProductionDeviceList ? "Add Device to Group" : "Add Spare to Group";   
                <input type="button" id="@UniqueId.addDeviceToGroupButtonId" class="k-button k-primary" onclick="@(UniqueId.devices)deviceButtons.openAddDeviceToGroupWindow()" value="@addDeviceText" />
                }
            }

            @if (actionHelper.Controller == ControllerFields.SupportAccountController || actionHelper.Controller == ControllerFields.GroupController) {

                if (User.HasPermission(Permission.RegisterDevice)) {

                    var registerDeviceText = Model.IsProductionDeviceList ? "Register New Device" : "Register New Spare";

                    if (Model.IsProductionDeviceList && actionHelper.Controller == ControllerFields.SupportAccountController)
                    {
                        <input class="k-button k-primary" type="button" value="@registerDeviceText" data-link-type='devices' data-link-field='register new' onclick="window.location.href= '@Url.Action("RegisterDevice", "SupportAccount",new { id= Model.ActionHelper.Id })';"/>
                        <span class="csp-tooltip"><i class="icon-question-sign icon-large" onclick="SupportPortal.Help(this, 6);"></i></span>
                    }
                    else
                    { 
                        <input type="button" id="@UniqueId.registerDeviceButtonId" @Html.Raw(Model.IsProductionDeviceList ?  "data-link-type='devices' data-link-field='register new'" : "data-link-type='register-spare'") class="k-button" onclick="@(UniqueId.devices)deviceButtons.openDeviceTypeWindow()" value="@registerDeviceText" />
                        <span class="csp-tooltip"><i class="icon-question-sign icon-large" onclick="SupportPortal.Help(this, 6);"></i></span>
                    }
                    <input class="k-button" type="button" value="Run Day 1 Config" data-link-type='devices' data-link-field='run day 1 config' onclick="window.location.href= '@Url.Action("Day1Config", "SupportAccount",new { id= Model.ActionHelper.Id })';"/>
                }
                
                if(Model.IsProductionDeviceList){
                <input type="button" class="k-button" data-link-type="devices" data-link-field="deactivate" value="Deactivate License(s)" onclick="@(UniqueId.devices)deviceButtons.openDeactivateLicensesWindow(); " />
                }

                if (Model.ShowReviewPendingTransfersButton) {
                <input class="k-button k-primary" type="button" value="Review Pending Device Transfers" onclick="@(UniqueId.devices)deviceButtons.openDeviceTransferWindow(); " />
                }
                
            }
             @if(actionHelper.Controller == ControllerFields.SupportAccountController){
                if (User.HasPermission(Permission.EditDeviceTags))
                {
                    <input class="k-button" type="button" value="Device Tag" onclick="window.location.href= '@Url.Action("DeviceCategories", "Device",new { id= Model.ActionHelper.Id })';"/>
            
                }


                 if (Model.IsProductionDeviceList)
                 {
                     var btnExpiredLicensesText = Model.HideExpiredLicenses ? "Show Expired License(s)" : "Hide Expired License(s)";
                     <input type="button" class="k-button" id="btnExpiredLicenses" value="@btnExpiredLicensesText" onclick="@(UniqueId.devices)hideExpiredLicenses(); "/>


                     if (User.HasPermission(Permission.BulkDeviceTransfer) && Model.ShowBulkDeviceTransferButton)
                     {
                         <input class="k-button" type="button" value="Bulk Device Transfer" onclick="window.location.href = '@Url.Action("BulkDeviceTransfer", "SupportAccount", new {id = Model.ActionHelper.Id})';"/>

                     }
                 }
             }
            else{
                if (User.HasPermission(Permission.EditDeviceTags))
                {
                    <input class="k-button" type="button" value="Device Tag" onclick="window.location.href= '@Url.Action("DeviceCategories", "Device",new {})';"/>
            
                }
            }
            

        </div>
        <div class="grid-right">

            <div class="grid-filter">
                @{
                    if (Model.IsProductionDeviceList) {
                    @(Html.Kendo().DropDownList()
                        .Name((string)UniqueId.searchFieldId)
                        .Events(events => events.Change("OnDevicesCmbChange"))
                        .OptionLabel("Filter By")
                        .OptionLabelTemplate("<span class='grid-filter__dropdown-placeholder'>Filter By</span>")
                        .DataTextField("Text")
                        .DataValueField("Value")

                        .BindTo(new List<SelectListItem>
                            {
                                new SelectListItem
                                    {
                                        Text = "Serial Number",
                                        Value = "SerialNumber"
                                    },
                                new SelectListItem
                                    {
                                        Text = "Authorization Code",
                                        Value = "AuthorizationCodes"
                                    },
                                new SelectListItem
                                    {
                                        Text = "Expires By",
                                        Value = "ExpiresBy"
                                    },
                                new SelectListItem
                                    {
                                        Text = "Model Name",
                                        Value = "ModelName"
                                    },
                                new SelectListItem
                                    {
                                        Text = "Device Name",
                                        Value = "DeviceName"
                                    },

                                new SelectListItem
                                    {
                                        Text = "Authorized Support Center",
                                        Value = "ASCName"
                                    },
                                new SelectListItem
                                    {
                                        Text = ApiConstants.DEVICE_CATEGORY,
                                        Value = "DeviceCategoryId"
                                    },
                                new SelectListItem
                                    {
                                        Text = "Remarks",
                                        Value = "Comments"
                                    }

                            })
                        )
                    }
                    @* Must be "Spares" tab -- Don't show 'Authorized Support Center' column *@
                    else
                    {
                    @(Html.Kendo().DropDownList()
                        .Name((string)UniqueId.searchFieldId)
                        .Events(events => events.Change("OnDevicesCmbChange"))
                        .DataTextField("Text")
                        .DataValueField("Value")

                        .BindTo(new List<SelectListItem>
                            {
                                new SelectListItem
                                    {
                                        Text = "Serial Number",
                                        Value = "SerialNumber"
                                    },
                                new SelectListItem
                                    {
                                        Text = "Model Name",
                                        Value = "ModelName"
                                    },
                                new SelectListItem
                                    {
                                        Text = "Device Name",
                                        Value = "DeviceName"
                                    },
                                new SelectListItem
                                    {
                                        Text = "City",
                                        Value = "City"
                                    },
                                new SelectListItem
                                    {
                                        Text = "Postal Code",
                                        Value = "PostalCode"
                                    },
                                new SelectListItem
                                    {
                                        Text = ApiConstants.DEVICE_CATEGORY,
                                        Value = "DeviceCategoryId"
                                    },
                                new SelectListItem
                                    {
                                        Text = "Remarks",
                                        Value = "Comments"
                                    }

                            })
                        )
                    }
                }
            </div>

            <div class="grid-filter">
                    <div class="grid-filter" id="@UniqueId.textDivId">
                        @Html.TextBox((string)UniqueId.searchValueId, Model.DefaultDeviceCode, new {
                       onkeypress = "return " + (string)UniqueId.device + "onDevicesEnterPress(event)",
                       @class = "grid-filter__search-input",
                       placeholder = "Search",
                       aria_label = "Search"
                   })
                        <button aria-label="search" type="button" class="grid-filter__search-button" onclick="@(UniqueId.device)SearchDeviceData()">
                            <span aria-hidden="true" class="fa fa-search" />
                        </button>
                    </div>
                <div class="grid-filter" id="@UniqueId.deviceCategoryDropDownDivId" style="display: none;">
                    @(Html.Kendo().DropDownList()
                            .Name((string)UniqueId.deviceCategoryFieldId)
                            .Events(events => events.Change("DeviceTagChangeHandler"))
                            .OptionLabel(Constants.DropDownPleaseSelect)
                            .DataValueField("DeviceCategoryId")
                            .DataTextField("DeviceCategoryName")
                            .BindTo(Model.AllDeviceCategories))
                </div>
                <div id="@UniqueId.DateSearchDiv" class="filter-datepicker">
                    @{
                        var defaultDate = DateTime.Now.AddMonths(3);
                    }
                    @(Html.Kendo().DatePicker()
                          .Name(UniqueId.SearchDateValue)
                          .Value(defaultDate)
                          .HtmlAttributes(new {
                              onkeypress = "return " + (string)UniqueId.device + "onDevicesEnterPress(event)",
                              @class = "grid-filter__date-input",
                          }))
                </div>
            </div>
        </div>
    </div>
     
}
  

    <div class="grid-content">



    @{
        if (Model != null && Model.Devices != null) {
            var maxPageSizeForms = Convert.ToInt32(Model.Devices.Count);
            var pageSizeOptionsForms = new List<int> { 5, 10, 20, 50 };
            if (maxPageSizeForms > pageSizeOptionsForms.Max()) {
                pageSizeOptionsForms.Add(maxPageSizeForms);
            }

        @(Html.Kendo().Grid(Model.Devices)
                  .Name((string)UniqueId.gridId)
                  .HtmlAttributes(new { @class = "proddevicegrid" })
                  .Columns(columns => {

                      columns.Bound(p => p.SerialNumber).Filterable(false).Sortable(true).Template(t => "<a href='javascript: " + UniqueId.device + "showEditDeviceDetailWindow(" + t.DeviceId + ")'>" + t.SerialNumber + "</a>" + t.DeviceTransferMessage).ClientTemplate
                          ("<a href='javascript: " + UniqueId.device + "showEditDeviceDetailWindow(#: DeviceId #)'>#: SerialNumber #</a>#= DeviceTransferMessage #").Encoded(false);
                      
        

                      columns.Bound(x => x.ModelName).Filterable(false).Sortable(true);
                      columns.Bound(x => x.DeviceName).Filterable(false).Sortable(true).ClientTemplate("#= kendoGridNewLines(DeviceName) #").Encoded(false);
                      if (actionHelper.Controller != ControllerFields.GroupController) {
                          columns.Bound(x => x.Group).Filterable(false).Sortable(false).ClientTemplate("#= kendoGridNewLines(Group) #").Encoded(false);
                      }
                      if (Model.IsProductionDeviceList) {
                          columns.Bound(x => x.License).Filterable(false).Sortable(false).ClientTemplate("#= kendoGridNewLines(License) #").Encoded(false);
                          //columns.Command(com => com.Custom("csp-edit").Text(" ").Click((string)UniqueId.device + "licensePopup.editLicenses")).Title("Actions");
                          columns.Bound(x => x.Group).Filterable(false).Sortable(false).Title("Actions").ClientTemplate("#=GetActionsLink(data)#").Encoded(false);
                          columns.Bound(x => x.AuthCode).Filterable(false).Sortable(false).ClientTemplate("#= kendoGridNewLines(AuthCode) #").Encoded(false);
                          columns.Bound(x => x.ExpirationDate).Filterable(false).Sortable(false).ClientTemplate("#= kendoGridNewLines(ExpirationDate) #").Encoded(false);
                          columns.Bound(x => x.ASCName).Filterable(false).Sortable(true).Title("ASC").Template(@<text></text>).ClientTemplate("#=GetAscContactLink(data)#").Encoded(false);
                      }
                      else
                      {
                          columns.Bound(x => x.City).Filterable(false).Sortable(true);
                          columns.Bound(x => x.RegionState).Filterable(false).Sortable(true);
                          columns.Bound(x => x.PostalCode).Filterable(false).Sortable(true);
                          columns.Bound(x => x.Country).Filterable(false).Sortable(true);
                      }
                    
                              
                       columns.Bound(x => x.DeviceTag).Filterable(false).Sortable(true).ClientTemplate("#= kendoGridNewLines(DeviceTag) #").Encoded(false);
                       columns.Bound(x => x.PanOsVersion).Filterable(false).Sortable(false).Title("OS Release").ClientTemplate("#= (PanOsVersion == null) ? '' : PanOsVersion #").Encoded(false);
                       columns.Bound(x => x.HyperVisorVersion).Filterable(false).Sortable(false).Title("Virtual Platform").ClientTemplate("#= (HyperVisorVersion == null) ? '' : HyperVisorVersion #").Encoded(false);

                       if (actionHelper.Controller != ControllerFields.SupportAccountController) {
                           if ((User.HasPermission(Permission.CreateGroup) || User.HasPermission(Permission.EditGroup)) && (actionHelper.Controller == ControllerFields.GroupController)) {
                               columns.Command(command => command.Custom("csp-delete").Text(" ").Click((string)UniqueId.device + "DeleteDeviceDetails")).Width(30).Title("Action").HtmlAttributes(new { title = "Delete", href = "javascript:void(0);" });
                           }
                       }
                  })
                                  .Pageable(pageable => pageable.PageSizes(pageSizeOptionsForms.ToArray()))
                                  .Sortable()
                                  .Filterable()
                                  .Resizable(resize => resize.Columns(true))
                                  .Events(e => e.DataBound((string)UniqueId.device + "onDeviceDataBound"))
                                  .ToolBar(toolBar => {
                                      toolBar.Custom()
                                      .Text("Export To CSV")
                                      .HtmlAttributes(new { id = "export", data_link_type = "export-csv-assets" })
                                      .Url("javascript: " + UniqueId.devices + "deviceButtons.exportProductionAssetsToCsv();");
                                  })
                                  .DataSource(dataSource => dataSource
                                                                    .Ajax()
                                                                    .Total(Convert.ToInt32(Model.DataParameters.TotalRecordCount))
                                                                    .Model(model => model.Id(p => p.DeviceId))
                                                                    .Destroy(update => update.Action("EditingInline_Destroy", "Grid"))
                                                                    .PageSize(Model.DataParameters.PaginationCount)
                                                                    .Read(read => read.Action(Model.IsProductionDeviceList ? actionHelper.ProductionDevices : actionHelper.SpareDevices, actionHelper.Controller, new {
                                                                        actionHelper.Id
                                                                    }).Data(UniqueId.device + "getGridParams"))
                                  )
            )

            @(Html.Kendo().Tooltip()
                .For("#" + (string)UniqueId.gridId)
                .Filter(".forMagicLink")
                .ContentHandler("getMagicLinkTooltip")
                .Position(TooltipPosition.Right)
                .AutoHide(true)
                )
        }
    }

</div>

