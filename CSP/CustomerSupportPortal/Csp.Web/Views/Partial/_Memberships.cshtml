          .Modal(true)
          .Draggable()
          .Title("User:")
          .Events(events => events
                                    .Close((string)UniqueId.memberships + "onCloseUserWindow")
                                    .Open((string)UniqueId.memberships + "onOpenUserWindow"))
          .Visible(false)
            )
        </div>

        <div class="contextTitle">Manage Users </div>
        @if (Model.IsUserImpersonated || Model.IsUserInternal)
        {
            <h3>
                Adding users to this account requires super user approval. Confirm that urgent access requests have super user approval and <span style="color: red;">immediately</span> alert all super users on the account via e-mail if new user is being added.
            </h3>
            <br />
        }
        <div class="grid-header">
            <div class="grid-left">
                @if (User.HasPermission(Permission.CreateMembership) || (Model.MembershipTypeId == (int)MembershipType.Group && User.HasPermission(Permission.CreateGroupMembership)))
                {
                    <input type="button" value="Add Member" class="k-button k-primary" data-link-type="add-member" onclick="@(UniqueId.memberships)CreateMembership();" /> <span class="csp-tooltip"><i class="icon-question-sign icon-large" onclick="SupportPortal.Help(this, 5);"></i></span>
                }
                @if (Model.NumberOfPendingMemberships > 0)
                {
                    <input type="button" value="Review @Model.NumberOfPendingMemberships Pending Membership(s)" class="k-button" style="margin-left: 10px;" onclick="javascript: location.href = '@Url.Action("AllPendingMemberships", "Membership", new { id = @Model.ActionHelper.Id})';" />
                }
            </div>

            <div class="grid-right">

                <div class="grid-filter">
                    @(Html.Kendo().DropDownList()
                  .Name((string)UniqueId.searchFieldId)
                  .Events(events => events.Change((string)UniqueId.memberships + "OnCmbChange"))
                  .OptionLabel("Filter By")
                  .OptionLabelTemplate("<span class='grid-filter__dropdown-placeholder'>Filter By</span>")
                  .DataTextField("Text")
                  .DataValueField("Value")
                  .BindTo(new List<SelectListItem>
                      {
                          new SelectListItem {
                              Text = "First Name",
                              Value = "FirstName"
                          },
                          new SelectListItem {
                              Text = "Last Name",
                              Value = "LastName"
                          },
                          new SelectListItem {
                              Text="Email",
                              Value="Email"
                          },
                          new SelectListItem {
                              Text = "Activation Date",
                              Value = "ActivationDate"
                          },
                          new SelectListItem {
                              Text = "Expiration Date",
                              Value = "ExpirationDate"
                          },
                          new SelectListItem {
                              Text = "Roles",
                              Value = "RoleNames"
                          },
                          new SelectListItem {
                              Text = "Description",
                              Value = "Description"
                          }
                      })
                    )
                </div>


                <div class="grid-filter">
                    <div class="grid-filter" id="@UniqueId.searchDivId">
                        @Html.TextBox((string)UniqueId.searchValueId, "", new {
                            onkeypress = "return " + (string)UniqueId.memberships + "onMembershipEnterPress(event)",
                            @class = "grid-filter__search-input",
                            placeholder = "Search",
                            aria_label = "Search"
                        })
                        <button aria-label="search" type="button" class="grid-filter__search-button" onclick="@(UniqueId.memberships)SearchMemberShipData()">
                            <span aria-hidden="true" class="fa fa-search" />
                        </button>
                    </div>

                    <div class="filter-datepicker" id="@UniqueId.dateDivId">
                        @(Html.Kendo().DatePicker()
                      .Name(UniqueId.searchDateTimePickerId)
                      .HtmlAttributes(new
                      {
                          onkeypress = "return " + (string)UniqueId.memberships + "onMembershipEnterPress(event)",
                          @class = "grid-filter__date-input",
                      }))
                    </div>
                </div>
            </div>
        </div>

        <div class="grid-content">

            <div id="@UniqueId.gridDivId">
                @{
                    if (Model != null && Model.Memberships != null)
                    {

                        var maxPageSizeForms = Convert.ToInt32(Model.Memberships.Count);
                        var pageSizeOptionsForms = new List<int> { 5, 10, 20, 50 };
                        if (maxPageSizeForms > pageSizeOptionsForms.Max())
                        {
                            pageSizeOptionsForms.Add(maxPageSizeForms);
                        }

                        @(Html.Kendo().Grid(Model.Memberships)
                    .Name((string)UniqueId.gridId)
                    .Columns(columns =>
                    {
                        columns.Bound(p => p.FirstName).Width(150).Filterable(false).Sortable(true).ClientTemplate("#= FirstName # #= LastName #").Title("Name");
                        columns.Bound(p => p.Email).Width(125).Title("Email");
                        columns.Bound(p => p.ActivationDate).Width(120).Format("{0:d}").EditorTemplateName("Date").Title("Activation Date");
                        columns.Bound(p => p.ExpirationDate).Width(120).Format("{0:MM/dd/yyyy}").EditorTemplateName("Date").Title("Expiration Date");
                        columns.Bound(p => p.MultiFactorAuthType).Hidden();
                        //if (!Model.AllowMfaEdit)
                        //{
                        //    columns.Bound(p => p.MfaStatus).Width(35).Filterable(false).Sortable(true)
                        //        .ClientTemplate("<span id='mfaStatus'>#= MfaStatus #  #= IsThridPartyIdpConfigured ? visibility='hidden': ''  #   </span> ")
                        //        .Title("2 Factor Authentication");
                        //}
                        //else
                        //{
                        //    columns.Bound(p => p.MfaStatus).Width(35).Filterable(false).Sortable(true)
                        //        .ClientTemplate("<span id='mfaStatus'>#= MfaStatus #  #= IsThridPartyIdpConfigured ? visibility='hidden': ''  #   </span> ")
                        //        .Title("2 Factor Authentication").EditorTemplateName("MfaStatus");
                        //}
                        //columns.Bound(p => p.EnableEmailMfa).Width(35).Filterable(false).Sortable(false)
                        //    .ClientTemplate("<input type='checkbox' disabled='disabled' #= EnableEmailMfa ? checked='checked' :''#  #=IsThridPartyIdpConfigured ? visibility='hidden': '' #   />")
                        //    .Title("Default 2FA (Email)");
                        columns.Bound(p => p.Roles).Width(250).HeaderTemplate("<span>Roles</span><span class='csp-tooltip'><i class='icon-question-sign icon-large' onmouseover='SupportPortal.Help(this, 68);'></i></span>").
                            EditorTemplateName("Roles").EditorViewData(new { Model.AvailableRoles }).ClientTemplate("#=" + UniqueId.rolesTemplate + "(Roles)#");
                        columns.Bound(p => p.Description).Width(200).EditorTemplateName("TextArea").HtmlAttributes(new { @class = "wrapText" });

                        if (User.HasPermission(Permission.EditMembership) || User.HasPermission(Permission.DeleteMembership) ||
                            (Model.MembershipTypeId == (int)MembershipType.Group && (User.HasPermission(Permission.EditGroupMembership) || User.HasPermission(Permission.DeleteGroupMembership))))
                        {
                            columns.Command(command =>
                            {
                                if (User.HasPermission(Permission.EditMembership) ||
                                    (Model.MembershipTypeId == (int)MembershipType.Group && User.HasPermission(Permission.EditGroupMembership)))
                                {
                                    command.Custom("csp-edit").Text(" ").Click((string)UniqueId.memberships + "EditMembership").HtmlAttributes(new { title = "Edit", href = "javascript:void(0);", data_link_type = "edit-member" });
                                }
                                if (User.HasPermission(Permission.DeleteMembership) ||
                                    (Model.MembershipTypeId == (int)MembershipType.Group && User.HasPermission(Permission.DeleteGroupMembership)))
                                {
                                    command.Custom("csp-delete").Text(" ").Click((string)UniqueId.memberships + "DeleteMembership").HtmlAttributes(new { title = "Delete", href = "javascript:void(0);", data_link_type = "remove-member" });
                                }
                            }).Width(80).Title("Actions").HtmlAttributes(new { style = "white-space: nowrap;" });
                        }
                    })
                    .Editable(editable => editable.Mode(GridEditMode.InLine).DisplayDeleteConfirmation(false))
                    .Events(e =>
                    {
                        e.DataBound((string)UniqueId.memberships + "onMemberGridDataBound");
                        e.Edit((string)UniqueId.memberships + "onMemberGridEdit");
                    })
                    .ToolBar(toolBar =>
                    {
                        toolBar.Custom()
                        .Text("Export To CSV")
                        .HtmlAttributes(new { id = "export", data_link_type = "export-csv-members" })
                        .Url("javascript: exportMembersToCsv();");
                    })
                    .Pageable(pageable => pageable.PageSizes(pageSizeOptionsForms.ToArray()))
                    .Sortable()
                    .Resizable(resize => resize.Columns(true))
                    .DataSource(dataSource => dataSource
                                                  .Ajax()
                                                  .Model(model =>
                                                  {
                                                      model.Id(p => p.MembershipId);
                                                      model.Field(p => p.FirstName).Editable(false);
                                                      if (!Model.AllowMfaEdit)
                                                      {
                                                          model.Field(p => p.MfaStatus).Editable(false);
                                                      }
                                                      else
                                                      {
                                                          model.Field(p => p.MfaStatus).Editable(true);
                                                      }
                                                      model.Field(p => p.Roles).DefaultValue(new List<NameValue>());
                                                  }
                                                  )
                                                  .Total(Convert.ToInt32(Model.DataParameters.TotalRecordCount))
                                                  .PageSize(Model.DataParameters.PaginationCount)
                                                  .Events(e =>
                                                  {
                                                      e.Error((string)UniqueId.memberships + "onMemberGridError");
                                                      e.RequestEnd((string)UniqueId.memberships + "onMemberGridRequestEnd");
                                                  })
                                                  .Read(read => read.Action(actionHelper.Users, actionHelper.Controller, new
                                                  {
                                                      actionHelper.Id
                                                  }).Data("SetAntiForgery"))
                                                  .Create(create => create.Action("CreateMembership", "Membership").Data((string)UniqueId.memberships + "GetCreateMembershipData"))
                                                  .Update(update => update.Action("UpdateMembership", "Membership").Data((string)UniqueId.memberships + "GetUpdateMembershipData"))
                                                  .Destroy(destroy => destroy.Action("DeleteMembership", "Membership").Data((string)UniqueId.memberships + "GetDeleteMembershipData"))
                                                  .Events(e => e.RequestEnd((string)UniqueId.memberships + "membershipRequestEnd").RequestStart((string)UniqueId.memberships + "membershipRequestStart"))
                    )
                        )
                    }
                }

            </div>

        </div>
    </div>
}
