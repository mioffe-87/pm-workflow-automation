%>						   join <%=joinInfo.RightNameCamelCased%> in this.<%=GeneratorUtils.PluralizeString(joinInfo.RightEntityName)%> on <%=leftOnClauseOperand%> equals <%=rightOnClauseOperand%>
<%						break;
				}
