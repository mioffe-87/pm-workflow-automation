<?xml version="1.0"?>
<configuration>
	<configSections>
		<section name="dependencyInjectionInformation" type="SD.LLBLGen.Pro.ORMSupportClasses.DependencyInjectionSectionHandler, SD.LLBLGen.Pro.ORMSupportClasses.NET20, Version=3.5.0.0, Culture=neutral, PublicKeyToken=ca73b74ba4e3ff27"/>
	</configSections>

	<appSettings>
		<!-- adjust connection strings. -->
		<add key="ConnectionString.SQL Server (SqlClient)" value="data source=server;initial catalog=Northwind;integrated security=SSPI;persist security info=False;packet size=4096"/>
		<add key="AdventureWorks.ConnectionString.SQL Server (SqlClient)" value="data source=server;initial catalog=AdventureWorks;integrated security=SSPI;persist security info=False;packet size=4096"/>
		<add key="autoDependencyInjectionDiscovery" value="true"/>
	</appSettings>
	<system.diagnostics>
		<switches>
			<add name="SqlServerDQE" value="4"/>
			<add name="AccessDQE" value="4"/>
			<add name="OracleDQE" value="4"/>
			<add name="FirebirdDQE" value="4"/>
			<add name="MySqlDQE" value="4"/>
			<add name="DB2DQE" value="4"/>
			<add name="ORMGeneral" value="0"/>
			<add name="ORMStateManagement" value="0"/>
			<add name="ORMPersistenceExecution" value="0"/>
		</switches>
	</system.diagnostics>

	<dependencyInjectionInformation>
		<additionalAssemblies>
			<assembly filename="DITestClasses.dll"/>
		</additionalAssemblies>
		<instanceTypeFilters>
			<instanceTypeFilter namespace="Northwind"/>
			<instanceTypeFilter namespace="InheritanceOne.Dal"/>
			<instanceTypeFilter namespace="DITestClasses"/>
			<instanceTypeFilter namespace="UnitTests"/>
			<instanceTypeFilter namespace="Authorizers"/>
			<instanceTypeFilter namespace="AdventureWorks.Dal.Adapter"/>
			<instanceTypeFilter namespace="Unittests.TestLibrary"/>
		</instanceTypeFilters>
	</dependencyInjectionInformation>
</configuration>
