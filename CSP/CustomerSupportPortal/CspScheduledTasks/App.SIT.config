<?xml version="1.0" encoding="utf-8" ?>
<!-- For more information on using transformations 
     see the web.config examples at http://go.microsoft.com/fwlink/?LinkId=214134. -->
<configuration xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">
  <atlas>
    <host name="CSPScheduledTasks" displayName="CSP Scheduled Tasks Windows Service" description="CSP Scheduled Tasks Windows Service" allowMultipleInstances="false" xdt:Transform="SetAttributes" xdt:Locator="Match(name)">
      <runtime accounttype="NetworkService" startup="Automatic" />
    </host>
  </atlas>
  <applicationSettings xdt:Transform="Replace">
    <CspScheduledTasks.Properties.Settings>
      <setting name="CspScheduledTasks_SfdcServiceClient_SfdcService"
        serializeAs="String">
        <value>https://supportsit.paloaltonetworks.com/SfdcService.asmx</value>
      </setting>
      <setting name="CspScheduledTasks_ScheduledJobsServiceClient_ScheduledJobsService"
        serializeAs="String">
        <value>https://supportsit.paloaltonetworks.com/ScheduledJobsService.asmx</value>
      </setting>
    </CspScheduledTasks.Properties.Settings>
  </applicationSettings>
<appSettings>
   <add key="ApplicationUrl" value="https://support.sit.app.paloaltonetworks.com" xdt:Transform="SetAttributes" xdt:Locator="Match(key)"/>
    <add key="ScheduledJobCnName" value="support.qa.api.paloaltonetworks.com" xdt:Transform="SetAttributes" xdt:Locator="Match(key)"/>
</appSettings>
</configuration>