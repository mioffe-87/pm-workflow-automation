			return Get<%=typedList.Name%>TypedListQuery(session, string.Empty);
		}

		/// <summary>Creates an IQuery to fetch the typed list '<%=typedList.FullName%>' into instances of <%=typedList.Name%>TypedListRow</summary>
		/// <param name="session">The session to use for fetching.</param>
		/// <param name="additionalQueryFragment">The additional query fragment, in HQL syntax.</param>
		/// <returns>Query to fetch the typed list</returns>
		/// <remarks>Entities are aliased either by the alias specified in the typedlist, or using the pattern a_<i>entityname_lowercase</i>.</remarks>
		public static IQuery Get<%=typedList.Name%>TypedListQuery(ISession session, string additionalQueryFragment)
		{
<%		var sb = new StringBuilder();
		var usedAliases = new Dictionary<EntityAlias, string>();
		foreach(var alias in typedList.Vertices)
		{
			string aliasString = alias.Alias;
			if(string.IsNullOrEmpty(aliasString))
			{
				aliasString = string.Format("a_{0}", alias.AliassedEntity.Name.ToLowerInvariant());
			}
			usedAliases.Add(alias, aliasString);
		}
		sb.AppendFormat("select {0} from ", string.Join(", ", 
											typedList.Fields.Select(f=>string.Format("{0}.{1} as {2}", usedAliases.GetValue(f.SourceEntityAlias), f.MappedFieldAsString, f.FieldAlias))
															.ToArray()));
		if(typedList.EdgeCount<1)
		{
			var alias = usedAliases.First();
			sb.AppendFormat("{0} as {1}", alias.Key.AliassedEntity.Name, alias.Value);	// one alias present, just pick that one.
		}
		else
		{
			// traverse the edges and emit join clauses. 
			bool first = true;
			foreach(var edge in typedList.GetAllRelationshipsForQueryConstruction())
			{
				// edges are directed edges, where start entity points to the entity it is joined with. So ENDVertex joinhint STARTvertex
				if(first)
				{
					sb.AppendFormat("{0} as {1}", edge.EndVertex.AliassedEntity.Name, usedAliases.GetValue(edge.EndVertex));
					first = false;
				}
				switch(edge.HintForJoins)
				{
					case JoinHint.Cross:
						sb.AppendFormat(" full join ");
						break;
					case JoinHint.None:
					case JoinHint.Inner:
						sb.AppendFormat(" inner join ");
						break;
					case JoinHint.Left:
						sb.AppendFormat(" left outer join ");
						break;
					case JoinHint.Right:
						sb.AppendFormat(" right outer join ");
						break;
				}
				// use the END navigator, which is the LEFT navigator using the IRelationshipEdge interface, as with ENDVertex joinhint STARTvertex, 
				// the END vertex is the left operand of the join hint
				sb.AppendFormat("{0}.{1} as {2}", usedAliases.GetValue(edge.EndVertex), ((IRelationshipEdge)edge).LeftNavigator, 
								usedAliases.GetValue(edge.StartVertex));
			}
		}
%>			return ProduceQuery<<%=typedList.Name%>TypedListRow>(session, "<%=sb.ToString()%>", additionalQueryFragment);
		}
<# SD_NHibernate_CustomTypedListQueryFactoryInclude #>
<%	}
%>		/// <summary>Produces the IQuery from the parameters specified</summary>
		/// <typeparam name="TRow">the typedlist row type</typeparam>
		/// <param name="session">The session.</param>
		/// <param name="queryString">The query string.</param>
		/// <param name="additionalQueryFragment">The additional query fragment.</param>
		/// <returns>the query to produce</returns>
		private static IQuery ProduceQuery<TRow>(ISession session, string queryString, string additionalQueryFragment)
		{
			string queryStringToUse = queryString;
			if(!string.IsNullOrEmpty(additionalQueryFragment))
			{
				queryStringToUse += string.Format(" {0}", additionalQueryFragment);
			}
			IQuery query = session.CreateQuery(queryStringToUse);
			query.SetResultTransformer(new AliasToBeanResultTransformer(typeof(TRow)));
			return query;
		}
	}
