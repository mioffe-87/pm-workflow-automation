		int currentSetCounter = 0;
%>		''' <summary>Gets the query to fetch the typed list <%=typedList.FullName%></summary>
		Public Function Get<%=typedList.Name%>TypedList() As IQueryable(Of <%=typedList.Name%>TypedListRow)
			Dim current<%=currentSetCounter%> = From v In Me.<%=GeneratorUtils.PluralizeString(root.AliassedEntity.Name)%>
<%		bool currentSetIsJoinResult = false;
		int joinResultCounter = 0;
		var elementsThroughJoinResults = new HashSet<EntityAlias>();
		foreach(var chunkInfo in GeneratorUtils.GetLinqChunkInfosForTypedList(typedList))
		{
			bool startNewCurrentSet = true;
			foreach(var joinInfo in chunkInfo.JoinInfos)
			{
				bool leftSideDeclaredThisChunk = chunkInfo.EntityAliasses.Contains(joinInfo.LeftEntityAlias) && !elementsThroughJoinResults.Contains(joinInfo.LeftEntityAlias);
				bool rightSideDeclaredThisChunk = chunkInfo.EntityAliasses.Contains(joinInfo.RightEntityAlias) && !elementsThroughJoinResults.Contains(joinInfo.RightEntityAlias);
				string fromClauseSource = "current" + currentSetCounter;
				string joinClauseSource = "Me." + GeneratorUtils.PluralizeString(joinInfo.RightEntityName);
				string leftName = currentSetIsJoinResult && ! leftSideDeclaredThisChunk ?  "current_v" : joinInfo.LeftNameCamelCased;
				string rightName = joinInfo.RightNameCamelCased;
				string onClauseLeftSuffix = currentSetIsJoinResult && ! leftSideDeclaredThisChunk ? joinInfo.LeftNameCamelCased + "." : string.Empty;
				string onClauseRightSuffix = string.Empty;
				if(joinInfo.FetchFromClauseAsNew)
				{
					fromClauseSource = "Me." + GeneratorUtils.PluralizeString(joinInfo.LeftEntityName);;
					joinClauseSource = "current" + currentSetCounter;
					leftName = joinInfo.LeftNameCamelCased;
					rightName = currentSetIsJoinResult && ! rightSideDeclaredThisChunk ?  "current_v" : joinInfo.RightNameCamelCased;
					onClauseLeftSuffix = string.Empty;
					onClauseRightSuffix = currentSetIsJoinResult && ! rightSideDeclaredThisChunk ? joinInfo.RightNameCamelCased +"." : string.Empty;
				}

				string leftOnClauseOperand = SD_LinqToSqlGeneralUtils.ProduceLinqOnClauseOperand(leftName, onClauseLeftSuffix, joinInfo.LeftFields, "New With {{{0}}}");
				string rightOnClauseOperand = SD_LinqToSqlGeneralUtils.ProduceLinqOnClauseOperand(rightName, onClauseRightSuffix, joinInfo.RightFields, "New With {{{0}}}");
				
				if(startNewCurrentSet)
				{
					startNewCurrentSet = false;
					currentSetCounter++;
%>			Dim current<%=currentSetCounter%> = From <%=leftName%> In <%=fromClauseSource%> _
<%				}
				switch(joinInfo.HintForJoins)
				{
					case JoinHint.Left:
						joinResultCounter++;
%>						   Group Join <%=rightName%> In <%=joinClauseSource%> On <%=leftOnClauseOperand%> Equals <%=rightOnClauseOperand%> _
						   Into joinresult_<%=joinResultCounter%> = Group _
						   From <% if(currentSetIsJoinResult) {%><%=rightName%><%} else {%><%=joinInfo.RightNameCamelCased%><%}%> In joinresult_<%=joinResultCounter%>.DefaultIfEmpty() _
<%						break;
					case JoinHint.Cross:
%>						   From <%=joinInfo.RightNameCamelCased%> In Me.<%=GeneratorUtils.PluralizeString(joinInfo.RightEntityName)%> _
<%						break;
					default:
%>						   Join <%=joinInfo.RightNameCamelCased%> In Me.<%=GeneratorUtils.PluralizeString(joinInfo.RightEntityName)%> On <%=leftOnClauseOperand%> Equals <%=rightOnClauseOperand%> _
<%						break;
				}
			}
			// emit temporary projection for this intermediate query (currentSet)
			List<string> tempProjectionFragments = new List<string>();
			foreach(var alias in chunkInfo.EntityAliasses.Where(ea=>!elementsThroughJoinResults.Contains(ea)))
			{
				tempProjectionFragments.Add(GeneratorUtils.CamelCaseString(alias.NameForOutput));
			}
			foreach(var alias in elementsThroughJoinResults)
			{
				tempProjectionFragments.Add(string.Format("current_v.{0}", GeneratorUtils.CamelCaseString(alias.NameForOutput)));
			}
%>						   Select New With {<%=string.Join(", ", tempProjectionFragments.ToArray())%> }
<%
			elementsThroughJoinResults.AddRange(chunkInfo.EntityAliasses);
			currentSetIsJoinResult = true;
		}
		// emit final projection.
		List<string> finalProjectionFragments = new List<string>();
		foreach(var field in typedList.Fields)
		{
			string fieldPrefix = "v.";
			if(currentSetIsJoinResult)
			{
				fieldPrefix = string.Format("v.{0}.", GeneratorUtils.CamelCaseString(field.SourceEntityAlias.NameForOutput));
			}
			finalProjectionFragments.Add(string.Format(".{0} = {1}{2}", field.FieldAlias, fieldPrefix, field.MappedFieldAsString ));
		}
%>			Return current<%=currentSetCounter%>.Select(Function (v) New <%=typedList.Name%>TypedListRow() With { <%=string.Join(", ", finalProjectionFragments.ToArray())%> })
		End Function
		
<%	}
	
