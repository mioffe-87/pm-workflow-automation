@{
    var pageSizeOptionsForms = new List<int> { 5, 10, 20, 50 };
}

@* .HtmlAttributes(new { @class = "proddevicegrid", style = "display: " + (searchingOneAccount ? "block" : "none") + ";" })*@
<div class="grid-content">
<div class="grid-right" style="z-index: 2;position: absolute;right: 13px;">
    <div class="grid-actions">
        <input type="button" value="Expand All" id="expand-all" class="k-button" style="display:none;" />
        <input type="button" value="Collapse All" id="collapse-all" class="k-button" style="display:none;" />
    </div>
</div>

@(Html.Kendo().Grid<SearchAllModel>()
                  .Name("SearchAllGrid")
                  .BindTo(Model.SearchAllResults)
                  .HtmlAttributes(new { @class = "proddevicegrid" })
                  .Columns(columns => {
                      columns.Bound(c => c.SupportAccountName).Sortable(false).Title("Support<br/>Account").Hidden(searchingOneAccount).ClientTemplate("# if (SupportAccountId > 0) { ##=formatSupportAccount(data)## } else { ##=SupportAccountName## } #").Encoded(false);
                      columns.Bound(c => c.AssetType).Sortable(false).Title("Asset<br/>Type");
                      columns.Bound(c => c.DeviceCode).Title("SN").ClientTemplate("# if (SupportAccountId > 0) { ##=formatSNs(data)## } else { ##=DeviceCode## } #").Encoded(false);
                      columns.Bound(c => c.ModelName).Sortable(false).ClientTemplate("#=ModelName#").Encoded(false);
                      columns.Bound(c => c.DeviceName).Title("Device<br/>Name");
                      columns.Bound(c => c.Licenses).Sortable(false).ClientTemplate("#=Licenses#").Encoded(false);
                      columns.Bound(c => c.AuthorizationCodes).Sortable(false).Title("Auth<br/>Codes").ClientTemplate("#=AuthorizationCodes#").Encoded(false);
                      columns.Bound(c => c.ExpirationDates).Sortable(false).Title("Expiration<br/>Dates").ClientTemplate("#=ExpirationDates#").Encoded(false);
                      columns.Bound(c => c.Quantity).Hidden(!searchingOneAccount).Sortable(false).ClientTemplate("#=Quantity#").Encoded(false);
                      columns.Bound(c => c.HtmlLocation).Sortable(false).Encoded(false).Title("Location");
                      columns.Bound(c => c.HtmlGroups).Title("Groups").Hidden(!searchingOneAccount).Sortable(false).ClientTemplate("#=HtmlGroups#").Encoded(false);
                      columns.Bound(c => c.AuthorizedSupportCenter).Sortable(false).Title("ASC");
                      columns.Bound(c => c.DeviceTag).Sortable(false).Title("Device<br/>Tag");
                  })
                  .Pageable(pageable => pageable.PageSizes(pageSizeOptionsForms.ToArray()))
                  .Sortable()
                  .Events(e => { e.DataBound("SearchAllGridDataBound"); e.DetailInit("initDetail"); })
                  .Resizable(resize => resize.Columns(true))
                  .ClientDetailTemplateId("template")
                  .ToolBar(toolBar => {
                      toolBar.Custom()
                      .Text("Export To CSV")
                      .HtmlAttributes(new { id = "export", data_link_type = "export-csv-assets" })
                      .Url("javascript: exportSearchAllToCsv();");
                  })
                  .DataSource(dataSource => dataSource
                                                    .Ajax()
                                                    .Total(Convert.ToInt32(Model.DataParameters.TotalRecordCount))
                                                    .Events(e => e.RequestEnd("searchAllRequestEnd").RequestStart("searchAllRequestStart"))
                                                    .Model(model => model.Id(p => p.Id))
                                                    .PageSize(10)
                                                    .Sort(s => s.Add(searchingOneAccount ? "AssetType" : "SupportAccountName"))
                                                    .Read(read => read.Action("View", "SearchAll", new {
                                                        id = Model.DefaultSupportAccountId
                                                    }).Data("SetAntiForgery"))
                  )
      )
    <script id="template" type="text/kendo-tmpl">
        @((Html.Kendo().Grid<SearchAllDetail>()
            .Name("ChildGrid_#=DeviceCode#")
            .Columns(columns =>
            {
                columns.Bound(o => o.Model).Title("Model");
                columns.Bound(o => o.License).Title("License");
                columns.Bound(o => o.AuthorizationCode).Title("Auth code").Width(120);
                columns.Bound(o => o.ExpirationDate).Title("Expiration date").Width(120);
                columns.Bound(o => o.Quantity).Title("Quantity").Width(120);
            })
            .ToClientTemplate()))
    </script>
    <script>
        function initDetail(e) {
            var childDataDiv = $("#ChildGrid_" + e.data.DeviceCode);
            if (e.data.ChildLicenses) {
                childDataDiv.data("kendoGrid").dataSource.data(e.data.ChildLicenses);
            }
            if (!(e.data.ChildLicenses
                && e.data.ChildLicenses.length > 0)) {
                var childDiv = childDataDiv.parent().parent();
                childDiv.prev().removeClass('bold');
                childDiv.prev().find('a.k-icon').remove();
                childDiv.remove();
            }
        }

        function setButtonsState() {
            var total = $('.k-master-row').length;
            var selected = $('.k-master-row.bold').length;

            if (total === selected) { // all collapsed
                $('#expand-all').addClass('selected');
                $('#collapse-all').removeClass('selected');
            } else if (selected === 0) { // all expanded
                $('#expand-all').removeClass('selected');
                $('#collapse-all').addClass('selected');
            } else {
                $('#expand-all').removeClass('selected');
                $('#collapse-all').removeClass('selected');
            }
        }
        
        function setRowsState() {
            $('.k-master-row > td.k-hierarchy-cell a').click(function flipMasterRow(e) {
                var el = $(this).parent().parent()
                if (el.hasClass('bold')) {
                    el.removeClass('bold');
                } else {
                    el.addClass('bold');
                }
                setButtonsState();
            });
            $('#expand-all').click(function() {
                $('.k-master-row:not(.bold) > td.k-hierarchy-cell a').click();
            });
            $('#collapse-all').click(function() {
                $('.k-master-row.bold > td.k-hierarchy-cell a').click();
            });
            $('.k-master-row > td.k-hierarchy-cell a').click();
            setButtonsState();
        }
@*
        $('#FindSearchValue').keyup(function(e) {
            if (e.keyCode == 13) {
                $('#@UniqueId.FindCnSeries').click();
            }
        });
*@
        $(document).ready(checkInput);
    </script>
</div>
