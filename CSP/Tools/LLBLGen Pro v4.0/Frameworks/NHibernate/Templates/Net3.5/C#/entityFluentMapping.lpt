%>				.KeyReference(x => x.<%=relationship.NavigatorFkSide%>, x => x.Access.CamelCaseField(Prefix.Underscore), <%=string.Join(", ", targetFieldNames.ToArray())%>)<%if(index==pkFieldList.Count) { %>;<%}%>
