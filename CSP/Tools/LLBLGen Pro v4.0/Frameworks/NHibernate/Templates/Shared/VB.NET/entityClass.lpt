<%
	Project currentProject = _executingGenerator.ProjectDefinition;
	EntityDefinition entity = (EntityDefinition)_activeObject;
	bool isSubType = entity.IsSubType;
	var allRelationshipInfosToTraverse = GeneratorUtils.GetAllRelationshipInfosForEntity(_executingGenerator, entity);
	bool requiresIesiNamespaceReference = allRelationshipInfosToTraverse.Any(ri=>ri.NavigatorInstance.OutputSettingValues.GetRealStringSettingValue("CollectionType", currentProject)=="set");
	var entityFields = entity.Fields.Where(f=>f.FieldType.KindOfType==FieldTypeKind.DotNetType && !f.IsDiscriminator && 
													(!f.IsForeignKeyField || (f.IsForeignKeyField && f.IsPartOfIdentifyingFields))).OrderBy(f=>f.Name);
	var valueTypeFields = entity.Fields.Where(f=>f.FieldType.KindOfType==FieldTypeKind.ValueTypeDefinition).OrderBy(f=>f.Name);
	var identifyingFields = entityFields.Where(f=>f.IsPartOfIdentifyingFields);
	int countOfIdentifyingFields = identifyingFields.Count();
	var relationshipsFromPk = (from f in identifyingFields
							   where f.IsForeignKeyField
							   select entity.GetAllRelationshipsContainingFkField(f).First()).Distinct();
	bool pkContainsFk = relationshipsFromPk.Any();
	bool singleFkFormingKey = relationshipsFromPk.Count()==1 && relationshipsFromPk.First().FkFieldsFormPkOfFkSide && 
									relationshipsFromPk.First().FieldRelationships.Count==1;
	if(!singleFkFormingKey)
	{
		// filter out FK fields in entityFields which are part of the pk
		entityFields = entityFields.Where(f=>!f.IsForeignKeyField).OrderBy(f=>f.Name);
	}
	bool supportsPartialMethods = (_executingGenerator.PlatformToUse.GetAspectValue("supportsPartialMethods")!=string.Empty);
	_executingGenerator.StoreValueInRunQueueCache("EntityClassesNamespace", _executingGenerator.RootNamespaceToUse + ".EntityClasses");
%>'------------------------------------------------------------------------------
' <Auto-generated>This code was generated by LLBLGen Pro v<%=ApplicationConstants.LLBLGenProVersion%>.</Auto-generated>
'------------------------------------------------------------------------------
Imports System
Imports System.ComponentModel
Imports System.Collections.Generic
<%	if(valueTypeFields.Count() > 0)
	{
%>Imports <%=_executingGenerator.RootNamespaceToUse%>.ValueTypeClasses
<%	}

	foreach(var additionalNamespace in entity.GetAdditionalNamespaces(currentProject))
	{
%>Imports <%=additionalNamespace%>
<%	}
%>
Namespace <%=_executingGenerator.RootNamespaceToUse%>.EntityClasses
	''' <summary>Class which represents the entity '<%=entity.FullName%>'</summary>
<%	
	//-----------------CUSTOM PROPERTIES-------------------------------------------------------
	if(entity.OutputSettingValues.CustomProperties.Count>0)
	{
%>	''' <remarks>Custom Properties: <br/>
<%		foreach(var kvp in entity.OutputSettingValues.CustomProperties)
		{
%>	''' <%=kvp.Key%>: <%=kvp.Value%><br/>
<%		}
%>	''' </remarks>
<%	}
	foreach(var additionalAttribute in SD_NHibernateGeneralUtils.GetAttributes(entity, currentProject))
	{
%>	<%=_executingGenerator.ProduceRealAttributeString(additionalAttribute)%>
<%	}
	string inheritedTypesAsString = SD_NHibernateGeneralUtils.GetInheritedTypesAsStringVBNet(entity, "EntityBaseClassName", currentProject);
%>	Public Class [<%=entity.Name%>]
<% if(isSubType) 
	{
%>		Inherits <%=entity.GetSuperType().Name%>
<%	} 
	else 
	{
%><%=inheritedTypesAsString%>
<%	}
%>
<%	if((allRelationshipInfosToTraverse.Count>0) || (entityFields.Union(valueTypeFields).Count() > 0))
	{
%>#Region "Class Member Declarations"
<%
		//-----------------RELATIONSHIP MEMBERS-------------------------------------------------------
		foreach(var relationshipInfo in allRelationshipInfosToTraverse)
		{
			if(relationshipInfo.NavigatorIsHidden || relationshipInfo.RelatedEntity.IsPureManyToManyIntermediate)
			{
				continue;
			}
			string typeName = SD_NHibernateGeneralUtils.ProduceNavigatorDotNetTypeName(currentProject, relationshipInfo, "{0}(Of {1})");
%>		Private _<%=GeneratorUtils.CamelCaseString(relationshipInfo.Navigator)%> As <%=typeName%>
<%		}
	
		//-----------------FIELD MEMBERS-------------------------------------------------------
		foreach(IFieldElementCore field in entityFields.Union(valueTypeFields))
		{
%>		Private _<%=GeneratorUtils.CamelCaseString(field.Name)%> As <%=SD_NHibernateGeneralUtils.ProduceDotNetTypeName(field, _executingGenerator, "Nullable(Of {0})")%>
<%		}
%>#End Region

<%	}
%>		''' <summary>Initializes a New instance Of the <see cref="<%=entity.Name%>"/> Class.</summary>
		<% if(entity.IsAbstract) {%>Friend<%} else {%>Public<%}%> Sub New()
			MyBase.New()
<%	//-----------------INITIALISE COLLECTIONS-------------------------------------------------------
	bool initializeCollectionMembers = currentProject.GetRealBoolSettingValue("InitializeCollectionFields");
	if(initializeCollectionMembers)
	{
		foreach(var relationshipInfo in allRelationshipInfosToTraverse)
		{
			if(relationshipInfo.NavigatorIsHidden || relationshipInfo.RelatedEntity.IsPureManyToManyIntermediate)
			{
				continue;
			}
			if(!relationshipInfo.NavigatorIsSingleEntity) 
			{
				string typeName = string.Empty;
				string collectionType = relationshipInfo.NavigatorInstance.OutputSettingValues.GetRealStringSettingValue("CollectionType", currentProject);
				switch(collectionType)
				{
					case "bag":
						typeName = "List";
						break;
					case "set":
						typeName = "Iesi.Collections.Generic.HashedSet";
						break;
				}
%>			_<%=GeneratorUtils.CamelCaseString(relationshipInfo.Navigator)%> = New <%=typeName%>(Of <%=relationshipInfo.RelatedEntity.Name%>)()
<%			}
		}
	}

	//-----------------INITIALISE VALUE TYPES-------------------------------------------------------
	foreach(IFieldElementCore field in valueTypeFields)
	{
%>			_<%=GeneratorUtils.CamelCaseString(field.Name)%> = New <%=SD_NHibernateGeneralUtils.ProduceDotNetTypeName(field, _executingGenerator, "Nullable(Of {0})")%>()
<%	}

	//-----------------INITIALISE READONLY BACKING FIELDS-------------------------------------------------------
	foreach(IFieldElementCore field in entityFields.Where(f=>f.IsReadOnly))
	{
		 if(!field.OutputSettingValues.GetRealBoolSettingValue("EmitFieldSetter", currentProject))
		 {
		 	// no need for initialization, no setter was required anyway.
			continue;
		 }
%>			_<%=GeneratorUtils.CamelCaseString(field.Name)%> = Nothing
<%	}

	if(!isSubType && supportsPartialMethods)
	{
%>			OnCreated()
<%	}
%>		End Sub

<%	if(!isSubType)
	{
		if(supportsPartialMethods)
		{
%>		''' <summary>Method called From the constructor</summary>
		Partial Private Sub OnCreated()
		End Sub
		
<%		}
%>		''' <summary>Returns a hash code For this instance.</summary>
		''' <returns>A hash code For this instance, suitable For use In hashing algorithms And data structures like a hash table. </returns>
		Public Overrides Function GetHashCode() As Integer
			Dim toReturn As Integer = MyBase.GetHashCode()
<%		if(!pkContainsFk || singleFkFormingKey)
		{
			foreach(IFieldElementCore field in identifyingFields)
			{
				if(field.IsOptional)
				{
%>			toReturn = toReturn Xor CInt(IIf(Me.<%=field.Name%> Is Nothing, 0, Me.<%=field.Name%>.GetHashCode()))
<%				}
				else
				{
%>			toReturn = toReturn Xor Me.<%=field.Name%>.GetHashCode()
<%				}
			}
		}
%>			Return toReturn
		End Function
	
		''' <summary>Determines whether the specified Object Is equal To this instance.</summary>
		''' <param name="obj">The <see cref="System.Object"/> To Compare With this instance.</param>
		''' <returns><c>True</c> If the specified <see cref="System.Object"/> Is equal To this instance; otherwise, <c>False</c>.</returns>
		Public Overrides Function Equals(obj As Object) As Boolean
<%		if(pkContainsFk && !singleFkFormingKey)
		{
%>			Return Object.ReferenceEquals(Me, obj)
<%		}
		else
		{
%>			If obj Is Nothing Then
				Return False
			End If
            Dim toCompareWith As <%=entity.Name%> = TryCast(obj, <%=entity.Name%>)
            Return CBool(IIf(toCompareWith Is Nothing, False, (<% int index=1;foreach(IFieldElementCore field in identifyingFields){%>Me.<%=field.Name%>.Equals(toCompareWith.<%=field.Name%>)<%if(index<identifyingFields.Count()){%> AndAlso <%}%><%index++;}%>)))
<%		}
%>		End Function
<# SD_NHibernate_CustomEntityInclude #>		
<%	}

	if(entityFields.Union(valueTypeFields).Any() || allRelationshipInfosToTraverse.Any() || entity.FieldsMappedOntoRelatedFields.Any())
	{
%>
#Region "Class Property Declarations"
<%	//-----------------FIELD PROPERTIES-------------------------------------------------------
		foreach(IFieldElementCore field in entityFields.Union(valueTypeFields))
		{
			bool emitSetter = (!field.IsReadOnly && field.OutputSettingValues.GetRealBoolSettingValue("EmitFieldSetter", currentProject));
%>		''' <summary>Gets<% if(emitSetter) { %> Or sets<%}%> the <%=field.Name%> field. <%=field.Description%></summary>	
<%			if(field.OutputSettingValues.CustomProperties.Count>0)
			{
%>		''' <remarks>Custom Properties: <br/>
<%				foreach(var kvp in field.OutputSettingValues.CustomProperties)
				{
%>		''' <%=kvp.Key%>: <%=kvp.Value%><br/>
<%				}
%>		''' </remarks>
<%			}
			foreach(var additionalAttribute in SD_NHibernateGeneralUtils.GetAttributes(field, currentProject))
			{
%>		<%=_executingGenerator.ProduceRealAttributeString(additionalAttribute)%>
<%			}
%>		<%=field.OutputSettingValues.GetRealStringSettingValue("PropertyAccessModifier",currentProject)%> Overridable <%if(!emitSetter) { %>ReadOnly <%}%>Property [<%=field.Name%>] As <%=SD_NHibernateGeneralUtils.ProduceDotNetTypeName(field, _executingGenerator, "Nullable(Of {0})")%>
			Get
				Return _<%=GeneratorUtils.CamelCaseString(field.Name)%>
			End Get
<%			if(emitSetter)
			{
%>			Set 
				_<%=GeneratorUtils.CamelCaseString(field.Name)%> = value
			End Set
<%			}
%>		End Property

<%		}

		//-----------------RELATIONSHIP PROPERTIES-------------------------------------------------------
		foreach(var relationshipInfo in allRelationshipInfosToTraverse)
		{
			if(relationshipInfo.NavigatorIsHidden || relationshipInfo.RelatedEntity.IsPureManyToManyIntermediate)
			{
				continue;
			}
			string typeName = SD_NHibernateGeneralUtils.ProduceNavigatorDotNetTypeName(currentProject, relationshipInfo, "{0}(Of {1})");
%>		''' <summary>Represents the navigator which Is mapped onto the association '<%=relationshipInfo.Relationship.ToString()%>'</summary>
<%			if(relationshipInfo.NavigatorInstance.OutputSettingValues.CustomProperties.Count>0)
			{
%>		''' <remarks>Custom Properties: <br/>
<%				foreach(var kvp in relationshipInfo.NavigatorInstance.OutputSettingValues.CustomProperties)
				{
%>		''' <%=kvp.Key%>: <%=kvp.Value%><br/>
<%				}
%>		''' </remarks>
<%			}

			foreach(var additionalAttribute in SD_NHibernateGeneralUtils.GetAttributes(relationshipInfo.NavigatorInstance, currentProject))
			{
%>		<%=_executingGenerator.ProduceRealAttributeString(additionalAttribute)%>
<%			}
			bool emitSetter = relationshipInfo.NavigatorInstance.OutputSettingValues.GetRealBoolSettingValue("EmitNavigatorSetter", currentProject);
%>		<%=relationshipInfo.NavigatorInstance.OutputSettingValues.GetRealStringSettingValue("PropertyAccessModifier",currentProject)%> Overridable <%if(!emitSetter) { %>ReadOnly <%}%>Property [<%=relationshipInfo.Navigator%>] As <%=typeName%>
			Get 
				Return _<%=GeneratorUtils.CamelCaseString(relationshipInfo.Navigator)%>
			End Get
<%			if(emitSetter)
			{
%>			Set
				_<%=GeneratorUtils.CamelCaseString(relationshipInfo.Navigator)%> = value
			End Set
<%			}
%>		End Property
		
<%		}
	
		//-----------------FIELDS ON RELATED FIELDS-------------------------------------------------------
		foreach(var forf in entity.FieldsMappedOntoRelatedFields.OrderBy(f=>f.Name))
		{
			string typeName = SD_NHibernateGeneralUtils.ProduceDotNetTypeName(forf.MappedField.Field, _executingGenerator, "Nullable(Of {0})");
%>		''' <summary>Represents the related field 'this.<%=forf.MappedFieldAsString%>'</summary>
<%			if(forf.OutputSettingValues.CustomProperties.Count>0)
			{
%>		''' <remarks>Custom Properties: 
<%				foreach(var kvp in forf.OutputSettingValues.CustomProperties)
				{
%>		''' <%=kvp.Key%>: <%=kvp.Value%>
<%				}
%>		''' </remarks>
<%			}
			foreach(var additionalAttribute in SD_NHibernateGeneralUtils.GetAttributes(forf, currentProject))
			{
%>		<%=_executingGenerator.ProduceRealAttributeString(additionalAttribute)%>
<%			}
%>		<%=forf.OutputSettingValues.GetRealStringSettingValue("PropertyAccessModifier",currentProject)%> Overridable <%if(forf.IsReadOnly) { %>ReadOnly <%}%>Property [<%=forf.Name%>] As <%=typeName%> 
			Get
				Return CType(IIf(Me.<%=forf.MappedField.NavigatorUsed%> Is Nothing, Nothing, Me.<%=forf.MappedField.NavigatorUsed%>.<%=forf.MappedField.Field.Name%>), <%=typeName%>)
			End Get
<%			if(!forf.IsReadOnly)
			{
%>			Set
				If Not (Me.<%=forf.MappedField.NavigatorUsed%> Is Nothing) Then
					Me.<%=forf.MappedField.NavigatorUsed%>.<%=forf.MappedField.Field.Name%> = value
				End If
			End Set
<%			}
%>		End Property
		
<%		}
%>#End Region
<%	}
%>	End Class
End Namespace
