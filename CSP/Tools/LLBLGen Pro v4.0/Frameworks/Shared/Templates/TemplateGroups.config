<?xml version="1.0"?>
<templateGroups xmlns="http://sd/llblgen/pro/templateGroupsDefinition.xsd">
	<templateGroup name="Adapter" description="Template group which is focused on having persistence logic as a service." />
	<templateGroup name="SelfServicing" description="Template group which is focused on having persistence logic as behavior." />
	<templateGroup name="General" description="General template group for general grouping of templates" />
	<templateGroup name="Create DDL SQL" description="Template group which is focussed on DDL SQL generation for create scripts" />
	<templateGroup name="Update DDL SQL" description="Template group which is focussed on DDL SQL generation for update scripts" />
</templateGroups>