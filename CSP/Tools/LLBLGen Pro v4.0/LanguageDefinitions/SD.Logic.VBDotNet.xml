<SyntaxLanguage Key="LogicVBNet" LanguageDefinitionVersion="4.0" Secure="True" xmlns="http://ActiproSoftware/SyntaxEditor/4.0/LanguageDefinition">
	<!-- string properties -->
	<!-- MigrationAction: Insert or Add (default) -->
	<!-- CoreLanguage: The key of the Core language, for example CSharp -->
	<!-- DefaultBackColor: The name of the default back color for all lines in this language when it is the core logic language -->
	<Properties>
		<Property Key="Creator" Value="Solutions Design" />
		<Property Key="Copyright" Value="Copyright (c) 2002-2006 Solutions Design.  All rights reserved." />
		<Property Key="CoreLanguage" Value="VB.NET"/>
		<Property Key="DefaultBackColor" Value="WhiteSmoke" />
	</Properties>
	<!-- triggers -->
	<Triggers>
		<KeyPressTrigger Key="MemberListTriggerLogic" Character=".">
			<KeyPressTriggerValidStates>
				<KeyPressTriggerValidState State="DefaultState" />
			</KeyPressTriggerValidStates>
		</KeyPressTrigger>
	</Triggers>	
	<!-- styles -->
	<Styles>
		<Style Key="DefaultStyle" ForeColor="Black" BackColor="Default" Bold="False" Italic="False" />
		<Style Key="LLBLGenProPreprocessorElementStyle" ForeColor="Blue" BackColor="WhiteSmoke" Bold="False" Italic="False"/>
		<Style Key="LLBLGenProTemplateElementDelimiterStyle" ForeColor="Black" BackColor="Yellow" Bold="False" Italic="False"/>
		<Style Key="LLBLGenProIncludeElementDelimiterStyle" ForeColor="DarkRed" BackColor="Yellow" Bold="True" Italic="False"/>
	</Styles>

	<!-- macros -->
	<Macros>
		<!-- Redefine word macros to include hyphens -->
		<Macro Key="WordMacro" Value="[a-zA-Z_0-9\-]" />
		<Macro Key="NonWordMacro" Value="[^a-zA-Z_0-9\-]" />
		<!-- Tag name macro to include hyphens and colons -->
		<Macro Key="TagNameMacro" Value="[a-zA-Z_0-9\-:]" />
	</Macros>
	
	<!-- States -->
	<States>
		<!-- Text -->
		<State Key="DefaultState">
			<!-- Patterns Groups -->
			<PatternGroups>
				<!-- Entities -->
				<RegexPatternGroup TokenKey="EntityToken" Style="DefaultStyle" PatternValue="&amp; {WordMacro}+ ;?" />
				<!-- Identifier -->
				<RegexPatternGroup TokenKey="IdentifierToken" PatternValue="{AlphaMacro}({WordMacro})*" />
				<!-- Whitespace -->
				<RegexPatternGroup TokenKey="WhitespaceToken" PatternValue="{WhitespaceMacro}+" IsWhitespace="True" />
			</PatternGroups>
			<!-- Child States -->
			<ChildStates>
				<ChildState Key="LLBLGenPro001AssemblyReferenceDeclarationState" />
				<ChildState Key="LLBLGenPro002NamespaceReferenceDeclarationState" />
				<ChildState Key="LLBLGenPro003TemplateIncludeDeclarationState" />
				<ChildState Key="LLBLGenPro004OutputCodeSnippetState" />
				<ChildState Key="LLBLGenPro005CodeSnippetState" />
				<ChildState Key="LLBLGenPro006CodeBlockState" />
			</ChildStates>
		</State>
		
		<!-- All states start with LLBLGenPro, so the merge routine knows which states to merge -->
		<!-- As the order in which the states are added is important, 'LLBLGenPro' is followed by a 3 digit number. As the names are -->
		<!-- sorted by the xml deserializer, the number will make sure that the order is correct. -->
		
		<!-- Assembly Reference Declaration -->
		<State Key="LLBLGenPro001AssemblyReferenceDeclarationState" TokenKey="LLBLGenProAssemblyReferenceDeclarationDefaultToken" Style="LLBLGenProPreprocessorElementStyle">
			<!-- Scopes -->
			<Scopes>
				<Scope>
					<ExplicitPatternGroup Type="StartScope" TokenKey="LLBLGenProAssemblyReferenceDeclarationStartToken" 
						Style="LLBLGenProTemplateElementDelimiterStyle" PatternValue="&lt;$" />
					<ExplicitPatternGroup Type="EndScope" TokenKey="LLBLGenProAssemblyReferenceDeclarationEndToken" 
						Style="LLBLGenProTemplateElementDelimiterStyle" PatternValue="$&gt;" />	
				</Scope>
			</Scopes>
		</State>

		<!-- Namespace Reference Declaration -->
		<State Key="LLBLGenPro002NamespaceReferenceDeclarationState" TokenKey="LLBLGenProNamespaceReferenceDeclarationDefaultToken" Style="LLBLGenProPreprocessorElementStyle">
			<!-- Scopes -->
			<Scopes>
				<Scope>
					<ExplicitPatternGroup Type="StartScope" TokenKey="LLBLGenProNamespaceReferenceDeclarationStartToken" 
						Style="LLBLGenProTemplateElementDelimiterStyle" PatternValue="&lt;[" />
					<ExplicitPatternGroup Type="EndScope" TokenKey="LLBLGenProNamespaceReferenceDeclarationEndToken" 
						Style="LLBLGenProTemplateElementDelimiterStyle" PatternValue="]&gt;" />	
				</Scope>
			</Scopes>
		</State>

		<!-- Template include Declaration -->
		<State Key="LLBLGenPro003TemplateIncludeDeclarationState" TokenKey="LLBLGenProTemplateIncludeDeclarationDefaultToken" Style="LLBLGenProPreprocessorElementStyle">
			<!-- Scopes -->
			<Scopes>
				<Scope>
					<ExplicitPatternGroup Type="StartScope" TokenKey="LLBLGenProTemplateIncludeDeclarationStartToken" 
						Style="LLBLGenProIncludeElementDelimiterStyle" PatternValue="&lt;#" />
					<ExplicitPatternGroup Type="EndScope" TokenKey="LLBLGenProTemplateIncludeDeclarationEndToken" 
						Style="LLBLGenProIncludeElementDelimiterStyle" PatternValue="#&gt;" />	
				</Scope>
			</Scopes>
		</State>

		<!-- Output code snippet -->
		<State Key="LLBLGenPro004OutputCodeSnippetState" Filename="SD.VBDotNet.xml" ChildLanguageBackColor="Default">
			<!-- Scopes -->
			<Scopes>
				<Scope>
					<ExplicitPatternGroup Type="StartScope" TokenKey="LLBLGenProOutputCodeSnippetStartToken" 
						Style="LLBLGenProTemplateElementDelimiterStyle" PatternValue="&lt;%=" />
					<ExplicitPatternGroup Type="EndScope" TokenKey="LLBLGenProOutputCodeSnippetEndToken" 
						Style="LLBLGenProTemplateElementDelimiterStyle" PatternValue="%&gt;" />
				</Scope>
			</Scopes>
		</State>
		
		<!-- Code snippet -->
		<State Key="LLBLGenPro005CodeSnippetState" Filename="SD.VBDotNet.xml" ChildLanguageBackColor="Default">
			<!-- Scopes -->
			<Scopes>
				<Scope>
					<ExplicitPatternGroup Type="StartScope" TokenKey="LLBLGenProCodeSnippetStartToken" 
						Style="LLBLGenProTemplateElementDelimiterStyle" PatternValue="&lt;%" LookAhead="[^%]" />
					<ExplicitPatternGroup Type="EndScope" TokenKey="LLBLGenProCodeSnippetEndToken" 
						Style="LLBLGenProTemplateElementDelimiterStyle" PatternValue="%&gt;" />
				</Scope>
			</Scopes>
		</State>
		
		<!-- Code block -->
		<State Key="LLBLGenPro006CodeBlockState" Filename="SD.VBDotNet.xml" ChildLanguageBackColor="Default">
			<!-- Scopes -->
			<Scopes>
				<Scope>
					<ExplicitPatternGroup Type="StartScope" TokenKey="LLBLGenProCodeBlockStartToken" 
						Style="LLBLGenProTemplateElementDelimiterStyle" PatternValue="&lt;~" />
					<ExplicitPatternGroup Type="EndScope" TokenKey="LLBLGenProCodeBlockEndToken" 
						Style="LLBLGenProTemplateElementDelimiterStyle" PatternValue="~&gt;" />
				</Scope>
			</Scopes>
		</State>
	</States>
</SyntaxLanguage>
