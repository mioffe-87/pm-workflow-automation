%>			return object.ReferenceEquals(this, obj);
<%		}
		else
		{
%>			if(obj == null) 
			{
				return false;
			}
			<%=entity.Name%> toCompareWith = obj as <%=entity.Name%>;
			return toCompareWith == null ? false : (<% int index=1;foreach(IFieldElementCore field in identifyingFields){%>(this.<%=field.Name%> == toCompareWith.<%=field.Name%>)<%if(index<identifyingFields.Count()){%> && <%}%><%index++;}%>);
