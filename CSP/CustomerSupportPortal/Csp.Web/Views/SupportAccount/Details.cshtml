@using Csp.Web.DataTransferObjects
@using Kendo.Mvc.UI;
@using Csp.Api.Security;
@using Newtonsoft.Json

@model SupportAccountTabsDto

@{
    Layout = (Model.SelectedTab == SupportAccountTabs.Users) ? "~/Views/Shared/_SiteLayout.cshtml" : "~/Views/Shared/_Layout.cshtml";
}


@*@Html.Partial("../Partial/_CompanyLogoName")*@
@{

    if (Model.SelectedTab == SupportAccountTabs.Home)
    {
        Html.RenderAction("Home", new { id = Model.PartialId });
    }
    else if (Model.SelectedTab == SupportAccountTabs.Users)
    {
        ViewBag.Title = "Manage Users - Customer Support - Palo Alto Networks";
        Html.RenderAction("Users", new { id = Model.PartialId });
    }

    else if (Model.SelectedTab == SupportAccountTabs.Account)
    {
        if (Model.PartialId.HasValue && (!User.RoleSecurities.IsSupportAccountAdmin(Model.PartialId.Value) || !User.RoleSecurities.IsAscUser(Model.PartialId.Value)))
        {
            ViewBag.Title = "Company Information - Customer Support - Palo Alto Networks";
            if (User.HasPermission(Permission.EditSupportAccount))
            {
                Html.RenderAction("Edit", new { id = Model.PartialId });
            }
            else if (User.HasPermission(Permission.ViewSupportAccount))
            {
                Html.RenderAction("View", new { id = Model.PartialId });

            }

        }
        else
        {
            if (Model.PartialId.HasValue && User.HasPermission(Permission.ViewSupportAccount))
            {
                // accountTab.Selected(true).Content(Html.Action("AccountInfo", "SupportAccount", new { id = Model.PartialId }).ToString());
                Html.RenderAction("AccountInfo", "SupportAccount", new { id = Model.PartialId });
            }
        }
    }
    else if (Model.SelectedTab == SupportAccountTabs.Devices)
    {
        if (Model.PartialId.HasValue && User.HasPermission(Permission.ViewSupportAccountDevices))
        {
            // deviceTab.Selected(true).Content(Html.Action("Devices", "SupportAccount", new { id = Model.PartialId, assettype = Model.DefaultAssetType, devicecode = Model.DefaultDevicecode }).ToString());
            // Html.Red("Devices", "SupportAccount", new {id = Model.PartialId, assettype = Model.DefaultAssetType, devicecode = Model.DefaultDevicecode});

        }
    }
    else if (Model.SelectedTab == SupportAccountTabs.Groups)
    {
        if (Model.PartialId.HasValue && (User.HasPermission(Permission.CreateGroup) || (User.HasPermission(Permission.ViewSupportAccountGroups) && Model.HasGroups)))
        {
            // groupTab.Selected(true).Content(Html.Action("Groups", Model.PartialId).ToString());
            ViewBag.Title = "Groups - Customer Support - Palo Alto Networks";
            Html.RenderAction("Groups", new { id = Model.PartialId });
        }
    }

    else if (Model.IsCsspAccount && Model.SelectedTab == SupportAccountTabs.Cssp)
    {
        if (string.IsNullOrEmpty(Model.FirstQueryStringValue))
        {
            // csspTab.Selected(true).Content(Html.Action("Cssp", "SupportAccount", new {id = Model.PartialId}).ToString());
            Html.RenderAction("Cssp", "SupportAccount", new { id = Model.PartialId });
        }
        else
        {
            // csspTab.Selected(true).Content(Html.Action("Cssp", "SupportAccount", new { id = Model.PartialId, prelicenseId  = Model.FirstQueryStringValue}).ToString());
            Html.RenderAction("Cssp", "SupportAccount", new { id = Model.PartialId, prelicenseId = Model.FirstQueryStringValue });
        }
    }
}





