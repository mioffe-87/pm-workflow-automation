<edmx:Edmx Version="1.0" xmlns:edmx="http://schemas.microsoft.com/ado/2007/06/edmx">
  <edmx:DataServices xmlns:m="http://schemas.microsoft.com/ado/2007/08/dataservices/metadata" m:DataServiceVersion="1.0">
    <Schema Namespace="ServiceTester" xmlns:d="http://schemas.microsoft.com/ado/2007/08/dataservices" xmlns:m="http://schemas.microsoft.com/ado/2007/08/dataservices/metadata" xmlns="http://schemas.microsoft.com/ado/2007/05/edm">
      <EntityType Name="AddressEntity">
        <Key>
          <PropertyRef Name="AddressId" />
        </Key>
        <Property Name="AddressId" Type="Edm.Int32" Nullable="false" />
        <Property Name="City" Type="Edm.String" Nullable="true" />
        <Property Name="Country" Type="Edm.String" Nullable="true" />
        <Property Name="HouseNumber" Type="Edm.Int32" Nullable="false" />
        <Property Name="StreetName" Type="Edm.String" Nullable="true" />
        <Property Name="TestRunId" Type="Edm.Guid" Nullable="true" />
        <Property Name="Zipcode" Type="Edm.String" Nullable="true" />
        <Property Name="BillingAddressCompanyName" Type="Edm.String" Nullable="true" />
        <NavigationProperty Name="CustomerBillingAddress" Relationship="ServiceTester.AddressEntity_CustomerBillingAddress_CustomerEntity_BillingAddress" FromRole="AddressEntity_CustomerBillingAddress" ToRole="CustomerEntity_BillingAddress" />
        <NavigationProperty Name="CustomerVisitingAddress" Relationship="ServiceTester.AddressEntity_CustomerVisitingAddress_CustomerEntity_VisitingAddress" FromRole="AddressEntity_CustomerVisitingAddress" ToRole="CustomerEntity_VisitingAddress" />
      </EntityType>
      <EntityType Name="AddressSimpleEntity">
        <Key>
          <PropertyRef Name="Id" />
        </Key>
        <Property Name="City" Type="Edm.String" Nullable="true" />
        <Property Name="Country" Type="Edm.String" Nullable="true" />
        <Property Name="HouseNumber" Type="Edm.Int32" Nullable="false" />
        <Property Name="Id" Type="Edm.Int32" Nullable="false" />
        <Property Name="StreetName" Type="Edm.String" Nullable="true" />
        <Property Name="TestRunId" Type="Edm.Guid" Nullable="true" />
        <Property Name="Zipcode" Type="Edm.String" Nullable="true" />
      </EntityType>
      <EntityType Name="CustomerEntity">
        <Key>
          <PropertyRef Name="CustomerId" />
        </Key>
        <Property Name="BillingAddressId" Type="Edm.Int32" Nullable="false" />
        <Property Name="CompanyEmailAddress" Type="Edm.String" Nullable="true" />
        <Property Name="CompanyName" Type="Edm.String" Nullable="true" />
        <Property Name="ContactPerson" Type="Edm.String" Nullable="true" />
        <Property Name="CustomerId" Type="Edm.Int32" Nullable="false" />
        <Property Name="CustomerSince" Type="Edm.DateTime" Nullable="false" />
        <Property Name="TestRunId" Type="Edm.Guid" Nullable="false" />
        <Property Name="VisitingAddressId" Type="Edm.Int32" Nullable="false" />
        <Property Name="BillingAddressCountry" Type="Edm.String" Nullable="true" />
        <NavigationProperty Name="Orders" Relationship="ServiceTester.CustomerEntity_Orders_OrderEntity_Customer" FromRole="CustomerEntity_Orders" ToRole="OrderEntity_Customer" />
        <NavigationProperty Name="Employees" Relationship="ServiceTester.CustomerEntity_Employees" FromRole="CustomerEntity" ToRole="Employees" />
        <NavigationProperty Name="BillingAddress" Relationship="ServiceTester.AddressEntity_CustomerBillingAddress_CustomerEntity_BillingAddress" FromRole="CustomerEntity_BillingAddress" ToRole="AddressEntity_CustomerBillingAddress" />
        <NavigationProperty Name="VisitingAddress" Relationship="ServiceTester.AddressEntity_CustomerVisitingAddress_CustomerEntity_VisitingAddress" FromRole="CustomerEntity_VisitingAddress" ToRole="AddressEntity_CustomerVisitingAddress" />
      </EntityType>
      <EntityType Name="EmployeeEntity">
        <Key>
          <PropertyRef Name="EmployeeId" />
        </Key>
        <Property Name="EmployeeId" Type="Edm.Int32" Nullable="false" />
        <Property Name="EmployeeSince" Type="Edm.DateTime" Nullable="false" />
        <Property Name="ManagedBy" Type="Edm.Int32" Nullable="true" />
        <Property Name="Name" Type="Edm.String" Nullable="true" />
        <Property Name="Photo" Type="Edm.Binary" Nullable="true" />
        <Property Name="TestRunId" Type="Edm.Guid" Nullable="false" />
        <NavigationProperty Name="ManagesEmployees" Relationship="ServiceTester.EmployeeEntity_ManagesEmployees_EmployeeEntity_ManagedByEmployee" FromRole="EmployeeEntity_ManagesEmployees" ToRole="EmployeeEntity_ManagedByEmployee" />
        <NavigationProperty Name="Orders" Relationship="ServiceTester.EmployeeEntity_Orders_OrderEntity_Employee" FromRole="EmployeeEntity_Orders" ToRole="OrderEntity_Employee" />
        <NavigationProperty Name="Customers" Relationship="ServiceTester.EmployeeEntity_Customers" FromRole="EmployeeEntity" ToRole="Customers" />
        <NavigationProperty Name="ManagedByEmployee" Relationship="ServiceTester.EmployeeEntity_ManagesEmployees_EmployeeEntity_ManagedByEmployee" FromRole="EmployeeEntity_ManagedByEmployee" ToRole="EmployeeEntity_ManagesEmployees" />
      </EntityType>
      <EntityType Name="OrderEntity">
        <Key>
          <PropertyRef Name="OrderId" />
        </Key>
        <Property Name="CustomerId" Type="Edm.Int32" Nullable="false" />
        <Property Name="EmployeeId" Type="Edm.Int32" Nullable="true" />
        <Property Name="OrderDate" Type="Edm.DateTime" Nullable="false" />
        <Property Name="OrderId" Type="Edm.Int32" Nullable="false" />
        <Property Name="RequiredDate" Type="Edm.DateTime" Nullable="true" />
        <Property Name="ShippedDate" Type="Edm.DateTime" Nullable="true" />
        <Property Name="TestRunId" Type="Edm.Guid" Nullable="false" />
        <Property Name="CustomerCompanyName" Type="Edm.String" Nullable="true" />
        <Property Name="CustomerContactPerson" Type="Edm.String" Nullable="true" />
        <NavigationProperty Name="OrderRows" Relationship="ServiceTester.OrderEntity_OrderRows_OrderRowEntity_Order" FromRole="OrderEntity_OrderRows" ToRole="OrderRowEntity_Order" />
        <NavigationProperty Name="Customer" Relationship="ServiceTester.CustomerEntity_Orders_OrderEntity_Customer" FromRole="OrderEntity_Customer" ToRole="CustomerEntity_Orders" />
        <NavigationProperty Name="Employee" Relationship="ServiceTester.EmployeeEntity_Orders_OrderEntity_Employee" FromRole="OrderEntity_Employee" ToRole="EmployeeEntity_Orders" />
      </EntityType>
      <EntityType Name="OrderRowEntity">
        <Key>
          <PropertyRef Name="OrderId" />
          <PropertyRef Name="ProductId" />
        </Key>
        <Property Name="OrderId" Type="Edm.Int32" Nullable="false" />
        <Property Name="PriceInvoiced" Type="Edm.Decimal" Nullable="false" />
        <Property Name="ProductId" Type="Edm.Guid" Nullable="false" />
        <Property Name="Quantity" Type="Edm.Int32" Nullable="false" />
        <Property Name="TestRunId" Type="Edm.Guid" Nullable="false" />
        <NavigationProperty Name="Order" Relationship="ServiceTester.OrderEntity_OrderRows_OrderRowEntity_Order" FromRole="OrderRowEntity_Order" ToRole="OrderEntity_OrderRows" />
      </EntityType>
      <Association Name="AddressEntity_CustomerBillingAddress_CustomerEntity_BillingAddress">
        <End Role="AddressEntity_CustomerBillingAddress" Type="ServiceTester.AddressEntity" Multiplicity="0..1" />
        <End Role="CustomerEntity_BillingAddress" Type="ServiceTester.CustomerEntity" Multiplicity="0..1" />
      </Association>
      <Association Name="AddressEntity_CustomerVisitingAddress_CustomerEntity_VisitingAddress">
        <End Role="AddressEntity_CustomerVisitingAddress" Type="ServiceTester.AddressEntity" Multiplicity="0..1" />
        <End Role="CustomerEntity_VisitingAddress" Type="ServiceTester.CustomerEntity" Multiplicity="0..1" />
      </Association>
      <Association Name="CustomerEntity_Orders_OrderEntity_Customer">
        <End Role="CustomerEntity_Orders" Type="ServiceTester.CustomerEntity" Multiplicity="0..1" />
        <End Role="OrderEntity_Customer" Type="ServiceTester.OrderEntity" Multiplicity="*" />
      </Association>
      <Association Name="CustomerEntity_Employees">
        <End Role="CustomerEntity" Type="ServiceTester.CustomerEntity" Multiplicity="*" />
        <End Role="Employees" Type="ServiceTester.EmployeeEntity" Multiplicity="*" />
      </Association>
      <Association Name="EmployeeEntity_ManagesEmployees_EmployeeEntity_ManagedByEmployee">
        <End Role="EmployeeEntity_ManagesEmployees" Type="ServiceTester.EmployeeEntity" Multiplicity="0..1" />
        <End Role="EmployeeEntity_ManagedByEmployee" Type="ServiceTester.EmployeeEntity" Multiplicity="*" />
      </Association>
      <Association Name="EmployeeEntity_Orders_OrderEntity_Employee">
        <End Role="EmployeeEntity_Orders" Type="ServiceTester.EmployeeEntity" Multiplicity="0..1" />
        <End Role="OrderEntity_Employee" Type="ServiceTester.OrderEntity" Multiplicity="*" />
      </Association>
      <Association Name="EmployeeEntity_Customers">
        <End Role="EmployeeEntity" Type="ServiceTester.EmployeeEntity" Multiplicity="*" />
        <End Role="Customers" Type="ServiceTester.CustomerEntity" Multiplicity="*" />
      </Association>
      <Association Name="OrderEntity_OrderRows_OrderRowEntity_Order">
        <End Role="OrderEntity_OrderRows" Type="ServiceTester.OrderEntity" Multiplicity="0..1" />
        <End Role="OrderRowEntity_Order" Type="ServiceTester.OrderRowEntity" Multiplicity="*" />
      </Association>
      <EntityContainer Name="UnitTestService" m:IsDefaultEntityContainer="true">
        <EntitySet Name="Address" EntityType="ServiceTester.AddressEntity" />
        <EntitySet Name="AddressSimple" EntityType="ServiceTester.AddressSimpleEntity" />
        <EntitySet Name="Customer" EntityType="ServiceTester.CustomerEntity" />
        <EntitySet Name="Employee" EntityType="ServiceTester.EmployeeEntity" />
        <EntitySet Name="Order" EntityType="ServiceTester.OrderEntity" />
        <EntitySet Name="OrderRow" EntityType="ServiceTester.OrderRowEntity" />
        <AssociationSet Name="AddressEntityCustomerEntityBillingAddressId" Association="ServiceTester.AddressEntity_CustomerBillingAddress_CustomerEntity_BillingAddress">
          <End Role="AddressEntity_CustomerBillingAddress" EntitySet="Address" />
          <End Role="CustomerEntity_BillingAddress" EntitySet="Customer" />
        </AssociationSet>
        <AssociationSet Name="AddressEntityCustomerEntityVisitingAddressId" Association="ServiceTester.AddressEntity_CustomerVisitingAddress_CustomerEntity_VisitingAddress">
          <End Role="AddressEntity_CustomerVisitingAddress" EntitySet="Address" />
          <End Role="CustomerEntity_VisitingAddress" EntitySet="Customer" />
        </AssociationSet>
        <AssociationSet Name="CustomerEntityOrderEntityCustomerId" Association="ServiceTester.CustomerEntity_Orders_OrderEntity_Customer">
          <End Role="CustomerEntity_Orders" EntitySet="Customer" />
          <End Role="OrderEntity_Customer" EntitySet="Order" />
        </AssociationSet>
        <AssociationSet Name="CustomerEntity_Employees" Association="ServiceTester.CustomerEntity_Employees">
          <End Role="CustomerEntity" EntitySet="Customer" />
          <End Role="Employees" EntitySet="Employee" />
        </AssociationSet>
        <AssociationSet Name="EmployeeEntityEmployeeEntityManagedBy" Association="ServiceTester.EmployeeEntity_ManagesEmployees_EmployeeEntity_ManagedByEmployee">
          <End Role="EmployeeEntity_ManagesEmployees" EntitySet="Employee" />
          <End Role="EmployeeEntity_ManagedByEmployee" EntitySet="Employee" />
        </AssociationSet>
        <AssociationSet Name="EmployeeEntityOrderEntityEmployeeId" Association="ServiceTester.EmployeeEntity_Orders_OrderEntity_Employee">
          <End Role="EmployeeEntity_Orders" EntitySet="Employee" />
          <End Role="OrderEntity_Employee" EntitySet="Order" />
        </AssociationSet>
        <AssociationSet Name="EmployeeEntity_Customers" Association="ServiceTester.EmployeeEntity_Customers">
          <End Role="EmployeeEntity" EntitySet="Employee" />
          <End Role="Customers" EntitySet="Customer" />
        </AssociationSet>
        <AssociationSet Name="OrderEntityOrderRowEntityOrderId" Association="ServiceTester.OrderEntity_OrderRows_OrderRowEntity_Order">
          <End Role="OrderEntity_OrderRows" EntitySet="Order" />
          <End Role="OrderRowEntity_Order" EntitySet="OrderRow" />
        </AssociationSet>
      </EntityContainer>
    </Schema>
  </edmx:DataServices>
</edmx:Edmx>