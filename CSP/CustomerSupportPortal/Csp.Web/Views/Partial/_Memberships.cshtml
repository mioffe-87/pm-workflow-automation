    function @(UniqueId.memberships)onMemberGridError(args) {
        if (args.errors) {
            var grid = $("#@UniqueId.gridId").data("kendoGrid");
            var gridElement = grid.editable.element;

            grid.one("dataBinding", function (e) {
                e.preventDefault ? e.preventDefault() : e.returnValue = false; // cancel grid rebind if error occurs

                $.each(args.errors, function (key, value) {
                    if (value.errors) {
                        if (key.length > 6 && key.substring(0, 6) == 'Roles[') {
                            key = 'Roles';
                        }
                        gridElement.find("[data-valmsg-for=" + key + "],[data-val-msg-for=" + key + "]")
                            .replaceWith(SupportPortal.ValidationMessageTemplate({ field: key, message: value.errors[0] }));

                        // Comments By LK On 11/06/2013
                        // Do not set the focus since we are clearing the error messages when a user clicks on the controls
                        //gridElement.find("input[name=" + key + "]").focus();
                    }
                });
            });
        }
    }

        function @(UniqueId.memberships)onMemberGridRequestEnd(e) {
        //check for errors in the response
        if (e.response == null || e.response.Errors == null) {
            var message = "";

            switch (e.type) {
                case "create":
                    message = "Membership has been created successfully";
                    break;
                case "update":
                    message = "Membership has been updated successfully";
                    break;
                case "delete":
                    message = "Membership has been deleted successfully";
                    break;
                default:
            }

            if (message != "") {
                SupportPortal.ClearNotification();
                SupportPortal.Notification(message, SupportPortal.NotificationType.Success);
            }
        } else {
            if (e.response.Errors["Error"] != undefined) {
                SupportPortal.ClearNotification();
                SupportPortal.Notification(e.response.Errors["Error"].errors[0], SupportPortal.NotificationType.Error);
            }
        }
    }

    function @(UniqueId.memberships)CreateMembership() {
        var grid = $("#@UniqueId.gridId").data("kendoGrid");
        grid.addRow();
    }

    function @(UniqueId.memberships)EditMembership(e) {
        var grid = $("#@UniqueId.gridId").data("kendoGrid");
        grid.editRow($(e.target).closest("tr"));
    }

    function @(UniqueId.memberships)CancelMembership() {
        var grid = $("#@UniqueId.gridId").data("kendoGrid");
        grid.cancelRow();
    }

    function @(UniqueId.memberships)UpdateMembership() {
        var grid = $("#@UniqueId.gridId").data("kendoGrid");
        var gridElement = grid.editable.element;
        var mfaType = gridElement.find('[id="MultiFactorAuthType"]').val();
        var enableEmailMfa = gridElement.find('[id="EnableEmailMfa"]').prop('checked');
        if (enableEmailMfa && mfaType == 2) {
            SupportPortal.Confirmation(
                "Are you sure you want to switch user's MFA from Google Authenticator to email based OTP?",
                function() {
                    grid.saveRow();
                    gridElement.find('[id="mfaStatus"]').text("Email");
                },
                function(){
                    grid.cancelRow();
                });
        } else {
            grid.saveRow();
        }
    }

