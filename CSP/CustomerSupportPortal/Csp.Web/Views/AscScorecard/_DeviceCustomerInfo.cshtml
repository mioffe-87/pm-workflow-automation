        $(".CustomerInfoexport-img").click(function () {
            var chart = $("#customerInfoBarChart").getKendoChart();
            chart.exportImage().done(function (data) {
                kendo.saveAs({
                    dataURI: data,
                    fileName: "CustomerInfo.png",
                    proxyURL: "@Url.Action("Export_Save", "Chart_Api")"
            });
        });

        });
    </script>*@
}