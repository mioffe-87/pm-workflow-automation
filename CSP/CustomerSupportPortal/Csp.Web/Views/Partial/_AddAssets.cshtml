@using Csp.Api.Model
@model Csp.Web.DataTransferObjects.AddAssetsDto
@{ 
    ActionHelper actionHelper = Model.ActionHelper;
    var availablePurchasesGridId = UniqueId.GridAvailablePurchases;
    var selectedPurchasesGridId = UniqueId.GridSelectedPurchases;
    var pageSizeOptionsForms = new List<int> { 5, 10, 20, 50 };
}
<style>
    .move-assets {
        display: table-row;
    }

    .grid-available-purchases {
        width: 47%;
        display: table-cell;
    }

    .grid-selected-purchases {
        width: 47%;
        display: table-cell;
    }

    .grid-commands {
        width: 5%;
        display: table-cell;
        text-align: center;
        vertical-align: middle;
    }

    .grid-available-purchases fieldset, .grid-selected-purchases fieldset {
        padding: 0px;
    }

    .grid-commands div {
        padding: 5px;
    }

    .grid-commands div a {
        text-align: center;
        text-decoration: none;
        width: 35px;
    }

    .search-purchases {
        display: inline;
    }

    .assets-toolbar {
        padding: 5px;
        height: 20px;
    }
</style>
<script>
    var availablePurchasesGridId = '@availablePurchasesGridId';
    var selectedPurchasesGridId = '@selectedPurchasesGridId';

    function GetAdditionalInfo() {
        return {
            customerCode: $("#CustomerCode").val(),
            deviceCode: $("#DeviceCode").val()
        };
    }

    function Search() {
        SupportPortal.BlockUI();
        SupportPortal.ClearNotification();

        $('#' + availablePurchasesGridId).data('kendoGrid').dataSource.filter({});
        $('#' + availablePurchasesGridId).data('kendoGrid').dataSource.read();
        $('#' + selectedPurchasesGridId).data('kendoGrid').dataSource.data([]);

        return false;
    }

    function MoveRows(fromGrid, toGrid, isSelectAll) {
        if (fromGrid.tbody.find('tr.grid-empty-message-row').length > 0) {
            return;
        }

        var selectedRows = (isSelectAll) ? fromGrid.dataSource.data().toJSON() : GetSelectedRows(fromGrid);

        if (selectedRows.length > 0) {
            var fromGridData = fromGrid.dataSource.data().toJSON();
            var toGridData = toGrid.dataSource.data().toJSON();

            var fromGridIdsForDeletion = _.difference(_.pluck(fromGridData, 'UniqueId'), _.pluck(selectedRows, 'UniqueId'));
            var fromGridDataSource = _.filter(fromGridData, function (item) { return fromGridIdsForDeletion.indexOf(item.UniqueId) >= 0; });
            var toGridDataSource = _.values(_.extend(_.indexBy(toGridData, 'UniqueId'), _.indexBy(selectedRows, 'UniqueId')));

            fromGrid.dataSource.data(fromGridDataSource);
            toGrid.dataSource.data(toGridDataSource);
        }
    }

    function GetSelectedRows(grid) {
        var items = [];
        var selected = grid.select();

        if (selected.length > 0) {
            $.each(selected, function (idx, elem) {
                items.push(grid.dataItem(elem).toJSON());
            });
        }

        return items;
    }

    function ToggleClaimSelectedPurchasesButton() {
        var selectedCount = $('#' + selectedPurchasesGridId).data('kendoGrid').dataSource.total();

        if (selectedCount > 0) {
            $("#btnClaimSelectedPurchases").val("Add (" + selectedCount + ") Selected Asset(s)");
        } else {
            $("#btnClaimSelectedPurchases").val("Add Selected Assets");
        }
    }

    function OnGridAvailablePurchasesError(e) {
        var status = e.status;

        SupportPortal.ClearNotification();

        if (status === "customerror") {
            SupportPortal.Notification(e.errors, SupportPortal.NotificationType.Error);
        }
    }

    function OnGridAvailablePurchasesRequestEnd(e) {
        SupportPortal.UnBlockUI();
    }

    function OnGridAvailablePurchasesDataBound(e) {
        var grid = e.sender;

        if (grid.dataSource.total() === 0) {
            var columnCount = grid.columns.length;
            $(e.sender.wrapper)
                .find('tbody')
                .append('<tr class="grid-empty-message-row"><td colspan="' + columnCount + '" class="grid-empty-message">No available assets to display</td></tr>');
        }
    }

    function OnGridSelectedPurchasesDataBound(e) {
        var grid = e.sender;

        if (grid.dataSource.total() === 0) {
            var columnCount = grid.columns.length;
            $(e.sender.wrapper)
                .find('tbody')
                .append('<tr class="grid-empty-message-row"><td colspan="' + columnCount + '" class="grid-empty-message">No selected assets to display</td></tr>');
        }

        ToggleClaimSelectedPurchasesButton();
    }

    function CloseAddAssetsWindow(e) {
        $(e).closest(".k-window-content").data("kendoWindow").close();
    }

    function OnGridAvailablePurchasesParse(response) {
        SupportPortal.ClearNotification();

        if (!response.Data.Success) {
            SupportPortal.Notification(response.Data.Errors, SupportPortal.NotificationType.Error);
        }

        try {
            $('#AvailableAssetsTypeFilter').data('kendoDropDownList').value("");
            $('#AvailableAssetsTypeFilter').data('kendoDropDownList').setDataSource(response.Data.AssetTypes);

            $('#AvailableAssetsCodeFilter').data('kendoDropDownList').value("");
            $('#AvailableAssetsCodeFilter').data('kendoDropDownList').setDataSource(response.Data.AssetCodes);

            $('#AvailableAssetsPartNumberFilter').data('kendoDropDownList').value("");
            $('#AvailableAssetsPartNumberFilter').data('kendoDropDownList').setDataSource(response.Data.PartNumbers);

            $('#AvailableAssetsSalesOrderNumberFilter').data('kendoDropDownList').value("");
            $('#AvailableAssetsSalesOrderNumberFilter').data('kendoDropDownList').setDataSource(response.Data.SalesOrderNumbers);

            /*
            $('#SelectedAssetsTypeFilter').data('kendoDropDownList').setDataSource(response.Data.AssetTypes);
            $('#SelectedAssetsCodeFilter').data('kendoDropDownList').setDataSource(response.Data.AssetCodes);
            $('#SelectedAssetsPartNumberFilter').data('kendoDropDownList').setDataSource(response.Data.PartNumbers);
            $('#SelectedAssetsSalesOrderNumberFilter').data('kendoDropDownList').setDataSource(response.Data.SalesOrderNumbers);
            */
        } catch (e) {
            
        }

        return response.Data.Data;
    }

    function OnAvailableAssetsTypeFilterChange(e) {
        ApplyFilter(availablePurchasesGridId, 'AssetType', e.sender.value());
    }

    function OnAvailableAssetsCodeFilterChange(e) {
        ApplyFilter(availablePurchasesGridId, 'Code', e.sender.value());
    }

    function OnAvailableAssetsPartNumberFilterChange(e) {
        ApplyFilter(availablePurchasesGridId, 'PartNumber', e.sender.value());
    }

    function OnAvailableAssetsSalesOrderNumberFilterChange(e) {
        ApplyFilter(availablePurchasesGridId, 'SalesOrderNumber', e.sender.value());
    }

    function OnSelectedAssetsTypeFilterChange(e) {
        ApplyFilter(selectedPurchasesGridId, 'AssetType', e.sender.value());
    }

    function OnSelectedAssetsCodeFilterChange(e) {
        ApplyFilter(selectedPurchasesGridId, 'Code', e.sender.value());
    }

    function OnSelectedAssetsPartNumberFilterChange(e) {
        ApplyFilter(selectedPurchasesGridId, 'PartNumber', e.sender.value());
    }

    function OnSelectedAssetsSalesOrderNumberFilterChange(e) {
        ApplyFilter(selectedPurchasesGridId, 'SalesOrderNumber', e.sender.value());
    }

    function ApplyFilter(gridName, fieldName, filterValue) {
        var grid = $("#" + gridName).data("kendoGrid");
        var gridFilters = grid.dataSource.filter();
        var currentFilters = gridFilters ? gridFilters.filters : [];

        if (currentFilters && currentFilters.length > 0) {
            for (var i = 0; i < currentFilters.length; i++) {
                if (currentFilters[i].field === fieldName) {
                    currentFilters.splice(i, 1);
                    break;
                }
            }
        }

        if (filterValue !== "") {
            currentFilters.push({
                field: fieldName,
                operator: "eq",
                value: filterValue
            });
        }

        var filter = { logic: "and", filters: currentFilters };

        if (currentFilters.length === 0 && gridName === availablePurchasesGridId && grid.dataSource.total() === 0) {
            return;
        }

        grid.dataSource.filter(filter);
    }
</script>
