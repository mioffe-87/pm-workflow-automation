	''' <summary>
	''' An System.Collections.ObjectModel.ObservableCollection that raises individual item removal notifications on clear and prevents adding duplicates.
	''' </summary>
	''' <typeparam name="T"></typeparam>
	Public Class TrackableCollection(Of T)
		Inherits ObservableCollection(Of T)
		''' <summary>Clears the items.</summary>
		Protected Overrides Sub ClearItems()
			Dim items As New List(Of T)(Me)
			items.ForEach(Function(t) Remove(t))
		End Sub

		''' <summary>Inserts the item.</summary>
		''' <param name="index">The index.</param>
		''' <param name="item">The item.</param>
		Protected Overrides Sub InsertItem(index As Integer, item As T)
			If Not Me.Contains(item) Then
				MyBase.InsertItem(index, item)
			End If
		End Sub
	End Class


